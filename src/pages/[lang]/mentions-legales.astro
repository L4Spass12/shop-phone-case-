---
/**
 * ⚠️ PLACEHOLDER LÉGAL — À FAIRE VALIDER PAR UN JURISTE AVANT MISE EN LIGNE.
 *
 * Un texte juridique traduit n'est PAS un texte juridique valide dans l'autre
 * juridiction : ces pages fournissent la structure attendue par chaque marché,
 * pas un contenu opposable.
 *
 * ⚖️ PRINCIPE DU PAYS D'ORIGINE (directive e-commerce 2000/31, art. 3) : un
 * vendeur établi en FRANCE relève du droit français pour ses obligations
 * d'identification. Il n'a donc PAS à produire un « Impressum » au sens du
 * §5 DDG allemand, lequel vise les fournisseurs établis en Allemagne.
 *
 * On conserve néanmoins le titre « Impressum » : c'est le terme que les
 * consommateurs allemands cherchent, et l'information d'identification doit
 * de toute façon leur être fournie (directive UE droits des consommateurs).
 * Le contenu identifie donc l'entreprise FRANÇAISE, et renvoie au médiateur
 * français — et non à une Verbraucherschlichtungsstelle allemande, le VSBG ne
 * s'appliquant qu'aux entreprises établies en Allemagne.
 *
 * NB : le §5 TMG n'existe plus, remplacé par le §5 DDG en mai 2024. Les
 * modèles citant « §5 TMG » sont périmés.
 * Remplace tous les [CROCHETS] et fais relire le tout.
 */
import LegalPage from '../../components/LegalPage.astro';
import siteConfig from '../../../site.config.mjs';
import { ACTIVE_LOCALES } from '../../lib/i18n';

export async function getStaticPaths() {
  return ACTIVE_LOCALES
    .filter(l => l !== siteConfig.i18n.defaultLocale)
    .map(lang => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: 'en' | 'de' };
const shop  = siteConfig.name;
const email = siteConfig.forms?.contactEmail ?? 'contact@example.com';

const content = {
  en: {
    heading: 'LEGAL NOTICE',
    description: `Legal notice for ${shop}: publisher, contact details, hosting provider and VAT information.`,
    html: `
<p><strong>Site publisher</strong> This website, accessible at <strong>${siteConfig.url}</strong> (the "Site"), is operated by a company established in <strong>France</strong> and is therefore subject to French law:</p>

<p><strong>[COMPANY NAME]</strong>, [LEGAL FORM], registered office at <strong>[ADDRESS]</strong>. Company registration number <strong>[REGISTRATION NUMBER]</strong>, registered in [CITY/REGISTRY].</p>

<h2 class="wp-block-heading">Contact details</h2>

<ul class="wp-block-list">
<li>Email: <strong>${email}</strong></li>
<li>Phone: <strong>[PHONE]</strong></li>
<li>Postal address: [ADDRESS]</li>
</ul>

<h2 class="wp-block-heading">VAT</h2>

<p>[VAT STATUS: e.g. "VAT number [VAT ID]" or "Not VAT registered".]</p>

<h2 class="wp-block-heading">Person responsible for publication</h2>

<p>[NAME OF THE PERSON RESPONSIBLE FOR PUBLICATION].</p>

<h2 class="wp-block-heading">Hosting</h2>

<p>The Site is hosted by <strong>[HOSTING PROVIDER + ADDRESS]</strong>, who can be reached at: [HOSTING PROVIDER CONTACT].</p>

<h2 class="wp-block-heading">Intellectual property</h2>

<p>Unless stated otherwise, all content on this Site (texts, images, logos, page structure) is the property of [COMPANY NAME] or is used with permission. Any reproduction without prior written consent is prohibited.</p>

<h2 class="wp-block-heading">Consumer mediation</h2>

<p>As a French business we are affiliated with an approved consumer mediation body, which you can contact <strong>free of charge</strong> if a written complaint to us has not been resolved to your satisfaction:</p>

<p><strong>[MEDIATOR NAME]</strong> — <strong>[ADDRESS]</strong> — <strong>[WEBSITE]</strong></p>

<p><em>The EU online dispute resolution (ODR) platform was permanently shut down on 20 July 2025; a link to it is no longer required.</em></p>
`,
  },
  de: {
    heading: 'IMPRESSUM',
    description: `Impressum von ${shop}: Anbieter, Kontakt, Hosting und Umsatzsteuer-Angaben.`,
    html: `
<p><strong>Anbieter dieser Website</strong></p>

<p><em>Dieser Shop wird von einem in Frankreich ansässigen Unternehmen betrieben. Nach dem Herkunftslandprinzip (Art. 3 der E-Commerce-Richtlinie) gilt für die Anbieterkennzeichnung französisches Recht; die folgenden Angaben entsprechen den französischen Vorschriften und geben dir alle Informationen, die du zur Identifikation des Verkäufers brauchst.</em></p>

<p><strong>[FIRMENNAME]</strong>, [RECHTSFORM]<br />
[STRASSE UND HAUSNUMMER]<br />
[PLZ] [ORT]<br />
[LAND]</p>

<h2 class="wp-block-heading">Vertreten durch</h2>

<p>[NAME DES VERTRETUNGSBERECHTIGTEN / GESCHÄFTSFÜHRERS].</p>

<h2 class="wp-block-heading">Kontakt</h2>

<ul class="wp-block-list">
<li>E-Mail: <strong>${email}</strong></li>
<li>Telefon: <strong>[TELEFON]</strong></li>
</ul>

<h2 class="wp-block-heading">Registereintrag</h2>

<p>Eingetragen im französischen Handelsregister (R.C.S.) von [STADT]<br />
Registernummer (SIREN/SIRET): <strong>[REGISTERNUMMER]</strong><br />
Stammkapital: <strong>[BETRAG] €</strong></p>

<h2 class="wp-block-heading">Umsatzsteuer-Identifikationsnummer</h2>

<p>Innergemeinschaftliche USt-IdNr.: <strong>[USt-IdNr.]</strong> <em>[oder Hinweis, dass keine USt. ausgewiesen wird - franz. Kleinunternehmerregelung, Art. 293 B CGI.]</em></p>

<h2 class="wp-block-heading">Verantwortlich für den Inhalt</h2>

<p>[NAME UND ANSCHRIFT DER VERANTWORTLICHEN PERSON].</p>

<h2 class="wp-block-heading">Hosting</h2>

<p>Diese Website wird gehostet von <strong>[HOSTING-ANBIETER + ANSCHRIFT]</strong>. Kontakt: [KONTAKT DES ANBIETERS].</p>

<h2 class="wp-block-heading">Urheberrecht</h2>

<p>Sofern nicht anders angegeben, sind alle Inhalte dieser Website (Texte, Bilder, Logos, Seitenstruktur) Eigentum von [FIRMENNAME] oder werden mit Erlaubnis verwendet. Eine Vervielfältigung ohne vorherige schriftliche Zustimmung ist untersagt.</p>

<h2 class="wp-block-heading">Verbraucherschlichtung</h2>

<p>Als französisches Unternehmen sind wir einer französischen Verbraucherschlichtungsstelle (« médiateur de la consommation ») angeschlossen, die du <strong>kostenlos</strong> anrufen kannst, wenn deine schriftliche Beschwerde bei uns nicht zufriedenstellend gelöst wurde:</p>

<p><strong>[NAME DER SCHLICHTUNGSSTELLE]</strong><br />
Anschrift: <strong>[ANSCHRIFT]</strong><br />
