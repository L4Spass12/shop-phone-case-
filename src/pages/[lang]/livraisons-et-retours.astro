---
/**
 * Livraisons et retours EN / DE : traduction FIDÈLE de la version française
 * (src/pages/livraisons-et-retours.astro), qui fait foi. Toute modification
 * de la version française doit être reportée ici.
 */
import LegalPage from '../../components/LegalPage.astro';
import siteConfig from '../../../site.config.mjs';
import { ACTIVE_LOCALES } from '../../lib/i18n';

export async function getStaticPaths() {
  return ACTIVE_LOCALES
    .filter(l => l !== siteConfig.i18n.defaultLocale)
    .map(lang => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: 'en' | 'de' };
const shop = siteConfig.name;
const email = siteConfig.forms?.contactEmail ?? '';
// Adresse des retours : l'atelier d'expédition (Roubaix), distinct du siège
// déclaré de l'entreprise (Beaucourt-sur-l'Hallue) qui figure sur les pages légales.
const addr = '123 rue d&rsquo;Isly, 59100 Roubaix, France';

const content = {
  en: {
    heading: 'Shipping and Returns',
    description: `Every order placed on ${shop} is handled with care. We ship your parcel within 24 to 48 business hours of receiving payment.`,
    html: `
<h2 class="wp-block-heading">1. Shipping</h2>

<p>Every order placed on <strong>${shop}</strong> is prepared with care at our workshop in <strong>Roubaix (Nord, France)</strong>. We ship your parcel within <strong>24 to 48 business hours</strong> of receiving payment. <em>(Orders placed on Friday evening or at the weekend are shipped the following Monday.)</em></p>

<p><strong>Delivery options &amp; rates</strong> Outside France, delivery times run from shipping, in business days.</p>

<ul class="wp-block-list">
<li><strong>Mainland France</strong>: <strong>€5.90</strong>, home delivery by La Poste tracked letter (<strong>coming soon</strong>), <strong>3 to 5 business days after your order</strong> (preparation included).</li>
<li><strong>Mondial Relay pickup point</strong>: France <strong>€3.90</strong> (4 to 7 business days); Belgium and Luxembourg <strong>€4.50</strong> (5 to 8 business days); Netherlands <strong>€5.90</strong>, Germany, Spain, Portugal <strong>€6.90</strong>, Italy <strong>€7.90</strong> (5 to 9 business days). Times count from your order, preparation included. You choose your pickup point (shop or 24/7 locker) when ordering, and you are notified as soon as your parcel arrives.</li>
<li><strong>European Union</strong> (Austria, Belgium, Denmark, Finland, Germany, Ireland, Italy, Luxembourg, Netherlands, Poland, Portugal, Spain, Sweden): <strong>€8.90</strong>, in <strong>4 to 7 days</strong>.</li>
<li><strong>United Kingdom, Switzerland, Norway</strong>: <strong>€14.90</strong>, in <strong>5 to 10 days</strong>.</li>
<li><strong>United States, Canada</strong>: <strong>€16.90</strong>, in <strong>7 to 14 days</strong>.</li>
</ul>

<p><strong>Customs duties outside the European Union</strong> For the United Kingdom, Switzerland, Norway, the United States and Canada, customs duties and import taxes may be charged on delivery. They are set by the destination country, are not included in the displayed price and are <strong>payable by the recipient</strong>. Refusing to pay these charges results in the parcel being returned, and the shipping costs are not refunded.</p>

<p>Once your order has shipped, you will automatically receive a <strong>tracking number</strong> by email so you can follow your parcel in real time.</p>

<h2 class="wp-block-heading">2. Returns and exchanges</h2>

<p><strong>Satisfied or your money back</strong> Changed your mind? In accordance with the law, you have <strong>14 days</strong> after receiving your order to withdraw.</p>

<p>The simplest way: use our <a href="/${lang}/retractation"><strong>online withdrawal form</strong></a>, free and available at all times. You can also write to us by email or by post.</p>

<p><strong>How to return an item</strong></p>

<ol start="1" class="wp-block-list">
<li>Send us a short email at <strong>${email}</strong> with your order number to let us know.</li>
<li>Pack the product carefully (it must be new, in its original packaging and unused).</li>
<li>Send the parcel to the following address: <strong>Quentin Amat (${shop})</strong>, <strong>${addr}</strong></li>
</ol>

<p><strong>Return costs</strong></p>

<ul class="wp-block-list">
<li>If the product is faulty or we made a mistake: <strong>we cover the return costs</strong> (we will send you a prepaid label).</li>
<li>If you simply changed your mind: return costs are <strong>your responsibility</strong>.</li>
</ul>

<p><strong>Refund</strong> Once the parcel has been received and checked at our premises, we issue a full refund (product price + original shipping costs) within <strong>7 days at most</strong> to the payment method used for the purchase.</p>

<p><em>Still disagree? You can refer the matter free of charge to our consumer mediator, whose details are given in our <a href="/${lang}/conditions-generales-de-vente-cgv">terms and conditions of sale</a> and our <a href="/${lang}/mentions-legales">legal notice</a>.</em></p>

<h2 class="wp-block-heading">3. A problem with delivery?</h2>

<p>If your parcel arrives damaged or opened, please <strong>take photos immediately</strong> and contact us by email at <strong>${email}</strong>. We will find a solution straight away (a new product sent out or a refund).</p>
`,
  },
  de: {
    heading: 'Versand und Rückgabe',
    description: `Jede Bestellung bei ${shop} wird sorgfältig bearbeitet. Wir versenden dein Paket innerhalb von 24 bis 48 Werkstunden nach Zahlungseingang.`,
    html: `
<h2 class="wp-block-heading">1. Versand</h2>

<p>Jede Bestellung bei <strong>${shop}</strong> wird sorgfältig in unserer Werkstatt in <strong>Roubaix (Nord, Frankreich)</strong> vorbereitet. Wir versenden dein Paket innerhalb von <strong>24 bis 48 Werkstunden</strong> nach Zahlungseingang. <em>(Bestellungen von Freitagabend oder vom Wochenende werden am folgenden Montag verschickt.)</em></p>

<p><strong>Versandarten &amp; Preise</strong> Außerhalb Frankreichs gelten die Lieferzeiten ab Versand, in Werktagen.</p>

<ul class="wp-block-list">
<li><strong>Frankreich (Festland)</strong>: <strong>5,90 €</strong>, Zustellung nach Hause per verfolgtem Brief von La Poste (<strong>bald verfügbar</strong>), <strong>3 bis 5 Werktage nach deiner Bestellung</strong> (Vorbereitung inklusive).</li>
<li><strong>Mondial Relay Abholstelle</strong>: Frankreich <strong>3,90 €</strong> (4 bis 7 Werktage); Belgien und Luxemburg <strong>4,50 €</strong> (5 bis 8 Werktage); Niederlande <strong>5,90 €</strong>, Deutschland, Spanien, Portugal <strong>6,90 €</strong>, Italien <strong>7,90 €</strong> (5 bis 9 Werktage). Ab deiner Bestellung gerechnet, Vorbereitung inklusive. Du wählst deine Abholstelle (Geschäft oder 24/7-Packstation) bei der Bestellung und wirst benachrichtigt, sobald dein Paket angekommen ist.</li>
<li><strong>Europäische Union</strong> (Belgien, Dänemark, Deutschland, Finnland, Irland, Italien, Luxemburg, Niederlande, Österreich, Polen, Portugal, Schweden, Spanien): <strong>8,90 €</strong>, in <strong>4 bis 7 Tagen</strong>.</li>
<li><strong>Vereinigtes Königreich, Schweiz, Norwegen</strong>: <strong>14,90 €</strong>, in <strong>5 bis 10 Tagen</strong>.</li>
<li><strong>USA, Kanada</strong>: <strong>16,90 €</strong>, in <strong>7 bis 14 Tagen</strong>.</li>
</ul>

<p><strong>Zölle außerhalb der Europäischen Union</strong> Für das Vereinigte Königreich, die Schweiz, Norwegen, die USA und Kanada können bei der Zustellung Zölle und Einfuhrabgaben anfallen. Sie werden vom Zielland festgelegt, sind nicht im angezeigten Preis enthalten und <strong>vom Empfänger zu tragen</strong>. Wird die Zahlung verweigert, geht das Paket zurück, und die Versandkosten werden nicht erstattet.</p>

<p>Sobald deine Bestellung verschickt ist, erhältst du automatisch eine <strong>Sendungsnummer</strong> per E-Mail, um dein Paket in Echtzeit zu verfolgen.</p>

<h2 class="wp-block-heading">2. Rückgabe und Umtausch</h2>

<p><strong>Zufrieden oder Geld zurück</strong> Du hast es dir anders überlegt? Gemäß dem Gesetz hast du nach Erhalt deiner Bestellung <strong>14 Tage</strong> Zeit, den Kauf zu widerrufen.</p>

<p>Am einfachsten: Nutze unser <a href="/${lang}/retractation"><strong>Online-Widerrufsformular</strong></a>, kostenlos und jederzeit verfügbar. Du kannst uns auch per E-Mail oder Post schreiben.</p>

<p><strong>So funktioniert die Rücksendung</strong></p>

<ol start="1" class="wp-block-list">
<li>Schicke uns eine kurze E-Mail an <strong>${email}</strong> mit deiner Bestellnummer.</li>
<li>Verpacke das Produkt sorgfältig (es muss neu, in der Originalverpackung und unbenutzt sein).</li>
<li>Schicke das Paket an folgende Adresse: <strong>Quentin Amat (${shop})</strong>, <strong>${addr}</strong></li>
</ol>

<p><strong>Rücksendekosten</strong></p>

<ul class="wp-block-list">
<li>Wenn das Produkt defekt ist oder uns ein Fehler unterlaufen ist: <strong>Wir übernehmen die Rücksendekosten</strong> (wir schicken dir ein frankiertes Etikett).</li>
<li>Wenn du es dir einfach anders überlegt hast: Die Rücksendekosten <strong>trägst du</strong>.</li>
</ul>

<p><strong>Erstattung</strong> Sobald das Paket bei uns eingegangen und geprüft ist, erstatten wir den vollen Betrag (Produktpreis + Hinversandkosten) innerhalb von <strong>höchstens 7 Tagen</strong> über das beim Kauf verwendete Zahlungsmittel.</p>

<p><em>Besteht weiterhin Uneinigkeit? Du kannst dich kostenlos an unsere Verbraucherschlichtungsstelle wenden, deren Kontaktdaten in unseren <a href="/${lang}/conditions-generales-de-vente-cgv">Allgemeinen Geschäftsbedingungen</a> und unserem <a href="/${lang}/mentions-legales">Impressum</a> stehen.</em></p>

<h2 class="wp-block-heading">3. Ein Problem bei der Lieferung?</h2>

<p>Wenn dein Paket beschädigt oder geöffnet ankommt, <strong>mach bitte sofort Fotos</strong> und kontaktiere uns per E-Mail an <strong>${email}</strong>. Wir finden umgehend eine Lösung (Versand eines neuen Produkts oder Erstattung).</p>
`,
  },
}[lang];
---

<LegalPage heading={content.heading} description={content.description} html={content.html} />
