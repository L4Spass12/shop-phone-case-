---
// Fiche produit EN / DE : même gabarit que la version française
// (src/components/ProductPage.astro). Les données viennent de la fiche FR,
// la traduction ne fournit que les textes. Une page n'existe que pour les
// produits traduits dans la langue.
import ProductPage from '../../../components/ProductPage.astro';
import { getCollection } from 'astro:content';
import siteConfig from '../../../../site.config.mjs';
import { parseEntrySlug, ACTIVE_LOCALES, type Locale } from '../../../lib/i18n';

export async function getStaticPaths() {
  const products = await getCollection('products');
  const nonDefault = ACTIVE_LOCALES.filter(l => l !== siteConfig.i18n.defaultLocale) as string[];
  const fr = new Map(
    products.filter(p => parseEntrySlug(p.slug).lang === 'fr').map(p => [p.slug, p])
  );
  return products
    .filter(p => nonDefault.includes(parseEntrySlug(p.slug).lang))
    .flatMap(translation => {
      const { lang, slug } = parseEntrySlug(translation.slug);
      const product = fr.get(slug);
      // Traduction sans fiche française : rien à afficher.
      if (!product) return [];
      return [{ params: { lang, slug }, props: { product, translation } }];
    });
}

const { lang } = Astro.params as { lang: Locale };
const { product, translation } = Astro.props;
---

<ProductPage product={product} lang={lang} translation={translation} />
