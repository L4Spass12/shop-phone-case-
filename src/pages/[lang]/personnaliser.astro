---
// Studio de personnalisation EN / DE. Page commune : src/components/StudioPage.astro.
import StudioPage from '../../components/StudioPage.astro';
import siteConfig from '../../../site.config.mjs';
import { ACTIVE_LOCALES, type Locale } from '../../lib/i18n';

export async function getStaticPaths() {
  return ACTIVE_LOCALES
    .filter(l => l !== siteConfig.i18n.defaultLocale)
    .map(lang => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };
---

<StudioPage lang={lang} />
