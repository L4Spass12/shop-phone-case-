---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import InstaGrid from '../components/InstaGrid.astro';
import siteConfig from '../../site.config.mjs';
import { getCollection } from 'astro:content';
import { inlineMd } from '../lib/inline-md';
import { parseEntrySlug } from '../lib/i18n';
import { unsplashSrcset } from '../lib/image';

// ─── Données ──────────────────────────────────────────────────────────────
const allProducts = await getCollection('products');
// Homepage FR : produits FR uniquement, hors internes/tests (catégorie vide).
const sortedProducts = allProducts
  .filter(p => parseEntrySlug(p.slug).lang === 'fr')
  .filter(p => (p.data.categories ?? []).length > 0)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// 8 produits "vedettes" : d'abord ceux marqués featured, puis les plus récents
const featuredProducts = [
  ...sortedProducts.filter(p => p.data.featured),
  ...sortedProducts.filter(p => !p.data.featured),
].slice(0, 8);

// Produits par catégorie (TOUS les produits, pas juste quelques-uns)
function byCategory(slug: string) {
  return sortedProducts.filter(p => (p.data.categories || []).includes(slug));
}

// Décor thématique par catégorie : glows colorés plus marqués
// Showcases par catégorie — pilotés par siteConfig.productCategories :
// chaque catégorie déclarée dans site.config.mjs qui a au moins un produit
// obtient sa rangée, avec une paire de glows attribuée cycliquement.
// Personnalise GLOW_PAIRS pour matcher ta palette de marque.
const GLOW_PAIRS = [
  ['rgba(120, 120, 140, 0.14)', 'rgba(160, 160, 180, 0.08)'],
  ['rgba(90, 130, 200, 0.14)',  'rgba(120, 160, 220, 0.08)'],
  ['rgba(130, 170, 130, 0.14)', 'rgba(160, 190, 160, 0.08)'],
  ['rgba(200, 160, 100, 0.14)', 'rgba(220, 190, 140, 0.08)'],
];
const categoryRows = (siteConfig.productCategories as { slug: string; label: string }[])
  .map((cat, i) => ({
    slug: cat.slug,
    label: cat.label,
    products: byCategory(cat.slug),
    glow1: GLOW_PAIRS[i % GLOW_PAIRS.length][0],
    glow2: GLOW_PAIRS[i % GLOW_PAIRS.length][1],
  }))
  .filter(row => row.products.length > 0);


// ⚠️ Ces réponses partent AUSSI dans les données structurées lues par Google
// (FAQPage plus bas) : un texte de gabarit oublié ici se retrouve dans les
// résultats de recherche.
const faqs = [
  { q: 'Sur quels téléphones vos coques existent-elles ?',
    a: "Le modèle se choisit sur la fiche produit et dans le studio : iPhone, Samsung Galaxy, Google Pixel et Xiaomi. Chaque coque est fabriquée pour le modèle sélectionné, vérifiez-le avant de valider votre commande." },
  { q: 'Comment sont fabriquées vos coques ?',
    a: "Nous partons de coques transparentes que nous imprimons nous-mêmes, à l'unité, en France. L'encre est déposée directement sur la coque, sans film ni autocollant intermédiaire." },
  { q: 'Quels sont les délais de livraison ?',
    a: "Les commandes sont préparées sous 24 à 48 heures ouvrées. La livraison prend ensuite généralement de 2 à 5 jours ouvrés selon votre adresse. Vous recevez un numéro de suivi dès l'expédition de votre commande." },
  { q: 'Puis-je retourner un article ?',
    a: "Oui, vous disposez de 14 jours après réception pour changer d'avis. Le produit doit être retourné dans son état d'origine. Consultez notre page dédiée pour connaître la marche à suivre." },
  { q: 'Une coque personnalisée est-elle reprise ?',
    a: "Une coque créée dans le studio est fabriquée d'après votre visuel, pour vous seul : elle ne peut pas être remise en vente et n'entre donc pas dans le droit de rétractation. Relisez bien votre aperçu avant de valider. Un défaut de fabrication reste évidemment pris en charge." },
];

// ─── Helpers ──────────────────────────────────────────────────────────────
const formatPrice = (n: number) => new Intl.NumberFormat('fr-FR', {
  style: 'currency', currency: siteConfig.shop.currency,
}).format(n);

const displayPrice = (d: any) =>
  d.priceRange && d.priceRange.min !== d.priceRange.max
    ? `Dès ${formatPrice(d.priceRange.min)}`
    : formatPrice(d.price);

// ─── Schemas JSON-LD ──────────────────────────────────────────────────────
const SITE_URL = siteConfig.url;

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteConfig.name,
  description: siteConfig.description,
  url: SITE_URL,
  inLanguage: 'fr-FR',
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(f => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<BaseLayout
  title={`${siteConfig.name} | Votre boutique en ligne`}
  description="Découvrez notre collection de produits de qualité : sélection soignée, livraison rapide et service client attentif."
  jsonLd={[websiteSchema, faqSchema]}
  preloadImages={[
    { href: '/images/hero-vareska.webp?v=2',
      imagesrcset: '/images/hero-vareska-800w.webp?v=2 800w, /images/hero-vareska-1280w.webp?v=2 1280w, /images/hero-vareska.webp?v=2 1696w',
      imagesizes: '100vw' },
  ]}
>
  <!-- ═══════════════════════════ HERO ═══════════════════════════ -->
  <!-- Structure simplifiée pour LCP détectable :
       - L'image hero est un <img> direct de la section (pas de wrapper z-indexé)
       - Le voile sombre est appliqué via `::after` en CSS pur (pas de div overlay) -->
  <section class="hero-section relative overflow-hidden min-h-[70vh] md:min-h-[75vh] flex items-center">
    <!-- Un seul <img> avec srcset (plus simple, LCP-friendly) -->
    <img
      src="/images/hero-vareska.webp?v=2"
      srcset="/images/hero-vareska-800w.webp?v=2 800w, /images/hero-vareska-1280w.webp?v=2 1280w, /images/hero-vareska.webp?v=2 1696w"
      {/* 126vw sur desktop et non 100vw : la bannière y est agrandie de 26 %
          (cf. global.css). Sans ça le navigateur choisissait une source calée
          sur la largeur de l'écran, puis l'agrandissait — image molle. */}
      sizes="(min-width: 768px) 126vw, 100vw"
      alt="Coques Vareska personnalisables présentées en studio"
      class="hero-img hero-bg"
      fetchpriority="high"
      loading="eager"
      decoding="async"
      width="1696"
      height="960"
    />
    {/* Bannière du thème « heritage » : vitrine de musée. Masquée par défaut,
        affichée uniquement quand data-theme=heritage (cf. global.css). */}
    <img
      src="/images/hero-heritage.webp?v=2"
      srcset="/images/hero-heritage-800w.webp?v=2 800w, /images/hero-heritage-1280w.webp?v=2 1280w, /images/hero-heritage.webp?v=2 1692w"
      sizes="100vw"
      alt="Coques Vareska exposées comme des œuvres dans une vitrine de musée"
      class="hero-img hero-bg-heritage"
      {/* `eager` et non `lazy` : cette image EST la bannière en heritage, elle
          est dans le viewport au chargement. En lazy, le hero restait un
          rectangle gris le temps du chargement — soit précisément le moment où
          le visiteur regarde. Pas de fetchpriority : la priorité haute reste
          au preload du thème Défaut, qu'on ne veut pas dégrader. */}
      loading="eager"
      decoding="async"
      width="1692"
      height="929"
    />

    <div class="relative max-w-7xl mx-auto px-6 py-14 md:py-16 w-full">
      {/* Colonne de texte volontairement ÉTROITE. Le sujet de la bannière est
          la vitrine, au centre du cadre : au-delà de ~30rem le titre passait
          par-dessus les coques et les deux se neutralisaient. */}
      <div class="hero-copy max-w-[30rem]">
        {/* La pastille porte une PREUVE, pas une étiquette de saison :
            « Collection 2026 » ne disait rien et vieillira mal, alors que
            l'impression en France est l'argument que la concurrence à bas prix
            ne peut pas copier. */}
        <span class="tag tag-status mb-5">Imprimées en France</span>

        {/* Le titre porte la PROMESSE, le sous-titre porte l'OFFRE. Le titre
            ne parle volontairement pas de personnalisation : elle a sa propre
            section plus bas, la répéter ici affaiblirait les deux. Le mot-clé
            « coques de téléphone » reste en tête de titre.
            Le sous-titre, lui, annonce les DEUX façons d'acheter, ce qui
            explique les deux boutons juste en dessous. « Motifs dessinés » a
            sauté : rien ne garantit que les motifs sont dessinés en interne, et
            une promesse invérifiable en page d'accueil est un risque inutile. */}
        <h1 class="text-[1.7rem] sm:text-3xl lg:text-[2.1rem] font-medium tracking-tight text-cream mb-3 leading-[1.15]">
          Des coques de téléphone que l'on remarque
        </h1>

        <p class="text-sm md:text-base text-n-300 mb-7 font-light leading-relaxed">
          Choisissez un motif ou créez le vôtre. Imprimées à l'unité pour
          iPhone, Samsung, Pixel et Xiaomi.
        </p>

        {/* Deux CTA, deux destinations RÉELLEMENT différentes : acheter une
            coque existante, ou créer la sienne dans le studio. (Le second
            bouton avait été retiré quand les deux menaient à /boutique.) */}
        {/* Les deux boutons forment un groupe INSÉCABLE : ils restent côte à
            côte à toutes les largeurs (cf. .hero-cta dans global.css). */}
        <div class="hero-cta flex items-center gap-3 sm:gap-4">
          <a href="/boutique" class="btn-primary inline-flex items-center gap-2">
            Voir la collection
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
          </a>
          <a href="/personnaliser" class="btn-outline">Créer ma coque</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════ PRODUITS EN VEDETTES ═══════════════════════════ -->
  {featuredProducts.length > 0 && (
    <section class="relative py-20 md:py-24 px-6 border-t border-white/[0.04] overflow-hidden">
      <!-- Accent décoratif subtil -->
      <div class="absolute top-0 right-0 w-[600px] h-[300px] bg-white/[0.025] blur-[120px] rounded-[100%] pointer-events-none"></div>
      <div class="relative max-w-7xl mx-auto">
        <div class="flex items-end justify-between mb-10 gap-6">
          <div>
            <span class="text-[10px] text-n-500 font-medium uppercase tracking-widest mb-2 block">Sélection</span>
            <h2 class="text-2xl md:text-3xl font-medium tracking-tight text-cream">Produits en vedette</h2>
          </div>
          <a href="/boutique" class="hidden md:inline-flex items-center gap-1 text-sm text-n-400 hover:text-cream transition-colors whitespace-nowrap">
            Voir tout
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
          </a>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 md:gap-6">
          {featuredProducts.map(product => (
            <a href={`/product/${product.slug}`} class="group block">
              <div class="relative aspect-[4/5] rounded-2xl overflow-hidden bg-panel border border-white/[0.05] mb-3">
                <img
                  src={product.data.image}
                  srcset={unsplashSrcset(product.data.image)}
                  sizes="(max-width: 768px) 50vw, (max-width: 1024px) 33vw, 25vw"
                  alt={product.data.imageAlt ?? product.data.name}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  width="800" height="1000" loading="lazy" decoding="async"
                />
                {product.data.compareAtPrice && (
                  <span class="absolute top-3 left-3 bg-accent text-dark text-[10px] font-medium px-2 py-1 rounded-sm uppercase tracking-wider">
                    -{Math.round((1 - product.data.price / product.data.compareAtPrice) * 100)}%
                  </span>
                )}
              </div>
              <h3 class="text-sm font-medium text-cream tracking-tight leading-snug line-clamp-2 mb-1 group-hover:underline underline-offset-4">
                {product.data.name}
              </h3>
              <div class="flex items-baseline gap-2 text-xs">
                <span class="price-amount text-cream font-medium">{displayPrice(product.data)}</span>
                {product.data.compareAtPrice && (
                  <span class="text-n-500 line-through font-light">{formatPrice(product.data.compareAtPrice)}</span>
                )}
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ═══════════════════════════ PERSONNALISATION ═══════════════════════════ -->
  {/* Le texte est posé SUR l'image : celle-ci offre un grand plan de travail
      blanc et uni en bas à gauche, où le bloc s'installe sans rien masquer
      d'utile. Réduit au titre et au bouton — l'intertitre et le sous-titre
      faisaient doublon et ne tenaient pas la lisibilité à cette taille. */}
  <section class="studio-b relative overflow-hidden below-fold-defer flex items-end">
    <img
      src="/images/studio-banner-b.webp"
      srcset="/images/studio-banner-b-800w.webp 800w, /images/studio-banner-b-1280w.webp 1280w, /images/studio-banner-b.webp 1696w"
      sizes="100vw"
      alt="Une table de travail où l'on choisit ses visuels : la coque vierge d'un côté, les coques imprimées alignées de l'autre"
      width="1696"
      height="960"
      loading="lazy"
      decoding="async"
      class="studio-b-bg"
    />
    <div class="studio-b-copy relative w-full max-w-7xl mx-auto px-6 pt-8 pb-3 md:pt-10 md:pb-6">
      <h2 class="text-2xl md:text-3xl lg:text-4xl font-medium tracking-tight mb-5 leading-[1.15]">
        Personnalisez votre coque
      </h2>
      <a href="/personnaliser" class="btn-primary inline-flex items-center gap-2">
        Créer ma coque
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
      </a>
    </div>
  </section>

  <!-- ═══════════════════════════ CATÉGORIES PRODUITS (sliders) ═══════════════════════════ -->
  {/* Une rangée par catégorie. Tant qu'il n'y en a qu'UNE, elle réaffiche
      exactement les produits déjà montrés en vedette : on ne l'affiche donc
      qu'à partir de deux catégories. Le jour où le catalogue s'étoffe, les
      rangées reviennent seules. */}
  {categoryRows.length > 1 && categoryRows.map((row, idx) => {
    const bgClass = idx % 3 === 0 ? '' : idx % 3 === 1 ? 'bg-panel' : 'bg-teal';
    return (
    <section class={`relative py-16 md:py-20 border-t border-white/[0.04] overflow-hidden below-fold-defer ${bgClass}`}>
      <!-- Glows thématiques (desktop : larges et visibles / mobile : réduits via CSS) -->
      <div class="slider-glow slider-glow-1" style={`background: ${row.glow1}`}></div>
      <div class="slider-glow slider-glow-2" style={`background: ${row.glow2}`}></div>

      <div class="relative max-w-7xl mx-auto px-6">
        <div class="flex items-end justify-between mb-6 md:mb-8 gap-4">
          <div>
            <span class="text-[10px] text-n-500 font-medium uppercase tracking-widest mb-2 block">Collection</span>
            <h2 class="text-xl md:text-2xl font-medium tracking-tight text-cream">{row.label}</h2>
          </div>
          <a href={`/product-category/${row.slug}`} class="inline-flex items-center gap-1.5 text-xs md:text-sm text-n-400 hover:text-cream transition-colors whitespace-nowrap">
            Voir tout ({row.products.length})
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
          </a>
        </div>
      </div>

      <!-- Slider full-width : track s'étend jusqu'au bord de l'écran, cards coupées à l'edge -->
      <div class="product-slider relative" data-slider>
        <div class="slider-track flex gap-3 md:gap-4 lg:gap-5 overflow-x-auto snap-x snap-mandatory scroll-smooth pb-2 pl-6 md:pl-[max(1.5rem,calc((100vw-80rem)/2+1.5rem))] pr-6">
          {row.products.map(p => (
            <a
              href={`/product/${p.slug}`}
              class="slider-card group flex-none w-[72vw] sm:w-[45vw] md:w-[30vw] lg:w-[22vw] xl:w-[310px] snap-start block"
            >
              <div class="relative aspect-[4/5] rounded-2xl overflow-hidden bg-panel border border-white/[0.05] mb-3">
                <img
                  src={p.data.image}
                  srcset={unsplashSrcset(p.data.image)}
                  sizes="(max-width: 640px) 72vw, (max-width: 768px) 45vw, (max-width: 1024px) 32vw, 300px"
                  alt={p.data.imageAlt ?? p.data.name}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  width="800" height="1000" loading="lazy" decoding="async"
                />
                {p.data.compareAtPrice && (
                  <span class="absolute top-3 left-3 bg-accent text-dark text-[10px] font-medium px-2 py-1 rounded-sm uppercase tracking-wider">
                    -{Math.round((1 - p.data.price / p.data.compareAtPrice) * 100)}%
                  </span>
                )}
              </div>
              <h3 class="text-sm font-medium text-cream tracking-tight leading-snug line-clamp-2 mb-1 group-hover:underline underline-offset-4">
                {p.data.name}
              </h3>
              <div class="flex items-baseline gap-2 text-xs">
                <span class="price-amount text-cream font-medium">{displayPrice(p.data)}</span>
                {p.data.compareAtPrice && (
                  <span class="text-n-500 line-through font-light">{formatPrice(p.data.compareAtPrice)}</span>
                )}
              </div>
            </a>
          ))}
          <!-- Spacer final pour que la dernière card respire -->
          <div class="flex-none w-2" aria-hidden="true"></div>
        </div>

        <!-- Boutons flèches (desktop) : wrapper limité à max-w-7xl pour qu'ils s'alignent au contenu -->
        <div class="pointer-events-none absolute inset-0 max-w-7xl mx-auto hidden md:block px-6">
          <button
            type="button"
            data-scroll="prev"
            class="pointer-events-auto absolute left-2 top-[38%] -translate-y-1/2 w-10 h-10 rounded-full bg-dark/90 border border-white/[0.15] backdrop-blur flex items-center justify-center text-cream hover:bg-dark hover:border-white/30 disabled:opacity-0 disabled:pointer-events-none transition-all shadow-lg"
            aria-label="Produits précédents"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="15 18 9 12 15 6"/></svg>
          </button>
          <button
            type="button"
            data-scroll="next"
            class="pointer-events-auto absolute right-2 top-[38%] -translate-y-1/2 w-10 h-10 rounded-full bg-dark/90 border border-white/[0.15] backdrop-blur flex items-center justify-center text-cream hover:bg-dark hover:border-white/30 disabled:opacity-0 disabled:pointer-events-none transition-all shadow-lg"
            aria-label="Produits suivants"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="9 18 15 12 9 6"/></svg>
          </button>
        </div>

        <!-- Indicateur mobile : petit texte "← swipe →" sous la 1ère section -->
        {idx === 0 && (
          <div class="md:hidden px-6 mt-2 text-center">
            <span class="inline-flex items-center gap-2 text-[10px] text-n-500 font-light uppercase tracking-widest">
              <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
              Glissez pour explorer
              <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
            </span>
          </div>
        )}
      </div>
    </section>
    );
  })}

  <style>
    /* ─── HERO : structure plate pour LCP détectable ───────────────────
       L'image est un <img> direct de la section.
       Le voile sombre est un ::after en CSS (pas un div overlay dans le DOM
       → Lighthouse voit l'image comme non couverte). */
    .hero-section { isolation: isolate; }
    /* Image hero : absolute fill de la section, z-index 0 */
    .hero-img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      z-index: 0;
    }

    /* ─── content-visibility: auto pour sections below-fold ───────
       Skip layout/paint des sections hors viewport au load → LCP
       committé plus rapidement par Lighthouse. contain-intrinsic-size
       réserve l'espace pour éviter les sauts de scroll. */
    .below-fold-defer {
      content-visibility: auto;
      contain-intrinsic-size: auto 800px;
    }
    /* Fondu de lisibilité, en ::after : z-index 1 pour passer SOUS le texte.
       Il ne couvre plus toute la bannière — l'ancien voile blanc à 92 % avait
       été conçu pour une image neutre et délavait la photo. Il s'arrête à
       mi-largeur : le texte reste lisible à gauche, le sujet (mannequin et
       coques) reste intact à droite. */
    .hero-section::after {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(to right,
        rgba(255,255,255,0.88) 0%,
        rgba(255,255,255,0.62) 26%,
        rgba(255,255,255,0) 52%);
      pointer-events: none;
      z-index: 1;
    }
    /* Contenu (tag + h1 + boutons) : z-index 2, AU-DESSUS du voile */
    .hero-section > .relative {
      z-index: 2;
    }

    /* Scrollbar masquée mais scroll/swipe actif */
    .product-slider .slider-track {
      scrollbar-width: none;
      -ms-overflow-style: none;
    }
    .product-slider .slider-track::-webkit-scrollbar {
      display: none;
    }

    /* ─── Glows thématiques par catégorie ─────────────────────────────
       Desktop : larges halos bien visibles
       Mobile : réduits en taille + intensité (positions ajustées pour rester
       en arrière-plan sans saturer l'écran étroit) */
    .slider-glow {
      position: absolute;
      border-radius: 100%;
      pointer-events: none;
      filter: blur(120px);
    }
    .slider-glow-1 {
      top: -5rem;
      left: -5rem;
      width: 700px;
      height: 500px;
    }
    .slider-glow-2 {
      bottom: -5rem;
      right: -5rem;
      width: 600px;
      height: 400px;
      filter: blur(110px);
    }
    @media (max-width: 767px) {
      .slider-glow-1 {
        width: 340px;
        height: 220px;
        top: -4rem;
        left: -6rem;
        opacity: 0.55;
        filter: blur(80px);
      }
      .slider-glow-2 {
        width: 300px;
        height: 200px;
        bottom: -4rem;
        right: -6rem;
        opacity: 0.55;
        filter: blur(80px);
      }
    }
  </style>

  <script is:inline>
    // Contrôle des boutons flèches des sliders produits (desktop).
    // Différé via requestIdleCallback pour libérer le main thread au load
    // (laisse Lighthouse committer le LCP avant parse/exec de ce JS).
    (function() {
      function initSliders() {
        document.querySelectorAll('[data-slider]').forEach(slider => {
          const track = slider.querySelector('.slider-track');
          const prev = slider.querySelector('[data-scroll="prev"]');
          const next = slider.querySelector('[data-scroll="next"]');
          if (!track) return;

          function scrollBy(dir) {
            const card = track.querySelector('.slider-card');
            if (!card) return;
            const cardWidth = card.getBoundingClientRect().width + 20;
            track.scrollBy({ left: cardWidth * 2 * dir, behavior: 'smooth' });
          }
          prev?.addEventListener('click', () => scrollBy(-1));
          next?.addEventListener('click', () => scrollBy(1));

          function update() {
            if (!prev || !next) return;
            prev.disabled = track.scrollLeft <= 1;
            next.disabled = track.scrollLeft >= track.scrollWidth - track.clientWidth - 1;
          }
          track.addEventListener('scroll', update, { passive: true });
          window.addEventListener('resize', update);
          requestAnimationFrame(update);
        });
      }
      if ('requestIdleCallback' in window) {
        requestIdleCallback(initSliders, { timeout: 2000 });
      } else {
        setTimeout(initSliders, 0);
      }
    })();
  </script>

  <!-- ═══════════════════════════ INSTAGRAM ═══════════════════════════ -->
