---
/**
 * Atelier d'essai des polices de TITRAGE.
 *
 * Page de travail, jamais liée depuis le site et exclue de l'index : elle
 * n'existe que pour choisir. Chaque candidate est montrée sur les éléments
 * qu'elle habillerait vraiment (titre de section, nom de produit, prix,
 * bouton), puis un lien permet d'aller la voir sur les vraies pages.
 *
 * Elle charge les neuf polices : c'est le seul endroit du site où c'est le
 * cas, et c'est assumé, on vient ici pour comparer.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import siteConfig from '../../site.config.mjs';
import { CANDIDATES, faceCss, candidate } from '../lib/typo-titres';

const choisie = candidate(siteConfig.titreFont ?? undefined);
const toutesLesFaces = CANDIDATES.map(faceCss).join('');
// Les pages sur lesquelles l'essai vaut vraiment le coup d'œil.
const parcours = [
  { url: '/', quoi: "la page d'accueil" },
  { url: '/boutique/', quoi: 'la boutique' },
  { url: '/product/produit-exemple/', quoi: 'une fiche produit' },
];
---

<BaseLayout title="Essai de polices | Vareska" noindex={true}>
  <div class="typo-page">
    <header class="typo-intro">
      <p class="typo-sur">Atelier</p>
      <h1>Essayer une police de titres</h1>
      <p class="typo-texte">
        Cette police habille les titres, mais aussi les libellés des boutons,
        les prix et le pied de page. Ci-dessous, chaque candidate sur ces
        quatre éléments.
      </p>
      <p class="typo-texte">
        {choisie
          ? `Police retenue pour l'instant : ${choisie.famille}.`
          : "Aucune police n'est chargée aujourd'hui : les titres s'affichent en Georgia, la police de secours du système. Ce n'est pas un choix, c'est l'absence de choix."}
      </p>
      <p class="typo-texte typo-aide">
        Pour voir une candidate sur le vrai site, suivez un des liens de sa
        fiche. Elle vous suit de page en page jusqu'à la fermeture de
        l'onglet. <a href="/?typo=off">Revenir à l'état normal</a>.
      </p>
    </header>

    {CANDIDATES.map((c) => (
      <section class="typo-carte" style={`--essai:'${c.famille}'`}>
        <div class="typo-entete">
          <h2 class="typo-nom">{c.famille}</h2>
          <p class="typo-meta">
            {c.ko} Ko · {c.italique ? 'italique fournie' : 'pas d’italique, le navigateur l’imiterait'}
          </p>
          <p class="typo-note">{c.note}</p>
        </div>

        <div class="typo-demo">
          <p class="typo-etiquette">Titre de section</p>
          <p class="typo-h2">Produits en vedette</p>

          <p class="typo-etiquette">Nom de produit</p>
          <p class="typo-h1">Coque Vague</p>

          <p class="typo-etiquette">Prix et bouton</p>
          <p class="typo-ligne">
            <span class="typo-prix">24,90 €</span>
            <span class="typo-bouton">Ajouter au panier</span>
          </p>
        </div>

        <p class="typo-liens">
          Voir sur {parcours.map((p, i) => (
            <>
              <a href={`${p.url}?typo=${c.id}`}>{p.quoi}</a>{i < parcours.length - 1 ? ', ' : '.'}
            </>
          ))}
        </p>
      </section>
    ))}
  </div>

  <style is:global set:html={toutesLesFaces}></style>

  <style>
    .typo-page { max-width: 62rem; margin: 0 auto; padding: 2.5rem 1.25rem 5rem; }
    .typo-intro { margin-bottom: 2.5rem; max-width: 42rem; }
    .typo-sur {
      font-size: .7rem; letter-spacing: .3em; text-transform: uppercase;
      color: rgb(var(--c-n500)); margin: 0 0 .6rem;
    }
    .typo-intro h1 { font-size: 1.9rem; margin: 0 0 .9rem; }
    .typo-texte { color: rgb(var(--c-n400)); line-height: 1.6; margin: 0 0 .6rem; font-size: .95rem; }
    .typo-aide a { text-decoration: underline; }

    .typo-carte {
      border: 1px solid rgb(var(--c-beige));
      border-radius: 18px;
      padding: 1.5rem 1.5rem 1.25rem;
      margin-bottom: 1.1rem;
      background: rgb(var(--c-panel));
    }
    .typo-entete { margin-bottom: 1.2rem; }
    /* Le nom de la candidate est composé DANS la candidate : on la reconnaît
       avant même de lire les exemples. */
    .typo-nom { font-family: var(--essai), Georgia, serif; font-size: 1.5rem; margin: 0; }
    .typo-meta { font-size: .78rem; color: rgb(var(--c-n500)); margin: .2rem 0 .5rem; }
    .typo-note { font-size: .88rem; color: rgb(var(--c-n400)); margin: 0; line-height: 1.5; }

    .typo-demo {
      border-top: 1px solid rgb(var(--c-beige));
      padding-top: 1.1rem;
    }
    .typo-etiquette {
      font-size: .62rem; letter-spacing: .22em; text-transform: uppercase;
      color: rgb(var(--c-n500)); margin: 0 0 .25rem;
    }
    .typo-etiquette:not(:first-child) { margin-top: 1.1rem; }

    /* Les trois exemples reprennent les réglages réels du thème : mêmes
       graisses, mêmes tailles, même italique sur le bouton. Sinon on compare
       des spécimens, pas ce qu'on verra. */
    .typo-h2 { font-family: var(--essai), Georgia, serif; font-weight: 700; font-size: 1.75rem; letter-spacing: -.015em; margin: 0; }
    .typo-h1 { font-family: var(--essai), Georgia, serif; font-weight: 700; font-size: 2.4rem; letter-spacing: -.015em; margin: 0; line-height: 1.1; }
    .typo-ligne { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; margin: 0; }
    .typo-prix { font-family: var(--essai), Georgia, serif; font-weight: 400; font-size: 1.5rem; }
    .typo-bouton {
      font-family: var(--essai), Georgia, serif;
      font-style: italic; font-weight: 700; font-size: .95rem;
      background: var(--sun-yellow, #ffe14d); color: #2a1147;
      border: 1.5px solid rgb(var(--c-cream)); border-radius: 14px;
      padding: .6rem 1.2rem;
    }

    .typo-liens {
      margin: 1.2rem 0 0; font-size: .85rem; color: rgb(var(--c-n400));
      border-top: 1px solid rgb(var(--c-beige)); padding-top: .9rem;
    }
    .typo-liens a { text-decoration: underline; }
  </style>
</BaseLayout>
