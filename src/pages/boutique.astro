---
import CategoryChips from '../components/CategoryChips.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import InfiniteReveal from '../components/InfiniteReveal.astro';
import { getCollection } from 'astro:content';
import siteConfig from '../../site.config.mjs';
import { listPrice } from '../lib/printModes';
import { responsiveSrcset } from '../lib/responsive';
import { parseEntrySlug } from '../lib/i18n';

const allProducts = await getCollection('products');
// Boutique FR uniquement (locale par défaut). Filtres :
//  - même locale FR (pas de pollution cross-langue)
//  - au moins une catégorie (masque les produits internes/tests).
const products = allProducts
  .filter(p => parseEntrySlug(p.slug).lang === 'fr')
  .filter(p => (p.data.categories ?? []).length > 0)
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0) || b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Collect unique category slugs from all products (array field)
const categorySlugs = [...new Set(products.flatMap(p => p.data.categories || []))].sort();

const formatPrice = (n: number) => new Intl.NumberFormat('fr-FR', {
  style: 'currency', currency: siteConfig.shop.currency,
}).format(n);

// Toujours « À partir de » : le prix affiché est celui du rendu à plat, le
// relief coûte plus cher (même règle que l'accueil).
const displayPrice = (d: any) => `À partir de ${formatPrice(listPrice(d))}`;

// Libellé d'une catégorie : celui de site.config, sinon le slug rendu lisible.
const catLabel = (slug: string) =>
  siteConfig.productCategories?.find((c: { slug: string }) => c.slug === slug)?.label
  ?? slug.replace(/^boutique-/, '').replace(/-/g, ' ').replace(/^\w/, c => c.toUpperCase());

// Badge « Nouveau » : produit publié il y a moins de 60 jours. Remplace
// l'ancien « Bestseller », qui s'affichait sur des nouveautés sans ventes.
const isNew = (d: any) => d.pubDate && Date.now() - new Date(d.pubDate).getTime() < 60 * 864e5;


const SITE_URL = siteConfig.url;
const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `Boutique ${siteConfig.name}`,
  description: `Les produits sélectionnés par ${siteConfig.name}. Livraison suivie, retour sous 14 jours.`,
  url: `${SITE_URL}/boutique`,
  inLanguage: 'fr-FR',
  isPartOf: { '@type': 'WebSite', name: siteConfig.name, url: SITE_URL },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: SITE_URL },
    { '@type': 'ListItem', position: 2, name: 'Boutique', item: `${SITE_URL}/boutique` },
  ],
};
---

<BaseLayout
  title={`Boutique - ${siteConfig.name}`}
  description={`Coques iPhone imprimées à l'unité dans notre atelier en France. Livraison suivie, retour sous 14 jours.`}
  jsonLd={[collectionSchema, breadcrumbSchema]}
>
  <section class="max-w-7xl mx-auto px-6 pt-6 md:pt-8 pb-16 md:pb-24">
    <!-- Page header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-6">
      <div>
        <h1 class="text-3xl md:text-4xl font-medium tracking-tight text-cream mb-2 leading-[1.15]">La Collection</h1>
        <p class="text-sm text-n-500 font-light">{products.length} produit{products.length > 1 ? 's' : ''} sélectionné{products.length > 1 ? 's' : ''}.</p>
      </div>
      <div class="flex items-center gap-2 text-xs text-n-500 font-light">
        <Icon name="shield-check" size={14} strokeWidth={1.5} />
        <span>Livraison sécurisée</span>
        <span class="mx-2">·</span>
        <span>Retour sous 14 jours</span>
      </div>
    </div>

    {products.length === 0 ? (
      <div class="text-center py-20">
        <p class="text-sm text-n-500 font-light">Les premiers produits arrivent bientôt…</p>
      </div>
    ) : (
      <>
        <CategoryChips lang={'fr'} />

        <!-- Grille produits : cartes uniformes, responsive (2 col mobile → 4 desktop) -->
        <div id="products-grid" class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-x-4 gap-y-8 md:gap-x-6 md:gap-y-12">
          {products.map((product, i) => (
            <a
              href={`/product/${product.slug}`}
              class="product-card group block"
              data-categories={(product.data.categories || []).join(',')}
            >
              <div class="relative aspect-[4/5] rounded-2xl overflow-hidden bg-panel border border-white/[0.05] mb-3 md:mb-4">
                <img
                  src={product.data.image}
                  srcset={responsiveSrcset(product.data.image)}
                  sizes="(max-width: 768px) 50vw, (max-width: 1024px) 33vw, 300px"
                  alt={product.data.imageAlt ?? product.data.name}
                  class="w-full h-full object-cover group-hover:scale-105 transition-all duration-500"
                  width="800" height="1000"
                  loading={i < 4 ? 'eager' : 'lazy'}
                  fetchpriority={i === 0 ? 'high' : undefined}
                  decoding="async"
                />
                {isNew(product.data) ? (
                  <span class="absolute top-3 left-3 bg-accent text-dark text-[10px] font-medium px-2 py-1 rounded-sm uppercase tracking-wider">Nouveau</span>
                ) : product.data.compareAtPrice ? (
                  <span class="absolute top-3 left-3 bg-accent text-dark text-[10px] font-medium px-2 py-1 rounded-sm uppercase tracking-wider">Promo</span>
                ) : null}
              </div>
              <h2 class="text-sm md:text-base font-medium text-cream tracking-tight leading-snug line-clamp-1 group-hover:underline underline-offset-4">
                {product.data.name}
              </h2>
              <div class="mt-1 flex items-baseline gap-2">
                <span class="price-amount text-sm md:text-base text-cream font-medium">{displayPrice(product.data)}</span>
                {product.data.compareAtPrice && (
                  <span class="text-xs text-n-500 line-through font-light">{formatPrice(product.data.compareAtPrice)}</span>
                )}
              </div>
            </a>
          ))}
        </div>
        <InfiniteReveal targetId="products-grid" itemSelector=".product-card" initial={12} batch={12} />
      </>
    )}
  </section>
</BaseLayout>

