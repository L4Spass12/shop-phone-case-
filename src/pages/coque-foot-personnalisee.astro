---
// Page SEO « coque foot personnalisée » (/coque-foot-personnalisee/) : cible
// coque personnalisée foot, coque foot personnalisable, coque de téléphone
// personnalisée foot, coque maillot… et renvoie vers les modèles Maillot du
// studio (/personnaliser/?tpl=maillot-<id>).
//
// Les visuels sont les rendus réalistes du studio (scripts/foot-mockups.mjs :
// fond maillot + nom et numéro, sur une vraie coque iPhone 17 Pro Max).
// Aucun logo, écusson ni nom de club : uniquement des couleurs.
import BaseLayout from '../layouts/BaseLayout.astro';
import siteConfig from '../../site.config.mjs';
import { JERSEYS } from '../data/jerseys.mjs';
import { SAMPLES } from '../data/foot-samples.mjs';
import { PHONE_MODELS } from '../lib/models';

const money = (c: number) => new Intl.NumberFormat('fr-FR', { style: 'currency', currency: siteConfig.shop.currency }).format(c / 100);
const flat = money(siteConfig.shop?.customCasePriceCents ?? 1990);
const relief = money(siteConfig.shop?.customCaseReliefPriceCents ?? 2490);
const iphones = PHONE_MODELS.filter((m) => m.brand === 'apple').map((m) => m.label);
const galaxies = PHONE_MODELS.filter((m) => m.brand === 'samsung').map((m) => m.label);
const studio = (id: string) => `/personnaliser/?tpl=maillot-${id}`;

const NATIONS = ['france', 'espagne', 'portugal', 'italie', 'bresil', 'argentine', 'allemagne', 'angleterre', 'pays-bas', 'belgique', 'maroc', 'algerie'];
const nations = JERSEYS.filter((j) => NATIONS.includes(j.id));
const clubs = JERSEYS.filter((j) => !NATIONS.includes(j.id));
const sample = (id: string): [string, string] => (SAMPLES as Record<string, [string, string]>)[id] ?? ['TON NOM', '10'];
const hero = ['argentine', 'france', 'bresil'].map((id) => JERSEYS.find((j) => j.id === id)!);

const T = {
  title: 'Coque foot personnalisée avec ton nom et ton numéro',
  description: `Coque foot personnalisée façon maillot : les couleurs de ton pays ou de ton club, ton nom et ton numéro. iPhone et Samsung, dès ${flat}.`,
  h1: 'Coque foot personnalisée avec ton nom et ton numéro',
  intro: 'Le dos de ton maillot, sur ta coque de téléphone : choisis les couleurs de ton pays ou de ton équipe préférée, écris ton nom et ton numéro, et c’est prêt. Une coque foot personnalisable en quelques secondes, imprimée à l’unité dans notre atelier en France.',
  cta: 'Créer ma coque foot',
  price: `À partir de ${flat}, ${relief} en relief · iPhone et Samsung`,
};

const STEPS: [string, string][] = [
  ['Choisis ton maillot', 'France, Espagne, Brésil, Argentine… ou les couleurs de ton club : 23 maillots prêts à personnaliser.'],
  ['Ajoute ton nom et ton numéro', 'Touche le texte pour le remplacer. Change la couleur, la taille ou la police si tu veux, ou ajoute une photo.'],
  ['Reçois ta coque', 'Elle est imprimée à l’unité dans notre atelier en France, pour ton modèle exact de téléphone, puis expédiée sous 1 à 2 jours ouvrés.'],
];

const FAQ: [string, string][] = [
  ['Puis-je mettre le logo ou l’écusson de mon club ?', 'Non : les logos, écussons et noms des clubs et des fédérations sont des marques déposées, nous ne pouvons pas les imprimer. Nos maillots reprennent uniquement les couleurs, et c’est ton nom et ton numéro qui les rendent uniques.'],
  ['Quels noms et numéros puis-je mettre ?', 'Ce que tu veux : ton prénom, ton surnom, le nom d’un proche, ton numéro de joueur ou une date. Le texte reste modifiable jusqu’à la commande.'],
  ['C’est une bonne idée de cadeau ?', 'Oui : pour un joueur de club, un fan de l’équipe de France, un enfant qui fait du foot ou pour la fête des pères. Une coque foot personnalisée avec son nom fait un cadeau qu’il utilisera tous les jours.'],
  ['Quels téléphones sont compatibles ?', 'iPhone 11 à 18 Pro Max et Samsung Galaxy S24, S25, S26 (Ultra compris), A36 et A56 : la coque est fabriquée pour ton modèle exact.'],
  ['Combien de temps pour la recevoir ?', 'La coque est imprimée à la commande puis expédiée sous 1 à 2 jours ouvrés, puis livrée par La Poste en 3 jours ouvrés à domicile en France. En point relais, compte 4 à 7 jours ouvrés au total.'],
  ['Puis-je la retourner ?', 'Une coque personnalisée est fabriquée pour toi seul : comme le prévoit la loi, elle ne bénéficie pas du droit de rétractation. En cas de défaut d’impression, nous la refaisons.'],
];

const pageUrl = `${siteConfig.url}/coque-foot-personnalisee/`;
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: `${siteConfig.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Coque personnalisée', item: `${siteConfig.url}/coque-personnalisee/` },
    { '@type': 'ListItem', position: 3, name: T.h1, item: pageUrl },
  ] },
  { '@context': 'https://schema.org', '@type': 'HowTo', name: 'Créer sa coque foot personnalisée',
    step: STEPS.map(([name, text], i) => ({ '@type': 'HowToStep', position: i + 1, name, text })) },
  { '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: FAQ.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) },
];
const alt = (j: (typeof JERSEYS)[number]) => `Coque foot personnalisée ${j.name.fr} avec le nom ${sample(j.id)[0]} et le numéro ${sample(j.id)[1]}`;
---

<BaseLayout title={`${T.title} | ${siteConfig.name}`} description={T.description} jsonLd={jsonLd} image="/images/foot-studio-v2/france.webp">
  <div class="max-w-7xl mx-auto px-6 pt-6 md:pt-8 pb-16 md:pb-24">
    <nav class="site-breadcrumb flex items-center gap-2 text-xs text-n-500 mb-6 font-light" aria-label="breadcrumb">
      <a href="/" class="hover:text-cream transition-colors">Accueil</a>
      <span>/</span>
      <a href="/coque-personnalisee/" class="hover:text-cream transition-colors">Coque personnalisée</a>
      <span>/</span>
      <span class="text-n-400">Coque foot</span>
    </nav>

    <section class="grid md:grid-cols-2 gap-10 md:gap-12 items-center mb-20">
      <div>
        <h1 class="text-4xl md:text-5xl font-medium tracking-tight text-cream leading-[1.1] mb-5">{T.h1}</h1>
        <p class="text-base md:text-lg text-n-400 font-light leading-relaxed mb-7">{T.intro}</p>
        <a href={studio('france')} class="btn-primary inline-flex items-center gap-2">{T.cta} →</a>
        <p class="text-sm text-n-500 font-light mt-4">{T.price}</p>
      </div>
      <div class="hero-cases">
        {hero.map((j, i) => (
          <img class="jimg" data-i={i} src={`/images/foot-studio-v2/${j.id}-400w.webp`} srcset={`/images/foot-studio-v2/${j.id}-400w.webp 400w, /images/foot-studio-v2/${j.id}.webp 737w`}
            sizes="(min-width: 768px) 180px, 30vw" alt={alt(j)} width="737" height="1421" fetchpriority={i === 1 ? 'high' : undefined} decoding="async" />
        ))}
      </div>
    </section>

    <section class="mb-20">
      <h2 class="text-2xl md:text-3xl font-medium tracking-tight text-cream mb-8">Comment ça marche ?</h2>
      <ol class="grid md:grid-cols-3 gap-6">
        {STEPS.map(([name, text], i) => (
          <li class="rounded-2xl border border-white/[0.08] bg-panel p-6">
            <span class="text-xs font-medium text-n-500 tracking-widest">0{i + 1}</span>
            <h3 class="text-lg font-medium text-cream mt-2 mb-2">{name}</h3>
            <p class="text-sm text-n-400 font-light leading-relaxed">{text}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="mb-16">
      <h2 class="text-2xl md:text-3xl font-medium tracking-tight text-cream mb-3">Coques aux couleurs des pays</h2>
      <p class="text-base text-n-400 font-light mb-8 max-w-2xl">Supporte ta sélection : touche un maillot pour l’ouvrir dans le studio et y mettre ton nom et ton numéro.</p>
      <ul class="jgrid">
        {nations.map((j) => (
          <li>
            <a href={studio(j.id)} class="group block" aria-label={`Coque foot personnalisée ${j.name.fr}`}>
              <img class="jimg" src={`/images/foot-studio-v2/${j.id}-400w.webp`} alt={alt(j)} width="400" height="771" loading="lazy" decoding="async" />
              <span class="block mt-3 text-sm font-medium text-cream text-center">{j.name.fr}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="mb-20">
      <h2 class="text-2xl md:text-3xl font-medium tracking-tight text-cream mb-3">Coques aux couleurs de ton équipe</h2>
      <p class="text-base text-n-400 font-light mb-8 max-w-2xl">Rayé, uni, à bande : retrouve les couleurs des grands clubs, sans logo, pour une coque maillot qui te ressemble.</p>
      <ul class="jgrid">
        {clubs.map((j) => (
          <li>
            <a href={studio(j.id)} class="group block" aria-label={`Coque foot personnalisée ${j.name.fr}`}>
              <img class="jimg" src={`/images/foot-studio-v2/${j.id}-400w.webp`} alt={alt(j)} width="400" height="771" loading="lazy" decoding="async" />
              <span class="block mt-3 text-sm font-medium text-cream text-center">{j.name.fr}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="grid md:grid-cols-3 gap-6 mb-20">
      <div class="rounded-2xl border border-white/[0.08] bg-panel p-6">
        <h2 class="text-lg font-medium text-cream mb-2">À plat ou en relief</h2>
        <p class="text-sm text-n-400 font-light leading-relaxed">À plat ({flat}), surface lisse et couleurs franches. En relief ({relief}), l’encre est déposée en plusieurs couches : ton nom et ton numéro se sentent sous le doigt, comme un flocage.</p>
      </div>
      <div class="rounded-2xl border border-white/[0.08] bg-panel p-6">
        <h2 class="text-lg font-medium text-cream mb-2">Le cadeau des fans de foot</h2>
        <p class="text-sm text-n-400 font-light leading-relaxed">Anniversaire, Noël, fête des pères, fin de saison du club : une coque de téléphone personnalisée foot, avec son nom et son numéro, il ne la quittera plus.</p>
      </div>
      <div class="rounded-2xl border border-white/[0.08] bg-panel p-6">
        <h2 class="text-lg font-medium text-cream mb-2">Imprimée en France</h2>
        <p class="text-sm text-n-400 font-light leading-relaxed">Chaque coque est imprimée à l’unité dans notre atelier, directement sur une coque transparente : pas d’autocollant qui se décolle.</p>
      </div>
    </section>

    <section class="mb-20">
      <h2 class="text-2xl md:text-3xl font-medium tracking-tight text-cream mb-5">Modèles compatibles</h2>
      <p class="text-sm text-n-400 font-light leading-relaxed"><strong class="text-cream font-medium">iPhone :</strong> {iphones.join(', ')}</p>
      <p class="text-sm text-n-400 font-light leading-relaxed mt-2"><strong class="text-cream font-medium">Samsung :</strong> {galaxies.join(', ')}</p>
    </section>

    <section class="max-w-3xl mb-16">
      <h2 class="text-2xl md:text-3xl font-medium tracking-tight text-cream mb-6">Questions fréquentes</h2>
      <div class="space-y-3">
        {FAQ.map(([q, a]) => (
          <details class="rounded-2xl border border-white/[0.08] bg-panel px-6 py-4">
            <summary class="cursor-pointer font-medium text-cream">{q}</summary>
            <p class="mt-3 text-sm text-n-400 font-light leading-relaxed">{a}</p>
          </details>
        ))}
      </div>
    </section>

    <div class="text-center">
      <a href={studio('france')} class="btn-primary inline-flex items-center gap-2">{T.cta} →</a>
      <p class="text-sm text-n-500 font-light mt-4">Envie d’une photo plutôt ? <a href="/coque-personnalisee/" class="underline underline-offset-4">Coque personnalisée avec photo</a></p>
    </div>
  </div>
</BaseLayout>

<style>
  .jimg { display: block; width: 100%; height: auto; transition: transform .3s ease; }
  .group:hover .jimg { transform: translateY(-4px); }
  .jgrid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
  @media (min-width: 640px) { .jgrid { grid-template-columns: repeat(4, 1fr); } }
  @media (min-width: 1024px) { .jgrid { grid-template-columns: repeat(6, 1fr); } }
  .hero-cases { display: grid; grid-template-columns: repeat(3, 1fr); gap: .5rem; align-items: end; width: 100%; max-width: 560px; margin-inline: auto; padding: 1.5rem 0; }
  .hero-cases .jimg[data-i='0'] { transform: rotate(-6deg) translateY(12px); }
  .hero-cases .jimg[data-i='1'] { transform: translateY(-14px) scale(1.06); position: relative; z-index: 1; }
  .hero-cases .jimg[data-i='2'] { transform: rotate(6deg) translateY(12px); }
</style>
