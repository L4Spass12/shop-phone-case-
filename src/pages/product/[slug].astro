---
// Fiche produit française. Le gabarit (commun à toutes les langues) est dans
// src/components/ProductPage.astro.
import ProductPage from '../../components/ProductPage.astro';
import { getCollection } from 'astro:content';
import { parseEntrySlug } from '../../lib/i18n';

export async function getStaticPaths() {
  const products = await getCollection('products');
  return products
    .filter(p => parseEntrySlug(p.slug).lang === 'fr')
    .map(product => ({
      params: { slug: product.slug },
      props: { product },
    }));
}

const { product } = Astro.props;
---

<ProductPage product={product} lang="fr" />
