---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import FabricationSection from '../../components/FabricationSection.astro';
import ModelPicker from '../../components/ModelPicker.astro';
import { getCollection } from 'astro:content';
import siteConfig from '../../../site.config.mjs';
import { unsplashSrcset } from '../../lib/image';
import { parseEntrySlug } from '../../lib/i18n';

export async function getStaticPaths() {
  const products = await getCollection('products');
  // Cette route ne génère QUE les pages FR : /product/<slug>/. Les versions EN/DE
  // (ex: /en/product/<slug>/) auront leur propre fichier dans src/pages/[lang]/...
  // ajouté en phase 5 quand le contenu localisé sera disponible.
  return products
    .filter(p => parseEntrySlug(p.slug).lang === 'fr')
    .map(product => ({
      params: { slug: product.slug },
      props: { product },
    }));
}

const { product } = Astro.props;
const { Content } = await product.render();
const {
  name, price, compareAtPrice, priceRange, image, imageAlt, gallery,
  categories, shortDescription, stock, sku, attributes, variations,
} = product.data;

const allProducts = await getCollection('products');

// ─── Sélection catégorie pour "Vous aimerez aussi" ─────────────────────
// Les catégories transversales contiennent TOUS les produits
// → on préfère une catégorie thématique. Priorité bas = déprioritisé.
const GENERIC_CATEGORIES = new Set([
  'categorie-transversale-exemple',        // à personnaliser : slugs de catégories transversales
]);
const preferredCategory = (categories || []).find(c => !GENERIC_CATEGORIES.has(c))
  ?? categories?.[0];

// TOUS les produits de cette collection thématique (hors produit courant) ET
// dans la même langue que le produit affiché (pas de mix FR/EN dans le slider).
const productLang = parseEntrySlug(product.slug).lang;
const related = allProducts
  .filter(p => p.slug !== product.slug
    && parseEntrySlug(p.slug).lang === productLang
    && (p.data.categories || []).includes(preferredCategory));

const formatPrice = (n: number) => new Intl.NumberFormat('fr-FR', {
  style: 'currency', currency: siteConfig.shop.currency,
}).format(n);

// Dates de livraison estimées : 6 à 10 jours calendaires (week-ends inclus)
const _today = new Date();
function addCalendarDays(date: Date, days: number) {
  const d = new Date(date);
  d.setDate(d.getDate() + days);
  return d;
}
const deliveryStart = addCalendarDays(_today, 6);
const deliveryEnd   = addCalendarDays(_today, 10);
const fmtDeliveryDate = (d: Date) =>
  new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'long' }).format(d);
const deliveryWindowText = `entre le ${fmtDeliveryDate(deliveryStart)} et le ${fmtDeliveryDate(deliveryEnd)}`;

const SITE_URL = siteConfig.url;
const productUrl = `${SITE_URL}/product/${product.slug}/`;
const imageUrl = new URL(image, SITE_URL).toString();
const hasVariations = Array.isArray(variations) && variations.length > 0;
const inStock = hasVariations ? variations.some(v => v.inStock) : (stock == null || stock > 0);

// Variante A/B du bouton ATC. Le style 'blob' repose sur des éléments enfants
// (blobs + couche verre) : on ne l'applique QUE si le produit n'a pas de
// variations, car le JS du sélecteur réécrit l'innerHTML de #buy-button et
// détruirait ces enfants. Avec variations → repli silencieux sur 'gradient'.
const atcBlob = product.data.atcVariant === 'blob' && !hasVariations;

// Variantes 'ink*' : simples classes CSS, donc compatibles avec les variations
// (contrairement à 'blob'). La classe est posée sur les TROIS CTA de la page —
// principal + barres sticky mobile et desktop — sans quoi le bouton flottant
// resterait violet en bas d'une page au CTA noir.
const INK_VARIANTS = ['ink', 'ink-flat', 'ink-glow', 'ink-frame'] as const;
const atcInk = (INK_VARIANTS as readonly string[]).includes(product.data.atcVariant)
  ? ` btn-atc--${product.data.atcVariant}`
  : '';
// Seule 'ink-glow' a besoin de JS (suivi du curseur) : on n'injecte le script
// que sur les pages concernées.
const atcGlow = product.data.atcVariant === 'ink-glow';

// ─── SEO : titre court + meta description unique par produit ──────────
// Titre : max ~60 chars. "Nom du produit | Nom du site" si ça rentre,
// sinon juste "Nom du produit" (sans le nom du site).
const brandSuffix = ` | ${siteConfig.name}`;
const seoTitle = (name.length + brandSuffix.length) <= 60
  ? `${name}${brandSuffix}`
  : name;

// Meta description : combine shortDesc tronquée + catégorie + prix pour garantir
// l'unicité même si shortDescription est dupliquée entre produits.
// Format : "<nom>. <shortDesc courte>. À partir de X€. Livraison sécurisée."
const priceStart = priceRange?.min ?? price;
const catLabel = categories?.[0]?.replace(/^boutique-/, '').replace(/-/g, ' ') ?? '';
const truncated = shortDescription.length > 70
  ? shortDescription.slice(0, 70).replace(/\s+\S*$/, '') + '…'
  : shortDescription;
const rawDesc = `${name}${catLabel ? ` ${catLabel}` : ''}. ${truncated} Dès ${priceStart}€, livraison sécurisée.`;
const seoDescription = rawDesc.length > 160
  ? rawDesc.slice(0, 160).replace(/\s+\S*$/, '') + '…'
  : rawDesc;

// Serialize variations + attributes pour le JS client (sélecteur de variantes)
const variantsJson = JSON.stringify(variations || []);

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name,
  description: shortDescription,
  image: [imageUrl, ...(gallery || []).slice(1).map(g => new URL(g, SITE_URL).toString())],
  sku: sku ?? product.slug,
  brand: { '@type': 'Brand', name: siteConfig.name },
  offers: hasVariations ? {
    '@type': 'AggregateOffer',
    priceCurrency: siteConfig.shop.currency,
    lowPrice: priceRange?.min ?? price,
    highPrice: priceRange?.max ?? price,
    offerCount: variations.length,
    availability: inStock ? 'https://schema.org/InStock' : 'https://schema.org/OutOfStock',
    seller: { '@type': 'Organization', name: siteConfig.name, url: SITE_URL },
  } : {
    '@type': 'Offer',
    url: productUrl,
    priceCurrency: siteConfig.shop.currency,
    price: price.toFixed(2),
    availability: inStock ? 'https://schema.org/InStock' : 'https://schema.org/OutOfStock',
    itemCondition: 'https://schema.org/NewCondition',
    seller: { '@type': 'Organization', name: siteConfig.name, url: SITE_URL },
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: SITE_URL },
    { '@type': 'ListItem', position: 2, name: 'Boutique', item: `${SITE_URL}/boutique` },
    { '@type': 'ListItem', position: 3, name, item: productUrl },
  ],
};
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  image={image}
  imageWidth={1200}
  imageHeight={1500}
  jsonLd={[productSchema, breadcrumbSchema]}
  noindex={(categories ?? []).length === 0}
>
  <div class="crumbs-shell max-w-7xl mx-auto px-6 pt-6 md:pt-8 pb-16 md:pb-20">
    <!-- Breadcrumb -->
    <nav class="site-breadcrumb flex items-center gap-2 text-xs text-n-500 mb-4 overflow-x-auto whitespace-nowrap pb-1 font-light">
      <a href="/" class="hover:text-cream transition-colors shrink-0">Accueil</a>
      <span class="shrink-0">/</span>
      <a href="/boutique" class="hover:text-cream transition-colors shrink-0">Boutique</a>
      <span class="shrink-0">/</span>
      <span class="text-n-400 truncate">{name}</span>
    </nav>

    <div class="grid lg:grid-cols-2 gap-5 lg:gap-16">
      <!-- ═══════════════════════════ GALERIE ═══════════════════════════ -->
      {(() => {
        // Galerie épurée : UNIQUEMENT image principale + gallery définie dans le frontmatter.
        // Les images de variations ne sont PAS ajoutées (design épuré).
        // Au changement de variante, le slide principal sera swappé directement via JS.
        const slides = Array.from(new Set([image, ...(gallery || [])]));
        return (
        <div class="product-gallery" data-gallery data-slide-count={slides.length}>
          <!-- Viewport : scroll-snap horizontal. Sur mobile = swipe natif,
               sur desktop = flèches prev/next. Une seule image visible à la fois. -->
          <div class="gallery-viewport relative overflow-hidden bg-panel aspect-[4/5] group md:rounded-2xl md:border md:border-white/[0.05]">
            <div
              class="gallery-track flex overflow-x-auto snap-x snap-mandatory scroll-smooth h-full"
              data-gallery-track
            >
              {slides.map((src, i) => (
                <div class="flex-none w-full h-full snap-start snap-always">
                  <img
                    data-gallery-slide={i}
                    src={src}
                    srcset={unsplashSrcset(src)}
                    sizes="(max-width: 1024px) 100vw, 560px"
                    alt={i === 0 ? (imageAlt ?? name) : `${name} - image ${i + 1}`}
                    class="w-full h-full object-cover"
                    width="1200"
                    height="1500"
                    fetchpriority={i === 0 ? 'high' : 'auto'}
                    loading={i === 0 ? 'eager' : 'lazy'}
                    decoding="async"
                  />
                </div>
              ))}
            </div>

            <!-- Flèches desktop uniquement (apparaissent au hover) -->
            {slides.length > 1 && (
              <>
                <button
                  type="button"
                  data-gallery-prev
                  aria-label="Image précédente"
                  class="hidden md:flex absolute left-3 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-dark/80 backdrop-blur border border-white/[0.15] items-center justify-center text-cream opacity-0 group-hover:opacity-100 hover:bg-dark hover:border-white/30 disabled:opacity-0 disabled:pointer-events-none transition-all z-10"
                >
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="15 18 9 12 15 6"/></svg>
                </button>
                <button
                  type="button"
                  data-gallery-next
                  aria-label="Image suivante"
                  class="hidden md:flex absolute right-3 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-dark/80 backdrop-blur border border-white/[0.15] items-center justify-center text-cream opacity-0 group-hover:opacity-100 hover:bg-dark hover:border-white/30 disabled:opacity-0 disabled:pointer-events-none transition-all z-10"
                >
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="9 18 15 12 9 6"/></svg>
                </button>
              </>
            )}

            <!-- Dots : MOBILE uniquement (le desktop a flèches + thumbs).
                 Sur un chip translucide pour rester visibles quelle que soit
                 l'image dessous. -->
            {slides.length > 1 && (
              <div
                class="md:hidden absolute bottom-3 left-1/2 -translate-x-1/2 flex items-center gap-1.5 px-2.5 py-1.5 rounded-full bg-black/25 backdrop-blur-sm z-10"
                data-gallery-dots
              >
                {slides.map((_, i) => (
                  <button
                    type="button"
                    data-gallery-dot={i}
                    aria-label={`Voir l'image ${i + 1}`}
                    class="gallery-dot"
                  ></button>
                ))}
              </div>
            )}
          </div>

          <!-- Thumbs : DESKTOP uniquement. Sur mobile → swipe natif. -->
          {slides.length > 1 && (
            <div class="hidden md:grid grid-cols-5 gap-2 mt-3">
              {slides.slice(0, 10).map((g, i) => (
                <button
                  type="button"
                  data-gallery-thumb={i}
                  class={`gallery-thumb aspect-square rounded-lg overflow-hidden bg-dark border transition-colors ${i === 0 ? 'border-cream' : 'border-white/[0.08]'} hover:border-white/30`}
                  aria-label={`Voir l'image ${i + 1}`}
                >
                  <img src={g} alt="" loading="lazy" decoding="async" class="w-full h-full object-contain" />
                </button>
              ))}
            </div>
          )}
        </div>
        );
      })()}

      <!-- Info + CTA -->
      <div class="flex flex-col">
        <!-- Categories -->
        {categories && categories.length > 0 && (
          <div class="flex flex-wrap gap-1.5 mb-3">
            {categories.map(c => (
              <a
                href={`/product-category/${c}`}
                class="text-[10px] text-n-500 font-medium uppercase tracking-widest hover:text-cream transition-colors"
              >
                {c.replace(/-/g, ' ')}
              </a>
            ))}
          </div>
        )}

        <h1 class="text-xl md:text-2xl lg:text-3xl font-medium tracking-tight text-cream leading-[1.2] mb-3">
          {name}
        </h1>
        <p class="text-sm md:text-base text-n-400 leading-relaxed mb-4 font-light">
          {shortDescription}
        </p>

        <!-- Prix -->
        <div class="flex items-baseline gap-3 mb-5">
          <span id="product-price" class="price-amount text-xl md:text-2xl text-cream font-medium tracking-tight">
            {priceRange && priceRange.min !== priceRange.max
              ? `Dès ${formatPrice(priceRange.min)}`
              : formatPrice(price)}
          </span>
          {compareAtPrice && (
            <span id="product-compare" class="text-sm text-n-500 line-through font-light">
              {formatPrice(compareAtPrice)}
            </span>
          )}
          {compareAtPrice && (
            <span class="text-[10px] font-medium bg-cream text-dark px-2 py-1 rounded-sm uppercase tracking-wider">
              -{Math.round((1 - price / compareAtPrice) * 100)}%
            </span>
          )}
        </div>

        {/* Choix du modèle de téléphone. Placé avant les variantes : c'est la
            première question que se pose l'acheteur, et le seul champ requis. */}
        <ModelPicker lang="fr" />

        <!-- Sélecteurs de variantes -->
        {hasVariations && attributes.length > 0 && (
          <div id="variant-selector" class="space-y-5 mb-6">
            {attributes.map(attr => {
              // Détecte si l'attribut est une dimension ("45 × 35 cm", "90x40 cm"…).
              // Si oui → cards avec visualisation SVG. Sinon → pills classiques.
              const SIZE_RE = /(\d+)\s*[x×]\s*(\d+)/i;
              const parsed = attr.values.map(v => {
                const m = v.label.match(SIZE_RE);
                return m ? { ...v, w: parseInt(m[1], 10), h: parseInt(m[2], 10) } : { ...v, w: null, h: null };
              });
              const isSize = parsed.every(v => v.w != null && v.h != null);

              if (!isSize) {
                // ── Attribut classique (couleur, matière…) : pills ──
                return (
                  <div>
                    <label class="block text-xs text-n-500 uppercase tracking-widest mb-2 font-medium">
                      {attr.name} : <span class="text-cream" data-selected-label={attr.name}>-</span>
                    </label>
                    <div class="flex flex-wrap gap-2">
                      {attr.values.map((val, idx) => (
                        <button
                          type="button"
                          data-variant-option
                          data-variant-type="pill"
                          data-attr={attr.name}
                          data-value={val.slug}
                          class={`variant-pill text-xs font-medium px-4 py-2 rounded-full border transition-colors ${idx === 0 ? 'bg-cream text-dark border-cream' : 'bg-white/[0.02] text-n-400 border-white/[0.08] hover:text-cream hover:border-white/20'}`}
                        >
                          {val.label}
                        </button>
                      ))}
                    </div>
                  </div>
                );
              }

              // ── Attribut "Dimensions" : cards avec visualisation ──
              const maxW = Math.max(...parsed.map(v => v.w));
              const maxH = Math.max(...parsed.map(v => v.h));
              // Variante par défaut = la plus grande (par aire) → badge "Populaire"
              const largestIdx = parsed.reduce(
                (best, v, i, arr) => (v.w * v.h > arr[best].w * arr[best].h ? i : best),
                0
              );

              return (
                <div>
                  <label class="block text-xs text-n-500 uppercase tracking-widest mb-2 font-medium">
                    {attr.name} : <span class="text-cream" data-selected-label={attr.name}>-</span>
                  </label>
                  <div class={`grid gap-2`} style={`grid-template-columns: repeat(${parsed.length}, minmax(0, 1fr));`}>
                    {parsed.map((val, idx) => {
                      const isSelected = idx === largestIdx;
                      const isPopular  = idx === largestIdx;
                      // Produit scalé dans la card (viewBox = largeur max × hauteur max).
                      // Padding 5 unités tout autour pour laisser respirer.
                      const pad = 5;
                      const vbW = maxW + pad * 2;
                      const vbH = maxH + pad * 2;
                      // Position du produit (centré verticalement, aligné à gauche)
                      const padX = pad;
                      const padY = pad + (maxH - val.h) / 2;
                      // Souris : orientation portrait (longueur > largeur, vue du dessus)
                      // Dimensions réalistes ~7 × 12 cm
                      const mouseW = Math.min(7, val.w * 0.13);
                      const mouseH = Math.min(12, val.h * 0.32);
                      const mouseCx = padX + val.w - mouseW / 2 - val.w * 0.08;
                      const mouseCy = padY + val.h / 2;
                      // Clavier : ~36 × 13 cm, uniquement si le produit fait ≥ 55 cm de large
                      const showKeyboard = val.w >= 55;
                      const kbW = Math.min(36, val.w * 0.55);
                      const kbH = kbW * 0.36;
                      const kbX = padX + val.w * 0.08;
                      const kbY = padY + (val.h - kbH) / 2;

                      return (
                        <button
                          type="button"
                          data-variant-option
                          data-variant-type="size"
                          data-attr={attr.name}
                          data-value={val.slug}
                          class={`variant-size-card relative rounded-xl border p-2 md:p-3 transition-colors min-w-0 ${isSelected ? 'bg-white/[0.04] border-cream' : 'bg-white/[0.02] border-white/[0.08] hover:border-white/25'}`}
                          aria-label={`Taille ${val.label}${isPopular ? ' (le plus populaire)' : ''}`}
                        >
                          {isPopular && (
                            <span class="absolute -top-2 left-1/2 -translate-x-1/2 text-[9px] md:text-[10px] font-medium bg-cream text-dark px-2 py-0.5 rounded-full uppercase tracking-wider whitespace-nowrap shadow-sm">
                              Populaire
                            </span>
                          )}
                          <svg
                            viewBox={`0 0 ${vbW} ${vbH}`}
                            class="w-full h-auto mb-2 block"
                            aria-hidden="true"
                          >
                            <!-- Surface produit -->
                            <rect
                              x={padX} y={padY} width={val.w} height={val.h}
                              rx="2" ry="2"
                              fill={isSelected ? 'rgba(244,244,247,0.10)' : 'rgba(255,255,255,0.04)'}
                              stroke={isSelected ? 'rgba(244,244,247,0.8)' : 'rgba(255,255,255,0.25)'}
                              stroke-width="0.5"
                              class="size-rect"
                            />
                            {/* Clavier : rect + petites touches stylisées */}
                            {showKeyboard && (
                              <g class="keyboard-g">
                                <rect
                                  x={kbX} y={kbY} width={kbW} height={kbH}
                                  rx="1" ry="1"
                                  fill="rgba(255,255,255,0.06)"
                                  stroke="rgba(255,255,255,0.35)"
                                  stroke-width="0.4"
                                />
                                {/* Touches : 3 lignes de petits rects */}
                                {[0.22, 0.45, 0.68].map(ry => (
                                  <line
                                    x1={kbX + kbW * 0.05} y1={kbY + kbH * ry}
                                    x2={kbX + kbW * 0.95} y2={kbY + kbH * ry}
                                    stroke="rgba(255,255,255,0.25)"
                                    stroke-width="0.3"
                                    stroke-dasharray="0.6 0.4"
                                  />
                                ))}
                              </g>
                            )}
                            {/* Souris : forme "pear" vue du dessus, palm en haut,
                                 boutons en bas, molette centrale */}
                            <g class="mouse-g">
                              {/* Corps : path avec haut arrondi plus large, bas légèrement
                                   resserré (proportions d'une souris type) */}
                              <path
                                d={
                                  `M ${mouseCx - mouseW*0.48} ${mouseCy - mouseH*0.15}` +
                                  ` C ${mouseCx - mouseW*0.48} ${mouseCy - mouseH*0.5}, ${mouseCx - mouseW*0.3} ${mouseCy - mouseH*0.5}, ${mouseCx} ${mouseCy - mouseH*0.5}` +
                                  ` C ${mouseCx + mouseW*0.3} ${mouseCy - mouseH*0.5}, ${mouseCx + mouseW*0.48} ${mouseCy - mouseH*0.5}, ${mouseCx + mouseW*0.48} ${mouseCy - mouseH*0.15}` +
                                  ` L ${mouseCx + mouseW*0.4} ${mouseCy + mouseH*0.4}` +
                                  ` C ${mouseCx + mouseW*0.3} ${mouseCy + mouseH*0.5}, ${mouseCx - mouseW*0.3} ${mouseCy + mouseH*0.5}, ${mouseCx - mouseW*0.4} ${mouseCy + mouseH*0.4}` +
                                  ` Z`
                                }
                                fill="rgba(255,255,255,0.08)"
                                stroke="rgba(255,255,255,0.45)"
                                stroke-width="0.4"
                                stroke-linejoin="round"
                              />
                              {/* Ligne de séparation des clics gauche/droit (haut) */}
                              <line
                                x1={mouseCx} y1={mouseCy - mouseH*0.42}
                                x2={mouseCx} y2={mouseCy - mouseH*0.12}
                                stroke="rgba(255,255,255,0.3)"
                                stroke-width="0.3"
                              />
                              {/* Molette : petit rect arrondi centré-haut */}
                              <rect
                                x={mouseCx - mouseW*0.06}
                                y={mouseCy - mouseH*0.2}
                                width={mouseW*0.12}
                                height={mouseH*0.14}
                                rx={mouseW*0.05}
                                fill="rgba(255,255,255,0.3)"
                                stroke="rgba(255,255,255,0.45)"
                                stroke-width="0.2"
                              />
                            </g>
                          </svg>
                          <div class="text-center">
                            <div class="text-[11px] md:text-[13px] font-medium text-cream tracking-tight leading-none whitespace-nowrap">{val.label}</div>
                          </div>
                        </button>
                      );
                    })}
                  </div>
                </div>
              );
            })}
          </div>
        )}

        <!-- Bouton d'achat (Atelier) — style piloté par `atcVariant` du produit :
             'gradient' (défaut, .btn-atc), 'ink' (le même en noir) ou 'blob'
             (.btn-atc-blob) — cf. global.css. -->
        {atcBlob ? (
          <button
            id="buy-button"
            class="buy-button btn-atc-blob self-start"
            disabled={!inStock}
            data-item-id={sku ?? product.slug}
            data-item-name={name}
            data-item-price={Math.round(price * 100)}
            data-item-image={imageUrl}
          >
            {/* .ab-clip porte la découpe arrondie : sur mobile, overflow+radius
                ne clippe pas les blobs (couches compositées) — cf. global.css */}
            <span class="ab-clip">
              <span class="ab-text">
                {inStock ? (
                  <>Ajouter au panier <span>{priceRange && priceRange.min !== priceRange.max ? `dès ${formatPrice(priceRange.min)}` : formatPrice(price)}</span></>
                ) : 'Indisponible'}
              </span>
              <span class="ab-blob" aria-hidden="true"></span>
              <span class="ab-blob" aria-hidden="true"></span>
              <span class="ab-blob" aria-hidden="true"></span>
              <span class="ab-blob" aria-hidden="true"></span>
            </span>
          </button>
        ) : (
          <button
            id="buy-button"
            class={`buy-button btn-atc self-start${atcInk}`}
            disabled={!inStock}
            data-item-id={sku ?? product.slug}
            data-item-name={name}
            data-item-price={Math.round(price * 100)}
            data-item-image={imageUrl}
          >
            {inStock ? (
