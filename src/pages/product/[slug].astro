  <!-- ═══════════════════════════ JS PRODUIT ═══════════════════════════
       Trois modules indépendants, tous différés via requestIdleCallback :
       1. Galerie (scroll-snap + thumbs + flèches desktop + clavier)
       2. Slider "Vous aimerez aussi" (flèches desktop)
       3. Sélecteur de variantes (pills/cards + sync prix/stock/image)
  -->
  <script is:inline set:html={`
    (function() {

    /* ─── 1. GALERIE ───────────────────────────────────────────────── */
    function initGallery() {
      const root = document.querySelector('[data-gallery]');
      if (!root) return null;
      const track  = root.querySelector('[data-gallery-track]');
      const thumbs = Array.from(root.querySelectorAll('[data-gallery-thumb]'));
      const dots   = Array.from(root.querySelectorAll('[data-gallery-dot]'));
      const prev   = root.querySelector('[data-gallery-prev]');
      const next   = root.querySelector('[data-gallery-next]');
      const count  = parseInt(root.dataset.slideCount || '0', 10);
      let current  = 0;

      const paint = () => {
        thumbs.forEach((t, i) => {
          t.className = 'gallery-thumb aspect-square rounded-lg overflow-hidden bg-dark border transition-colors '
            + (i === current ? 'border-cream' : 'border-white/[0.08] hover:border-white/30');
        });
        dots.forEach((d, i) => d.setAttribute('aria-current', i === current ? 'true' : 'false'));
        if (prev) prev.disabled = current <= 0;
        if (next) next.disabled = current >= count - 1;
      };

      const goTo = (idx) => {
        if (idx < 0 || idx >= count || !track) return;
        track.scrollTo({ left: track.clientWidth * idx, behavior: 'smooth' });
      };

      // Détecte le slide courant via scroll (swipe natif mobile + scrollTo desktop)
      if (track) {
        let raf = null;
        track.addEventListener('scroll', () => {
          if (raf) cancelAnimationFrame(raf);
          raf = requestAnimationFrame(() => {
            const idx = Math.round(track.scrollLeft / track.clientWidth);
            if (idx !== current) { current = idx; paint(); }
          });
        }, { passive: true });
      }

      prev?.addEventListener('click', () => goTo(current - 1));
      next?.addEventListener('click', () => goTo(current + 1));
      thumbs.forEach((t, i) => t.addEventListener('click', () => goTo(i)));
      dots.forEach((d, i) => d.addEventListener('click', () => goTo(i)));
      root.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft')  { e.preventDefault(); goTo(current - 1); }
        if (e.key === 'ArrowRight') { e.preventDefault(); goTo(current + 1); }
      });
      root.setAttribute('tabindex', '0');

      paint();
      // API exposée pour le sélecteur de variantes
      return { goTo, getMainSlide: () => root.querySelector('[data-gallery-slide="0"]'),
               getMainThumb: () => root.querySelector('[data-gallery-thumb="0"] img') };
    }

    /* ─── 2. SLIDER "VOUS AIMEREZ AUSSI" ───────────────────────────── */
    function initRelatedSlider() {
      document.querySelectorAll('[data-slider]').forEach(slider => {
        const track = slider.querySelector('.slider-track');
        const prev  = slider.querySelector('[data-scroll="prev"]');
        const next  = slider.querySelector('[data-scroll="next"]');
        if (!track) return;

        const scrollByCards = (dir) => {
          const card = track.querySelector('.slider-card');
          if (!card) return;
          const w = card.getBoundingClientRect().width + 20;
          track.scrollBy({ left: w * 2 * dir, behavior: 'smooth' });
        };
        prev?.addEventListener('click', () => scrollByCards(-1));
        next?.addEventListener('click', () => scrollByCards(1));

        const upd = () => {
          if (!prev || !next) return;
          prev.disabled = track.scrollLeft <= 1;
          next.disabled = track.scrollLeft >= track.scrollWidth - track.clientWidth - 1;
        };
        track.addEventListener('scroll', upd, { passive: true });
        window.addEventListener('resize', upd);
        requestAnimationFrame(upd);
      });
    }

    /* ─── 3. SÉLECTEUR DE VARIANTES ────────────────────────────────── */
    function initVariants(galleryApi, stickyRefs) {
      const variants = ${variantsJson};
      const buyBtn   = document.getElementById('buy-button');
      const priceEl  = document.getElementById('product-price');
      const compareEl = document.getElementById('product-compare');
      const stockEl  = document.getElementById('product-stock');
      const selector = document.getElementById('variant-selector');
      if (!variants.length || !selector || !buyBtn) return;

      const currency = '${siteConfig.shop.currency}';
      const fmtPrice = (v) => new Intl.NumberFormat('fr-FR', { style: 'currency', currency }).format(v);

      // Slide 0 = image principale (swap au changement de variante)
      const mainSlide = galleryApi?.getMainSlide() ?? null;
      const mainThumb = galleryApi?.getMainThumb() ?? null;
      const originalSrc = mainSlide?.getAttribute('src') ?? null;

      // Initial : pill bg-cream OU size-card border-cream
      const selected = {};
      selector.querySelectorAll('[data-attr]').forEach(btn => {
        const a = btn.dataset.attr;
        if (selected[a]) return;
        if (btn.classList.contains('bg-cream') || btn.classList.contains('border-cream')) {
          selected[a] = btn.dataset.value;
        }
      });

      const findVariant = () => variants.find(v => {
        for (const [k, val] of Object.entries(selected)) {
          if (v.attributes[k] !== val) return false;
        }
        return true;
      });

      const setStock = (inStock, label) => {
        if (!stockEl) return;
        const dot = stockEl.querySelector('span:first-child');
        const txt = stockEl.querySelector('span:last-child');
        stockEl.className = 'flex items-center gap-2 mb-6 text-sm font-light ' + (inStock ? 'text-sage' : 'text-n-500');
        if (dot) dot.className = 'w-1.5 h-1.5 rounded-full ' + (inStock ? 'bg-sage' : 'bg-n-500');
        if (txt) txt.textContent = label;
      };

      function update() {
        // Labels "Dimensions : 45 × 35 cm"
        Object.entries(selected).forEach(([attr, slug]) => {
          const label = document.querySelector('[data-selected-label="' + attr + '"]');
          if (!label) return;
          const pill = selector.querySelector('[data-attr="' + attr + '"][data-value="' + slug + '"]');
          label.textContent = pill ? pill.textContent.trim() : slug;
        });

        const v = findVariant();
        if (!v) {
          buyBtn.disabled = true;
          buyBtn.textContent = 'Combinaison indisponible';
          setStock(false, 'Indisponible');
          return;
        }

        // Prix + compare
        if (priceEl) priceEl.textContent = fmtPrice(v.price);
        if (compareEl) {
          if (v.compareAtPrice) {
            compareEl.textContent = fmtPrice(v.compareAtPrice);
            compareEl.classList.remove('hidden');
          } else {
            compareEl.classList.add('hidden');
          }
        }

        // Stock
        setStock(v.inStock, v.inStock ? 'En stock' : 'Rupture');

        // Image : swap src du slide principal + thumb 0
        if (mainSlide) {
          const nextSrc = v.image || originalSrc;
          if (nextSrc && mainSlide.getAttribute('src') !== nextSrc) {
            mainSlide.setAttribute('src', nextSrc);
            // Reconstruit le srcset responsive pour les .webp locaux (variantes -400w/-800w pré-générées)
            const m = nextSrc.match(/^(?!https?:)(.*)\.webp$/i);
            if (m) {
              const base = m[1];
              mainSlide.setAttribute('srcset', base + '-400w.webp 400w, ' + base + '-800w.webp 800w, ' + nextSrc + ' 1200w');
            } else {
              mainSlide.removeAttribute('srcset');
            }
            if (mainThumb) mainThumb.setAttribute('src', nextSrc);
          }
          galleryApi?.goTo(0);
        }

        // Bouton + dataset Atelier
        const variantDesc = Object.entries(selected).map(([k, val]) => {
          const pill = selector.querySelector('[data-attr="' + k + '"][data-value="' + val + '"]');
          return k + ': ' + (pill ? pill.textContent.trim() : val);
        }).join(', ');
        buyBtn.disabled = !v.inStock;
        // Cle d'article UNIQUE PAR CONFIGURATION : l'id nu de la variation
        // ("1", "2") entrerait en collision entre deux produits du meme
        // shop, et c'est cette cle qui sert au mapping fournisseur cote
        // Seamless (supplier_skus.store_key).
        buyBtn.dataset.itemId = ${JSON.stringify(product.slug)} + '-v' + v.id;
        buyBtn.dataset.itemPrice = Math.round(v.price * 100);
        buyBtn.dataset.itemName = ${JSON.stringify(name)} + ' (' + variantDesc + ')';
        if (v.image) buyBtn.dataset.itemImage = new URL(v.image, location.origin).href;
        buyBtn.innerHTML = v.inStock
          ? 'Ajouter au panier <span class="opacity-70 font-normal">' + fmtPrice(v.price) + '</span>'
          : 'Indisponible';

        // Sync sticky ATC bar (boutons mobile + desktop, prix, label taille)
        if (stickyRefs) {
          stickyRefs.btns.forEach(b => {
            b.disabled = !v.inStock;
            b.dataset.itemId = ${JSON.stringify(product.slug)} + '-v' + v.id;
            b.dataset.itemPrice = Math.round(v.price * 100);
            b.dataset.itemName = ${JSON.stringify(name)} + ' (' + variantDesc + ')';
            if (v.image) b.dataset.itemImage = new URL(v.image, location.origin).href;
          });
          const dimPill = selector.querySelector('[data-variant-type="size"].border-cream');
          const sizeLabel = dimPill
            ? (dimPill.querySelector('.text-cream')?.textContent.trim() || variantDesc)
            : variantDesc;
          if (stickyRefs.sizeMobile) stickyRefs.sizeMobile.textContent = sizeLabel;
          if (stickyRefs.sizeDesk)   stickyRefs.sizeDesk.textContent   = sizeLabel;
          if (stickyRefs.priceMobile) stickyRefs.priceMobile.textContent = fmtPrice(v.price);
          if (stickyRefs.priceDesk)   stickyRefs.priceDesk.textContent   = fmtPrice(v.price);
        }
      }

      // Click handlers (pills + size cards)
      const pillClass = 'variant-pill text-xs font-medium px-4 py-2 rounded-full border transition-colors';
      const sizeClass = 'variant-size-card relative rounded-xl border p-2 md:p-3 transition-colors min-w-0';
      const off = (type) => type === 'size'
        ? sizeClass + ' bg-white/[0.02] border-white/[0.08] hover:border-white/25'
        : pillClass + ' bg-white/[0.02] text-n-400 border-white/[0.08] hover:text-cream hover:border-white/20';
      const on = (type) => type === 'size'
        ? sizeClass + ' bg-white/[0.04] border-cream'
        : pillClass + ' bg-cream text-dark border-cream';

      selector.querySelectorAll('[data-variant-option]').forEach(btn => {
        btn.addEventListener('click', () => {
          const attr = btn.dataset.attr;
          const type = btn.dataset.variantType || 'pill';
          selector.querySelectorAll('[data-attr="' + attr + '"]').forEach(b => {
            const t = b.dataset.variantType || 'pill';
            b.className = off(t);
            const rect = b.querySelector('.size-rect');
            if (rect) {
              rect.setAttribute('fill', 'rgba(255,255,255,0.04)');
              rect.setAttribute('stroke', 'rgba(255,255,255,0.25)');
            }
          });
          btn.className = on(type);
          if (type === 'size') {
            const rect = btn.querySelector('.size-rect');
            if (rect) {
              rect.setAttribute('fill', 'rgba(244,244,247,0.10)');
              rect.setAttribute('stroke', 'rgba(244,244,247,0.8)');
            }
          }
          selected[attr] = btn.dataset.value;
          update();
        });
      });

      update();
    }

    /* ─── 4. STICKY ATC BAR ────────────────────────────────────────── */
    function initStickyAtc() {
      const bar     = document.getElementById('sticky-atc');
      const mainCTA = document.getElementById('buy-button');
      if (!bar || !mainCTA) return null;

      // La barre n'apparaît QUE lorsque le CTA principal est sorti par le HAUT
      // du viewport (= dépassé en scrollant). Elle reste cachée tant qu'il est
      // encore plus bas que l'écran, ce qui est le cas à l'arrivée sur la page.
      //
      // On lit la position réelle du CTA à chaque frame de scroll plutôt que
      // d'utiliser un IntersectionObserver : celui-ci ne réagit qu'aux
      // FRANCHISSEMENTS d'intersection et resterait bloqué dans le mauvais état
      // si l'on arrive directement au-delà du CTA sans jamais l'avoir croisé
      // (lien d'ancrage, restauration de position de scroll, saut de scroll).
      let scheduled = false;
      const syncBar = () => {
        scheduled = false;
        const passed = mainCTA.getBoundingClientRect().bottom <= 0;
        bar.classList.toggle('translate-y-full', !passed);
        bar.setAttribute('aria-hidden', passed ? 'false' : 'true');
      };
      const onScroll = () => {
        if (scheduled) return;
        scheduled = true;
        requestAnimationFrame(syncBar);
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
      syncBar();

      return {
        btns: [
          document.getElementById('sticky-atc-btn'),
          document.getElementById('sticky-atc-btn-desk'),
        ].filter(Boolean),
        sizeMobile: document.getElementById('sticky-atc-size-mobile'),
        sizeDesk:   document.getElementById('sticky-atc-size'),
        priceMobile: document.getElementById('sticky-atc-price-mobile'),
        priceDesk:   document.getElementById('sticky-atc-price'),
      };
    }

    /* ─── ENTRYPOINT : tout différé jusqu'à idle (post-LCP) ─────────── */
    function bootProductJS() {
      const galleryApi = initGallery();
      initRelatedSlider();
      const stickyRefs = initStickyAtc();
      initVariants(galleryApi, stickyRefs);
    }

    if ('requestIdleCallback' in window) {
      requestIdleCallback(bootProductJS, { timeout: 2000 });
    } else {
      setTimeout(bootProductJS, 0);
    }

    })();
  `} />

{/* Suivi du curseur pour la variante 'ink-glow' (test A/B). Bloc séparé et
    conditionnel : rien n'est envoyé sur les pages qui n'utilisent pas ce style.
    Le CSS a des valeurs par défaut pour --mx/--my, donc le bouton reste correct
    si ce script ne tourne pas (mobile, JS désactivé). */}
{atcGlow && (
  <script is:inline>
    (function () {
      // Pointeur grossier (tactile) : pas de curseur à suivre, on garde la
      // lueur statique du CSS et on évite d'écouter des événements pour rien.
      if (!window.matchMedia('(hover: hover) and (pointer: fine)').matches) return;

      document.querySelectorAll('.btn-atc--ink-glow').forEach(function (btn) {
        var raf = null;
        var pending = null;

        function apply() {
          raf = null;
          btn.style.setProperty('--mx', pending.x + 'px');
          btn.style.setProperty('--my', pending.y + 'px');
        }

        btn.addEventListener('pointermove', function (e) {
          var r = btn.getBoundingClientRect();
          pending = { x: Math.round(e.clientX - r.left), y: Math.round(e.clientY - r.top) };
          // Un pointermove peut arriver plusieurs fois par frame : on coalesce
          // les écritures de style pour ne toucher le DOM qu'une fois par frame.
          if (raf === null) raf = requestAnimationFrame(apply);
        });

        // Au départ du curseur, on rend la main aux valeurs par défaut du CSS
        // plutôt que de figer la lueur là où le pointeur a quitté le bouton.
        btn.addEventListener('pointerleave', function () {
          if (raf !== null) { cancelAnimationFrame(raf); raf = null; }
          btn.style.removeProperty('--mx');
          btn.style.removeProperty('--my');
        });
      });
    })();
  </script>
)}
</BaseLayout>
