---
/**
 * Encadré « modèle sur commande » : masqué par défaut, affiché par
 * <ModelPicker> quand le modèle choisi vient du catalogue fournisseur
 * (site.config.mjs › phoneModels.onDemand). Annonce le délai AVANT l'achat.
 */
import siteConfig from '../../site.config.mjs';
import { t, type Locale } from '../lib/i18n';

interface Props {
  lang?: Locale;
  /** Texte propre au studio (aperçu rectangle, zone caméra). */
  studio?: boolean;
}
const { lang = 'fr', studio = false } = Astro.props;
const n = String(siteConfig.phoneModels?.onDemand?.delayDays ?? 2);
---

{(siteConfig.phoneModels?.onDemand?.brands?.length ?? 0) > 0 && (
  <div class:list={['od-note', studio && 'od-note--studio']} data-ondemand-note hidden role="note">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M10 17h4V5H2v12h3" /><path d="M20 17h2v-3.34a4 4 0 0 0-1.17-2.83L19 9h-5v8h1" /><circle cx="7.5" cy="17.5" r="2.5" /><circle cx="17.5" cy="17.5" r="2.5" />
    </svg>
    <div>
      <strong>{t('model.onDemandNoteTitle', lang)}</strong>
      {studio ? t('model.onDemandStudio', lang) : t('model.onDemandNote', lang).replace('{n}', n)}
    </div>
    {/* Studio : l'encadré recouvre le bas du plan de travail, on peut le
        fermer (il revient si on choisit un autre modèle sur commande). */}
    {studio && (
      <button type="button" class="od-note-close" aria-label={t('model.close', lang)} onclick="this.parentElement.hidden = true">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12" /></svg>
      </button>
    )}
  </div>
)}
