---
// Page « coques pour <modèle> » (/coques/<id>/ et /<lang>/coques/<id>/) :
// toutes les coques, photographiées sur CE modèle (photos de l'atelier).
// Un clic mémorise le modèle : la fiche s'ouvre avec lui déjà choisi.
import BaseLayout from '../layouts/BaseLayout.astro';
import InfiniteReveal from './InfiniteReveal.astro';
import siteConfig from '../../site.config.mjs';
import { listPrice } from '../lib/printModes';
import { localePrefix, type Locale } from '../lib/i18n';
import { localizedProducts } from '../lib/products';
import { PHONE_MODELS, MODEL_TEXT, modelPhoto, type PhoneModel } from '../lib/models';

interface Props { lang: Locale; model: PhoneModel }
const { lang, model } = Astro.props;
const T = MODEL_TEXT[lang];
const lp = localePrefix(lang);
const url = (p: string) => `${lp}${p}`;
const SITE = siteConfig.url;

const products = (await localizedProducts(lang))
  .filter((p) => (p.data.categories ?? []).length > 0)
  .map((p) => ({ ...p, photo: modelPhoto(p.slug, model.id) }))
  .filter((p) => p.photo)
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0) || b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const n = products.length;
const money = (v: number) => new Intl.NumberFormat(lang === 'en' ? 'en-IE' : lang === 'de' ? 'de-DE' : 'fr-FR', { style: 'currency', currency: siteConfig.shop.currency }).format(v);
const pageUrl = `${SITE}${url(`/coques/${model.id}/`)}`;
const faq = T.faq(model);
const others = PHONE_MODELS.filter((m) => m.id !== model.id);

// Filtres par catégorie (dans la page, sans rechargement) : seulement les
// catégories de style qui ont au moins une coque.
type Cat = { slug: string; label: string; labels?: Record<string, string>; theme?: boolean };
const cats = ((siteConfig.productCategories ?? []) as Cat[])
  .filter((c) => c.theme && products.some((p) => (p.data.categories ?? []).includes(c.slug)))
  .map((c) => ({ slug: c.slug, name: (lang !== 'fr' && c.labels?.[lang]) || c.label }));
const allLabel = { fr: 'Toutes', en: 'All', de: 'Alle' }[lang] ?? 'Toutes';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: T.home, item: `${SITE}${url('/')}` },
      { '@type': 'ListItem', position: 2, name: T.shop, item: `${SITE}${url('/boutique/')}` },
      { '@type': 'ListItem', position: 3, name: T.h1(model), item: pageUrl },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: T.h1(model),
    description: T.description(model, n),
    url: pageUrl,
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: n,
      itemListElement: products.slice(0, 30).map((p, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        url: `${SITE}${url(`/product/${p.slug}/`)}`,
        name: p.data.name,
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---

<BaseLayout title={`${T.title(model)} | ${siteConfig.name}`} description={T.description(model, n)} jsonLd={jsonLd} image={products[0]?.photo ?? undefined}>
  <div class="crumbs-shell max-w-7xl mx-auto px-6 pt-6 md:pt-8 pb-16 md:pb-20">
    <nav class="site-breadcrumb flex items-center gap-2 text-xs text-n-500 mb-4 font-light" aria-label="breadcrumb">
      <a href={url('/')} class="hover:text-cream transition-colors">{T.home}</a>
      <span>/</span>
      <a href={url('/boutique')} class="hover:text-cream transition-colors">{T.shop}</a>
      <span>/</span>
      <span class="text-n-400">{model.label}</span>
    </nav>

    <header class="mb-10 max-w-3xl">
      <span class="text-[10px] text-n-500 font-medium uppercase tracking-widest mb-3 block">{T.count(n)}</span>
      <h1 class="text-4xl md:text-5xl font-medium tracking-tight text-cream leading-[1.1] mb-5">{T.h1(model)}</h1>
      <p class="text-base md:text-lg text-n-400 font-light leading-relaxed">{T.intro(model, n)}</p>
    </header>

    {cats.length > 0 && (
      <div class="cat-chips" role="group" aria-label={T.h1(model)}>
        <button type="button" class="cat-chip filter-btn is-active" data-filter="all" aria-pressed="true">{allLabel}</button>
        {cats.map((c) => (
          <button type="button" class="cat-chip filter-btn" data-filter={c.slug} aria-pressed="false">{c.name}</button>
        ))}
      </div>
    )}

    <section aria-label={T.h1(model)}>
      <div id="products-grid" class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-x-4 gap-y-8 md:gap-x-6 md:gap-y-12">
        {products.map((p, i) => (
          <article class="product-card" data-cats={(p.data.categories ?? []).join(' ')}>
            <a href={url(`/product/${p.slug}/`)} class="group block" data-model-link={model.label}>
              <div class="relative aspect-[4/5] rounded-2xl overflow-hidden bg-panel border border-white/[0.05] mb-5">
                <img
                  src={p.photo!.replace(/\.webp$/, '-500w.webp')}
                  srcset={`${p.photo!.replace(/\.webp$/, '-500w.webp')} 500w, ${p.photo} 1000w`}
                  sizes="(max-width: 767px) calc(50vw - 24px), (max-width: 1023px) calc(33vw - 24px), 300px"
                  alt={`${p.data.name} ${model.fullName}`}
                  class="w-full h-full object-contain group-hover:scale-105 transition-all duration-500"
                  width="500" height="750"
                  loading={i < 2 ? 'eager' : 'lazy'}
                  fetchpriority={i === 0 ? 'high' : undefined}
                  decoding="async"
                />
              </div>
              <h2 class="text-sm md:text-base font-medium text-cream mb-1 tracking-tight group-hover:underline underline-offset-4 line-clamp-1">{p.data.name}</h2>
              <span class="text-sm text-cream font-medium whitespace-nowrap">{T.from(money(listPrice(p.data)))}</span>
            </a>
          </article>
        ))}
      </div>
      <InfiniteReveal targetId="products-grid" itemSelector=".product-card" initial={16} batch={16} />
    </section>

    <section class="mt-20 pt-12 border-t border-white/[0.08] max-w-3xl">
      <h2 class="text-xl md:text-2xl font-medium tracking-tight text-cream mb-6">{T.faqTitle}</h2>
      <div class="space-y-3">
        {faq.map((f) => (
          <details class="rounded-2xl border border-white/[0.08] bg-panel px-6 py-4">
            <summary class="cursor-pointer font-medium text-cream">{f.q}</summary>
            <p class="mt-3 text-sm text-n-400 font-light leading-relaxed">{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <nav class="mt-16" aria-label={T.otherModels}>
      <h2 class="text-sm font-medium uppercase tracking-widest text-n-500 mb-4">{T.otherModels}</h2>
      <ul class="flex flex-wrap gap-2">
        {others.map((m) => (
          <li><a href={url(`/coques/${m.id}/`)} class="inline-block rounded-full border border-white/[0.1] px-3 py-1.5 text-xs text-n-400 hover:text-cream hover:border-white/30">{m.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</BaseLayout>

<style>
  /* Mêmes pastilles que la boutique (CategoryChips). */
  .cat-chips {
    display: flex; gap: .5rem; overflow-x: auto; scrollbar-width: none;
    margin: 0 -1.5rem 2.25rem; padding: .25rem 1.5rem;
    -webkit-mask: linear-gradient(90deg, transparent 0, #000 1.5rem, #000 calc(100% - 1.5rem), transparent 100%);
            mask: linear-gradient(90deg, transparent 0, #000 1.5rem, #000 calc(100% - 1.5rem), transparent 100%);
  }
  .cat-chips::-webkit-scrollbar { display: none; }
  @media (min-width: 1024px) { .cat-chips { flex-wrap: wrap; overflow: visible; margin: 0 0 2.5rem; padding: 0; -webkit-mask: none; mask: none; } }
  .cat-chip {
    flex: none; padding: .55rem 1rem; border-radius: 999px; font-size: .85rem; font-weight: 500; white-space: nowrap; cursor: pointer;
    border: 1px solid rgb(var(--c-cream) / .14); color: rgb(var(--c-cream) / .8); background: rgb(var(--c-cream) / .03);
    transition: border-color .2s, background .2s, color .2s;
  }
  .cat-chip:hover { border-color: rgb(var(--c-cream) / .35); color: rgb(var(--c-cream)); }
  .cat-chip.is-active { background: rgb(var(--c-cream)); color: rgb(var(--c-dark)); border-color: rgb(var(--c-cream)); }
</style>

<script>
  // Filtre par catégorie. InfiniteReveal écoute aussi les .filter-btn : au
  // premier filtre il affiche toutes les cartes, ici on masque les autres.
  const chips = document.querySelectorAll<HTMLButtonElement>('.cat-chips .filter-btn');
  chips.forEach((btn) => btn.addEventListener('click', () => {
    const f = btn.dataset.filter || 'all';
    chips.forEach((b) => { const on = b === btn; b.classList.toggle('is-active', on); b.setAttribute('aria-pressed', String(on)); });
    document.querySelectorAll<HTMLElement>('#products-grid .product-card').forEach((card) => {
      const ok = f === 'all' || (card.dataset.cats || '').split(' ').includes(f);
      card.style.display = ok ? '' : 'none';
    });
  }));

  // Le modèle de la page devient celui du visiteur au clic : la fiche s'ouvre
  // avec lui déjà sélectionné (même clé que le sélecteur de l'en-tête).
  document.addEventListener('click', (e) => {
    const a = (e.target as HTMLElement).closest('[data-model-link]') as HTMLElement | null;
    if (!a) return;
    try { localStorage.setItem('vareska:phone-model', a.dataset.modelLink || ''); } catch {}
  });
</script>
