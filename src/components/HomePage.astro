---
/**
 * Page d'accueil, UNIQUE pour toutes les langues (FR, EN, DE).
 *
 * La version française est la référence : même mise en page, mêmes blocs,
 * mêmes produits dans toutes les langues ; seuls les textes changent. Les
 * produits affichés sont les fiches FR (prix, images), avec le nom traduit
 * quand une traduction existe. En EN/DE, un produit sans traduction n'a pas
 * de fiche : il n'est pas affiché.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import siteConfig from '../../site.config.mjs';
import { listPrice } from '../lib/printModes';
import { getCollection } from 'astro:content';
import { inlineMd } from '../lib/inline-md';
import { parseEntrySlug, localePrefix, localeMeta, type Locale } from '../lib/i18n';
import { unsplashSrcset } from '../lib/image';

interface Props { lang: Locale }
const { lang } = Astro.props;
const lp = localePrefix(lang);
const url = (path: string) => `${lp}${path}`;

const TEXTS = {
  fr: {
    title: `Coques de téléphone uniques, imprimées en France | ${siteConfig.name}`,
    description: "Choisissez un motif ou créez le vôtre. Coques pour iPhone imprimées à l'unité en France.",
    heroAlt: "Une femme tend une coque de téléphone vers le ciel, d'autres coques à motifs flottent autour d'elle",
    eyebrow: "L'art sur votre téléphone", title1: 'Votre coque', title2: 'votre style',
    seeCollection: 'Voir la collection', createCase: 'Créer ma coque',
    selection: 'Sélection', featured: 'Produits en vedette', viewAll: 'Voir tout', from: 'À partir de',
    studioAlt: "Une table de travail où l'on choisit ses visuels : la coque vierge d'un côté, les coques imprimées alignées de l'autre",
    studioTitle: 'Personnalisez votre coque', collection: 'Collection',
    prevProducts: 'Produits précédents', nextProducts: 'Produits suivants', swipe: 'Glissez pour explorer',
    faqTitle: 'Questions fréquentes',
    faqs: [
      { q: 'Quels modèles de téléphone sont compatibles ?',
        a: "Nos coques existent pour l'iPhone 13, 14, 15, 15 Pro, 15 Pro Max, 16, 16 Pro, 16 Pro Max, 17, 17 Pro et 17 Pro Max, et pour les Samsung Galaxy S24, S24 Ultra, S25, S25 Ultra, S26, S26 Ultra, A36 5G et A56 5G. Vous choisissez votre modèle sur la fiche produit, et la coque est fabriquée pour lui : vérifiez-le bien avant de commander." },
      { q: 'Comment sont fabriquées vos coques ?',
        a: "Nous partons de coques transparentes que nous imprimons nous-mêmes, à l'unité, en France. L'encre est déposée directement sur la coque, sans film ni autocollant intermédiaire." },
      { q: 'Quels sont les délais de livraison ?',
        a: "En France métropolitaine, vous recevez votre colis en point relais Mondial Relay 4 à 7 jours ouvrés après votre commande (la livraison à domicile arrive bientôt). En Belgique et au Luxembourg, comptez 5 à 8 jours en point relais, 5 à 9 jours dans les autres pays de l'Union européenne, et jusqu'à 14 jours vers les États-Unis et le Canada. Vous recevez un numéro de suivi dès l'expédition." },
      { q: 'Puis-je retourner un article ?',
        a: "Oui, vous disposez de 14 jours après réception pour changer d'avis. Le produit doit être retourné dans son état d'origine. Consultez notre page dédiée pour connaître la marche à suivre." },
      { q: "J'ai une idée, mais je ne sais pas comment la réaliser",
        a: "Pas de souci, on s'en occupe ! Dans le studio, ouvrez [l'onglet Aide](/personnaliser/?aide) : décrivez votre idée, ajoutez vos photos ou inspirations, et notre atelier crée votre design. Vous le recevez par e-mail sous 48 à 72 h, gratuitement et sans engagement." },
      { q: 'Une coque personnalisée est-elle reprise ?',
        a: "Une coque créée dans le studio est fabriquée d'après votre visuel, pour vous seul : elle ne peut pas être remise en vente et n'entre donc pas dans le droit de rétractation. Relisez bien votre aperçu avant de valider. Un défaut de fabrication reste évidemment pris en charge." },
    ],
  },
  en: {
    title: `Unique phone cases, printed in France | ${siteConfig.name}`,
    description: 'Pick a design or create your own. iPhone cases printed one by one in France.',
    heroAlt: 'A woman holds a phone case up to the sky, other patterned cases floating around her',
    eyebrow: 'Art on your phone', title1: 'Your case', title2: 'your style',
    seeCollection: 'View the collection', createCase: 'Create my case',
    selection: 'Selection', featured: 'Featured products', viewAll: 'View all', from: 'From',
    studioAlt: 'A work table where designs are chosen: the blank case on one side, printed cases lined up on the other',
    studioTitle: 'Customise your case', collection: 'Collection',
    prevProducts: 'Previous products', nextProducts: 'Next products', swipe: 'Swipe to explore',
    faqTitle: 'Frequently asked questions',
    faqs: [
      { q: 'Which phone models are compatible?',
        a: 'Our cases are available for iPhone 13, 14, 15, 15 Pro, 15 Pro Max, 16, 16 Pro, 16 Pro Max, 17, 17 Pro and 17 Pro Max, and for Samsung Galaxy S24, S24 Ultra, S25, S25 Ultra, S26, S26 Ultra, A36 5G and A56 5G. You choose the model on the product page: each case is made for the selected model, so please check it before placing your order.' },
      { q: 'How are your cases made?',
        a: 'We start from clear cases that we print ourselves, one by one, in France. The ink is applied directly onto the case, with no film or sticker in between.' },
      { q: 'What are the delivery times?',
        a: 'In mainland France, your parcel reaches your Mondial Relay pickup point 4 to 7 business days after your order (home delivery is coming soon). Allow 5 to 8 days to a pickup point in Belgium and Luxembourg, 5 to 9 days elsewhere in the European Union, and up to 14 days to the United States and Canada. You receive a tracking number as soon as your order ships.' },
      { q: 'Can I return an item?',
        a: 'Yes, you have 14 days after receipt to change your mind. The product must be returned in its original condition. See our dedicated page for the procedure.' },
      { q: "I have an idea but don't know how to make it",
        a: "No problem, we'll take care of it! In the studio, open [the Help tab](/en/personnaliser/?aide): describe your idea, add your photos or inspiration, and our workshop creates your design. You receive it by email within 48 to 72 hours, free and with no obligation." },
      { q: 'Can a custom case be returned?',
        a: 'A case created in the studio is made from your own design, just for you: it cannot be resold, so it is not covered by the right of withdrawal. Please check your preview carefully before ordering. A manufacturing defect is of course always covered.' },
    ],
  },
  de: {
    title: `Einzigartige Handyhüllen, gedruckt in Frankreich | ${siteConfig.name}`,
    description: 'Wähle ein Motiv oder gestalte dein eigenes. iPhone-Hüllen, einzeln in Frankreich gedruckt.',
    heroAlt: 'Eine Frau hält eine Handyhülle in den Himmel, um sie herum schweben weitere gemusterte Hüllen',
    eyebrow: 'Kunst auf deinem Handy', title1: 'Deine Hülle', title2: 'dein Stil',
    seeCollection: 'Zur Kollektion', createCase: 'Hülle gestalten',
    selection: 'Auswahl', featured: 'Ausgewählte Produkte', viewAll: 'Alle ansehen', from: 'Ab',
    studioAlt: 'Ein Arbeitstisch, an dem Motive ausgewählt werden: die leere Hülle auf der einen Seite, die bedruckten Hüllen auf der anderen',
    studioTitle: 'Gestalte deine Hülle', collection: 'Kollektion',
    prevProducts: 'Vorherige Produkte', nextProducts: 'Nächste Produkte', swipe: 'Wischen zum Entdecken',
    faqTitle: 'Häufige Fragen',
    faqs: [
      { q: 'Welche Handymodelle sind kompatibel?',
        a: 'Unsere Hüllen gibt es für iPhone 13, 14, 15, 15 Pro, 15 Pro Max, 16, 16 Pro, 16 Pro Max, 17, 17 Pro und 17 Pro Max sowie für Samsung Galaxy S24, S24 Ultra, S25, S25 Ultra, S26, S26 Ultra, A36 5G und A56 5G. Das Modell wählst du auf der Produktseite: Jede Hülle wird für das gewählte Modell gefertigt, prüfe es also vor der Bestellung.' },
      { q: 'Wie werden eure Hüllen hergestellt?',
        a: 'Wir gehen von transparenten Hüllen aus, die wir selbst einzeln in Frankreich bedrucken. Die Tinte wird direkt auf die Hülle aufgetragen, ohne Folie oder Aufkleber dazwischen.' },
      { q: 'Wie lang sind die Lieferzeiten?',
        a: 'In Frankreich (Festland) liegt dein Paket 4 bis 7 Werktage nach deiner Bestellung an deiner Mondial-Relay-Abholstelle (Lieferung nach Hause folgt bald). Rechne mit 5 bis 8 Tagen an eine Abholstelle in Belgien und Luxemburg, 5 bis 9 Tagen im Rest der Europäischen Union und bis zu 14 Tagen in die USA und nach Kanada. Du erhältst eine Sendungsnummer, sobald deine Bestellung verschickt wird.' },
      { q: 'Kann ich einen Artikel zurückgeben?',
        a: 'Ja, du hast nach Erhalt 14 Tage Zeit, deine Meinung zu ändern. Das Produkt muss im Originalzustand zurückgeschickt werden. Auf unserer Infoseite findest du das Vorgehen.' },
      { q: 'Ich habe eine Idee, weiß aber nicht, wie ich sie umsetze',
        a: 'Kein Problem, wir kümmern uns darum! Öffne im Studio [den Hilfe-Tab](/de/personnaliser/?aide): Beschreibe deine Idee, füge deine Fotos oder Inspirationen hinzu, und unser Atelier gestaltet dein Design. Du bekommst es innerhalb von 48 bis 72 Stunden per E-Mail, kostenlos und unverbindlich.' },
      { q: 'Kann eine personalisierte Hülle zurückgegeben werden?',
        a: 'Eine im Studio gestaltete Hülle wird nach deinem eigenen Motiv nur für dich gefertigt: Sie kann nicht weiterverkauft werden und ist daher vom Widerrufsrecht ausgenommen. Prüfe deine Vorschau vor der Bestellung sorgfältig. Ein Fertigungsfehler wird selbstverständlich immer übernommen.' },
    ],
  },
}[lang];
if (!TEXTS) throw new Error(`HomePage : langue non prise en charge (${lang})`);
const T = TEXTS;

// ─── Données ──────────────────────────────────────────────────────────────
const allProducts = await getCollection('products');
const translationOf = (slug: string) =>
  allProducts.find(p => p.slug === `${lang}/${parseEntrySlug(slug).slug}`);
// Fiches FR (hors internes/tests : catégorie vide), textes traduits hors FR.
const sortedProducts = allProducts
  .filter(p => parseEntrySlug(p.slug).lang === 'fr')
  .filter(p => (p.data.categories ?? []).length > 0)
  .filter(p => lang === 'fr' || translationOf(p.slug))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .map(p => {
    const tr = lang === 'fr' ? undefined : translationOf(p.slug);
    return {
      href: url(`/product/${parseEntrySlug(p.slug).slug}`),
      data: { ...p.data, name: tr?.data.name ?? p.data.name, imageAlt: tr?.data.imageAlt ?? p.data.imageAlt },
    };
  });
// 8 produits "vedettes" : d'abord ceux marqués featured, puis les plus récents
const featuredProducts = [
  ...sortedProducts.filter(p => p.data.featured),
  ...sortedProducts.filter(p => !p.data.featured),
].slice(0, 8);

// Produits par catégorie (TOUS les produits, pas juste quelques-uns)
function byCategory(slug: string) {
  return sortedProducts.filter(p => (p.data.categories || []).includes(slug));
}

// Décor thématique par catégorie : glows colorés plus marqués
// Showcases par catégorie, pilotés par siteConfig.productCategories :
// chaque catégorie déclarée dans site.config.mjs qui a au moins un produit
// obtient sa rangée, avec une paire de glows attribuée cycliquement.
// Personnalise GLOW_PAIRS pour matcher ta palette de marque.
const GLOW_PAIRS = [
  ['rgba(120, 120, 140, 0.14)', 'rgba(160, 160, 180, 0.08)'],
  ['rgba(90, 130, 200, 0.14)',  'rgba(120, 160, 220, 0.08)'],
  ['rgba(130, 170, 130, 0.14)', 'rgba(160, 190, 160, 0.08)'],
  ['rgba(200, 160, 100, 0.14)', 'rgba(220, 190, 140, 0.08)'],
];
const categoryRows = (siteConfig.productCategories as { slug: string; label: string }[])
  .map((cat, i) => ({
    slug: cat.slug,
    label: cat.label,
    products: byCategory(cat.slug),
    glow1: GLOW_PAIRS[i % GLOW_PAIRS.length][0],
    glow2: GLOW_PAIRS[i % GLOW_PAIRS.length][1],
  }))
  .filter(row => row.products.length > 0);


// ⚠️ Les réponses de la FAQ partent AUSSI dans les données structurées lues
// par Google (FAQPage plus bas) : un texte de gabarit oublié se retrouve dans
// les résultats de recherche.
const faqs = T.faqs;

// ─── Helpers ──────────────────────────────────────────────────────────────
const formatPrice = (n: number) => new Intl.NumberFormat('fr-FR', {
  style: 'currency', currency: siteConfig.shop.currency,
}).format(n);

// Toujours « À partir de » : le prix affiché est celui du rendu à plat, le
// relief coûte plus cher. Sans la mention, on croirait à un prix unique.
const displayPrice = (d: any) => `${T.from} ${formatPrice(listPrice(d))}`;

// ─── Schemas JSON-LD ──────────────────────────────────────────────────────
const SITE_URL = siteConfig.url;

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteConfig.name,
  description: siteConfig.description,
  url: `${SITE_URL}${url('/')}`,
  inLanguage: localeMeta(lang).htmlLang,
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(f => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/\[([^\]]+)\]\([^)]+\)/g, '$1') },
  })),
};
---

<BaseLayout
  title={T.title}
  description={T.description}
  jsonLd={[websiteSchema, faqSchema]}
  preloadImages={[
    { href: '/images/hero-coques.webp',
      imagesrcset: '/images/hero-coques-800w.webp 800w, /images/hero-coques-1280w.webp 1280w, /images/hero-coques.webp 1696w',
      imagesizes: '100vw' },
  ]}
>
  <!-- ═══════════════════════════ HERO ═══════════════════════════ -->
  <!-- Structure simplifiée pour LCP détectable :
       - L'image hero est un <img> direct de la section (pas de wrapper z-indexé)
       - Le voile sombre est appliqué via `::after` en CSS pur (pas de div overlay) -->
  <section class="hero-section relative overflow-hidden min-h-[70vh] md:min-h-[75vh] flex items-center">
    <!-- Un seul <img> avec srcset (plus simple, LCP-friendly) -->
    <img
      src="/images/hero-coques.webp"
      srcset="/images/hero-coques-800w.webp 800w, /images/hero-coques-1280w.webp 1280w, /images/hero-coques.webp 1696w"
      {/* 100vw : la bannière n'est plus agrandie. Le visuel réserve lui-même
          sa moitié gauche au texte, le zoom de 26 % qui servait à dégager
          cette place n'a plus lieu d'être (cf. global.css). */}
      sizes="100vw"
      alt={T.heroAlt}
      class="hero-img hero-bg"
      fetchpriority="high"
      loading="eager"
      decoding="async"
      width="1696"
      height="960"
    />

    {/* Le bloc de texte occupe la MOITIÉ GAUCHE et s'y centre, au lieu d'être
        collé au bord. C'est ce qui fait la différence avec une bannière de
        gabarit : le regard tombe sur un bloc composé, pas sur un titre aligné
        à gauche par défaut. La moitié droite reste vide de texte, le mannequin
        y est. */}
    <div class="hero-shell relative max-w-7xl mx-auto px-6 w-full">
      <div class="hero-copy">
        {/* Capitales fines très espacées : elles se regardent avant de se
            lire, comme une signature de marque. Elles remplacent la pastille
            jaune, qui appartenait au vocabulaire du gabarit et non à celui
            d'une boutique de coques. */}
        <span class="hero-eyebrow">{T.eyebrow}</span>

        {/* Le titre, en deux lignes de capitales très grasses : la première
            pleine, la seconde CREUSE, dessinée par son seul contour. C'est ce
            contraste qui fait la signature de la référence. La police est
            chargée pour ce seul titre (voir global.css), le reste du site
            garde la sienne. */}
        <h1 class="hero-title">
          {T.title1}
          <span class="creux">{T.title2}</span>
        </h1>

        {/* Le trait tracé à main levée sous la seconde ligne. Décoratif, donc
            invisible aux lecteurs d'écran. */}
        <span class="hero-trait" aria-hidden="true">
          <svg viewBox="0 0 160 16" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M3 11.2c22-5.4 54-8 84-7.4 21 .4 42 2.6 70 7.4" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/>
            <path d="M22 14.6c25-3.4 52-4.6 78-4.2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" opacity=".85"/>
          </svg>
        </span>

        {/* Deux CTA, deux destinations RÉELLEMENT différentes : acheter une
            coque existante, ou créer la sienne dans le studio. Ils restent
            côte à côte à toutes les largeurs (cf. .hero-cta dans global.css). */}
        <div class="hero-cta flex items-center justify-center gap-3 sm:gap-4">
          <a href={url('/boutique')} class="btn-primary inline-flex items-center gap-2">
            {T.seeCollection}
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
          </a>
          <a href={url('/personnaliser')} class="btn-outline">{T.createCase}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════ PRODUITS EN VEDETTES ═══════════════════════════ -->
  {featuredProducts.length > 0 && (
    <section class="relative py-20 md:py-24 px-6 border-t border-white/[0.04] overflow-hidden">
      <!-- Accent décoratif subtil -->
      <div class="absolute top-0 right-0 w-[600px] h-[300px] bg-white/[0.025] blur-[120px] rounded-[100%] pointer-events-none"></div>
      <div class="relative max-w-7xl mx-auto">
        <div class="flex items-end justify-between mb-10 gap-6">
          <div>
            <span class="text-[10px] text-n-500 font-medium uppercase tracking-widest mb-2 block">{T.selection}</span>
            <h2 class="text-2xl md:text-3xl font-medium tracking-tight text-cream">{T.featured}</h2>
          </div>
          <a href={url('/boutique')} class="hidden md:inline-flex items-center gap-1 text-sm text-n-400 hover:text-cream transition-colors whitespace-nowrap">
            {T.viewAll}
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
          </a>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 md:gap-6">
          {featuredProducts.map(product => (
            <a href={product.href} class="group block">
              <div class="relative aspect-[4/5] rounded-2xl overflow-hidden bg-panel border border-white/[0.05] mb-3">
                <img
                  src={product.data.image}
                  srcset={unsplashSrcset(product.data.image)}
                  sizes="(max-width: 768px) 50vw, (max-width: 1024px) 33vw, 25vw"
                  alt={product.data.imageAlt ?? product.data.name}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  width="800" height="1000" loading="lazy" decoding="async"
                />
                {product.data.compareAtPrice && (
                  <span class="absolute top-3 left-3 bg-accent text-dark text-[10px] font-medium px-2 py-1 rounded-sm uppercase tracking-wider">
                    -{Math.round((1 - product.data.price / product.data.compareAtPrice) * 100)}%
                  </span>
                )}
              </div>
              <h3 class="text-sm font-medium text-cream tracking-tight leading-snug line-clamp-2 mb-1 group-hover:underline underline-offset-4">
                {product.data.name}
              </h3>
              <div class="flex items-baseline gap-2 text-xs">
                <span class="price-amount text-cream font-medium">{displayPrice(product.data)}</span>
                {product.data.compareAtPrice && (
                  <span class="text-n-500 line-through font-light">{formatPrice(product.data.compareAtPrice)}</span>
                )}
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ═══════════════════════════ PERSONNALISATION ═══════════════════════════ -->
  {/* Le texte est posé SUR l'image : celle-ci offre un grand plan de travail
      blanc et uni en bas à gauche, où le bloc s'installe sans rien masquer
      d'utile. Réduit au titre et au bouton : l'intertitre et le sous-titre
      faisaient doublon et ne tenaient pas la lisibilité à cette taille. */}
  {/* L'ange s'accroche au bord HAUT de la section : la ligne de coupe de
      l'image tombe pile dessus, et seules ses mains passent devant. Il est
      posé en FRÈRE de la section, jamais dedans : `overflow: hidden` y est
      indispensable pour que la photo suive les coins arrondis, et il
      rognerait net tout ce qui dépasse. Le rail ne mesure rien, il sert
      seulement de repère de position. */}
  {/* Une seule et même scène pour l'ange ET la section. C'est ce qui rend
      l'inclinaison possible sans décrocher l'ange : ils subissent la même
      transformation, donc leur alignement ne dépend d'aucun réglage, il est
      vrai par construction, à n'importe quel angle. L'ange reste hors de la
      section, qui le rognerait. */}
  <div class="studio-scene">
  <div class="studio-ange-rail" aria-hidden="true">
    <img
      src={siteConfig.shop.angeStudio}
      alt=""
      class="studio-ange"
      width="480"
      height="242"
      loading="lazy"
      decoding="async"
    />
  </div>
  <section class="studio-b relative overflow-hidden below-fold-defer flex items-end">
    <img
      src="/images/studio-banner-b.webp"
      srcset="/images/studio-banner-b-800w.webp 800w, /images/studio-banner-b-1280w.webp 1280w, /images/studio-banner-b.webp 1696w"
      sizes="100vw"
      alt={T.studioAlt}
      width="1696"
      height="960"
      loading="lazy"
      decoding="async"
      class="studio-b-bg"
    />
    {/* Toute la section mène au studio, pas seulement le bouton : un clic ou
        un doigt n'importe où sur l'image ouvre la même page. Ce lien couvre
        la surface entière, mais il est retiré de l'arbre d'accessibilité et
        du parcours clavier : sinon la même destination serait annoncée deux
        fois et le clavier s'arrêterait sur une zone vide. Le bouton reste le
        seul lien réel, et il passe au-dessus de celui-ci. */}
    <a href={url('/personnaliser')} class="studio-b-lien" aria-hidden="true" tabindex="-1"></a>
    <div class="studio-b-copy relative w-full max-w-7xl mx-auto px-6 pt-8 pb-3 md:pt-10 md:pb-6">
      <h2 class="text-2xl md:text-3xl lg:text-4xl font-medium tracking-tight mb-5 leading-[1.15]">
        {T.studioTitle}
      </h2>
      <a href={url('/personnaliser')} class="btn-primary inline-flex items-center gap-2">
        {T.createCase}
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
      </a>
    </div>
  </section>
  </div>

  <!-- ═══════════════════════════ CATÉGORIES PRODUITS (sliders) ═══════════════════════════ -->
  {/* Une rangée par catégorie. Tant qu'il n'y en a qu'UNE, elle réaffiche
      exactement les produits déjà montrés en vedette : on ne l'affiche donc
      qu'à partir de deux catégories. Le jour où le catalogue s'étoffe, les
      rangées reviennent seules. */}
  {categoryRows.length > 1 && categoryRows.map((row, idx) => {
    const bgClass = idx % 3 === 0 ? '' : idx % 3 === 1 ? 'bg-panel' : 'bg-teal';
    return (
    <section class={`relative py-16 md:py-20 border-t border-white/[0.04] overflow-hidden below-fold-defer ${bgClass}`}>
      <!-- Glows thématiques (desktop : larges et visibles / mobile : réduits via CSS) -->
      <div class="slider-glow slider-glow-1" style={`background: ${row.glow1}`}></div>
      <div class="slider-glow slider-glow-2" style={`background: ${row.glow2}`}></div>

      <div class="relative max-w-7xl mx-auto px-6">
        <div class="flex items-end justify-between mb-6 md:mb-8 gap-4">
          <div>
            <span class="text-[10px] text-n-500 font-medium uppercase tracking-widest mb-2 block">{T.collection}</span>
            <h2 class="text-xl md:text-2xl font-medium tracking-tight text-cream">{row.label}</h2>
          </div>
          <a href={url(`/product-category/${row.slug}`)} class="inline-flex items-center gap-1.5 text-xs md:text-sm text-n-400 hover:text-cream transition-colors whitespace-nowrap">
            {T.viewAll} ({row.products.length})
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
          </a>
        </div>
      </div>

      <!-- Slider full-width : track s'étend jusqu'au bord de l'écran, cards coupées à l'edge -->
      <div class="product-slider relative" data-slider>
        <div class="slider-track flex gap-3 md:gap-4 lg:gap-5 overflow-x-auto snap-x snap-mandatory scroll-smooth pb-2 pl-6 md:pl-[max(1.5rem,calc((100vw-80rem)/2+1.5rem))] pr-6 scroll-pl-6 md:scroll-pl-[max(1.5rem,calc((100vw-80rem)/2+1.5rem))]">
          {row.products.map(p => (
            <a
              href={p.href}
              class="slider-card group flex-none w-[72vw] sm:w-[45vw] md:w-[30vw] lg:w-[22vw] xl:w-[310px] snap-start block"
            >
              <div class="relative aspect-[4/5] rounded-2xl overflow-hidden bg-panel border border-white/[0.05] mb-3">
                <img
                  src={p.data.image}
                  srcset={unsplashSrcset(p.data.image)}
                  sizes="(max-width: 640px) 72vw, (max-width: 768px) 45vw, (max-width: 1024px) 32vw, 300px"
                  alt={p.data.imageAlt ?? p.data.name}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  width="800" height="1000" loading="lazy" decoding="async"
                />
                {p.data.compareAtPrice && (
                  <span class="absolute top-3 left-3 bg-accent text-dark text-[10px] font-medium px-2 py-1 rounded-sm uppercase tracking-wider">
                    -{Math.round((1 - p.data.price / p.data.compareAtPrice) * 100)}%
                  </span>
                )}
              </div>
              <h3 class="text-sm font-medium text-cream tracking-tight leading-snug line-clamp-2 mb-1 group-hover:underline underline-offset-4">
                {p.data.name}
              </h3>
              <div class="flex items-baseline gap-2 text-xs">
                <span class="price-amount text-cream font-medium">{displayPrice(p.data)}</span>
                {p.data.compareAtPrice && (
                  <span class="text-n-500 line-through font-light">{formatPrice(p.data.compareAtPrice)}</span>
                )}
              </div>
            </a>
          ))}
          <!-- Spacer final pour que la dernière card respire -->
          <div class="flex-none w-2" aria-hidden="true"></div>
        </div>

        <!-- Boutons flèches (desktop) : wrapper limité à max-w-7xl pour qu'ils s'alignent au contenu -->
        <div class="pointer-events-none absolute inset-0 max-w-7xl mx-auto hidden md:block px-6">
          <button
            type="button"
            data-scroll="prev"
            class="pointer-events-auto absolute left-2 top-[38%] -translate-y-1/2 w-10 h-10 rounded-full bg-dark/90 border border-white/[0.15] backdrop-blur flex items-center justify-center text-cream hover:bg-dark hover:border-white/30 disabled:opacity-0 disabled:pointer-events-none transition-all shadow-lg"
            aria-label={T.prevProducts}
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="15 18 9 12 15 6"/></svg>
          </button>
          <button
            type="button"
            data-scroll="next"
            class="pointer-events-auto absolute right-2 top-[38%] -translate-y-1/2 w-10 h-10 rounded-full bg-dark/90 border border-white/[0.15] backdrop-blur flex items-center justify-center text-cream hover:bg-dark hover:border-white/30 disabled:opacity-0 disabled:pointer-events-none transition-all shadow-lg"
            aria-label={T.nextProducts}
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="9 18 15 12 9 6"/></svg>
          </button>
        </div>

        <!-- Indicateur mobile : petit texte "← swipe →" sous la 1ère section -->
        {idx === 0 && (
          <div class="md:hidden px-6 mt-2 text-center">
            <span class="inline-flex items-center gap-2 text-[10px] text-n-500 font-light uppercase tracking-widest">
              <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
              {T.swipe}
              <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
            </span>
          </div>
        )}
      </div>
    </section>
    );
  })}

  <style>
    /* ─── HERO : structure plate pour LCP détectable ───────────────────
       L'image est un <img> direct de la section.
       Le voile sombre est un ::after en CSS (pas un div overlay dans le DOM
       → Lighthouse voit l'image comme non couverte). */
    .hero-section { isolation: isolate; }
    /* Image hero : absolute fill de la section, z-index 0 */
    .hero-img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      z-index: 0;
    }

    /* ─── content-visibility: auto pour sections below-fold ───────
       Skip layout/paint des sections hors viewport au load → LCP
       committé plus rapidement par Lighthouse. contain-intrinsic-size
       réserve l'espace pour éviter les sauts de scroll. */
    .below-fold-defer {
      content-visibility: auto;
      contain-intrinsic-size: auto 800px;
    }
    /* Plus aucun voile devant la photo. Celui-ci, blanc à 88 %, délavait tout
       le côté gauche du ciel : il avait été posé pour rendre lisible un texte
       en ENCRE SOMBRE. Le texte est blanc, et les références gardent le
       cliché intact, c'est ce qui fait leur qualité.
       Le contenu reste au-dessus de l'image, qui est en position absolue. */
    .hero-shell {
      z-index: 2;
    }

    /* Scrollbar masquée mais scroll/swipe actif */
    .product-slider .slider-track {
      scrollbar-width: none;
      -ms-overflow-style: none;
    }
    .product-slider .slider-track::-webkit-scrollbar {
      display: none;
    }

    /* ─── Glows thématiques par catégorie ─────────────────────────────
       Desktop : larges halos bien visibles
       Mobile : réduits en taille + intensité (positions ajustées pour rester
       en arrière-plan sans saturer l'écran étroit) */
    .slider-glow {
      position: absolute;
      border-radius: 100%;
      pointer-events: none;
      filter: blur(120px);
    }
    .slider-glow-1 {
      top: -5rem;
      left: -5rem;
      width: 700px;
      height: 500px;
    }
    .slider-glow-2 {
      bottom: -5rem;
      right: -5rem;
      width: 600px;
      height: 400px;
      filter: blur(110px);
    }
    @media (max-width: 767px) {
      .slider-glow-1 {
        width: 340px;
        height: 220px;
        top: -4rem;
        left: -6rem;
        opacity: 0.55;
        filter: blur(80px);
      }
      .slider-glow-2 {
        width: 300px;
        height: 200px;
        bottom: -4rem;
        right: -6rem;
        opacity: 0.55;
        filter: blur(80px);
      }
    }
  </style>

  <script is:inline>
    /* Effet de carte sur la section studio : la scène entière s'incline vers
       la souris, ange compris, et la photo glisse un peu à l'intérieur.

       Rien ne se met en place sur un écran tactile ni pour qui demande moins
       d'animations : la requête média est interrogée AVANT de poser le
       moindre écouteur, plutôt que de laisser le CSS neutraliser un effet
       déjà calculé.

       Les coordonnées du curseur sont mises de côté telles quelles, et tout
       le calcul a lieu dans la frame suivante : la souris émet bien plus
       d'événements qu'il n'y a d'images à l'écran, et lire la position de la
       section oblige le navigateur à recalculer sa mise en page. Une fois
       par image, pas une fois par mouvement. */
    (function () {
      var section = document.querySelector('.studio-scene');
      if (!section) return;
      if (!window.matchMedia('(hover: hover) and (pointer: fine)').matches) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      var px = 0, py = 0, prevu = false;
      var peindre = function () {
        prevu = false;
        var r = section.getBoundingClientRect();
        if (!r.width || !r.height) return;
        var mx = ((px - r.left) / r.width - 0.5) * 2;
        var my = ((py - r.top) / r.height - 0.5) * 2;
        section.style.setProperty('--mx', Math.max(-1, Math.min(1, mx)).toFixed(3));
        section.style.setProperty('--my', Math.max(-1, Math.min(1, my)).toFixed(3));
      };
      var programmer = function () {
        if (prevu) return;
        prevu = true;
        requestAnimationFrame(peindre);
      };
      section.addEventListener('pointermove', function (e) {
        px = e.clientX; py = e.clientY;
        programmer();
      }, { passive: true });
      section.addEventListener('pointerenter', function (e) {
        px = e.clientX; py = e.clientY;
        section.setAttribute('data-survol', '');
        programmer();
      });
      section.addEventListener('pointerleave', function () {
        section.removeAttribute('data-survol');
        section.style.setProperty('--mx', '0');
        section.style.setProperty('--my', '0');
      });
    })();

    // Contrôle des boutons flèches des sliders produits (desktop).
    // Différé via requestIdleCallback pour libérer le main thread au load
    // (laisse Lighthouse committer le LCP avant parse/exec de ce JS).
    (function() {
      function initSliders() {
        document.querySelectorAll('[data-slider]').forEach(slider => {
          const track = slider.querySelector('.slider-track');
          const prev = slider.querySelector('[data-scroll="prev"]');
          const next = slider.querySelector('[data-scroll="next"]');
          if (!track) return;

          function scrollBy(dir) {
            const card = track.querySelector('.slider-card');
            if (!card) return;
            const cardWidth = card.getBoundingClientRect().width + 20;
            track.scrollBy({ left: cardWidth * 2 * dir, behavior: 'smooth' });
          }
          prev?.addEventListener('click', () => scrollBy(-1));
          next?.addEventListener('click', () => scrollBy(1));

          function update() {
            if (!prev || !next) return;
            prev.disabled = track.scrollLeft <= 1;
            next.disabled = track.scrollLeft >= track.scrollWidth - track.clientWidth - 1;
          }
          track.addEventListener('scroll', update, { passive: true });
          window.addEventListener('resize', update);
          requestAnimationFrame(update);
        });
      }
      if ('requestIdleCallback' in window) {
        requestIdleCallback(initSliders, { timeout: 2000 });
      } else {
        setTimeout(initSliders, 0);
      }
    })();
  </script>

  <!-- ═══════════════════════════ INSTAGRAM ═══════════════════════════ -->
  {/* Même composant que le bas des fiches produit. Placé APRÈS la
      personnalisation et avant la FAQ : il montre le produit porté, ce qui
      prolonge l'envie née de la section studio, puis la FAQ vient lever les
      dernières objections. */}
  {/* Section Instagram masquée le temps que le compte @bymoroji se
      remplisse : remettre <InstaGrid /> ici (et son import). */}

  <!-- ═══════════════════════════ FAQ ═══════════════════════════ -->
  <section class="py-20 md:py-24 px-6 border-t border-white/[0.04] bg-panel below-fold-defer">
    <div class="max-w-3xl mx-auto">
      <div class="text-center mb-12">
        <span class="text-[10px] text-n-500 font-medium uppercase tracking-widest mb-3 block">FAQ</span>
        <h2 class="text-2xl md:text-3xl font-medium tracking-tight text-cream">
          {T.faqTitle}
        </h2>
      </div>
      <div class="space-y-3">
        {faqs.map(f => (
          <details class="group rounded-2xl border border-white/[0.08] bg-dark open:border-white/20 transition-colors">
            <summary class="flex items-start justify-between gap-4 px-6 py-5 cursor-pointer list-none font-medium text-base text-cream tracking-tight">
              <span class="flex-1" set:html={inlineMd(f.q)} />
              <span class="text-n-400 text-xl leading-none transition-transform group-open:rotate-45 shrink-0">+</span>
            </summary>
            <p class="px-6 pb-5 pt-1 font-light text-sm text-n-400 leading-relaxed [&_strong]:text-cream [&_strong]:font-medium [&_a]:text-cream [&_a]:underline [&_a]:underline-offset-4" set:html={inlineMd(f.a)} />
          </details>
        ))}
      </div>
    </div>
  </section>

</BaseLayout>
