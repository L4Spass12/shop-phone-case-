---
// Page « coques par modèle » (/coques/) : un lien vers chaque page modèle,
// illustré par une coque photographiée sur ce modèle.
import BaseLayout from '../layouts/BaseLayout.astro';
import siteConfig from '../../site.config.mjs';
import { localePrefix, type Locale } from '../lib/i18n';
import { localizedProducts } from '../lib/products';
import { PHONE_MODELS, MODEL_TEXT, modelPhoto } from '../lib/models';

interface Props { lang: Locale }
const { lang } = Astro.props;
const T = MODEL_TEXT[lang];
const lp = localePrefix(lang);
const url = (p: string) => `${lp}${p}`;

const products = (await localizedProducts(lang))
  .filter((p) => (p.data.categories ?? []).length > 0)
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0) || b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
// Une coque différente par modèle, pour varier la page.
const cards = PHONE_MODELS.map((m, i) => {
  const p = products.slice(i).concat(products).find((x) => modelPhoto(x.slug, m.id));
  return { m, photo: p ? modelPhoto(p.slug, m.id) : null };
});
const groups = [
  { title: 'iPhone', items: cards.filter((c) => c.m.brand === 'apple') },
  { title: 'Samsung Galaxy', items: cards.filter((c) => c.m.brand === 'samsung') },
];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: T.home, item: `${siteConfig.url}${url('/')}` },
    { '@type': 'ListItem', position: 2, name: T.hub, item: `${siteConfig.url}${url('/coques/')}` },
  ],
};
---

<BaseLayout title={`${T.hubTitle} | ${siteConfig.name}`} description={T.hubDescription} jsonLd={jsonLd}>
  <div class="crumbs-shell max-w-7xl mx-auto px-6 pt-6 md:pt-8 pb-16 md:pb-20">
    <nav class="site-breadcrumb flex items-center gap-2 text-xs text-n-500 mb-4 font-light" aria-label="breadcrumb">
      <a href={url('/')} class="hover:text-cream transition-colors">{T.home}</a>
      <span>/</span>
      <span class="text-n-400">{T.hub}</span>
    </nav>
    <header class="mb-10 max-w-3xl">
      <h1 class="text-4xl md:text-5xl font-medium tracking-tight text-cream leading-[1.1] mb-5">{T.hubH1}</h1>
      <p class="text-base md:text-lg text-n-400 font-light leading-relaxed">{T.hubIntro}</p>
    </header>
    {groups.map((g) => (
      <section class="mb-14">
        <h2 class="text-xl md:text-2xl font-medium tracking-tight text-cream mb-6">{g.title}</h2>
        <ul class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-4">
          {g.items.map(({ m, photo }) => (
            <li>
              <a href={url(`/coques/${m.id}/`)} class="group block">
                <div class="aspect-[4/5] rounded-2xl overflow-hidden bg-panel border border-white/[0.05] mb-3">
                  {photo && (
                    <img src={photo.replace(/\.webp$/, '-500w.webp')} alt={T.h1(m)} width="500" height="750" loading="lazy" decoding="async"
                      class="w-full h-full object-contain group-hover:scale-105 transition-all duration-500" />
                  )}
                </div>
                <span class="text-sm font-medium text-cream group-hover:underline underline-offset-4">{m.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</BaseLayout>
