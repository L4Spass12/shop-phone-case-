---
// Section "Pourquoi nous choisir" - bloc de réassurance réutilisable sur toutes les fiches produit.
// Copy générique (qualité, expédition, paiement, support) : personnalisez les clés i18n fabrication.*.
// Locale-aware : détecte la langue depuis l'URL et bascule les strings via t().
import { t, localeFromPath } from '../lib/i18n';

interface Props {
  /** Points clés affichés à droite. Si non fourni, valeurs i18n par défaut. */
  bullets?: string[];
  /** Surtitre affiché au-dessus du H2. */
  eyebrow?: string;
  /** Titre principal. */
  title?: string;
}

const lang = localeFromPath(Astro.url.pathname);

const {
  eyebrow = t('fabrication.eyebrow', lang),
  title = t('fabrication.title', lang),
  bullets = [
    t('fabrication.bullet1', lang),
    t('fabrication.bullet2', lang),
    t('fabrication.bullet3', lang),
  ],
} = Astro.props;
---

<section class="relative py-20 md:py-28 px-6 border-t border-white/[0.04] overflow-hidden bg-gradient-to-br from-teal via-panel to-dark">
  <!-- Grille subtile bleutée en arrière-plan (effet tech/industriel) -->
  <div
    class="absolute inset-0 opacity-[0.08] pointer-events-none"
    style="background-image: linear-gradient(rgba(80,120,255,0.2) 1px, transparent 1px), linear-gradient(90deg, rgba(80,120,255,0.2) 1px, transparent 1px); background-size: 48px 48px;"
  ></div>
  <!-- Glow bleu pour souligner l'ambiance atelier -->
  <div class="absolute top-1/2 right-10 -translate-y-1/2 w-[500px] h-[400px] bg-white/[0.06] blur-[140px] rounded-full pointer-events-none"></div>

  <div class="relative max-w-6xl mx-auto grid md:grid-cols-2 gap-10 md:gap-14 items-center">
    <!-- Image machine -->
    <div class="relative">
      <div class="relative rounded-2xl overflow-hidden border border-white/[0.06] bg-dark aspect-[4/3]">
        <img
          src="/images/placeholder.webp"
          srcset="/images/placeholder-400w.webp 400w, /images/placeholder-800w.webp 800w, /images/placeholder.webp 1200w"
          sizes="(max-width: 768px) 100vw, 500px"
          alt={t('fabrication.imageAlt', lang)}
          class="w-full h-full object-cover"
          width="1536"
          height="1024"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>

    <!-- Contenu -->
    <div>
      <span class="text-[10px] text-n-500 font-medium uppercase tracking-widest mb-3 block">
        {eyebrow}
      </span>
      <h2 class="text-2xl md:text-3xl lg:text-4xl font-medium tracking-tight text-cream mb-8 leading-[1.15]">
        {title}
      </h2>
      <ul class="space-y-4">
        {bullets.map(b => (
          <li class="flex items-center gap-3">
            <span class="w-6 h-6 rounded-full bg-white/[0.04] border border-white/[0.12] flex items-center justify-center text-cream shrink-0">
              <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
            </span>
            <span class="text-sm md:text-base text-n-300 font-light">{b}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
