---
// Section "Pourquoi nous choisir" - bloc de réassurance réutilisable sur toutes les fiches produit.
// Copy générique (qualité, expédition, paiement, support) : personnalisez les clés i18n fabrication.*.
// Locale-aware : détecte la langue depuis l'URL et bascule les strings via t().
import { t, localeFromPath } from '../lib/i18n';

interface Props {
  /** Points clés affichés à droite. Si non fourni, valeurs i18n par défaut. */
  bullets?: string[];
  /** Surtitre affiché au-dessus du H2. */
  eyebrow?: string;
  /** Titre principal. */
  title?: string;
}

const lang = localeFromPath(Astro.url.pathname);

const {
  eyebrow = t('fabrication.eyebrow', lang),
  title = t('fabrication.title', lang),
  bullets = [
    t('fabrication.bullet1', lang),
    t('fabrication.bullet2', lang),
    t('fabrication.bullet3', lang),
  ],
} = Astro.props;
---

<section class="relative py-20 md:py-28 px-6 border-t border-white/[0.04] overflow-hidden bg-gradient-to-br from-teal via-panel to-dark">
  <!-- Grille subtile bleutée en arrière-plan (effet tech/industriel) -->
  <div
    class="absolute inset-0 opacity-[0.08] pointer-events-none"
    style="background-image: linear-gradient(rgba(80,120,255,0.2) 1px, transparent 1px), linear-gradient(90deg, rgba(80,120,255,0.2) 1px, transparent 1px); background-size: 48px 48px;"
  ></div>
  <!-- Glow bleu pour souligner l'ambiance atelier -->
  <div class="absolute top-1/2 right-10 -translate-y-1/2 w-[500px] h-[400px] bg-white/[0.06] blur-[140px] rounded-full pointer-events-none"></div>

  <div class="relative max-w-6xl mx-auto grid md:grid-cols-2 gap-10 md:gap-14 items-center">
    <!-- Image machine -->
    <div class="relative">
      {/* Vidéo de l'atelier, chargée seulement quand la section approche de
          l'écran : preload="none" et aucune source tant qu'elle est loin, donc
          rien ne pèse sur le chargement de la fiche. Muette, en boucle, lue
          en ligne (iPhone). Sans mouvement réduit demandé, sinon l'affiche
          reste seule. WebM (VP9, ~470 Ko) d'abord, MP4 (H.264) en repli. */}
      <div class="relative rounded-2xl overflow-hidden border border-white/[0.06] bg-dark aspect-video">
        <video
          class="fab-video w-full h-full object-cover"
          poster="/images/atelier-impression-poster.webp"
          muted
          loop
          playsinline
          preload="none"
          width="1280"
          height="720"
          aria-label={t('fabrication.imageAlt', lang)}
        >
          <source data-src="/videos/atelier-impression.webm?v=2" type="video/webm" />
          <source data-src="/videos/atelier-impression.mp4?v=2" type="video/mp4" />
        </video>
      </div>
    </div>

    <!-- Contenu -->
    <div>
      <span class="text-[10px] text-n-500 font-medium uppercase tracking-widest mb-3 block">
        {eyebrow}
      </span>
      <h2 class="text-2xl md:text-3xl lg:text-4xl font-medium tracking-tight text-cream mb-8 leading-[1.15]">
        {title}
      </h2>
      <ul class="space-y-4">
        {bullets.map(b => (
          <li class="flex items-center gap-3">
            <span class="w-6 h-6 rounded-full bg-white/[0.04] border border-white/[0.12] flex items-center justify-center text-cream shrink-0">
              <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
            </span>
            <span class="text-sm md:text-base text-n-300 font-light">{b}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<script>
  const videos = document.querySelectorAll<HTMLVideoElement>('.fab-video');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (videos.length && !reduce && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        const v = e.target as HTMLVideoElement;
        if (e.isIntersecting) {
          if (!v.dataset.loaded) {
            v.querySelectorAll<HTMLSourceElement>('source[data-src]').forEach((s) => { s.src = s.dataset.src!; });
            v.load();
            v.dataset.loaded = '1';
            // Premier chargement : relance dès que la vidéo est prête, un
            // play() lancé pendant le chargement peut être ignoré.
            v.addEventListener('canplay', () => { v.muted = true; v.play().catch(() => {}); }, { once: true });
          }
          // Muette aussi par la propriété : certains navigateurs ne lisent
          // l'attribut `muted` qu'au rendu et refusent alors la lecture auto.
          v.muted = true;
          v.play().catch(() => {});
        } else {
          v.pause();
        }
      }
    }, { rootMargin: '200px 0px' });
    videos.forEach((v) => io.observe(v));
  }
</script>
