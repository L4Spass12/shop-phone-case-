---
/**
 * Vidéo d'ambiance de la bannière d'accueil, posée sur la photo de la
 * bannière (paysage sur ordinateur, verticale aux proportions exactes de la
 * bannière sur mobile : 1080 × 1512, rien à recadrer pour le téléphone).
 *
 * - Une vraie <video>, partout : décodée par la puce graphique, donc fluide
 *   et nette, en boucle.
 * - `autoplay muted playsinline` dans le HTML : seule combinaison lancée sans
 *   geste par tous les navigateurs, Safari iPhone compris. La vidéo est
 *   visible dès le départ (Safari ne lance pas une vidéo qu'il juge cachée) ;
 *   tant que la première image n'est pas prête, on voit la photo dessous.
 * - Sources choisies par le navigateur (attribut `media`) : MP4 H.264 en
 *   premier sur mobile (Safari iPhone), WebM d'abord sur ordinateur.
 * - Secours iPhone / iPad : si iOS refuse la lecture automatique (mode
 *   économie d'énergie), le même MP4 est affiché dans une <img>, que Safari
 *   anime sans condition. Moins fluide qu'une vidéo, donc réservé à ce cas.
 * - Moins d'animations demandé ou économie de données : pas de vidéo.
 *
 * Retour à la photo seule : tag git `banniere-image-avant-video`.
 */
---
<video
  class="hero-video"
  autoplay
  muted
  loop
  playsinline
  disablepictureinpicture
  disableremoteplayback
  preload="auto"
  aria-hidden="true"
  tabindex="-1"
  data-poster-mobile="/videos/hero-mobile-v3-poster-750w.webp"
  data-poster-desktop="/videos/hero-relief-poster.webp"
  data-mp4-mobile="/videos/hero-mobile-v3.mp4"
  data-mp4-desktop="/videos/hero-relief-v2.mp4"
>
  <source src="/videos/hero-mobile-v3.mp4" type="video/mp4" media="(max-width: 767px)" />
  <source src="/videos/hero-mobile-v3.webm" type="video/webm" media="(max-width: 767px)" />
  <source src="/videos/hero-relief-v2.webm" type="video/webm" media="(min-width: 768px)" />
  <source src="/videos/hero-relief-v2.mp4" type="video/mp4" media="(min-width: 768px)" />
</video>
<script is:inline>
  (function () {
    var v = document.currentScript && document.currentScript.previousElementSibling;
    if (!v || v.tagName !== 'VIDEO') return;
    var mq = window.matchMedia;

    if (mq('(prefers-reduced-motion: reduce)').matches || (navigator.connection && navigator.connection.saveData)) {
      v.removeAttribute('autoplay');
      v.pause();
      v.remove();
      return;
    }

    var mobile = mq('(max-width: 767px)').matches;
    var ios = /iP(hone|ad|od)/.test(navigator.userAgent) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
    v.poster = mobile ? v.dataset.posterMobile : v.dataset.posterDesktop;
    v.muted = true;
    v.defaultMuted = true;

    var secours = function () {
      if (!v.isConnected || !v.paused) return;
      if (!ios) return; // ailleurs : la vidéo démarrera au premier geste
      var img = document.createElement('img');
      img.className = v.className;
      img.alt = '';
      img.setAttribute('aria-hidden', 'true');
      img.src = mobile ? v.dataset.mp4Mobile : v.dataset.mp4Desktop;
      v.replaceWith(img);
    };

    var jouer = function () {
      if (!v.paused) return;
      var p = v.play();
      if (p && p.catch) p.catch(function (e) { if (e && e.name === 'NotAllowedError') secours(); });
    };
    jouer();
    v.addEventListener('canplay', jouer, { once: true });
    // Filet : toujours à l'arrêt 2,5 s après le chargement de la page.
    window.addEventListener('load', function () { setTimeout(secours, 2500); }, { once: true });

    // Navigateurs hors iOS qui exigent un geste : on relance au premier.
    var gestes = ['touchstart', 'pointerdown', 'scroll', 'keydown'];
    var relance = function () {
      jouer();
      gestes.forEach(function (e) { window.removeEventListener(e, relance); });
    };
    gestes.forEach(function (e) { window.addEventListener(e, relance, { passive: true }); });

    // Retour sur l'onglet : Safari met en pause les vidéos en arrière-plan.
    document.addEventListener('visibilitychange', function () {
      if (document.visibilityState === 'visible') jouer();
    });
  })();
</script>
