---
/**
 * Date de livraison estimée sur les fiches produit (France métropolitaine).
 *
 * Calculée DANS LE NAVIGATEUR, le jour de la visite : le site est statique,
 * une date calculée au build restait figée jusqu'à la mise en ligne suivante
 * et devenait fausse. Sans JavaScript, la phrase générique reste affichée.
 *
 * Délai en jours OUVRÉS (week-ends sautés) : commande préparée sous 24 à
 * 48 h (souvent le jour même) puis Lettre suivie La Poste à domicile en 3
 * jours ouvrés, soit 3 à 5 jours ouvrés au total (le point relais compte 4 à
 * 7 jours). Week-ends et jours fériés fixes sautés.
 */
import { t, type Locale } from '../lib/i18n';

interface Props {
  lang?: Locale;
  min?: number;
  max?: number;
}
const { lang = 'fr', min = 3, max = 5 } = Astro.props;

const generique = {
  fr: `en ${min} à ${max} jours ouvrés`,
  en: `within ${min} to ${max} business days`,
  de: `innerhalb von ${min} bis ${max} Werktagen`,
}[lang] ?? `en ${min} à ${max} jours ouvrés`;
---

<span data-delivery-window data-min={min} data-max={max} data-lang={lang}>{
  t('shop.deliveryWindow', lang, { window: generique })
}</span>

<script>
  // Jours fériés fixes (mois-jour) : La Poste ne distribue pas.
  const FERIES = new Set(['1-1', '5-1', '5-8', '7-14', '8-15', '11-1', '11-11', '12-25']);
  function ajouterJoursOuvres(depart: Date, n: number) {
    const d = new Date(depart);
    let restants = n;
    while (restants > 0) {
      d.setDate(d.getDate() + 1);
      const jour = d.getDay();
      if (jour !== 0 && jour !== 6 && !FERIES.has(`${d.getMonth() + 1}-${d.getDate()}`)) restants--;
    }
    return d;
  }

  const MODELES: Record<string, (a: string, b: string) => string> = {
    fr: (a, b) => `Vous recevez votre colis entre le ${a} et le ${b}.`,
    en: (a, b) => `You'll receive your order between ${a} and ${b}.`,
    de: (a, b) => `Du erhältst deine Bestellung zwischen dem ${a} und dem ${b}.`,
  };
  const LOCALES: Record<string, string> = { fr: 'fr-FR', en: 'en-GB', de: 'de-DE' };

  document.querySelectorAll<HTMLElement>('[data-delivery-window]').forEach((el) => {
    const lang = el.dataset.lang || 'fr';
    const min = Number(el.dataset.min) || 3;
    const max = Number(el.dataset.max) || 5;
    const auj = new Date();
    const fmt = new Intl.DateTimeFormat(LOCALES[lang] || 'fr-FR', { weekday: 'long', day: 'numeric', month: 'long' });
    const modele = MODELES[lang] || MODELES.fr;
    el.textContent = modele(fmt.format(ajouterJoursOuvres(auj, min)), fmt.format(ajouterJoursOuvres(auj, max)));
  });
</script>
