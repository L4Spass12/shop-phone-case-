    var panelAnimTimer = null;
    function animatePanel() {
      panel.classList.add('panel--anim');
      if (panelAnimTimer) clearTimeout(panelAnimTimer);
      panelAnimTimer = setTimeout(function () { panel.classList.remove('panel--anim'); panelAnimTimer = null; }, 500);
    }
    function closePane() {
      activePane = null;
      root.querySelectorAll('.rbtn').forEach(function (b) { b.setAttribute('aria-pressed', 'false'); });
      moveRailInd(true);
      animatePanel();
      panel.classList.remove('panel--open');
      builderEl.classList.remove('builder--help');
