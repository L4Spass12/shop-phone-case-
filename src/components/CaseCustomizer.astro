    });
    ['dragenter', 'dragover'].forEach(function (ev) { caseEl.addEventListener(ev, function (e) { e.preventDefault(); caseEl.setAttribute('data-over', ''); }); });
    ['dragleave', 'drop'].forEach(function (ev) { caseEl.addEventListener(ev, function (e) { e.preventDefault(); caseEl.removeAttribute('data-over'); }); });
