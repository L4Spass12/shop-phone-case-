    root.querySelectorAll('.rbtn').forEach(function (b) {
      b.addEventListener('click', function () { activePane === b.dataset.panel ? closePane() : openPane(b.dataset.panel); });
    });
    panel.querySelectorAll('[data-panelclose]').forEach(function (b) { b.addEventListener('click', closePane); });

    /* ── Clavier mobile ─────────────────────────────────────────────
       Sur iPhone, le clavier recouvre le bas de l'écran sans réduire la page :
       un champ du panneau finissait caché dessous. Tant qu'un champ du panneau
       a le focus et que le clavier est ouvert, on cale l'éditeur sur la zone
       visible (visualViewport) et on amène le champ au milieu de cette zone.
       Limité aux champs du panneau : le sélecteur de modèle, lui, vit dans la
       barre, qui s'efface dans ce mode. */
