          if (data.hk) slot.hk = data.hk; else delete slot.hk;
          var ref = nodes.get(slot.id);
          if (ref) { ref.node.remove(); nodes.delete(slot.id); }
          createNode(slot);
          // Garde l'ordre d'empilement d'origine.
          state.elements.forEach(function (x) { var r = nodes.get(x.id); if (r) design.appendChild(r.node); });
          select(slot.id); pushHistory();
        } else addElement(data);
