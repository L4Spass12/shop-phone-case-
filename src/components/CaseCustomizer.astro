import '@fontsource/montserrat/400.css';
import '@fontsource/oswald/400.css';
import '@fontsource/dancing-script/400.css';
import '@fontsource/caveat/400.css';
import '@fontsource/space-mono/400.css';

/* Prix de la coque personnalisée. En CENTIMES : c'est l'unité attendue par le
   panier et par Stripe, et le libellé affiché en découle. Défini dans
   site.config.mjs, qui alimente AUSSI le manifeste /seamless-items.json sur
   lequel le serveur de paiement s'appuie pour refuser un prix falsifié. */
const PRICE_CENTS = siteConfig.shop?.customCasePriceCents ?? 2990;
/* Clé d'article. Doit correspondre à l'entrée du manifeste : le serveur coupe
   l'identifiant de panier au « :: » (custom::<design_id>) pour la retrouver. */
const SKU = 'custom';
/* Impression en relief : seconde configuration achetable, seconde clé. C'est la
   clé qui porte le prix faisant foi côté serveur (cf. seamless-items.json), donc
   un « relief » vendu au tarif du plat ne peut pas passer. */
const RELIEF_PRICE_CENTS = siteConfig.shop?.customCaseReliefPriceCents ?? PRICE_CENTS;
const fmt = (c: number) => (c / 100).toFixed(2).replace('.', ',') + ' €';
const price = fmt(PRICE_CENTS);
const reliefPrice = fmt(RELIEF_PRICE_CENTS);
/* Offre de lancement du relief : prix à venir, annoncé sous le prix. */
const LAUNCH_NEXT = siteConfig.shop?.launchNextCents ?? null;

/* Config du panier. Le studio n'utilise PAS les attributs data-item-* comme les
   fiches produit : il doit d'abord envoyer le design au serveur, puis ajouter
   la ligne avec l'identifiant reçu. Il lui faut donc l'URL de l'API et le
   shop_id en clair. */

