      if (animated) {
        if (paneCloseTimer) clearTimeout(paneCloseTimer);
        paneCloseTimer = setTimeout(function () { panel.hidden = true; paneCloseTimer = null; fitCase(); }, 470);
      } else {
        panel.hidden = true;
      }
      fitCase();
