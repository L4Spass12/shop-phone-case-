      out.width = cols * c; out.height = rows * c;
      var g = out.getContext('2d');
      for (var y = 0; y < rows; y++) for (var x = 0; x < cols; x++) {
        var i = (y * cols + x) * 4, col = 'rgb(' + px[i] + ',' + px[i + 1] + ',' + px[i + 2] + ')';
        var X0 = x * c, Y0 = y * c;
        g.fillStyle = col; g.fillRect(X0, Y0, c, c);
        g.fillStyle = 'rgba(0,0,0,.22)'; g.fillRect(X0, Y0 + c - 3, c, 3); g.fillRect(X0 + c - 3, Y0, 3, c);
        g.fillStyle = 'rgba(255,255,255,.18)'; g.fillRect(X0, Y0, c, 2); g.fillRect(X0, Y0, 2, c);
        // Plot : ombre portée, disque de la couleur, reflet en haut à gauche.
        var cx = X0 + c / 2, cy = Y0 + c / 2, r = c * .3;
        g.beginPath(); g.arc(cx + 2, cy + 3, r, 0, Math.PI * 2); g.fillStyle = 'rgba(0,0,0,.3)'; g.fill();
        g.beginPath(); g.arc(cx, cy, r, 0, Math.PI * 2); g.fillStyle = col; g.fill();
        g.beginPath(); g.arc(cx, cy, r, Math.PI * 1.05, Math.PI * 1.7); g.lineWidth = 3; g.strokeStyle = 'rgba(255,255,255,.55)'; g.stroke();
      }
