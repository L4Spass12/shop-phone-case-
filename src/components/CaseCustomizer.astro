    }
    // Manga : noir et blanc sombre, contours encrés (détection des bords)
    // et demi-teintes en trame de points, comme une case de BD imprimée.
    function fxManga(img, ar) {
      var W = 1200, cv = cropTo(img, ar, W), H = cv.height, g = cv.getContext('2d');
      var d = g.getImageData(0, 0, W, H), p = d.data, lum = new Float32Array(W * H);
      for (var i = 0, k = 0; i < p.length; i += 4, k++) {
        var l = (.299 * p[i] + .587 * p[i + 1] + .114 * p[i + 2]) / 255;
        lum[k] = Math.pow(Math.min(1, Math.max(0, (l - .5) * 1.35 + .5)), 1.25);   // contraste, plus sombre
      }
