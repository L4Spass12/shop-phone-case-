    // La coque doit tenir dans le plan de travail : on calcule sa largeur à
    // partir de la place disponible (une largeur explicite est indispensable
    // au conteneur `inline-size` qui pilote les unités cqw des éléments).
    function fitCase() {
      var spec = specOf(state.model);
      var r = canvasEl.getBoundingClientRect();
      if (!r.height) return;
      // Aucun plancher élevé ici : un minimum de 220 px de haut empêchait la
      // coque de rétrécir quand un panneau s'ouvre en mobile, et elle
      // débordait alors du plan de travail par le haut.
      var maxW = Math.max(70, r.width - 28);
      var maxH = Math.max(110, r.height - 20);
      caseEl.style.width = Math.round(Math.min(maxW, maxH * spec.ratio, 300)) + 'px';
      // La coque a changé de taille : recale le cadre de sélection.
      if (selectedId != null) { var s = findEl(selectedId); if (s) positionGizmo(s); }
