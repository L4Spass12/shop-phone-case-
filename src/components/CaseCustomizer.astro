    }
    function importFile(file) {
      // Type vide : certains téléphones ne le renseignent pas. On tente le
      // décodage, l'échec est signalé plus bas.
      if (!file || (file.type && !/^image\//.test(file.type))) { toast(I.notImage, 'warn'); return; }
      // URL d'objet plutôt que FileReader : pas de copie base64 de 10 Mo en
      // mémoire juste pour décoder la photo.
      var srcUrl = URL.createObjectURL(file);
      var img = new Image();
      img.onload = function () {
        // Aperçu enregistré dans la composition : 1 400 px suffisent à l'écran
        // et au quota de sauvegarde.
        var max = 1400, w = img.naturalWidth || img.width, h = img.naturalHeight || img.height;
        var W0 = w, H0 = h;
        if (w > max || h > max) { var s = Math.min(max / w, max / h); w = Math.round(w * s); h = Math.round(h * s); }
        var cv = document.createElement('canvas'); cv.width = w; cv.height = h;
        var out = '';
        try {
          cv.getContext('2d').drawImage(img, 0, 0, w, h);
          out = cv.toDataURL('image/webp', .85);
