        bi.onload = function () { done(bi); };
        bi.onerror = function () { done(null); };
        bi.src = bgSrc();
      });
      var ovP = new Promise(function (done) {
        if (!state.overlay) return done(null);
        var oi = new Image();
        oi.onload = function () { done(oi); };
        oi.onerror = function () { done(null); };
        oi.src = state.overlay;
