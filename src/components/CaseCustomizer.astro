        if (x > 0 && y > 0 && x < W - 1 && y < H - 1) {
          var gx = lum[k2 - W + 1] + 2 * lum[k2 + 1] + lum[k2 + W + 1] - lum[k2 - W - 1] - 2 * lum[k2 - 1] - lum[k2 + W - 1];
          var gy = lum[k2 + W - 1] + 2 * lum[k2 + W] + lum[k2 + W + 1] - lum[k2 - W - 1] - 2 * lum[k2 - W] - lum[k2 - W + 1];
