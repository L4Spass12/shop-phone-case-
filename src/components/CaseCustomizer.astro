      });
      g.restore();
    }

    // Les images sont des data URL : elles doivent être décodées AVANT le
    // dessin, sinon le canvas sort vide sans lever d'erreur.
    function loadImages(hi) {
      var jobs = state.elements.filter(function (e) { return e.type === 'image' && e.src; });
      return Promise.all(jobs.map(function (el) {
        return new Promise(function (resolve) {
          var img = new Image();
          img.onload = function () { resolve({ id: el.id, img: img }); };
          img.onerror = function () { resolve(null); };
          img.src = (hi && el.hk && hiRes[el.hk]) || el.src;
        });
      })).then(function (list) {
        var map = {};
        list.forEach(function (r) { if (r) map[r.id] = r.img; });
        return map;
      });
    }

    // Idem pour les polices : une police pas encore chargée est remplacée en
    // silence par la police par défaut sur le canvas.
