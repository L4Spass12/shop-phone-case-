                g.fillStyle = '#ffffff'; g.fillRect(-fw / 2, -fh / 2, fw, fh);
                g.restore();
                if (el.frame === 'panel') { g.lineWidth = scale * 1.8; g.strokeStyle = '#111111'; g.strokeRect(-fw / 2, -fh / 2, fw, fh); }
              }
