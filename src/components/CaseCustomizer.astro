      vv.addEventListener('scroll', update);
      panel.addEventListener('focusin', function () { setTimeout(function () { update(); reveal(); }, 320); });
      panel.addEventListener('focusout', function () { setTimeout(update, 120); });
    })();

    /* ── Textes ─────────────────────────────────────────────────── */
