        // dans le navigateur. Aucun redessin à l'import (un canvas de 3 200 px
        // en plus faisait lâcher Safari sur iPhone : la photo n'apparaissait
        // pas). Il n'est décodé qu'au moment de préparer le fichier
        // d'impression.
        if (W0 > w || H0 > h) {
          data.hk = 'h' + Date.now().toString(36) + Math.random().toString(36).slice(2, 8);
          hiRes[data.hk] = srcUrl;
          hiStore(data.hk, file);
        } else URL.revokeObjectURL(srcUrl);
        // Une case photo de modèle attend : la photo s'y place, recadrée par
        // le cadre. Sinon, nouvelle photo libre comme avant.
        var slot = pendingSlot != null ? findEl(pendingSlot) : null;
        if (!isEmptySlot(slot)) slot = state.elements.filter(isEmptySlot)[0] || null;
        pendingSlot = null;
        if (slot) {
          // Photo verticale : on cadre sur le haut (les visages), sinon au centre.
          var pr = (img.naturalHeight || 1) / (img.naturalWidth || 1);
          slot.ox = .5; slot.oy = pr > (slot.frame === 'polaroid' ? 1 : (slot.ar || 1)) * 1.05 ? .25 : .5;
        }
        if (slot && slot.fx === 'bricks') {
          // La photo reste une vraie photo, déplaçable ; elle part en
          // couvrant toute la coque.
          var ratioImg = (img.naturalHeight || 1) / (img.naturalWidth || 1);
          slot.size = Math.max(100, Math.round(100 * (1 / CASE_AR) / ratioImg));
          slot.x = 50; slot.y = 50; slot.rot = 0;
        } else if (slot && slot.fx) {
          // Effet (briques, manga) : calculé une fois ici, sur la photo
          // d'origine recadrée aux proportions de la case. Le résultat est
          // l'image imprimée : pas de copie HD à garder.
          // Effet calculé sur la photo ENTIÈRE (pas recadrée) : le cadrage se
          // règle ensuite avec « Recadrer ».
          var fxOut = applyFx(img, slot.fx, (img.naturalHeight || 1) / (img.naturalWidth || 1));
