        g.fillStyle = 'rgba(0,0,0,.22)'; g.fillRect(X0, Y0 + ch - e, cw, e); g.fillRect(X0 + cw - e, Y0, e, ch);
        g.fillStyle = 'rgba(255,255,255,.18)'; g.fillRect(X0, Y0, cw, e * .7); g.fillRect(X0, Y0, e * .7, ch);
        var cx = X0 + cw / 2, cy = Y0 + ch / 2, r = Math.min(cw, ch) * .3;
        g.beginPath(); g.arc(cx + e * .7, cy + e, r, 0, Math.PI * 2); g.fillStyle = 'rgba(0,0,0,.3)'; g.fill();
        g.beginPath(); g.arc(cx, cy, r, 0, Math.PI * 2); g.fillStyle = col; g.fill();
        g.beginPath(); g.arc(cx, cy, r, Math.PI * 1.05, Math.PI * 1.7); g.lineWidth = e; g.strokeStyle = 'rgba(255,255,255,.55)'; g.stroke();
      }
