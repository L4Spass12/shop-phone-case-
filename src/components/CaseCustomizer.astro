---
/**
 * ═══════════════════════════════════════════════════════════════════════
 *  STUDIO — builder de coque personnalisée (esprit Canva / Printify)
 * ═══════════════════════════════════════════════════════════════════════
 *  Organisation : rail d'icônes → panneau contextuel → plan de travail.
 *  Sur mobile le rail passe en bas, le panneau devient une feuille.
 *
 *  Choix structurants :
 *   1. UN SEUL ÉTAT SÉRIALISABLE (`state`) ; le DOM n'en est que le rendu.
 *      D'où, gratuitement : annuler/rétablir, sauvegarde auto, envoi au panier.
 *   2. LA COQUE SUIT LE MODÈLE. Chaque famille d'appareils a son gabarit
 *      (proportions, rayon des angles, découpe caméra) : changer de modèle
 *      change réellement la coque affichée, pas seulement une étiquette.
 *   3. RENDU RÉALISTE. La coque est transparente par défaut : on voit le
 *      téléphone au travers, le TPU a une épaisseur et un reflet. C'est ce qui
 *      permet au client de juger son visuel avant d'acheter.
 *   4. GESTES UNIFIÉS souris + tactile (Pointer Events).
 * ═══════════════════════════════════════════════════════════════════════
 */
import ModelPicker from './ModelPicker.astro';
import siteConfig from '../../site.config.mjs';

/* Polices de personnalisation — importées ICI et non dans global.css :
   elles ne servent qu'au studio, elles ne doivent pas peser sur le reste
   du site. Un seul graisse/subset latin par famille. */
import '@fontsource/playfair-display/400.css';
import '@fontsource/abril-fatface/400.css';
import '@fontsource/bebas-neue/400.css';
import '@fontsource/anton/400.css';
import '@fontsource/montserrat/400.css';
import '@fontsource/oswald/400.css';
import '@fontsource/dancing-script/400.css';
import '@fontsource/caveat/400.css';
import '@fontsource/space-mono/400.css';

/* Prix de la coque personnalisée. En CENTIMES : c'est l'unité attendue par le
   panier et par Stripe, et le libellé affiché en découle. Une seule source
   évite que la vitrine et le paiement divergent. */
const PRICE_CENTS = 2990;
const SKU = 'coque-personnalisee';
const price = (PRICE_CENTS / 100).toFixed(2).replace('.', ',') + ' €';

/* Config du panier. Le studio n'utilise PAS les attributs data-item-* comme les
   fiches produit : il doit d'abord envoyer le design au serveur, puis ajouter
   la ligne avec l'identifiant reçu. Il lui faut donc l'URL de l'API et le
   shop_id en clair. */
const atelier = siteConfig.shop?.atelier ?? {};
const apiOrigin = atelier.widgetUrl ? new URL(atelier.widgetUrl).origin : '';
---

<section
  class="studio"
  data-studio
  aria-label="Studio de personnalisation"
  data-shop-id={atelier.shopId ?? ''}
  data-api={apiOrigin}
  data-sku={SKU}
  data-price={String(PRICE_CENTS)}
>
  <div class="builder">

    <!-- ─── Barre supérieure ─────────────────────────────────────── -->
    <header class="bar">
      <div class="bar-l">
        <button type="button" class="sbtn" data-undo disabled aria-label="Annuler" title="Annuler (Ctrl+Z)">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M9 14 4 9l5-5"/><path d="M4 9h11a5 5 0 0 1 0 10h-3"/></svg>
        </button>
        <button type="button" class="sbtn" data-redo disabled aria-label="Rétablir" title="Rétablir">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m15 14 5-5-5-5"/><path d="M20 9H9a5 5 0 0 0 0 10h3"/></svg>
        </button>
        <span class="bar-sep" aria-hidden="true"></span>
        <button type="button" class="sbtn" data-reset aria-label="Tout effacer" title="Tout effacer">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 6h18M8 6V4h8v2m-9 0 1 14h8l1-14"/></svg>
        </button>
        <span class="bar-model" data-barmodel>Choisissez un modèle</span>
      </div>
      <div class="bar-r">
        <span class="bar-price price-amount">{price}</span>
        <button type="button" class="btn-atc buy-button bar-add" data-add data-item-name="Coque personnalisée">
          <span class="add-full">Ajouter au panier</span>
          <span class="add-mini">Ajouter</span>
        </button>
      </div>
    </header>

    <!-- ─── Rail d'outils ────────────────────────────────────────── -->
    <nav class="rail" aria-label="Outils">
      <button type="button" class="rbtn" data-panel="design" aria-pressed="false">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="m14 4 1.6 3.4L19 9l-3.4 1.6L14 14l-1.6-3.4L9 9l3.4-1.6z"/><path d="M6 14.5 6.9 16.4 9 17.3l-2.1.9L6 20.1l-.9-1.9L3 17.3l2.1-.9z"/></svg>
        <span>Designs</span>
      </button>
      <button type="button" class="rbtn" data-panel="model" aria-pressed="false">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="6" y="2" width="12" height="20" rx="3"/><path d="M11 5.5h2"/></svg>
        <span>Modèle</span>
      </button>
      <button type="button" class="rbtn" data-panel="text" aria-pressed="false">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M4 7V5h16v2M9 5v14m-2 0h4"/></svg>
        <span>Texte</span>
      </button>
      <button type="button" class="rbtn" data-panel="sticker" aria-pressed="false">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M12 2.6 14.8 9l6.9.5-5.3 4.5 1.7 6.7L12 17.1 5.9 20.7l1.7-6.7L2.3 9.5 9.2 9z"/></svg>
        <span>Stickers</span>
      </button>
      <button type="button" class="rbtn" data-panel="photo" aria-pressed="false">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="8.5" cy="9" r="1.4"/><path d="m4 18 5-5 4 4 3-3 4 4"/></svg>
        <span>Photos</span>
      </button>
      <button type="button" class="rbtn" data-panel="finish" aria-pressed="false">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="12" cy="12" r="9"/><circle cx="8.6" cy="10" r="1.1"/><circle cx="15.4" cy="10" r="1.1"/><circle cx="12" cy="15.4" r="1.1"/></svg>
        <span>Coque</span>
      </button>
    </nav>

    <!-- ─── Panneau contextuel ───────────────────────────────────── -->
    <aside class="panel" data-panelwrap hidden>
      <div class="panel-head">
        <h2 data-paneltitle>Panneau</h2>
        <button type="button" class="panel-x" data-panelclose aria-label="Fermer le panneau">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M6 6 18 18M18 6 6 18"/>
          </svg>
        </button>
      </div>

      <!-- Designs prêts à l'emploi -->
      <div class="pane" data-pane="design" hidden>
        <p class="pane-hint" style="margin-top:0">Partez d'une base, puis modifiez tout : textes, couleurs, positions.</p>
        <div class="tpl-grid" data-templates></div>
      </div>

      <!-- Modèle -->
      <div class="pane" data-pane="model" hidden>
        <p class="pane-hint">La coque affichée s'adapte au modèle choisi.</p>
        <ModelPicker id="studio-model" />
      </div>

      <!-- Texte -->
      <div class="pane" data-pane="text" hidden>
        <button type="button" class="pane-cta" data-addtext>+ Ajouter un texte</button>
        <div data-textedit hidden>
          <label class="pane-label" for="studio-text">Contenu</label>
          <input id="studio-text" type="text" class="field" data-textinput placeholder="Votre texte" maxlength="40" autocomplete="off" />
          <label class="pane-label">Police</label>
          <div class="font-row" data-fonts></div>
          <label class="pane-label">Couleur du texte</label>
          <div class="swatch-row" data-textcolors></div>
        </div>
        <p class="pane-empty" data-textempty>Sélectionnez un texte sur la coque pour le modifier.</p>
      </div>

      <!-- Stickers -->
      <div class="pane" data-pane="sticker" hidden>
        <div class="chip-row" data-stickercats role="tablist" aria-label="Catégories"></div>
        <div class="sticker-grid" data-stickers></div>
      </div>

      <!-- Photos -->
      <div class="pane" data-pane="photo" hidden>
        <button type="button" class="dropzone" data-pick>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 16V4m0 0L8 8m4-4 4 4"/><path d="M4 16v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"/></svg>
          <strong>Importer une photo</strong>
          <span>ou glissez-la sur la coque · JPG, PNG, WebP</span>
        </button>
        <p class="pane-hint">Astuce : vous pouvez aussi coller une image (Ctrl+V).</p>
      </div>

      <!-- Coque -->
      <div class="pane" data-pane="finish" hidden>
        <label class="pane-label">Aperçu</label>
        <div class="seg" data-mounts role="group" aria-label="Type d'aperçu">
          <button type="button" data-mount-v="alone" aria-pressed="true">Coque seule</button>
          <button type="button" data-mount-v="phone" aria-pressed="false">Sur le téléphone</button>
        </div>
        <label class="pane-label">Finition</label>
        <div class="swatch-row" data-finishes></div>
        <div data-devicewrap hidden>
          <label class="pane-label">Couleur du téléphone</label>
          <div class="swatch-row" data-devices></div>
        </div>
        <p class="pane-hint">La finition transparente laisse voir le décor au travers : c'est le rendu réel d'une coque en TPU cristal.</p>
      </div>
    </aside>

    <!-- ─── Plan de travail ──────────────────────────────────────── -->
    <main class="canvas" data-canvas>
      <div class="case" data-case data-finish="clear" data-mount="alone">
        <!-- Verre dépoli : floute et voile légèrement le décor DERRIÈRE la
             coque (finition transparente). Placé avant le design pour que les
             stickers/textes restent nets par-dessus. -->
        <div class="frost" data-frost aria-hidden="true"></div>
        <div class="phone" data-phone></div>
        <div class="design" data-design>
          <span class="guide guide-v" data-guide-v aria-hidden="true"></span>
          <span class="guide guide-h" data-guide-h aria-hidden="true"></span>
        </div>
        <div class="cam" data-cam aria-hidden="true"></div>
        <div class="shell" aria-hidden="true"><span class="sheen"></span></div>
        <span class="side side-l" aria-hidden="true"></span>
        <span class="side side-r" aria-hidden="true"></span>

        <div class="empty" data-empty>
          <p>Votre coque est vierge</p>
          <span>Choisissez un outil pour commencer</span>
        </div>

        <!-- Cadre de sélection : calque UNIQUE hors du .design (qui, lui, rogne
             l'image à la coque). Ainsi le cadre et ses poignées restent
             visibles et attrapables même quand l'élément déborde de la coque,
             alors que l'image reste rognée au bord. -->
        <div class="gizmo" data-gizmo hidden aria-hidden="true">
          <span class="h h-rotate" data-handle="rotate"></span>
          <span class="h h-resize" data-handle="resize"></span>
        </div>
      </div>

      <!-- Barre d'actions : ancrée au plan de travail et non à la coque, qui
           devient trop étroite quand un panneau est ouvert en mobile. -->
      <div class="ctx" data-ctx hidden>
          <button type="button" data-act="edit" hidden>Éditer</button>
          <button type="button" data-act="dup" aria-label="Dupliquer" title="Dupliquer">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg>
          </button>
          <button type="button" data-act="back" aria-label="Reculer" title="Reculer">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m6 9 6 6 6-6"/></svg>
          </button>
          <button type="button" data-act="front" aria-label="Avancer" title="Avancer">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m6 15 6-6 6 6"/></svg>
          </button>
          <button type="button" data-act="del" class="ctx-del" aria-label="Supprimer" title="Supprimer">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 6h18M8 6V4h8v2m-9 0 1 14h8l1-14"/></svg>
          </button>
      </div>
    </main>
  </div>

  <div class="toast" data-toast hidden role="status"></div>
  <input type="file" accept="image/*" hidden data-file />
</section>

<style>
  .studio { --rail: 78px; --panel: 272px; }

  /* ── Mobile : une application à hauteur fixe ─────────────────────
     Colonne barre / plan de travail / panneau / rail. Le panneau est DANS
     le flux (et non posé par-dessus) : quand il s'ouvre, le plan de travail
     se réduit et la coque reste visible — on voit ce qu'on est en train de
     modifier, ce qui n'était pas le cas avec une feuille en surimpression. */
  .builder {
    display: flex;
    flex-direction: column;
    height: calc(100dvh - var(--header-h) - var(--marquee-h, 0px));
    overflow: hidden;
  }
  .builder > .bar    { flex: none; order: 0; }
  .builder > .canvas { flex: 1 1 auto; min-height: 0; order: 1; }
  .builder > .panel  { flex: none; order: 2; }
  .builder > .rail   { flex: none; order: 3; }

  /* En thème sunfreaks (mobile), l'îlot flottant du header descend un peu plus
     bas que --header-h ne le prévoit et chevauchait la barre d'action (ATC).
     On décale la colonne vers le bas et on réduit d'autant sa hauteur. */
  @media (max-width: 1023px) {
    html[data-theme='sunfreaks'] .builder {
      margin-top: 12px;
      height: calc(100dvh - var(--header-h) - var(--marquee-h, 0px) - 12px);
    }
  }

  @media (min-width: 1024px) {
    .builder {
      display: grid;
      height: auto;
      overflow: visible;
      grid-template-columns: var(--rail) auto minmax(0, 1fr);
      grid-template-rows: auto minmax(0, 1fr);
      grid-template-areas: "bar bar bar" "rail panel canvas";
      min-height: calc(100dvh - var(--header-h) - var(--marquee-h, 0px));
    }
  }

  /* ── Barre ───────────────────────────────────────────────────── */
  .bar {
    grid-area: bar;
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    padding: .55rem .9rem;
    border-bottom: 1px solid rgb(var(--c-cream) / .10);
    background: rgb(var(--c-dark));
    z-index: 60;
  }
  /* En mobile la barre est déjà figée par la colonne à hauteur fixe ;
     le `sticky` ne sert que sur desktop, où la page défile. */
  @media (min-width: 1024px) { .bar { position: sticky; top: calc(var(--header-h) + var(--marquee-h, 0px)); } }
  .bar-l, .bar-r { display: flex; align-items: center; gap: .4rem; }
  .sbtn {
    display: inline-flex; align-items: center; justify-content: center;
    width: 38px; height: 38px; border-radius: 9px; cursor: pointer; color: inherit;
    transition: background .15s, opacity .15s;
  }
  .sbtn svg { width: 18px; height: 18px; }
  .sbtn:hover:not(:disabled) { background: rgb(var(--c-cream) / .08); }
  .sbtn:disabled { opacity: .28; cursor: default; }
  .bar-sep { width: 1px; height: 20px; background: rgb(var(--c-cream) / .15); margin: 0 .2rem; }
  .bar-model {
    font-size: .74rem; opacity: .65; margin-left: .4rem;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 40vw;
  }
  @media (max-width: 520px) { .bar-model { display: none; } }
  /* Sur les très petits écrans, le prix cède la place au bouton d'achat. */
  @media (max-width: 359px) { .bar-price { display: none; } }
  .bar-price { font-size: 1.1rem; font-weight: 600; white-space: nowrap; }
  .bar-add { font-size: .74rem; padding-left: 1rem; padding-right: 1rem; white-space: nowrap; }
  /* Le libellé long ne tient pas à 375 px à côté du prix et des annulations :
     on bascule sur « Ajouter » (l'intitulé reste explicite en contexte).
     `font-size: 1em` annule la réduction que .btn-atc applique à ses <span>. */
  .bar-add .add-full, .bar-add .add-mini { font-size: 1em; font-weight: inherit; }
  .bar-add .add-mini { display: none; }
  @media (max-width: 700px) {
    .bar-add .add-full { display: none; }
    .bar-add .add-mini { display: inline; }
  }
  @media (min-width: 1024px) { .bar-price { font-size: 1.3rem; } .bar-add { font-size: .8rem; } }

  /* ── Rail ────────────────────────────────────────────────────── */
  .rail {
    grid-area: rail;
    display: flex; gap: .25rem;
    padding: .35rem .5rem calc(.35rem + env(safe-area-inset-bottom));
    background: rgb(var(--c-dark));
    border-top: 1px solid rgb(var(--c-cream) / .10);
    z-index: 60;
  }
  @media (min-width: 1024px) {
    .rail {
      flex-direction: column; padding: .6rem .5rem;
      border-top: 0; border-right: 1px solid rgb(var(--c-cream) / .10);
    }
  }
  .rbtn {
    flex: 1; display: flex; flex-direction: column; align-items: center; gap: .25rem;
    padding: .55rem .2rem; border-radius: 10px; cursor: pointer; color: inherit;
    font-size: .64rem; font-weight: 500; transition: background .15s, color .15s;
  }
  .rbtn svg { width: 21px; height: 21px; }
  /* Barre et rail compactés en mobile : chaque pixel gagné va au plan de
     travail, qui est la partie utile. */
  @media (max-width: 1023px) {
    .bar { padding: .35rem .7rem; }
    .sbtn { width: 34px; height: 34px; }
    .rbtn { padding: .4rem .2rem; font-size: .6rem; gap: .15rem; }
    .rbtn svg { width: 19px; height: 19px; }
  }
  .rbtn:hover { background: rgb(var(--c-cream) / .06); }
  .rbtn[aria-pressed="true"] { background: rgb(var(--accent-rgb) / .12); color: rgb(var(--accent-dark-rgb)); }

  /* ── Panneau ─────────────────────────────────────────────────── */
  .panel { grid-area: panel; background: rgb(var(--c-dark)); }
  .panel[hidden] { display: none; }
  @media (min-width: 1024px) {
    .panel {
      width: var(--panel); padding: 1rem;
      border-right: 1px solid rgb(var(--c-cream) / .10);
      overflow-y: auto; max-height: calc(100dvh - var(--header-h) - var(--marquee-h, 0px) - 52px);
    }
  }
  @media (max-width: 1023px) {
    /* Feuille du bas. Fermée = hauteur 0 ; ouverte = .panel--open. La bascule
       de max-height s'anime → ouverture ET fermeture lentes et fluides (le
       plan de travail se réajuste doucement en même temps). */
    .panel {
      max-height: 0; overflow-y: auto;
      overscroll-behavior: contain;          /* le défilement ne fuit pas vers la page */
      padding: 0 1rem;
      border-radius: 16px 16px 0 0;
      box-shadow: 0 -14px 34px -20px rgba(0,0,0,.4);
      border-top: 1px solid rgb(var(--c-cream) / .12);
      transition: max-height .45s cubic-bezier(.33, 1, .68, 1),
                  padding .45s cubic-bezier(.33, 1, .68, 1);
    }
    .panel.panel--open { max-height: 46dvh; padding: 0 1rem .9rem; }

    /* Le header (titre + croix) reste collé en haut pendant le scroll, avec un
       fond, pour que la croix soit toujours visible. */
    .panel-head {
      position: sticky; top: 0; z-index: 6;
      background: rgb(var(--c-dark));
      margin: 0 -1rem .4rem; padding: .55rem 1rem .5rem;
    }
    .panel-x { background: rgb(var(--c-cream) / .08); }
  }

  .panel-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: .6rem; }
  .panel-head h2 { font-size: .95rem; }
  .panel-x {
    width: 32px; height: 32px; border-radius: 8px; cursor: pointer; color: inherit;
    display: flex; align-items: center; justify-content: center; flex: none;
    transition: background .15s;
  }
  .panel-x svg { width: 17px; height: 17px; }
  .panel-x:hover { background: rgb(var(--c-cream) / .14); }
  @media (min-width: 1024px) { .panel-x { display: none; } }
  .pane[hidden] { display: none; }
  .pane-label { display: block; font-size: .66rem; text-transform: uppercase; letter-spacing: .11em; opacity: .6; margin: .9rem 0 .5rem; }
  .pane-hint { font-size: .72rem; opacity: .6; margin-top: .7rem; line-height: 1.45; }
  .pane-empty { font-size: .75rem; opacity: .6; margin-top: .8rem; }
  .pane-cta {
    width: 100%; padding: .7rem; border-radius: 9px; cursor: pointer; font-weight: 600; font-size: .82rem;
    border: 1px dashed rgb(var(--c-cream) / .3); background: rgb(var(--c-cream) / .03); color: inherit;
  }
  .pane-cta:hover { border-color: rgb(var(--accent-rgb)); color: rgb(var(--accent-dark-rgb)); }

  .field {
    width: 100%; padding: .7rem .75rem; border-radius: 8px; font-size: 16px; color: inherit;
    border: 1px solid rgb(var(--c-cream) / .18); background: rgb(var(--c-cream) / .03);
  }
  .field:focus { outline: none; border-color: rgb(var(--accent-rgb)); }

  /* NB : chips, pastilles de couleur et boutons de stickers sont créés en JS —
     leurs règles vivent dans le bloc <style is:global>. */
  .chip-row { display: flex; gap: .3rem; overflow-x: auto; padding-bottom: .5rem; scrollbar-width: none; }
  .chip-row::-webkit-scrollbar { display: none; }
  .sticker-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: .3rem; }
  /* 6 colonnes plutôt que 7 : ~52 px par cible, au-dessus du minimum tactile. */
  @media (max-width: 1023px) { .sticker-grid { grid-template-columns: repeat(6, 1fr); gap: .35rem; } }
  .swatch-row { display: flex; flex-wrap: wrap; gap: .5rem; }
  .font-row { display: flex; flex-wrap: wrap; gap: .4rem; }

  .tpl-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: .55rem; }
  @media (max-width: 1023px) { .tpl-grid { grid-template-columns: repeat(3, 1fr); } }

  .seg { display: flex; gap: .25rem; padding: .2rem; border-radius: 10px; background: rgb(var(--c-cream) / .05); }
  .seg button {
    flex: 1; padding: .45rem .3rem; border-radius: 8px; cursor: pointer; color: inherit;
    font-size: .74rem; font-weight: 500; transition: background .15s, color .15s;
  }
  .seg button[aria-pressed="true"] { background: rgb(var(--accent-rgb)); color: #fff; }

  .dropzone {
    width: 100%; display: flex; flex-direction: column; align-items: center; gap: .35rem;
    padding: 1.5rem 1rem; border-radius: 12px; cursor: pointer; color: inherit; text-align: center;
    border: 1.5px dashed rgb(var(--c-cream) / .28); background: rgb(var(--c-cream) / .03);
  }
  .dropzone:hover { border-color: rgb(var(--accent-rgb)); background: rgb(var(--accent-rgb) / .05); }
  .dropzone svg { width: 26px; height: 26px; opacity: .7; }
  .dropzone strong { font-size: .85rem; }
  .dropzone span { font-size: .7rem; opacity: .6; }

  /* ── Plan de travail ─────────────────────────────────────────── */
  /* Le plan de travail porte un décor doux : c'est en le voyant AU TRAVERS
     de la coque qu'on comprend qu'elle est transparente. */
  .canvas {
    grid-area: canvas;
    position: relative; overflow: hidden;
    display: flex; align-items: center; justify-content: center;
    padding: 1.25rem 1rem; min-height: 0;
    background: rgb(var(--c-panel) / .5);
    /* Un glissement sur le plan de travail compose, il ne fait pas défiler
       la page derrière (indispensable au confort tactile). */
    touch-action: none;
    overscroll-behavior: contain;
  }
  /* Fond « craft » : une grille type papier millimétré / tapis de découpe.
     Deux échelles (fine + large) posées sur le panneau clair. La coque étant
     transparente, on voit la grille au travers, ce qui souligne la matière. */
  .canvas::before {
    content: ""; position: absolute; inset: 0; pointer-events: none;
    background-color: rgb(var(--c-panel));
    background-image:
      linear-gradient(rgb(var(--accent-rgb) / .09) 1px, transparent 1px),
      linear-gradient(90deg, rgb(var(--accent-rgb) / .09) 1px, transparent 1px),
      linear-gradient(rgb(var(--accent-rgb) / .045) 1px, transparent 1px),
      linear-gradient(90deg, rgb(var(--accent-rgb) / .045) 1px, transparent 1px);
    background-size: 104px 104px, 104px 104px, 26px 26px, 26px 26px;
    background-position: center;
    z-index: 0;   /* le décor reste sous la coque et la barre d'actions, qui
                     sont positionnées et peintes après lui */
  }

  /* ── La coque ────────────────────────────────────────────────── */
  .case {
    position: relative;
    width: 250px;                     /* recalculé par fitCase() */
    aspect-ratio: var(--ratio, .476);
    border-radius: var(--radius, 13%) / calc(var(--radius, 13%) / 2.1);
    container-type: inline-size;
    touch-action: none;
    /* Ombre portée en box-shadow (et non filter) : un ancêtre avec `filter`
       désactive le backdrop-filter du verre dépoli à l'intérieur. box-shadow
       suit tout autant le rayon arrondi. */
    box-shadow: 0 24px 40px -6px rgba(0,0,0,.34);
  }
  .case[data-over] { outline: 2px dashed rgb(var(--accent-rgb)); outline-offset: 8px; }

  /* Le téléphone : affiché seulement en aperçu « sur le téléphone ». Par
     défaut la coque est présentée seule, comme sur une photo produit. */
  .phone {
    position: absolute; inset: 0; border-radius: inherit; display: none;
    background: var(--device, linear-gradient(158deg, #3c3c42, #17171b 46%, #2b2b31));
  }
  .case[data-mount="phone"] .phone { display: block; }
  /* Finition opaque : la coque est teintée, elle masque alors le téléphone. */
  .case[data-finish="solid"] .phone { display: block; background: var(--caseColor, #f4eee2); }

  /* Verre dépoli de la coque transparente : floute le décor derrière + un
     voile blanc très léger. Sous le design, donc les éléments restent nets.
     Si backdrop-filter n'est pas supporté, le voile suffit à adoucir. */
  .frost {
    position: absolute; inset: 0; border-radius: inherit; z-index: 0;
    pointer-events: none;
    background: rgba(255,255,255,.2);
    -webkit-backdrop-filter: blur(9px);
    backdrop-filter: blur(9px);
  }
  /* Finition opaque ou montée sur téléphone : le dos n'est plus transparent,
     il n'y a rien à flouter. */
  .case[data-finish="solid"] .frost,
  .case[data-mount="phone"] .frost { display: none; }

  .design { position: absolute; inset: 0; border-radius: inherit; overflow: hidden; }

  .guide { position: absolute; background: rgb(var(--accent-rgb)); display: none; z-index: 30; pointer-events: none; }
  .guide-v { left: 50%; top: 0; bottom: 0; width: 1px; transform: translateX(-.5px); }
  .guide-h { top: 50%; left: 0; right: 0; height: 1px; transform: translateY(-.5px); }

  /* Module caméra : dessiné par le JS selon la famille d'appareils */
  .cam { position: absolute; z-index: 6; pointer-events: none; }
  /* NB : le contenu du module caméra est injecté en JS — ses règles vivent
     dans le bloc <style is:global> (pas d'attribut de scope Astro). */

  /* La coque elle-même : épaisseur du TPU + reflet */
  /* La coque elle-même. En finition transparente elle ne pose AUCUN fond :
     on voit le plan de travail au travers — c'est ça qui fait lire « coque
     transparente » plutôt que « téléphone noir ». Seules les arêtes du TPU,
     sa paroi et les reflets sont dessinés. */
  .shell {
    position: absolute; inset: 0; border-radius: inherit; z-index: 8; pointer-events: none;
    background: linear-gradient(135deg, rgba(255,255,255,.14), rgba(255,255,255,.03) 42%, rgba(255,255,255,.09));
    border: 1px solid rgba(255,255,255,.8);
    box-shadow:
      inset 0 0 0 1.5px rgba(255,255,255,.55),   /* arête extérieure */
      inset 0 0 0 9px  rgba(255,255,255,.09),    /* paroi (épaisseur du TPU) */
      inset 0 0 0 10px rgba(255,255,255,.5),     /* arête intérieure */
      inset 0 3px 7px rgba(255,255,255,.4),      /* lumière du haut */
      inset 0 -3px 7px rgba(255,255,255,.22),
      0 1px 1px rgba(255,255,255,.5),
      0 22px 44px -20px rgba(0,0,0,.4);
  }
  /* Montée sur un téléphone : le dos opaque reprend le dessus, on adoucit
     donc les reflets pour ne pas voiler le visuel. */
  .case[data-mount="phone"] .shell,
  .case[data-finish="solid"] .shell {
    background: linear-gradient(135deg, rgba(255,255,255,.10), rgba(255,255,255,0) 45%, rgba(255,255,255,.06));
    border-color: rgba(255,255,255,.5);
    box-shadow:
      inset 0 0 0 1.5px rgba(255,255,255,.35),
      inset 0 0 0 9px rgba(255,255,255,.06),
      inset 0 0 0 10px rgba(255,255,255,.28),
      inset 0 3px 6px rgba(255,255,255,.28),
      0 22px 44px -20px rgba(0,0,0,.45);
  }
  .case[data-finish="solid"] .shell {
    border-color: rgba(255,255,255,.28);
    box-shadow: inset 0 0 0 1px rgba(255,255,255,.18), inset 0 2px 3px rgba(255,255,255,.22);
  }
  .sheen {
    position: absolute; inset: 0; border-radius: inherit;
    background: linear-gradient(112deg,
      rgba(255,255,255,.26) 0%, rgba(255,255,255,.05) 22%,
      rgba(255,255,255,0) 46%, rgba(255,255,255,0) 66%,
      rgba(255,255,255,.16) 82%, rgba(255,255,255,.02) 100%);
  }
  /* Boutons latéraux moulés dans la coque */
  .side { position: absolute; width: 2.4%; border-radius: 2px; background: rgba(255,255,255,.30); box-shadow: inset 0 0 0 1px rgba(255,255,255,.4); z-index: 9; }
  .side-l { left: -1.6%; top: 20%; height: 7%; }
  .side-r { right: -1.6%; top: 26%; height: 11%; }

  .empty {
    position: absolute; inset: 0; display: flex; flex-direction: column;
    align-items: center; justify-content: center; gap: .3rem; text-align: center;
    z-index: 4; pointer-events: none; padding: 0 10%;
  }
  .empty[hidden] { display: none; }
  .empty p { font-size: 4.2cqw; color: rgba(0,0,0,.48); }
  .empty span { font-size: 3.2cqw; color: rgba(0,0,0,.34); }
  .case[data-dark] .empty p { color: rgba(255,255,255,.75); }
  .case[data-dark] .empty span { color: rgba(255,255,255,.48); }

  /* ── Barre contextuelle ──────────────────────────────────────── */
  /* Flottante en bas du PLAN DE TRAVAIL : rattachée à la coque, elle
     débordait dès que celle-ci rétrécissait (panneau ouvert en mobile). */
  .ctx {
    position: absolute; left: 50%; bottom: 10px; transform: translateX(-50%);
    display: flex; gap: 2px; padding: 4px; border-radius: 10px;
    background: rgba(24,24,27,.88); backdrop-filter: blur(6px);
    box-shadow: 0 10px 26px -10px rgba(0,0,0,.6); z-index: 40;
  }
  .ctx[hidden] { display: none; }
  .ctx button {
    display: inline-flex; align-items: center; justify-content: center;
    min-width: 38px; height: 38px; padding: 0 9px; border-radius: 7px;
    color: #fff; background: transparent; font-size: .78rem; cursor: pointer;
  }
  .ctx button svg { width: 18px; height: 18px; }
  .ctx button:hover { background: rgba(255,255,255,.15); }
  .ctx .ctx-del:hover { background: #e11d48; }

  .toast {
    position: fixed; left: 50%; bottom: calc(84px + env(safe-area-inset-bottom)); transform: translateX(-50%);
    z-index: 10060; padding: .7rem 1.15rem; border-radius: 999px;
    background: #16a34a; color: #fff; font-size: .85rem; font-weight: 500;
    box-shadow: 0 10px 30px -10px rgba(0,0,0,.5);
  }
  .toast[data-kind="warn"] { background: #b45309; }
  @media (min-width: 1024px) { .toast { bottom: 26px; } }

  @media (prefers-reduced-motion: reduce) { .panel { transition: none } }
</style>

<!-- Éléments créés en JS : pas d'attribut de scope Astro, règles globales. -->
