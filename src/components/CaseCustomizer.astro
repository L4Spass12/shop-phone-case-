      state.elements = []; selectedId = null; renderAll(); pushHistory(); toast('Coque réinitialisée');
    });

    /* ── Ajout / suppression ────────────────────────────────────── */
    function addElement(data) {
      var n = state.elements.length;
      var el = Object.assign({ id: ++seq, x: clamp(50 + (n % 3 - 1) * 9, 12, 88), y: clamp(46 + (n % 4) * 7, 26, 88), rot: 0 }, data);
      state.elements.push(el); createNode(el); refreshEmpty(); select(el.id); pushHistory();
      return el;
    }
    function removeElement(id) {
      var ref = nodes.get(id); if (ref) { ref.node.remove(); nodes.delete(id); }
      state.elements = state.elements.filter(function (e) { return e.id !== id; });
      if (selectedId === id) { selectedId = null; applySelection(); }
      refreshEmpty(); pushHistory();
    }
    function duplicate(id) {
      var el = findEl(id); if (!el) return;
      var c = Object.assign({}, el); delete c.id;
      c.x = clamp(el.x + 7, 6, 94); c.y = clamp(el.y + 7, 6, 94);
      addElement(c);
    }
    function reorder(id, dir) {
      var i = state.elements.findIndex(function (e) { return e.id === id; });
      var j = i + dir; if (i < 0 || j < 0 || j >= state.elements.length) return;
      var t = state.elements[i]; state.elements[i] = state.elements[j]; state.elements[j] = t;
      state.elements.forEach(function (e) { design.appendChild(nodes.get(e.id).node); });
      pushHistory();
    }

    /* ── Sélection ──────────────────────────────────────────────── */
    function select(id) { selectedId = id; applySelection(); }
    function deselect() { if (editingId) exitEdit(); selectedId = null; applySelection(); }
    function applySelection() {
      nodes.forEach(function (ref, id) { ref.node.classList.toggle('sel', id === selectedId); });
      var el = selectedId ? findEl(selectedId) : null;
      if (el) { gizmoEl.hidden = false; positionGizmo(el); } else { gizmoEl.hidden = true; }
      ctx.hidden = !el;
      if (el) ctx.querySelector('[data-act="edit"]').hidden = el.type !== 'text';
      syncTextPane();
    }
    ctx.addEventListener('click', function (e) {
      var b = e.target.closest('[data-act]'); if (!b || !selectedId) return;
      var a = b.dataset.act;
      if (a === 'del') removeElement(selectedId);
      else if (a === 'dup') duplicate(selectedId);
      else if (a === 'front') reorder(selectedId, 1);
      else if (a === 'back') reorder(selectedId, -1);
      else if (a === 'edit') openPane('text');
    });
    // Cliquer n'importe où sur le plan de travail — coque OU fond autour —
    // désélectionne. Seuls un élément (.el, poignées comprises) et la barre
    // d'actions (data-ctx) en sont exclus : sinon on annulerait la sélection
    // qu'on vient de faire, ou l'action qu'on s'apprête à déclencher.
    canvasEl.addEventListener('pointerdown', function (e) {
      if (e.target.closest('.el') || e.target.closest('[data-gizmo]') || e.target.closest('[data-ctx]')) return;
      deselect();
    });

    // Poignées du cadre (redimensionner / pivoter) : elles vivent sur le calque
    // hors du clip, donc leur pointerdown doit déclencher le geste sur
    // l'élément sélectionné.
    gizmoEl.addEventListener('pointerdown', function (e) {
      var handle = e.target && e.target.dataset ? e.target.dataset.handle : null;
      if (!handle || selectedId == null) return;
      onDown(e, selectedId);
    });

    /* ── Gestes ─────────────────────────────────────────────────── */
    var SNAP = 2.2;
    function onDown(e, id) {
      if (editingId === id) return;
      e.preventDefault(); select(id);
      var el = findEl(id); if (!el) return;
      var handle = e.target.dataset ? e.target.dataset.handle : null;
      var d = design.getBoundingClientRect(), b = nodes.get(id).node.getBoundingClientRect();
      var cx = b.left + b.width / 2, cy = b.top + b.height / 2;
      gesture = {
        el: el, mode: handle || 'drag', px: e.clientX, py: e.clientY,
        sx: el.x, sy: el.y, srot: el.rot, ssize: el.size, cx: cx, cy: cy,
        a0: Math.atan2(e.clientY - cy, e.clientX - cx),
        d0: Math.hypot(e.clientX - cx, e.clientY - cy) || 1,
        cw: d.width, ch: d.height, moved: false,
      };
      try { e.target.setPointerCapture(e.pointerId); } catch (_) {}
      window.addEventListener('pointermove', onMove);
      window.addEventListener('pointerup', onUp);
      window.addEventListener('pointercancel', onUp);
    }
    function onMove(e) {
      if (!gesture) return;
      var g = gesture; g.moved = true;
      if (g.mode === 'drag') {
        var nx = g.sx + (e.clientX - g.px) / g.cw * 100, ny = g.sy + (e.clientY - g.py) / g.ch * 100;
        var sv = Math.abs(nx - 50) < SNAP, sh = Math.abs(ny - 50) < SNAP;
        if (sv) nx = 50; if (sh) ny = 50;
        guideV.style.display = sv ? 'block' : 'none';
        guideH.style.display = sh ? 'block' : 'none';
        g.el.x = clamp(nx, 0, 100); g.el.y = clamp(ny, 0, 100);
      } else if (g.mode === 'rotate') {
        var a = Math.atan2(e.clientY - g.cy, e.clientX - g.cx);
        var deg = g.srot + (a - g.a0) * 180 / Math.PI;
        if (Math.abs(deg % 90) < 5) deg = Math.round(deg / 90) * 90;
        g.el.rot = deg;
      } else if (g.mode === 'resize') {
        var dd = Math.hypot(e.clientX - g.cx, e.clientY - g.cy);
        // Les images peuvent déborder très largement la coque : le design est
        // en overflow:hidden, donc le débord est rogné proprement au bord et
        // on ne voit aucune coupure. Plafond bien plus haut que pour le texte.
        var maxSize = g.el.type === 'image' ? 400 : 96;
        g.el.size = clamp(g.ssize * (dd / g.d0), 4, maxSize);
      }
      applyStyles(g.el);
    }
    function onUp() {
      if (gesture && gesture.moved) pushHistory();
      gesture = null;
      guideV.style.display = 'none'; guideH.style.display = 'none';
      window.removeEventListener('pointermove', onMove);
      window.removeEventListener('pointerup', onUp);
      window.removeEventListener('pointercancel', onUp);
    }

    /* ── Édition de texte en place ──────────────────────────────── */
    function enterEdit(id) {
      var ref = nodes.get(id); if (!ref) return;
      editingId = id; ref.node.dataset.editing = '';
      ref.content.contentEditable = 'true'; ref.content.focus();
      var s = document.getSelection(); if (s) s.selectAllChildren(ref.content);
    }
    function exitEdit() {
      if (!editingId) return;
      var el = findEl(editingId), ref = nodes.get(editingId);
      if (ref) { ref.content.contentEditable = 'false'; delete ref.node.dataset.editing; }
      if (el && ref) {
        var v = ref.content.textContent.trim();
        if (!v) { var id = editingId; editingId = null; removeElement(id); return; }
        if (v !== el.text) { el.text = v; pushHistory(); }
      }
      editingId = null;
    }

    /* ── Panneaux ───────────────────────────────────────────────── */
    var TITLES = { design: 'Designs', model: 'Modèle', text: 'Texte', sticker: 'Stickers', photo: 'Photos', finish: 'Coque' };
    var paneCloseTimer = null;
    function openPane(name) {
      activePane = name;
      if (paneCloseTimer) { clearTimeout(paneCloseTimer); paneCloseTimer = null; }
      panel.hidden = false;
      root.querySelector('[data-paneltitle]').textContent = TITLES[name] || '';
      panel.querySelectorAll('[data-pane]').forEach(function (p) { p.hidden = p.dataset.pane !== name; });
      root.querySelectorAll('.rbtn').forEach(function (b) { b.setAttribute('aria-pressed', String(b.dataset.panel === name)); });
      if (name === 'text') syncTextPane();
      // Déclenche l'animation d'ouverture : on force un reflow (état fermé
      // max-height:0 committé) PUIS on ajoute la classe, pour que la transition
      // de max-height se joue. (Plus fiable que requestAnimationFrame.)
      void panel.offsetHeight;
      panel.classList.add('panel--open');
      fitCase();
    }
    function closePane() {
      activePane = null;
      root.querySelectorAll('.rbtn').forEach(function (b) { b.setAttribute('aria-pressed', 'false'); });
      panel.classList.remove('panel--open');
      // Mobile : on laisse l'animation de fermeture se jouer avant de masquer.
      // Desktop : pas de transition → on masque tout de suite.
      var animated = window.matchMedia('(max-width: 1023px)').matches;
      if (animated) {
        if (paneCloseTimer) clearTimeout(paneCloseTimer);
        paneCloseTimer = setTimeout(function () { panel.hidden = true; paneCloseTimer = null; fitCase(); }, 470);
      } else {
        panel.hidden = true;
      }
      fitCase();
    }
    root.querySelectorAll('.rbtn').forEach(function (b) {
      b.addEventListener('click', function () { activePane === b.dataset.panel ? closePane() : openPane(b.dataset.panel); });
    });
    panel.querySelectorAll('[data-panelclose]').forEach(function (b) { b.addEventListener('click', closePane); });

    /* ── Textes ─────────────────────────────────────────────────── */
    var textInput = root.querySelector('[data-textinput]');
    var fontRow = root.querySelector('[data-fonts]');
    var textColors = root.querySelector('[data-textcolors]');
    var textEdit = root.querySelector('[data-textedit]');
    var textEmpty = root.querySelector('[data-textempty]');
    var textTimer = null;

    root.querySelector('[data-addtext]').addEventListener('click', function () {
      addElement({ type: 'text', text: 'Votre texte', font: F('bodoni'), color: TEXT_COLORS[0], size: 11 });
      setTimeout(function () { textInput.focus(); textInput.select(); }, 60);
    });
    FONTS.forEach(function (f) {
      var c = document.createElement('button');
      c.type = 'button'; c.className = 'font-chip';
      c.textContent = f.label;              // le nom rendu DANS la police : on choisit à l'œil
      c.style.fontFamily = f.css; c.dataset.f = f.css; c.title = f.label;
      c.addEventListener('click', function () {
        var el = selectedId && findEl(selectedId);
        if (el && el.type === 'text') { el.font = f.css; applyStyles(el); syncTextPane(); pushHistory(); }
      });
      fontRow.appendChild(c);
    });
    TEXT_COLORS.forEach(function (col) {
      var s = document.createElement('button');
      s.type = 'button'; s.className = 'swatch'; s.dataset.c = col; s.style.background = col;
      s.setAttribute('aria-label', 'Texte ' + col);
      s.addEventListener('click', function () {
        var el = selectedId && findEl(selectedId);
        if (el && el.type === 'text') { el.color = col; applyStyles(el); syncTextPane(); pushHistory(); }
      });
      textColors.appendChild(s);
    });
    textInput.addEventListener('input', function () {
      var el = selectedId && findEl(selectedId); if (!el || el.type !== 'text') return;
      el.text = textInput.value;
      nodes.get(el.id).content.textContent = textInput.value;
      clearTimeout(textTimer); textTimer = setTimeout(pushHistory, 500);
    });
    function syncTextPane() {
      var el = selectedId && findEl(selectedId);
      var isText = !!(el && el.type === 'text');
      textEdit.hidden = !isText; textEmpty.hidden = isText;
      if (!isText) return;
      textInput.value = el.text;
      fontRow.querySelectorAll('.font-chip').forEach(function (c) { c.setAttribute('aria-pressed', String(c.dataset.f === el.font)); });
      textColors.querySelectorAll('.swatch').forEach(function (s) { s.setAttribute('aria-pressed', String(s.dataset.c === el.color)); });
    }

    /* ── Designs prêts à l'emploi ───────────────────────────────── */
    // La vignette est une mini-coque : comme les éléments se dimensionnent en
    // cqw (unité du conteneur), le même jeu de valeurs sert à l'aperçu et à
    // la coque réelle, sans facteur d'échelle à maintenir.
    var tplGrid = root.querySelector('[data-templates]');
    TEMPLATES.forEach(function (t) {
      var b = document.createElement('button');
      b.type = 'button'; b.className = 'tpl'; b.setAttribute('aria-label', 'Design ' + t.name);
      var thumb = document.createElement('span');
      thumb.className = 'tpl-thumb';
      t.els.forEach(function (e) {
        var s = document.createElement('span');
        s.className = 'tel';
        s.textContent = e.text;
        s.style.left = e.x + '%';
        s.style.top = e.y + '%';
        s.style.transform = 'translate(-50%,-50%) rotate(' + (e.rot || 0) + 'deg)';
        s.style.fontSize = e.size + 'cqw';
        if (e.type === 'text') { s.style.fontFamily = e.font; s.style.color = e.color; }
        thumb.appendChild(s);
      });
      var nm = document.createElement('span');
      nm.className = 'tpl-name'; nm.textContent = t.name;
      b.append(thumb, nm);
      b.addEventListener('click', function () { applyTemplate(t); });
      tplGrid.appendChild(b);
    });

    function applyTemplate(t) {
      if (state.elements.length &&
          !window.confirm('Remplacer votre composition actuelle par le design « ' + t.name + ' » ?')) return;
      state.elements = t.els.map(function (e) { return Object.assign({}, e, { id: ++seq }); });
      selectedId = null;
      renderAll(); pushHistory();
      toast('Design « ' + t.name + ' » appliqué');
      // On garde le panneau ouvert : la coque restant visible en mobile, on
      // peut comparer plusieurs designs sans faire d'aller-retour.
    }

    /* ── Stickers ───────────────────────────────────────────────── */
    var catRow = root.querySelector('[data-stickercats]');
    var grid = root.querySelector('[data-stickers]');
    function renderStickers(cat) {
      grid.innerHTML = '';
      STICKERS[cat].forEach(function (emo) {
        var b = document.createElement('button');
        b.type = 'button'; b.textContent = emo; b.setAttribute('aria-label', 'Sticker ' + emo);
        b.addEventListener('click', function () { addElement({ type: 'sticker', text: emo, size: 22 }); });
        grid.appendChild(b);
      });
      catRow.querySelectorAll('.chip').forEach(function (c) { c.setAttribute('aria-selected', String(c.dataset.cat === cat)); });
    }
    Object.keys(STICKERS).forEach(function (cat, i) {
      var c = document.createElement('button');
      c.type = 'button'; c.className = 'chip'; c.textContent = cat; c.dataset.cat = cat; c.setAttribute('role', 'tab');
      c.addEventListener('click', function () { renderStickers(cat); });
      catRow.appendChild(c);
      if (i === 0) renderStickers(cat);
    });

    /* ── Finition + téléphone ───────────────────────────────────── */
    var finishRow = root.querySelector('[data-finishes]');
    var deviceRow = root.querySelector('[data-devices]');
    FINISHES.forEach(function (f) {
      var b = document.createElement('button');
      b.type = 'button'; b.className = 'swatch' + (f.id === 'clear' ? ' swatch--clear' : '');
      b.dataset.v = f.id; if (f.id !== 'clear') b.style.background = f.id;
      b.title = f.label; b.setAttribute('aria-label', 'Finition ' + f.label);
      b.addEventListener('click', function () { state.finish = f.id; applyFinish(); pushHistory(); });
      finishRow.appendChild(b);
    });
    root.querySelectorAll('[data-mounts] button').forEach(function (b) {
      b.addEventListener('click', function () {
        state.mount = b.dataset.mountV;
        applyFinish(); renderCase(); pushHistory();
      });
    });
    DEVICES.forEach(function (d) {
      var b = document.createElement('button');
      b.type = 'button'; b.className = 'swatch'; b.dataset.v = d.id; b.style.background = d.id;
      b.title = d.label; b.setAttribute('aria-label', 'Téléphone ' + d.label);
      b.addEventListener('click', function () { state.device = d.id; applyFinish(); pushHistory(); });
      deviceRow.appendChild(b);
    });

    /* ── Photos ─────────────────────────────────────────────────── */
    root.querySelector('[data-pick]').addEventListener('click', function () { fileInput.click(); });
    function importFile(file) {
      if (!file || !/^image\//.test(file.type)) { toast('Choisissez un fichier image.', 'warn'); return; }
      var reader = new FileReader();
      reader.onload = function () {
        var img = new Image();
        img.onload = function () {
          // Redimensionnement avant stockage : une photo de 4000 px sature la
          // mémoire et fait exploser le quota de sauvegarde pour rien.
          var max = 1400, w = img.width, h = img.height;
          if (w > max || h > max) { var s = Math.min(max / w, max / h); w = Math.round(w * s); h = Math.round(h * s); }
          var cv = document.createElement('canvas'); cv.width = w; cv.height = h;
          cv.getContext('2d').drawImage(img, 0, 0, w, h);
          var out; try { out = cv.toDataURL('image/webp', .85); } catch (_) { out = ''; }
          if (!out || out.indexOf('data:image/webp') !== 0) out = cv.toDataURL('image/jpeg', .85);
          addElement({ type: 'image', src: out, size: 46 });
          toast('Photo ajoutée');
        };
        img.onerror = function () { toast('Image illisible.', 'warn'); };
        img.src = reader.result;
      };
      reader.readAsDataURL(file);
    }
    fileInput.addEventListener('change', function () {
      if (fileInput.files && fileInput.files[0]) importFile(fileInput.files[0]);
      fileInput.value = '';
    });
    ['dragenter', 'dragover'].forEach(function (ev) { caseEl.addEventListener(ev, function (e) { e.preventDefault(); caseEl.setAttribute('data-over', ''); }); });
    ['dragleave', 'drop'].forEach(function (ev) { caseEl.addEventListener(ev, function (e) { e.preventDefault(); caseEl.removeAttribute('data-over'); }); });
    caseEl.addEventListener('drop', function (e) { if (e.dataTransfer && e.dataTransfer.files[0]) importFile(e.dataTransfer.files[0]); });
    document.addEventListener('paste', function (e) {
      if (!e.clipboardData) return;
      var it = e.clipboardData.items;
      for (var i = 0; i < it.length; i++) if (it[i].type.indexOf('image') === 0) { importFile(it[i].getAsFile()); break; }
    });

    /* ── Modèle ─────────────────────────────────────────────────── */
    function setModel(label) {
      state.model = label || '';
      barModel.textContent = label ? label : 'Choisissez un modèle';
      renderCase();
    }
    document.addEventListener('model:change', function (e) {
      if (e.detail && e.detail.model) { setModel(e.detail.model); pushHistory(); }
    });

    /* ── Clavier ────────────────────────────────────────────────── */
    document.addEventListener('keydown', function (e) {
      if (editingId) { if (e.key === 'Escape' || e.key === 'Enter') { e.preventDefault(); exitEdit(); } return; }
      var tag = (e.target.tagName || '').toLowerCase();
      if (tag === 'input' || tag === 'textarea') return;
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'z') { e.preventDefault(); e.shiftKey ? redo() : undo(); return; }
      if (!selectedId) return;
      var el = findEl(selectedId); if (!el) return;
      if (e.key === 'Delete' || e.key === 'Backspace') { e.preventDefault(); removeElement(selectedId); return; }
      if (e.key === 'Escape') { deselect(); return; }
      var step = e.shiftKey ? 5 : 1, moved = true;
      if (e.key === 'ArrowLeft') el.x = clamp(el.x - step, 0, 100);
      else if (e.key === 'ArrowRight') el.x = clamp(el.x + step, 0, 100);
      else if (e.key === 'ArrowUp') el.y = clamp(el.y - step, 0, 100);
      else if (e.key === 'ArrowDown') el.y = clamp(el.y + step, 0, 100);
      else moved = false;
      if (moved) { e.preventDefault(); applyStyles(el); clearTimeout(textTimer); textTimer = setTimeout(pushHistory, 400); }
    });

    function toast(msg, kind) {
      toastEl.textContent = msg;
      if (kind) toastEl.dataset.kind = kind; else delete toastEl.dataset.kind;
      toastEl.hidden = false;
      clearTimeout(toast._t); toast._t = setTimeout(function () { toastEl.hidden = true; }, 2600);
    }

    /* ── Rendu pour la production ───────────────────────────────────
       Le studio compose en CSS ; l'atelier a besoin d'un fichier. On rejoue
       donc l'état sur un canvas, aux dimensions RÉELLES de la coque (les cotes
       en mm servent déjà aux proportions de l'aperçu).

       Deux sorties, volontairement :
        · l'aperçu, léger, affiché dans le panier et sur la fiche commande ;
        · le fichier d'impression à 300 dpi, celui qu'on envoie à l'imprimeur.
       Les découpes (caméra, boutons) ne sont PAS percées ici : le fichier est
       à fond perdu et c'est la production qui découpe. */
    // 600 dpi : la xTool O1 Omni sort en 720x1440 dpi, mais c'est la
    // résolution des têtes, pas celle attendue du fichier. 600 dpi donne des
    // lettrages et des liserés nets sans quadrupler inutilement le poids.
    var PRINT_DPI = 600;
    var PREVIEW_W = 520;
    var DEFAULT_MM = [71.5, 147.6];
    var EMOJI_FONT = '"Apple Color Emoji","Segoe UI Emoji","Noto Color Emoji",sans-serif';

    function caseMm() { return specOf(state.model).mm || DEFAULT_MM; }
    function printWidthPx() { return Math.round(caseMm()[0] * PRINT_DPI / 25.4); }

    // Contour arrondi repris du CSS : rayon horizontal en % de la LARGEUR,
    // rayon vertical 2,1 fois plus plat, rapporté à la HAUTEUR.
    function roundedRect(g, x, y, w, h, rx, ry) {
      rx = Math.min(rx, w / 2); ry = Math.min(ry, h / 2);
      var HALF = Math.PI / 2;
      g.beginPath();
      g.moveTo(x + rx, y);
      g.lineTo(x + w - rx, y);
      g.ellipse(x + w - rx, y + ry, rx, ry, 0, -HALF, 0);
      g.lineTo(x + w, y + h - ry);
      g.ellipse(x + w - rx, y + h - ry, rx, ry, 0, 0, HALF);
      g.lineTo(x + rx, y + h);
      g.ellipse(x + rx, y + h - ry, rx, ry, 0, HALF, Math.PI);
      g.lineTo(x, y + ry);
      g.ellipse(x + rx, y + ry, rx, ry, 0, Math.PI, Math.PI + HALF);
      g.closePath();
    }

    function casePath(g, w, h, radiusPct) {
      roundedRect(g, 0, 0, w, h, w * radiusPct / 100, h * (radiusPct / 2.1) / 100);
    }

    /* ── Découpe caméra ─────────────────────────────────────────────
       Le trou de l'objectif ne doit RIEN recevoir : la coque imprimée est
       percée, une encre posée là finirait sur le plateau de la machine. On
       reprend donc exactement la géométrie de renderCase(), en fractions de
       la coque, pour l'évider du fichier.
       Repères : le conteneur .cam est placé en % de la coque, et les formes
       à l'intérieur en % de ce conteneur. */
    function camShapes(fam) {
      var box, shapes = [];
      function rrect(radiusPct) {
        shapes.push({ kind: 'rrect', box: box, radius: radiusPct });
      }
      // Cercles répartis dans le conteneur (Galaxy, objectif unique) : la
      // largeur donne le diamètre, la hauteur suit (aspect-ratio: 1).
      function circles(leftPct, tops, sizePct) {
        tops.forEach(function (t) {
          shapes.push({ kind: 'circle', box: box, left: leftPct, top: t, size: sizePct });
        });
      }

      if (fam.cam === 'island3' || fam.cam === 'islandBig') {
        var big = fam.cam === 'islandBig';
        box = { l: 6, t: 3.2, w: big ? 42 : 39, h: big ? 20.5 : 19 };
        rrect(26);
      } else if (fam.cam === 'island2') {
        box = { l: 6, t: 3.2, w: 30, h: 14.5 };
        rrect(26);
      } else if (fam.cam === 'lenses3' || fam.cam === 'lenses4') {
        var four = fam.cam === 'lenses4';
        box = { l: 7, t: 3.5, w: 16, h: four ? 38 : 30 };
        circles(12, four ? [1, 26, 51, 76] : [2, 36, 70], 78);
      } else if (fam.cam === 'bar2' || fam.cam === 'bar3') {
        box = { l: 4, t: 6.5, w: 92, h: 8.2 };
        rrect(null);            // pilule : rayon = demi-hauteur
      } else if (fam.cam === 'single') {
        box = { l: 7, t: 3.5, w: 15, h: 9 };
        circles(0, [0], 100);
      } else if (fam.cam === 'dualv') {
        box = { l: 6, t: 3.4, w: 16, h: 17 };
        rrect(26);
      }
      return shapes;
    }

    /**
     * Évide (ou remplit) la zone caméra.
     * @param fill couleur pour l'aperçu ; null = découpe réelle pour l'impression
     */
    function punchCamera(g, w, h, fam, fill) {
      var shapes = camShapes(fam);
      if (!shapes.length) return;
      g.save();
      if (fill) g.fillStyle = fill;
      else g.globalCompositeOperation = 'destination-out';
      shapes.forEach(function (sh) {
        var bx = sh.box.l * w / 100, by = sh.box.t * h / 100;
        var bw = sh.box.w * w / 100, bh = sh.box.h * h / 100;
        if (sh.kind === 'rrect') {
          var rx = sh.radius === null ? bh / 2 : bw * sh.radius / 100;
          var ry = sh.radius === null ? bh / 2 : bh * sh.radius / 100;
          roundedRect(g, bx, by, bw, bh, rx, ry);
        } else {
          var d = sh.size * bw / 100;
          var cx = bx + sh.left * bw / 100 + d / 2;
          var cy = by + sh.top * bh / 100 + d / 2;
          g.beginPath();
          g.ellipse(cx, cy, d / 2, d / 2, 0, 0, Math.PI * 2);
        }
        g.fill();
      });
      g.restore();
    }

    // Les images sont des data URL : elles doivent être décodées AVANT le
    // dessin, sinon le canvas sort vide sans lever d'erreur.
    function loadImages() {
      var jobs = state.elements.filter(function (e) { return e.type === 'image' && e.src; });
      return Promise.all(jobs.map(function (el) {
        return new Promise(function (resolve) {
          var img = new Image();
          img.onload = function () { resolve({ id: el.id, img: img }); };
          img.onerror = function () { resolve(null); };
          img.src = el.src;
        });
      })).then(function (list) {
        var map = {};
        list.forEach(function (r) { if (r) map[r.id] = r.img; });
        return map;
      });
    }

    // Idem pour les polices : une police pas encore chargée est remplacée en
    // silence par la police par défaut sur le canvas.
    function loadFonts(scale) {
      if (!document.fonts || !document.fonts.load) return Promise.resolve();
      var jobs = state.elements
        .filter(function (e) { return e.type === 'text' && e.font; })
        .map(function (e) {
          return document.fonts.load(Math.round(e.size * scale) + 'px ' + e.font, e.text || 'A')
            .catch(function () {});
        });
      return Promise.all(jobs);
    }

    /**
     * Dessine la coque courante.
     * @param opts.width      largeur de sortie en pixels
     * @param opts.background couleur de fond pleine page (aperçu JPEG), sinon
     *                        le hors-coque reste transparent (fichier PNG)
     */
    function renderDesign(opts) {
      var mm = caseMm();
      var w = Math.round(opts.width);
      var h = Math.round(w * mm[1] / mm[0]);
      var scale = w / 100;                    // 1 cqw = 1 % de la largeur
      var cv = document.createElement('canvas');
      cv.width = w; cv.height = h;
      var g = cv.getContext('2d');

      return Promise.all([loadImages(), loadFonts(scale)]).then(function (out) {
        var images = out[0];

        // Le fond pleine page vient AVANT le détourage : en JPEG il n'y a pas
        // de transparence, sans lui le hors-coque virerait au noir.
        if (opts.background) { g.fillStyle = opts.background; g.fillRect(0, 0, w, h); }

        g.save();
        casePath(g, w, h, specOf(state.model).radius);
        g.clip();

        if (state.finish !== 'clear') { g.fillStyle = state.finish; g.fillRect(0, 0, w, h); }
        else if (opts.background) {
          // Coque transparente : sur l'aperçu on pose un voile clair, sinon le
          // design flotterait sur le fond et se lirait mal.
          g.fillStyle = 'rgba(255,255,255,.72)';
          g.fillRect(0, 0, w, h);
        }

        state.elements.forEach(function (el) {
          g.save();
          g.translate(el.x * w / 100, el.y * h / 100);
          g.rotate(el.rot * Math.PI / 180);
          if (el.type === 'image') {
            var img = images[el.id];
            if (img && img.naturalWidth) {
              var iw = el.size * scale;
              var ih = iw * (img.naturalHeight / img.naturalWidth);
              g.drawImage(img, -iw / 2, -ih / 2, iw, ih);
            }
          } else {
            var fs = el.size * scale;
            g.font = fs + 'px ' + (el.type === 'text' ? el.font : EMOJI_FONT);
            g.textAlign = 'center';
            g.textBaseline = 'middle';
            g.fillStyle = el.type === 'text' ? el.color : '#111113';
            g.fillText(el.text || '', 0, 0);
          }
          g.restore();
        });

        g.restore();
        // Après le détourage : l'évidement de la caméra vaut aussi pour
        // l'aperçu, pour que le client voie ce qui sera réellement imprimé.
        punchCamera(g, w, h, specOf(state.model), opts.background || null);
        return cv;
      });
    }

    /* ── Taille physique du PNG (chunk pHYs) ────────────────────────
       Un PNG sans pHYs s'ouvre à 72 dpi : la coque arriverait à ~14 cm de
       large dans le logiciel d'impression, et il faudrait la remettre à
       l'échelle à la main à chaque commande. On inscrit donc la résolution
       réelle dans le fichier, en pixels par mètre. */
    function pngWithDpi(dataUrl, dpi) {
      var b64 = dataUrl.slice(dataUrl.indexOf(',') + 1);
      var bin = atob(b64);
      var bytes = new Uint8Array(bin.length);
      for (var i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);

      // Table CRC32, exigée par le format pour chaque chunk.
      var table = pngWithDpi._t;
      if (!table) {
        table = pngWithDpi._t = new Uint32Array(256);
        for (var n = 0; n < 256; n++) {
          var c = n;
          for (var k = 0; k < 8; k++) c = (c & 1) ? (0xEDB88320 ^ (c >>> 1)) : (c >>> 1);
          table[n] = c >>> 0;
        }
      }
      function crc32(buf) {
        var c = 0xFFFFFFFF;
        for (var i = 0; i < buf.length; i++) c = table[(c ^ buf[i]) & 0xFF] ^ (c >>> 8);
        return (c ^ 0xFFFFFFFF) >>> 0;
      }

      var ppm = Math.round(dpi / 0.0254);   // pixels par mètre
      var chunk = new Uint8Array(21);       // 4 taille + 4 type + 9 donnees + 4 crc
      var dv = new DataView(chunk.buffer);
      dv.setUint32(0, 9);
      chunk.set([0x70, 0x48, 0x59, 0x73], 4);   // « pHYs »
      dv.setUint32(8, ppm);
      dv.setUint32(12, ppm);
      chunk[16] = 1;                             // unite : le metre
      dv.setUint32(17, crc32(chunk.subarray(4, 17)));

      // Le chunk se place juste apres IHDR (signature 8 o + 25 o d'IHDR).
      var at = 33;
      var out = new Uint8Array(bytes.length + chunk.length);
      out.set(bytes.subarray(0, at), 0);
      out.set(chunk, at);
      out.set(bytes.subarray(at), at + chunk.length);

      var str = '';
      for (var j = 0; j < out.length; j += 8192) {
        str += String.fromCharCode.apply(null, out.subarray(j, j + 8192));
      }
      return 'data:image/png;base64,' + btoa(str);
    }

    /* ── Panier ─────────────────────────────────────────────────────
       Le studio n'utilise pas les attributs data-item-* des fiches produit :
       il doit d'abord envoyer le design au serveur, puis ajouter la ligne avec
       l'identifiant reçu. D'où l'appel direct à l'API du widget. */
    var SHOP_ID = root.dataset.shopId || '';
    var API = root.dataset.api || '';
    var SKU = root.dataset.sku || 'coque-personnalisee';
    var PRICE_CENTS = parseInt(root.dataset.price, 10) || 0;
    // Au-delà, on n'embarque pas les photos dans la composition sauvegardée :
    // la commande reste juste (le PNG fait foi), seule la réédition perd les
    // images. Mieux que de faire échouer l'envoi.
    var STATE_MAX = 4 * 1024 * 1024;

    var addBtn = root.querySelector('[data-add]');
    var uploading = false;
    // Un même design ne remonte qu'une fois : recliquer sur « Ajouter » sans
    // rien changer réutilise l'identifiant au lieu d'empiler des doublons.
    var lastUpload = { hash: '', id: '', previewUrl: '' };

    function exportState() {
      var full = JSON.parse(snapshot());
      if (JSON.stringify(full).length <= STATE_MAX) return full;
      full.elements = full.elements.map(function (e) {
        if (e.type !== 'image') return e;
        var copy = Object.assign({}, e);
        delete copy.src;
        return copy;
      });
      full.imagesStripped = true;
      return full;
    }

    function uploadDesign() {
      var hash = snapshot();
      if (lastUpload.hash === hash && lastUpload.id) return Promise.resolve(lastUpload);
      if (!API || !SHOP_ID) return Promise.reject(new Error('Panier non configuré.'));

      return Promise.all([
        renderDesign({ width: PREVIEW_W, background: '#f1f0ed' }),
        renderDesign({ width: printWidthPx() }),
      ]).then(function (canvases) {
        return fetch(API + '/api/public/design', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            shop_id: SHOP_ID,
            model: state.model,
            finish: state.finish,
            state: exportState(),
            preview: canvases[0].toDataURL('image/jpeg', 0.82),
            print: pngWithDpi(canvases[1].toDataURL('image/png'), PRINT_DPI),
          }),
        });
      }).then(function (r) {
        if (!r.ok) return r.json().then(function (e) { throw new Error(e.error || 'HTTP ' + r.status); });
        return r.json();
      }).then(function (res) {
        lastUpload = { hash: hash, id: res.id, previewUrl: res.previewUrl };
        return lastUpload;
      });
    }

    function setUploading(on) {
      uploading = on;
      addBtn.disabled = on;
      addBtn.setAttribute('aria-busy', on ? 'true' : 'false');
    }

    // <ModelPicker> bloque déjà le clic tant qu'aucun modèle n'est choisi (il
    // écoute en phase de capture) : ici on ne traite que le cas « coque vide ».
    addBtn.addEventListener('click', function (e) {
      if (uploading) { e.preventDefault(); e.stopPropagation(); return; }
      if (!state.elements.length) {
        e.preventDefault(); e.stopPropagation();
        toast('Ajoutez au moins un élément à votre coque.', 'warn');
        openPane('sticker');
        return;
      }
      var m = ''; try { m = localStorage.getItem(MODEL_KEY) || ''; } catch (_) {}
      if (!m) return;   // le sélecteur de modèle prend la main

      e.preventDefault();
      save();
      deselect();
      setUploading(true);
      toast('Préparation de votre coque…');

      uploadDesign().then(function (up) {
        if (!window.AtelierCheckout || !window.AtelierCheckout.add) {
          throw new Error('Panier indisponible.');
        }
        window.AtelierCheckout.add({
          product: {
            // L'identifiant du design rend la ligne unique : deux coques
            // différentes ne fusionnent pas en « quantité 2 ».
            id: 'custom::' + up.id,
            name: 'Coque personnalisée — ' + (state.model || m),
            price: PRICE_CENTS,
            image: up.previewUrl,
            // Ce que l'atelier lit pour savoir quoi imprimer, et sur quel moule.
            meta: { design_id: up.id, model: state.model || m, finish: state.finish, sku: SKU },
          },
          quantity: 1,
        });
        toast('Design ajouté au panier !');
      }).catch(function (err) {
        console.error('[studio] ajout au panier', err);
        toast("Ajout impossible pour l'instant. Réessayez.", 'warn');
      }).then(function () {
        setUploading(false);
      });
    });

    /* ── Réédition d'un design déjà au panier ───────────────────────
       Le panier renvoie ici avec ?design=<id>. On récupère la composition
       côté serveur : la copie locale peut avoir été écrasée depuis (autre
       appareil, autre design commencé entre-temps). */
    var DESIGN_ID_RE = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;

    function restoreFromUrl() {
      var id = '';
      try { id = new URL(window.location.href).searchParams.get('design') || ''; } catch (_) {}
      if (!id || !DESIGN_ID_RE.test(id) || !API) return;

      fetch(API + '/api/public/design/' + id)
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (d) {
          if (!d || !d.state || !Array.isArray(d.state.elements)) return;
          state = Object.assign(state, d.state);
          seq = state.elements.reduce(function (mx, e) { return Math.max(mx, e.id || 0); }, 0);
          if (d.model) {
            state.model = d.model;
            try { localStorage.setItem(MODEL_KEY, d.model); } catch (_) {}
            setModel(d.model);
          }
          renderAll();
          save();
          history = [snapshot()]; hIndex = 0; syncHistory();
          // Le design rechargé EST celui déjà au panier : on mémorise son
          // identifiant pour qu'un « Ajouter » sans modification ne crée pas
          // un second exemplaire côté serveur.
          lastUpload = { hash: snapshot(), id: d.id, previewUrl: API + '/api/public/design/' + d.id + '/preview' };
          if (d.state.imagesStripped) {
            toast('Composition rechargée, sauf les photos importées.', 'warn');
          } else {
            toast('Composition rechargée.');
          }
        })
        .catch(function () {});
    }

    /* ── Démarrage ──────────────────────────────────────────────── */
    (function init() {
      // Signale que cette page est l'éditeur : verrouille le défilement et
      // masque le pied de page en mobile (cf. <style is:global>).
      document.documentElement.setAttribute('data-studio-app', '');
      var saved = null; try { saved = localStorage.getItem(STORE); } catch (_) {}
      if (saved) {
        try {
          var d = JSON.parse(saved);
          if (d && Array.isArray(d.elements)) { state = Object.assign(state, d); seq = state.elements.reduce(function (m, e) { return Math.max(m, e.id || 0); }, 0); }
        } catch (_) {}
      }
      var m = ''; try { m = localStorage.getItem(MODEL_KEY) || ''; } catch (_) {}
      if (m) state.model = m;
      setModel(state.model);
      renderAll();
      history = [snapshot()]; hIndex = 0; syncHistory();
      // Réédition depuis le panier (/personnaliser?design=<id>) : on recharge
      // la composition telle qu'elle a été envoyée. Asynchrone, donc posé
      // APRÈS le premier rendu pour ne pas retarder l'affichage.
      restoreFromUrl();
      // On ouvre d'emblée le panneau le plus utile : le modèle s'il manque,
      // sinon les designs (démarrer d'une base plutôt que d'une page blanche).
      if (window.matchMedia('(min-width: 1024px)').matches) openPane(state.model ? 'design' : 'model');
    })();
  })();
</script>
