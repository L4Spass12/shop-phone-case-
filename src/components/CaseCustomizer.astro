      // repli sur un délai court.
      var run = function () { brickRaf = 0; drawBrickLayer(); };
      brickRaf = document.hidden ? setTimeout(run, 16) : requestAnimationFrame(run);
    }
    function drawBrickLayer() {
      if (state.fx !== 'bricks') { brickLayer.hidden = true; return; }
      var list = [];
      state.elements.forEach(function (el) {
        if (el.type !== 'image' || !el.src) return;
        var ref = nodes.get(el.id), img = ref && ref.node.querySelector('img');
        if (img && img.naturalWidth) list.push({ el: el, img: img });
      });
