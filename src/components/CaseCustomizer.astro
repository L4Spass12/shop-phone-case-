              if (sh > nh) { sh = nh; sw = nh / ar; }
              var ox = el.ox == null ? .5 : el.ox, oy = el.oy == null ? .5 : el.oy;
              g.drawImage(pimg, (nw - sw) * ox, (nh - sh) * oy, sw, sh, -fw / 2 + pad, -fh / 2 + pad, pw, ph);
            }
          } else if (el.type === 'image') {
            var img = images[el.id];
            if (img && img.naturalWidth) {
              var iw = el.size * scale;
              var ih = iw * (img.naturalHeight / img.naturalWidth);
              g.drawImage(img, -iw / 2, -ih / 2, iw, ih);
            }
          } else {
            var fs = el.size * scale;
            g.font = fs + 'px ' + (el.type === 'text' ? el.font : EMOJI_FONT);
            g.textAlign = 'center';
            g.textBaseline = 'middle';
            if (el.type === 'text' && el.outline) {
              g.lineJoin = 'round'; g.lineWidth = fs * .11; g.strokeStyle = el.outline;
              g.strokeText(el.text || '', 0, 0);
            }
            g.fillStyle = el.type === 'text' ? el.color : '#111113';
            g.fillText(el.text || '', 0, 0);
          }
          g.restore();
        }

        // Avec une planche : les photos des cadres dessous, la planche, puis
        // les éléments ajoutés par le client par-dessus (comme à l'écran).
        var under = state.elements, over = [];
        if (ovImg && ovImg.naturalWidth) {
          under = state.elements.filter(function (e) { return e.slot; });
          over = state.elements.filter(function (e) { return !e.slot; });
        }
        under.forEach(drawEl);
        if (ovImg && ovImg.naturalWidth) g.drawImage(ovImg, 0, 0, w, h);
        over.forEach(drawEl);

        g.restore();
        // Après le détourage : l'évidement de la caméra vaut aussi pour
        // l'aperçu, pour que le client voie ce qui sera réellement imprimé.
        punchCamera(g, w, h, specOf(state.model), opts.background || null);
        return cv;
      });
    }

    /* ── Taille physique du PNG (chunk pHYs) ────────────────────────
       Un PNG sans pHYs s'ouvre à 72 dpi : la coque arriverait à ~14 cm de
       large dans le logiciel d'impression, et il faudrait la remettre à
       l'échelle à la main à chaque commande. On inscrit donc la résolution
       réelle dans le fichier, en pixels par mètre. */
    function pngWithDpi(dataUrl, dpi) {
      var b64 = dataUrl.slice(dataUrl.indexOf(',') + 1);
      var bin = atob(b64);
      var bytes = new Uint8Array(bin.length);
      for (var i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);

      // Table CRC32, exigée par le format pour chaque chunk.
      var table = pngWithDpi._t;
      if (!table) {
        table = pngWithDpi._t = new Uint32Array(256);
        for (var n = 0; n < 256; n++) {
          var c = n;
          for (var k = 0; k < 8; k++) c = (c & 1) ? (0xEDB88320 ^ (c >>> 1)) : (c >>> 1);
          table[n] = c >>> 0;
        }
      }
      function crc32(buf) {
        var c = 0xFFFFFFFF;
        for (var i = 0; i < buf.length; i++) c = table[(c ^ buf[i]) & 0xFF] ^ (c >>> 8);
        return (c ^ 0xFFFFFFFF) >>> 0;
      }

      var ppm = Math.round(dpi / 0.0254);   // pixels par mètre
      var chunk = new Uint8Array(21);       // 4 taille + 4 type + 9 donnees + 4 crc
      var dv = new DataView(chunk.buffer);
      dv.setUint32(0, 9);
      chunk.set([0x70, 0x48, 0x59, 0x73], 4);   // « pHYs »
      dv.setUint32(8, ppm);
      dv.setUint32(12, ppm);
      chunk[16] = 1;                             // unite : le metre
      dv.setUint32(17, crc32(chunk.subarray(4, 17)));

      // Le chunk se place juste apres IHDR (signature 8 o + 25 o d'IHDR).
      var at = 33;
      var out = new Uint8Array(bytes.length + chunk.length);
      out.set(bytes.subarray(0, at), 0);
      out.set(chunk, at);
      out.set(bytes.subarray(at), at + chunk.length);

      var str = '';
      for (var j = 0; j < out.length; j += 8192) {
        str += String.fromCharCode.apply(null, out.subarray(j, j + 8192));
      }
      return 'data:image/png;base64,' + btoa(str);
    }

    /* ── Panier ─────────────────────────────────────────────────────
       Le studio n'utilise pas les attributs data-item-* des fiches produit :
       il doit d'abord envoyer le design au serveur, puis ajouter la ligne avec
       l'identifiant reçu. D'où l'appel direct à l'API du widget. */
    var SHOP_ID = root.dataset.shopId || '';
    var API = root.dataset.api || '';
    var SKU = root.dataset.sku || 'coque-personnalisee';
    var PRICE_CENTS = parseInt(root.dataset.price, 10) || 0;
    var RELIEF_SKU = 'custom-relief';
    var RELIEF_PRICE_CENTS = parseInt(root.dataset.reliefPrice, 10) || PRICE_CENTS;
    // Au-delà, on n'embarque pas les photos dans la composition sauvegardée :
    // la commande reste juste (le PNG fait foi), seule la réédition perd les
    // images. Mieux que de faire échouer l'envoi.
    var STATE_MAX = 4 * 1024 * 1024;

    var addBtn = root.querySelector('[data-add]');
    var uploading = false;
    // Un même design ne remonte qu'une fois : recliquer sur « Ajouter » sans
    // rien changer réutilise l'identifiant au lieu d'empiler des doublons.
    var lastUpload = { hash: '', id: '', previewUrl: '' };

    function exportState() {
      var full = JSON.parse(snapshot());
      if (JSON.stringify(full).length <= STATE_MAX) return full;
      full.elements = full.elements.map(function (e) {
        if (e.type !== 'image') return e;
        var copy = Object.assign({}, e);
        delete copy.src;
        return copy;
      });
      full.imagesStripped = true;
      return full;
    }

    /* Rend la main au navigateur le temps d'un vrai rendu. Le tracé du fichier
       d'impression bloque le fil principal une seconde ou deux : sans cette
       pause, le voile de chargement n'est peint qu'APRÈS, donc jamais vu. */
    function paintPause() {
      return new Promise(function (done) {
        requestAnimationFrame(function () { requestAnimationFrame(function () { done(); }); });
      });
    }

    /* Fichier d'impression en PNG, avec sa résolution inscrite. Le serveur
       refuse au-delà de 24 Mo : si une photo très détaillée fait dépasser,
       on redessine un peu moins grand (et la résolution inscrite suit, pour
       garder la taille réelle de la coque) plutôt que de bloquer le client. */
    var PRINT_MAX_CHARS = 31 * 1000 * 1000;   // ~23 Mo une fois décodé
    function printFile(f) {
      return renderDesign({ width: printWidthPx() * f, hi: true }).then(function (cv) {
        var url = pngWithDpi(cv.toDataURL('image/png'), Math.round(PRINT_DPI * f));
        if (url.length > PRINT_MAX_CHARS && f > 0.5) return printFile(Math.round(f * 85) / 100);
        return url;
      });
    }

    function uploadDesign(step) {
      var say = step || function () {};
      var hash = snapshot();
      if (lastUpload.hash === hash && lastUpload.id) return Promise.resolve(lastUpload);
      if (!API || !SHOP_ID) return Promise.reject(new Error(I.cartNotSet));

      say(I.rendering);
      return paintPause().then(function () {
        return Promise.all([
          renderDesign({ width: PREVIEW_W, background: '#f1f0ed' }),
          printFile(1),
        ]);
      }).then(function (canvases) {
        say(I.printFile);
        return paintPause().then(function () { return canvases; });
      }).then(function (canvases) {
        say(I.sending);
        return fetch(API + '/api/public/design', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            shop_id: SHOP_ID,
            model: state.model,
            finish: state.finish,
            state: exportState(),
            preview: canvases[0].toDataURL('image/jpeg', 0.82),
            print: canvases[1],
          }),
        });
      }).then(function (r) {
        if (!r.ok) return r.json().then(function (e) { throw new Error(e.error || 'HTTP ' + r.status); });
        return r.json();
      }).then(function (res) {
        lastUpload = { hash: hash, id: res.id, previewUrl: res.previewUrl };
        return lastUpload;
      });
    }

    var busyEl   = root.querySelector('[data-busy]');
    var busyCard = root.querySelector('[data-busycard]');
    var busyMsg  = root.querySelector('[data-busymsg]');
    var busySub  = root.querySelector('[data-busysub]');
    var busyArc  = root.querySelector('[data-busyarc]');
    var busyActs = root.querySelector('[data-busyactions]');
    var RING = 125.66;                 // 2πr, r = 20
    var STEPS = 4;                     // rendu, fichier, envoi, panier

    /* Avance l'anneau. Une progression par étapes plutôt qu'un pourcentage
       inventé : les quatre étapes sont réelles et de durées comparables, donc
       le quart franchi veut dire quelque chose. */
    function busyStep(n, msg) {
      if (msg) busyMsg.textContent = msg;
      busyArc.style.strokeDashoffset = String(RING * (1 - Math.min(n, STEPS) / STEPS));
    }

    function setUploading(on, msg) {
      uploading = on;
      addBtn.disabled = on;
      addBtn.setAttribute('aria-busy', on ? 'true' : 'false');
      if (on) {
        busyCard.removeAttribute('data-done');
        busyActs.hidden = true;
        busySub.textContent = I.wait;
        busyArc.style.strokeDashoffset = String(RING);
        if (msg) busyMsg.textContent = msg;
      }
      busyEl.hidden = !on;
    }

    /* Succès : on NE referme pas tout seul. Voir la coche, lire « ajouté » et
       décider soi-même entre le panier et une nouvelle création vaut mieux
       qu'un écran qui disparaît avant d'avoir été lu. */
    function showSuccess(label) {
      busyStep(STEPS);
      busyCard.setAttribute('data-done', '');
      busyMsg.textContent = I.added;
      busySub.textContent = label;
      busyActs.hidden = false;
      addBtn.disabled = false;
      addBtn.setAttribute('aria-busy', 'false');
      uploading = false;
    }

    root.querySelector('[data-opencart]').addEventListener('click', function () {
      busyEl.hidden = true;
      closeStep();
      if (window.AtelierCheckout && window.AtelierCheckout.open) window.AtelierCheckout.open();
    });
    root.querySelector('[data-busyclose]').addEventListener('click', function () {
      busyEl.hidden = true;
      closeStep();
    });

    /* ── Étape 2 : mode d'impression ────────────────────────────────
       Le mode change le PRIX, donc la clé d'article : « custom » à plat,
       « custom-relief » en relief. C'est cette clé que le serveur de paiement
       relit dans le manifeste de la vitrine pour fixer le montant, annoncer
       un supplément depuis le navigateur ne protégerait rien. */
    var stepEl   = root.querySelector('[data-step]');
    var nextBtn  = root.querySelector('[data-next]');
    var backBtn  = root.querySelector('[data-stepback]');
    var totalEl  = root.querySelector('[data-steptotal]');
    var modeBtns = Array.prototype.slice.call(root.querySelectorAll('[data-mode]'));
    var printMode = 'flat';

    function money(cents) { return (cents / 100).toFixed(2).replace('.', ',') + ' \u20AC'; }
    function modePrice() { return printMode === 'relief' ? RELIEF_PRICE_CENTS : PRICE_CENTS; }

    function setMode(mode) {
      printMode = mode === 'relief' ? 'relief' : 'flat';
      modeBtns.forEach(function (b) {
        b.setAttribute('aria-checked', String(b.dataset.mode === printMode));
      });
      totalEl.textContent = money(modePrice());
    }
    modeBtns.forEach(function (b) {
      b.addEventListener('click', function () { setMode(b.dataset.mode); });
    });

    function openStep() {
      stepEl.hidden = false;
      // Reflow avant d'ajouter la classe : sans lui l'état de départ n'est pas
      // committé et la transition ne se joue pas (même mécanique que le
      // panneau latéral).
      void stepEl.offsetHeight;
      stepEl.classList.add('step--in');
      var checked = modeBtns.filter(function (b) { return b.getAttribute('aria-checked') === 'true'; })[0];
      if (checked) checked.focus();
    }
    function closeStep() {
      stepEl.classList.remove('step--in');
      setTimeout(function () { stepEl.hidden = true; }, 340);
      nextBtn.focus();
    }
    backBtn.addEventListener('click', closeStep);
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && !stepEl.hidden) closeStep();
    });

    // « Continuer » : mêmes garde-fous qu'avant (modèle choisi, coque non
    // vide), mais on ouvre l'étape au lieu d'ajouter. Le téléversement n'a
    // lieu qu'à l'ajout réel : inutile d'envoyer un design que le client va
    // peut-être abandonner ici.
    nextBtn.addEventListener('click', function (e) {
      if (!state.elements.length && !state.bg) {
        e.preventDefault(); e.stopPropagation();
        toast('Ajoutez au moins un élément à votre coque.', 'warn');
        openPane('design');
        return;
      }
      var m = ''; try { m = localStorage.getItem(MODEL_KEY) || ''; } catch (_) {}
      if (!m) return;   // le sélecteur de modèle prend la main

      e.preventDefault();
      save();
      deselect();
      openStep();
    });

    addBtn.addEventListener('click', function (e) {
      if (uploading) { e.preventDefault(); e.stopPropagation(); return; }
      // Mode atelier : le design est rattaché à la demande du client au lieu
      // d'aller dans le panier.
      if (atelier && atelier.info) { e.preventDefault(); saveForRequest(); return; }
      var m = ''; try { m = localStorage.getItem(MODEL_KEY) || ''; } catch (_) {}
      e.preventDefault();
      var vides = state.elements.filter(isEmptySlot).length;
      if (vides && !window.confirm(fill(I.slotsLeft, vides))) return;
      setUploading(true, I.preparingCase);

      var mode = printMode;
      var sku = mode === 'relief' ? RELIEF_SKU : SKU;
      var cents = modePrice();

      var done = 0;
      uploadDesign(function (m) { busyStep(done++, m); }).then(function (up) {
        busyStep(3, I.addingCart);
        if (!window.AtelierCheckout || !window.AtelierCheckout.add) {
          throw new Error(I.cartUnavailable);
        }
        window.AtelierCheckout.add({
          product: {
            // La clé ET l'identifiant du design rendent la ligne unique : la
            // même composition commandée à plat puis en relief donne deux
            // lignes, pas une quantité 2 au mauvais prix.
            id: sku + '::' + up.id,
            name: I.itemName[mode === 'relief' ? 'relief' : 'flat']
                  + ' · ' + (state.model || m),
            price: cents,
            image: up.previewUrl,
            // Ce que l'atelier lit pour savoir quoi imprimer, et comment.
            meta: {
              design_id: up.id,
              model: state.model || m,
              finish: state.finish,
              sku: sku,
              print_mode: mode,
            },
          },
          quantity: 1,
        });
        showSuccess(I.success[mode === 'relief' ? 'relief' : 'flat']
                    + ' · ' + (state.model || m));
      }).catch(function (err) {
        console.error('[studio] ajout au panier', err);
        setUploading(false);
        toast(I.addFailed, 'warn');
      });
    });

    /* ── Réédition d'un design déjà au panier ───────────────────────
       Le panier renvoie ici avec ?design=<id>. On récupère la composition
       côté serveur : la copie locale peut avoir été écrasée depuis (autre
       appareil, autre design commencé entre-temps). */
    var DESIGN_ID_RE = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;

    function restoreFromUrl() {
      var id = '';
      try { id = new URL(window.location.href).searchParams.get('design') || ''; } catch (_) {}
      if (!id || !DESIGN_ID_RE.test(id) || !API) return;

      fetch(API + '/api/public/design/' + id)
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (d) {
          if (!d || !d.state || !Array.isArray(d.state.elements)) return;
          state = Object.assign(state, d.state);
          seq = state.elements.reduce(function (mx, e) { return Math.max(mx, e.id || 0); }, 0);
          hiRestore();
          if (d.model) {
            state.model = d.model;
            try { localStorage.setItem(MODEL_KEY, d.model); } catch (_) {}
            setModel(d.model);
          }
          renderAll();
          save();
          history = [snapshot()]; hIndex = 0; syncHistory();
          // Le design rechargé EST celui déjà au panier : on mémorise son
          // identifiant pour qu'un « Ajouter » sans modification ne crée pas
          // un second exemplaire côté serveur.
          lastUpload = { hash: snapshot(), id: d.id, previewUrl: API + '/api/public/design/' + d.id + '/preview' };
          if (d.state.imagesStripped) {
            toast(I.reloadedNoPhotos, 'warn');
          } else {
            toast(I.reloaded);
          }
        })
        .catch(function () {});
    }


    /* ── Demande de design (« On crée votre design ») ──────────────
       Le client décrit son idée et joint ses images ; l'atelier crée la
       coque et la lui renvoie par e-mail. Les images sont recompressées ici
       (2 400 px au plus) : assez pour servir de matière à l'impression, assez
       léger pour l'envoi depuis un téléphone. */
    var LANG = root.dataset.lang || 'fr';
    var helpForm = root.querySelector('[data-helpform]');
    var helpDone = root.querySelector('[data-helpdone]');
    var helpThumbs = root.querySelector('[data-helpthumbs]');
    var helpFile = root.querySelector('[data-helpfile]');
    var helpModelEl = root.querySelector('[data-helpmodelval]');
    var helpModelNone = helpModelEl ? helpModelEl.textContent : '';
    var helpImgs = [];
    var HELP_MAX_CHARS = 8000000; // ~6 Mo décodés, la limite du serveur

    function helpSyncModel() {
      if (helpModelEl) helpModelEl.textContent = state.model || helpModelNone;
    }
    function helpCompress(file) {
      return new Promise(function (done) {
        var rd = new FileReader();
        rd.onload = function () {
          var img = new Image();
          img.onload = function () {
            var max = 2400, w = img.width, h = img.height;
            if (w > max || h > max) { var k = Math.min(max / w, max / h); w = Math.round(w * k); h = Math.round(h * k); }
            var cv = document.createElement('canvas'); cv.width = w; cv.height = h;
            cv.getContext('2d').drawImage(img, 0, 0, w, h);
            var out = '';
            try {
              if (file.type === 'image/png') {
                out = cv.toDataURL('image/webp', .92);
                if (out.indexOf('data:image/webp') !== 0) out = cv.toDataURL('image/png');
              } else out = cv.toDataURL('image/jpeg', .9);
              if (out.length > HELP_MAX_CHARS) out = cv.toDataURL('image/jpeg', .82);
            } catch (_) { out = ''; }
            done(out || null);
          };
          img.onerror = function () { done(null); };
          img.src = rd.result;
        };
        rd.onerror = function () { done(null); };
        rd.readAsDataURL(file);
      });
    }
    function helpRender() {
      helpThumbs.innerHTML = '';
      helpImgs.forEach(function (src, i) {
        var d = document.createElement('div'); d.className = 'help-thumb';
        var im = document.createElement('img'); im.src = src; im.alt = '';
        var x = document.createElement('button'); x.type = 'button'; x.textContent = '×'; x.setAttribute('aria-label', I.del || 'x');
        x.addEventListener('click', function () { helpImgs.splice(i, 1); helpRender(); });
        d.appendChild(im); d.appendChild(x); helpThumbs.appendChild(d);
      });
    }
    function helpAdd(files) {
      var list = Array.prototype.slice.call(files || []).filter(function (f) { return /^image\//.test(f.type); });
      if (helpImgs.length + list.length > 5) toast(I.helpTooMany, 'warn');
      list = list.slice(0, Math.max(0, 5 - helpImgs.length));
      list.reduce(function (p, f) {
        return p.then(function () { return helpCompress(f); }).then(function (u) {
          if (u) { helpImgs.push(u); helpRender(); } else toast(I.unreadable, 'warn');
        });
      }, Promise.resolve());
    }
    if (helpForm) {
      root.querySelector('[data-helppick]').addEventListener('click', function () { helpFile.click(); });
      helpFile.addEventListener('change', function () { helpAdd(helpFile.files); helpFile.value = ''; });
      root.querySelector('[data-helpmodel]').addEventListener('click', function () {
        var tr = root.querySelector('#studio-model [data-mp-trigger]') || root.querySelector('[data-mp-trigger]');
        if (tr) tr.click();
      });
      document.addEventListener('model:change', helpSyncModel);
      helpForm.addEventListener('submit', function (e) {
        e.preventDefault();
        var desc = root.querySelector('[data-helpdesc]').value.trim();
        var email = root.querySelector('[data-helpemail]').value.trim();
        if (desc.length < 10 || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { toast(I.helpMissing, 'warn'); return; }
        if (!API || !SHOP_ID) { toast(I.helpErr, 'warn'); return; }
        var btn = root.querySelector('[data-helpsend]');
        var label = btn.textContent;
        btn.disabled = true; btn.textContent = I.helpSending;
        var body = {
          shop_id: SHOP_ID, email: email, description: desc, lang: LANG,
          images: helpImgs, website: root.querySelector('[data-helphp]').value,
        };
        if (state.model) body.model = state.model;
        fetch(API + '/api/public/design-request', {
          method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body),
        }).then(function (r) {
          if (!r.ok) throw new Error('HTTP ' + r.status);
          helpForm.hidden = true; helpDone.hidden = false;
          helpImgs = []; helpRender();
        }).catch(function (err) {
          console.error('[studio] demande de design', err);
          toast(I.helpErr, 'warn');
        }).then(function () { btn.disabled = false; btn.textContent = label; });
      });
    }

    /* ── Mode atelier ───────────────────────────────────────────────
       Ouvert depuis l'admin (« Créer dans le studio ») avec
       ?atelier=<demande>.<jeton> : la demande s'affiche en bandeau, ses
       images s'ajoutent à la coque en un clic, et le bouton final rattache
       le design à la demande au lieu de l'ajouter au panier. */
    var atelier = null;
    (function () {
      var p = '';
      try { p = new URL(window.location.href).searchParams.get('atelier') || ''; } catch (_) {}
      var m = /^([0-9a-f-]{36})\.([0-9a-f]{32})$/i.exec(p);
      if (!m || !API) return;
      atelier = { id: m[1], t: m[2], info: null };
      var base = API + '/api/public/design-request/' + atelier.id;
      fetch(base + '?t=' + atelier.t).then(function (r) { return r.ok ? r.json() : null; }).then(function (d) {
        if (!d) { toast('Demande introuvable ou lien expiré.', 'warn'); atelier = null; return; }
        atelier.info = d;
        if (d.model) setModel(d.model);
        var lbl = root.querySelector('.step-add-l');
        if (lbl) lbl.textContent = 'Enregistrer pour ' + d.name;
        var bar = document.createElement('div');
        bar.className = 'atelier-bar';
        var title = document.createElement('strong');
        title.textContent = 'Mode atelier · demande de ' + d.name
          + (d.model ? ' · ' + d.model : '')
          + (d.finish ? ' · ' + (d.finish === 'relief' ? 'relief' : 'à plat') : '');
        var desc = document.createElement('p'); desc.textContent = d.description;
        var imgs = document.createElement('div'); imgs.className = 'atelier-imgs';
        for (var n = 1; n <= (d.images || 0); n++) {
          (function (n) {
            var url = base + '/image/' + n + '?t=' + atelier.t;
            var b = document.createElement('button'); b.type = 'button'; b.title = 'Ajouter cette image à la coque';
            var im = document.createElement('img'); im.src = url; im.alt = '';
            var sp = document.createElement('span'); sp.textContent = 'Utiliser';
            b.appendChild(im); b.appendChild(sp);
            b.addEventListener('click', function () {
              fetch(url).then(function (r) { return r.blob(); }).then(function (blob) {
                importFile(new File([blob], 'demande-' + n, { type: blob.type || 'image/jpeg' }));
              }).catch(function () { toast(I.unreadable, 'warn'); });
            });
            imgs.appendChild(b);
          })(n);
        }
        bar.appendChild(title); bar.appendChild(desc); bar.appendChild(imgs);
        document.body.appendChild(bar);
      }).catch(function () { atelier = null; });
    })();

    function saveForRequest() {
      setUploading(true, I.preparingCase);
      var done = 0;
      uploadDesign(function (m) { busyStep(done++, m); }).then(function (up) {
        busyStep(3, 'Rattachement à la demande…');
        return fetch(API + '/api/public/design-request/' + atelier.id, {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ t: atelier.t, design_id: up.id }),
        }).then(function (r) { if (!r.ok) throw new Error('HTTP ' + r.status); });
      }).then(function () {
        showSuccess('');
        busyMsg.textContent = 'Design enregistré pour ' + atelier.info.name;
        busySub.textContent = "Envoyez-le depuis l'admin, onglet Demandes de design.";
        var oc = root.querySelector('[data-opencart]'); if (oc) oc.hidden = true;
      }).catch(function (err) {
        console.error('[studio] atelier', err);
        setUploading(false);
        toast('Enregistrement impossible, réessayez.', 'warn');
      });
    }

    /* ── Démarrage ──────────────────────────────────────────────── */
    (function init() {
      // Signale que cette page est l'éditeur : verrouille le défilement et
      // masque le pied de page en mobile (cf. <style is:global>).
      document.documentElement.setAttribute('data-studio-app', '');
      var saved = null; try { saved = localStorage.getItem(STORE); } catch (_) {}
      if (saved) {
        try {
          var d = JSON.parse(saved);
          if (d && Array.isArray(d.elements)) { state = Object.assign(state, d); seq = state.elements.reduce(function (m, e) { return Math.max(m, e.id || 0); }, 0); }
        } catch (_) {}
      }
      var m = ''; try { m = localStorage.getItem(MODEL_KEY) || ''; } catch (_) {}
      if (m) state.model = m;
      setModel(state.model);
      renderAll();
      history = [snapshot()]; hIndex = 0; syncHistory();
      hiRestore();
      // Réédition depuis le panier (/personnaliser?design=<id>) : on recharge
      // la composition telle qu'elle a été envoyée. Asynchrone, donc posé
      // APRÈS le premier rendu pour ne pas retarder l'affichage.
      restoreFromUrl();
      // On ouvre d'emblée les designs : démarrer d'une base plutôt que d'une
      // page blanche. Le modèle, lui, se choisit dans la barre du haut.
      // Lien direct vers l'aide (/personnaliser/?aide, depuis la FAQ) : le
      // formulaire « On crée votre design » s'ouvre tout de suite.
      if (/[?&]aide\b/.test(location.search)) openPane('help');
      else if (window.matchMedia('(min-width: 1024px)').matches) openPane('design');
    })();
  })();
</script>
