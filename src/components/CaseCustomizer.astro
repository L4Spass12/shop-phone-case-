      if (kind) toastEl.dataset.kind = kind; else delete toastEl.dataset.kind;
      toastEl.hidden = false;
      clearTimeout(toast._t); toast._t = setTimeout(function () { toastEl.hidden = true; }, 2600);
    }

    /* ── Rendu pour la production ───────────────────────────────────
       Le studio compose en CSS ; l'atelier a besoin d'un fichier. On rejoue
       donc l'état sur un canvas, aux dimensions RÉELLES de la coque (les cotes
       en mm servent déjà aux proportions de l'aperçu).

       Deux sorties, volontairement :
        · l'aperçu, léger, affiché dans le panier et sur la fiche commande ;
        · le fichier d'impression à 300 dpi, celui qu'on envoie à l'imprimeur.
       Les découpes (caméra, boutons) ne sont PAS percées ici : le fichier est
       à fond perdu et c'est la production qui découpe. */
    // 600 dpi : la xTool O1 Omni sort en 720x1440 dpi, mais c'est la
    // résolution des têtes, pas celle attendue du fichier. 600 dpi donne des
    // lettrages et des liserés nets sans quadrupler inutilement le poids.
    var PRINT_DPI = 600;
    // Cadre Polaroid, en part de la largeur du cadre (comme .pola en CSS :
    // padding 6 % 6 % 24 %).
    var POLA = { side: .06, bottom: .24 };
    var PREVIEW_W = 520;
    var DEFAULT_MM = [71.5, 147.6];
    var INSET_MM = parseFloat(root.dataset.insetMm) || 0;
    var EMOJI_FONT = '"Apple Color Emoji","Segoe UI Emoji","Noto Color Emoji",sans-serif';

    function caseMm() { return specOf(state.model).mm || DEFAULT_MM; }
    function printWidthPx() { return Math.round(caseMm()[0] * PRINT_DPI / 25.4); }

    // Contour arrondi repris du CSS : rayon horizontal en % de la LARGEUR,
    // rayon vertical 2,1 fois plus plat, rapporté à la HAUTEUR.
    function roundedRect(g, x, y, w, h, rx, ry) {
      rx = Math.min(rx, w / 2); ry = Math.min(ry, h / 2);
      var HALF = Math.PI / 2;
      g.beginPath();
      g.moveTo(x + rx, y);
      g.lineTo(x + w - rx, y);
      g.ellipse(x + w - rx, y + ry, rx, ry, 0, -HALF, 0);
      g.lineTo(x + w, y + h - ry);
      g.ellipse(x + w - rx, y + h - ry, rx, ry, 0, 0, HALF);
      g.lineTo(x + rx, y + h);
      g.ellipse(x + rx, y + h - ry, rx, ry, 0, HALF, Math.PI);
      g.lineTo(x, y + ry);
      g.ellipse(x + rx, y + ry, rx, ry, 0, Math.PI, Math.PI + HALF);
      g.closePath();
    }

    // `inset` en pixels : bande périphérique laissée SANS encre. Les bords de
    // la coque s'arrondissent, l'encre y accroche mal ; la valeur se calibre
    // dans site.config.mjs après une première impression.
    function casePath(g, w, h, radiusPct, inset) {
      inset = inset || 0;
      roundedRect(
        g, inset, inset, w - 2 * inset, h - 2 * inset,
        Math.max(0, w * radiusPct / 100 - inset),
        Math.max(0, h * (radiusPct / 2.1) / 100 - inset)
      );
    }

    /* ── Découpe caméra ─────────────────────────────────────────────
       Le trou de l'objectif ne doit RIEN recevoir : la coque imprimée est
       percée, une encre posée là finirait sur le plateau de la machine. On
       reprend donc exactement la géométrie de renderCase(), en fractions de
       la coque, pour l'évider du fichier.
       Repères : le conteneur .cam est placé en % de la coque, et les formes
       à l'intérieur en % de ce conteneur. */
    function camShapes(fam) {
      var box, shapes = [];
      function rrect(radiusPct) {
        shapes.push({ kind: 'rrect', box: box, radius: radiusPct });
      }
      // Cercles répartis dans le conteneur (Galaxy, objectif unique) : la
      // largeur donne le diamètre, la hauteur suit (aspect-ratio: 1).
      function circles(leftPct, tops, sizePct) {
        tops.forEach(function (t) {
          shapes.push({ kind: 'circle', box: box, left: leftPct, top: t, size: sizePct });
        });
      }

      if (fam.cam === 'island3' || fam.cam === 'islandBig') {
        var big = fam.cam === 'islandBig';
        box = { l: 6, t: 3.2, w: big ? 42 : 39, h: big ? 20.5 : 19 };
        rrect(26);
      } else if (fam.cam === 'island2') {
        box = { l: 6, t: 3.2, w: 30, h: 14.5 };
        rrect(26);
      } else if (fam.cam === 'lenses3' || fam.cam === 'lenses4') {
        var four = fam.cam === 'lenses4';
        box = { l: 7, t: 3.5, w: 16, h: four ? 38 : 30 };
        circles(12, four ? [1, 26, 51, 76] : [2, 36, 70], 78);
      } else if (fam.cam === 'bar2' || fam.cam === 'bar3') {
        box = { l: 4, t: 6.5, w: 92, h: 8.2 };
        rrect(null);            // pilule : rayon = demi-hauteur
      } else if (fam.cam === 'single') {
        box = { l: 7, t: 3.5, w: 15, h: 9 };
        circles(0, [0], 100);
      } else if (fam.cam === 'dualv') {
        box = { l: 6, t: 3.4, w: 16, h: 17 };
        rrect(26);
      }
      return shapes;
    }

    /**
     * Évide (ou remplit) la zone caméra.
     * @param fill couleur pour l'aperçu ; null = découpe réelle pour l'impression
     */
    function punchCamera(g, w, h, fam, fill) {
      var shapes = camShapes(fam);
      if (!shapes.length) return;
      g.save();
      if (fill) g.fillStyle = fill;
      else g.globalCompositeOperation = 'destination-out';
      shapes.forEach(function (sh) {
        var bx = sh.box.l * w / 100, by = sh.box.t * h / 100;
        var bw = sh.box.w * w / 100, bh = sh.box.h * h / 100;
        if (sh.kind === 'rrect') {
          var rx = sh.radius === null ? bh / 2 : bw * sh.radius / 100;
          var ry = sh.radius === null ? bh / 2 : bh * sh.radius / 100;
          roundedRect(g, bx, by, bw, bh, rx, ry);
