    // pastille doit se recaler sans animer ce saut-là.
    window.addEventListener('resize', function () { moveRailInd(false); });

    /* ── Panneaux ───────────────────────────────────────────────── */
    var TITLES = I.titles;
    var builderEl = root.querySelector('.builder');
    var paneCloseTimer = null;
    function openPane(name) {
      activePane = name;
      if (paneCloseTimer) { clearTimeout(paneCloseTimer); paneCloseTimer = null; }
      panel.hidden = false;
      root.querySelector('[data-paneltitle]').textContent = TITLES[name] || '';
      panel.querySelectorAll('[data-pane]').forEach(function (p) { p.hidden = p.dataset.pane !== name; });
      root.querySelectorAll('.rbtn').forEach(function (b) { b.setAttribute('aria-pressed', String(b.dataset.panel === name)); });
      moveRailInd(true);
      if (name === 'text') syncTextPane();
      if (name === 'help') helpSyncModel();
