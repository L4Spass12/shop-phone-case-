const atelier = siteConfig.shop?.atelier ?? {};
const apiOrigin = atelier.widgetUrl ? new URL(atelier.widgetUrl).origin : '';
---

<section
  class="studio"
  data-studio
  aria-label={U.studio}
  data-i18n={JSON.stringify(TEXTS.js)}
  data-shop-id={atelier.shopId ?? ''}
  data-api={apiOrigin}
  data-sku={SKU}
  data-price={String(PRICE_CENTS)}
  data-relief-price={String(RELIEF_PRICE_CENTS)}
  data-inset-mm={String(siteConfig.shop?.printInsetMm ?? 0)}
  data-lang={lang}
>
  <div class="builder">

    <!-- ─── Barre supérieure ─────────────────────────────────────── -->
    <header class="bar">
      <div class="bar-l">
        <button type="button" class="sbtn" data-undo disabled aria-label={U.undo} title={U.undoTitle}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M9 14 4 9l5-5"/><path d="M4 9h11a5 5 0 0 1 0 10h-3"/></svg>
        </button>
        <button type="button" class="sbtn" data-redo disabled aria-label={U.redo} title={U.redo}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m15 14 5-5-5-5"/><path d="M20 9H9a5 5 0 0 0 0 10h3"/></svg>
        </button>
        <span class="bar-sep" aria-hidden="true"></span>
        <button type="button" class="sbtn" data-reset aria-label={U.reset} title={U.reset}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 6h18M8 6V4h8v2m-9 0 1 14h8l1-14"/></svg>
        </button>
        <!-- Le choix du modèle vit dans la barre plutôt que dans le rail : c'est
             une décision qu'on prend UNE fois, avant de dessiner, pas un outil
             qu'on rouvre en travaillant. Le rail ne garde que ce qui sert à
             composer. -->
        <div class="bar-mp"><ModelPicker id="studio-model" lang={lang} /></div>
      </div>
      <div class="bar-r">
        {/* « À partir de » : c'est le prix à plat, le relief coûte plus. */}
        <span class="bar-price price-amount"><span class="bar-from">{U.priceFrom}</span> {price}</span>
        {/* « Continuer » et non « Ajouter » : le mode d'impression se choisit
            à l'étape suivante, et il change le prix. Annoncer l'ajout ici
            reviendrait à cacher une décision qui coûte 5 €. */}
        <button type="button" class="btn-atc buy-button bar-add" data-next>
          <span class="add-full">{U.cont}</span>
          <span class="add-mini">{U.cont}</span>
        </button>
      </div>
    </header>

    <!-- ─── Rail d'outils ────────────────────────────────────────── -->
    <nav class="rail" aria-label={U.tools}>
      {/* Une SEULE pastille pour tous les outils : elle glisse de l'un à
          l'autre au lieu de s'éteindre ici et de se rallumer là. C'est le
          déplacement qui rend le changement lisible. */}
      <span class="rail-ind" data-railind aria-hidden="true"></span>
      <div class="rail-group">
      <button type="button" class="rbtn" data-panel="design" aria-pressed="false">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="m14 4 1.6 3.4L19 9l-3.4 1.6L14 14l-1.6-3.4L9 9l3.4-1.6z"/><path d="M6 14.5 6.9 16.4 9 17.3l-2.1.9L6 20.1l-.9-1.9L3 17.3l2.1-.9z"/></svg>
        <span>{U.designs}</span>
      </button>
      <button type="button" class="rbtn" data-panel="text" aria-pressed="false">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M4 7V5h16v2M9 5v14m-2 0h4"/></svg>
        <span>{U.text}</span>
      </button>
      <button type="button" class="rbtn" data-panel="photo" aria-pressed="false">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="8.5" cy="9" r="1.4"/><path d="m4 18 5-5 4 4 3-3 4 4"/></svg>
        <span>{U.photos}</span>
      </button>
      </div>
      <!-- L'aide à part : ce n'est pas un outil de composition mais un
           service (l'atelier crée la coque pour le client). -->
      <div class="rail-group rail-group-help">
      <button type="button" class="rbtn rbtn-help" data-panel="help" aria-pressed="false">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M20 12a8 8 0 0 1-11.6 7.1L4 20l1-4.2A8 8 0 1 1 20 12z"/><path d="M9.5 9.5a2.5 2.5 0 1 1 3.4 2.3c-.6.3-.9.8-.9 1.4v.3"/><path d="M12 16.5h.01"/></svg>
        <span>{U.help}</span>
      </button>
      </div>
    </nav>

    <!-- ─── Panneau contextuel ───────────────────────────────────── -->
    <aside class="panel" data-panelwrap hidden>
      <div class="panel-head">
        <h2 data-paneltitle>{U.panel}</h2>
        <button type="button" class="panel-x" data-panelclose aria-label={U.closePanel}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M6 6 18 18M18 6 6 18"/>
          </svg>
        </button>
      </div>

      <!-- Designs prêts à l'emploi -->
      <div class="pane" data-pane="design" hidden>
        <p class="pane-hint" style="margin-top:0">{U.designsHint}</p>
        <div class="tpl-grid" data-templates></div>
      </div>

      <!-- Texte -->
      <div class="pane" data-pane="text" hidden>
        <button type="button" class="pane-cta" data-addtext>{U.addText}</button>
        <div data-textedit hidden>
          <label class="pane-label" for="studio-text">{U.content}</label>
          <input id="studio-text" type="text" class="field" data-textinput placeholder={U.yourText} maxlength="40" autocomplete="off" />
          <label class="pane-label">{U.font}</label>
          <div class="font-row" data-fonts></div>
          <label class="pane-label">{U.textColor}</label>
          <div class="swatch-row" data-textcolors></div>
        </div>
        <p class="pane-empty" data-textempty>{U.textEmpty}</p>
      </div>

      <!-- Photos -->
      <div class="pane" data-pane="photo" hidden>
        <button type="button" class="dropzone" data-pick>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 16V4m0 0L8 8m4-4 4 4"/><path d="M4 16v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"/></svg>
          <strong>{U.importPhoto}</strong>
          <span>{U.importHint}</span>
        </button>
        <p class="pane-hint">{U.pasteHint}</p>
      </div>

      <!-- Demande de design : l'atelier crée la coque pour le client -->
      <div class="pane" data-pane="help" hidden>
        <form class="help-form" data-helpform novalidate>
          <div class="help-intro">
            <p>{U.helpText}</p>
          </div>
          <label class="pane-label" for="help-desc">{U.helpDesc}</label>
          <textarea id="help-desc" class="field field-area" data-helpdesc rows="5" maxlength="3000" placeholder={U.helpDescPh}></textarea>

          <label class="pane-label">{U.helpImages}</label>
          <div class="help-thumbs" data-helpthumbs></div>
          <button type="button" class="dropzone help-drop" data-helppick>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 16V4m0 0L8 8m4-4 4 4"/><path d="M4 16v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"/></svg>
            <strong>{U.helpAddImages}</strong>
            <span>{U.helpImagesHint}</span>
          </button>
          <input type="file" accept="image/*" multiple hidden data-helpfile />

          <label class="pane-label">{U.helpModel}</label>
          {/* Ouvre le même sélecteur que la barre du studio : le modèle choisi
              ici vaut pour toute la composition. */}
          <button type="button" class="field help-model" data-helpmodel>
            <span data-helpmodelval>{U.helpModelNone}</span>
            <span class="help-model-act" aria-hidden="true">{U.helpModelChange}</span>
          </button>

          <label class="pane-label" for="help-email">{U.helpEmail}</label>
          <input id="help-email" class="field" data-helpemail type="email" maxlength="200" autocomplete="email" inputmode="email" />
          <input class="help-hp" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" data-helphp />

          <button type="submit" class="btn-atc buy-button help-send" data-helpsend>{U.helpSend}</button>
          <p class="pane-hint help-note">{U.helpNote}</p>
        </form>
        <div class="help-done" data-helpdone hidden>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 13 4 4L19 7"/></svg>
          <strong>{U.helpDoneTitle}</strong>
          <p>{U.helpDoneText}</p>
        </div>
      </div>

    </aside>

    <!-- ─── Plan de travail ──────────────────────────────────────── -->
    <main class="canvas" data-canvas>
      <div class="case" data-case data-finish="clear" data-mount="alone">
        <!-- Verre dépoli : floute et voile légèrement le décor DERRIÈRE la
             coque (finition transparente). Placé avant le design pour que les
             stickers/textes restent nets par-dessus. -->
        <div class="frost" data-frost aria-hidden="true"></div>
        <div class="phone" data-phone></div>
        <div class="design" data-design>
          {/* Fond de coque (posé par un design) : couvre toute la coque, sous
              les éléments, et ne se sélectionne pas. */}
          <div class="case-bg" data-casebg aria-hidden="true"></div>
          {/* Calque « briques » : grille fixe sur la coque, la photo bouge
              dessous (cf. drawBrickLayer). */}
          <canvas class="brick-layer" data-bricks aria-hidden="true" hidden></canvas>
          {/* Planche posée AU-DESSUS des photos (case centrale transparente) :
              la photo se glisse dessous et n'apparaît que dans la case. Ne
              capte pas les clics, la photo reste manipulable au travers. */}
          <div class="case-overlay" data-overlay aria-hidden="true" hidden></div>
          <span class="guide guide-v" data-guide-v aria-hidden="true"></span>
          <span class="guide guide-h" data-guide-h aria-hidden="true"></span>
        </div>
        <div class="cam" data-cam aria-hidden="true"></div>
        <div class="shell" aria-hidden="true"><span class="sheen"></span></div>
        <span class="side side-l" aria-hidden="true"></span>
        <span class="side side-r" aria-hidden="true"></span>

        <div class="empty" data-empty>
          <p>{U.emptyTitle}</p>
          <span>{U.emptySub}</span>
        </div>

        <!-- Cadre de sélection : calque UNIQUE hors du .design (qui, lui, rogne
             l'image à la coque). Ainsi le cadre et ses poignées restent
             visibles et attrapables même quand l'élément déborde de la coque,
             alors que l'image reste rognée au bord. -->
        <div class="gizmo" data-gizmo hidden aria-hidden="true">
          <span class="h h-rotate" data-handle="rotate"></span>
          <span class="h h-resize" data-handle="resize"></span>
        </div>
      </div>

      <!-- Barre d'actions : ancrée au plan de travail et non à la coque, qui
           devient trop étroite quand un panneau est ouvert en mobile. -->
      <div class="ctx" data-ctx hidden>
          <button type="button" data-act="edit" hidden aria-label={U.edit} title={U.edit}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20h4L19 9a2.8 2.8 0 0 0-4-4L4 16z"/><path d="m13.5 6.5 4 4"/></svg>
          </button>
          {/* Recadrer : la photo glisse dans son cadre (cases des modèles). */}
          <button type="button" data-act="crop" hidden aria-label={U.crop} title={U.crop}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2v14a2 2 0 0 0 2 2h14"/><path d="M18 22V8a2 2 0 0 0-2-2H2"/></svg>
          </button>
          <button type="button" data-act="dup" aria-label={U.dup} title={U.dup}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg>
          </button>
          {/* Superposition, icônes à la manière de Canva : un calque vu en
              perspective (losange) et une flèche qui en sort vers le haut
              (avancer) ou vers le bas (reculer). */}
          <button type="button" data-act="front" aria-label={U.front} title={U.front}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M9 13.2 4 15.5l8 4 8-4-5-2.3"/><path d="M12 15.5V3.5M8.5 7 12 3.5 15.5 7"/></svg>
          </button>
          <button type="button" data-act="back" aria-label={U.back} title={U.back}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 8.5l8-4 8 4-8 4z"/><path d="M12 12.5v8M8.5 17 12 20.5 15.5 17"/></svg>
          </button>
          <button type="button" data-act="del" class="ctx-del" aria-label={U.del} title={U.del}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 6h18M8 6V4h8v2m-9 0 1 14h8l1-14"/></svg>
          </button>
      </div>
    </main>
  </div>


  {/* ─── Étape 2 : mode d'impression ─────────────────────────────────
      Posée par-dessus l'éditeur plutôt que sur une autre page : changer d'URL
      ferait perdre la composition en cours, et il faudrait la re-téléverser
      pour revenir en arrière. Ici, « Retour » ramène au dessin intact. */}
  <section class="step" data-step hidden aria-label={U.printChoice}>
    <header class="step-bar">
      <button type="button" class="step-back" data-stepback>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5 8 12l7 7"/></svg>
        {U.goBack}
      </button>
      <p class="step-title">{U.howPrint}</p>
      <span class="step-spacer" aria-hidden="true"></span>
    </header>

    <div class="step-grid" role="radiogroup" aria-label={U.printMode}>
      <button type="button" class="mode" data-mode="flat" role="radio" aria-checked="true">
        <span class="mode-bg" aria-hidden="true"></span>
        {/* Même illustration que sur les fiches produit : tranche en haut, dos
            en dessous. C'est la comparaison des deux cartes qui explique. */}
        <img class="mode-illu" src="/images/print-mode-flat.svg?v=2" alt="" width="320" height="282" loading="eager" fetchpriority="low" decoding="async" />
        <span class="mode-body">
          <span class="mode-name">{U.flat}</span>
          <span class="mode-desc">{U.flatDesc}</span>
          <span class="mode-price">{price}</span>
          {LAUNCH_NEXT?.flat && (
            <span class="mode-launch"><span class="mode-launch-tag">{t('print.launch', lang)}</span> {t('print.launchThen', lang, { price: fmt(LAUNCH_NEXT.flat) })}</span>
          )}
        </span>
        <span class="mode-check" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>
        </span>
      </button>

      <button type="button" class="mode" data-mode="relief" role="radio" aria-checked="false">
        <span class="mode-bg" aria-hidden="true"></span>
        <img class="mode-illu" src="/images/print-mode-relief.svg" alt="" width="320" height="282" loading="eager" fetchpriority="low" decoding="async" />
        <span class="mode-body">
          <span class="mode-name">{U.relief}</span>
          <span class="mode-desc">{U.reliefDesc}</span>
          <span class="mode-price">{reliefPrice}</span>
          {LAUNCH_NEXT?.relief && (
            <span class="mode-launch"><span class="mode-launch-tag">{t('print.launch', lang)}</span> {t('print.launchThen', lang, { price: fmt(LAUNCH_NEXT.relief) })}</span>
          )}
        </span>
        <span class="mode-check" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>
        </span>
      </button>
    </div>

    <div class="step-foot">
      <span class="step-total">
        <span class="step-total-l">{U.total}</span>
        <span class="step-total-v" data-steptotal>{price}</span>
      </span>
      <button type="button" class="btn-atc buy-button step-add" data-add>
        <span class="step-add-l">{U.addToCart}</span>
      </button>
    </div>

    {/* Voile de travail. La préparation dure quelques secondes, un rendu en
        600 dpi puis un envoi, et sans lui l'écran restait figé sans rien dire.
        L'anneau est une VRAIE progression, pas un sablier : il avance d'un
        quart à chaque étape franchie. Un tourniquet sans fin ne dit pas si on
        en est au début ou à la fin. */}
    <div class="busy" data-busy hidden>
      <div class="busy-card" data-busycard>
        <span class="busy-viz" aria-hidden="true">
          <svg class="busy-ring" viewBox="0 0 48 48">
            <circle class="busy-track" cx="24" cy="24" r="20" />
            <circle class="busy-arc" cx="24" cy="24" r="20" data-busyarc />
          </svg>
          <svg class="busy-tick" viewBox="0 0 24 24" fill="none" stroke="currentColor"
               stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
            <path d="m5 12.5 4.5 4.5L19 7.5" />
          </svg>
        </span>
        <p class="busy-msg" data-busymsg role="status">{U.preparing}</p>
        <p class="busy-sub" data-busysub>{U.wait}</p>
        <div class="busy-actions" data-busyactions hidden>
          <button type="button" class="busy-cart" data-opencart>{U.seeCart}</button>
          <button type="button" class="busy-more" data-busyclose>{U.another}</button>
        </div>
      </div>
    </div>
  </section>

  <div class="toast" data-toast hidden role="status"></div>
  <input type="file" accept="image/*" hidden data-file />
</section>

<style>
  .studio { --rail: 78px; --panel: 272px; }

  /* ── Mobile : une application à hauteur fixe ─────────────────────
     Colonne barre / plan de travail / panneau / rail. Le panneau est DANS
     le flux (et non posé par-dessus) : quand il s'ouvre, le plan de travail
     se réduit et la coque reste visible, on voit ce qu'on est en train de
     modifier, ce qui n'était pas le cas avec une feuille en surimpression. */
  .builder {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
  }
  .builder > .bar    { flex: none; order: 0; }
  .builder > .canvas { flex: 1 1 auto; min-height: 0; order: 1; }
  .builder > .panel  { flex: none; order: 2; }
  .builder > .rail   { flex: none; order: 3; }

  /* En thème sunfreaks (mobile), l'îlot flottant du header descend un peu plus
     bas que --header-h ne le prévoit et chevauchait la barre d'action (ATC).
     On décale la colonne vers le bas et on réduit d'autant sa hauteur. */
  @media (min-width: 1024px) {
    .builder {
      display: grid;
      grid-template-columns: var(--rail) auto minmax(0, 1fr);
      grid-template-rows: auto minmax(0, 1fr);
      grid-template-areas: "bar bar bar" "rail panel canvas";
      height: 100%;
      overflow: hidden;
    }
  }


  /* ── Étape 2 : mode d'impression ─────────────────────────────────
     Couche posée sur l'éditeur. `visibility` plutôt que `display` pour que
     l'ouverture et la fermeture soient toutes deux animables ; `hidden` reste
     l'état de repos, retiré par le JS avant de lancer la transition. */
  .step {
    position: fixed; inset: 0; z-index: 10010;
    display: flex; flex-direction: column;
    background: rgb(var(--c-dark));
    opacity: 0;
    transform: translateY(14px) scale(.985);
    transition: opacity .34s cubic-bezier(.22,.61,.36,1),
                transform .34s cubic-bezier(.22,.61,.36,1);
  }
  .step[hidden] { display: none; }
  .step.step--in { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) { .step { transition: none; } }

  .step-bar {
    flex: none; display: flex; align-items: center; justify-content: space-between;
    gap: .75rem; padding: .85rem 1rem;
    border-bottom: 1px solid rgb(var(--c-cream) / .1);
  }
  .step-back, .step-spacer { flex: 0 0 auto; min-width: 76px; }
  .step-back {
    display: inline-flex; align-items: center; gap: .3rem;
    font-size: .82rem; font-weight: 500; color: rgb(var(--c-cream) / .7); cursor: pointer;
  }
  .step-back svg { width: 17px; height: 17px; }
  .step-back:hover { color: rgb(var(--c-cream)); }
  .step-title { flex: 1 1 auto; text-align: center; font-size: .95rem; font-weight: 600; }
  @media (max-width: 560px) { .step-title { font-size: .86rem; } }

  /* Deux moitiés franches : c'est la comparaison qui doit sauter aux yeux. */
  .step-grid {
    flex: 1 1 auto; min-height: 0;
    display: grid; gap: 10px; padding: 10px;
    grid-template-rows: 1fr 1fr;
  }
  @media (min-width: 768px) {
    .step-grid { grid-template-rows: none; grid-template-columns: 1fr 1fr; gap: 14px; padding: 14px; }
  }

  .mode {
    position: relative; overflow: hidden;
    display: flex; align-items: flex-end;
    border-radius: 20px; cursor: pointer; color: inherit; text-align: left;
    border: 2px solid rgb(var(--c-cream) / .12);
    transition: border-color .2s, transform .12s, box-shadow .2s;
  }
  .mode:hover { border-color: rgb(var(--c-cream) / .3); }
  .mode:active { transform: scale(.99); }
  .mode[aria-checked="true"] {
    border-color: rgb(var(--accent-rgb));
    box-shadow: 0 0 0 4px rgb(var(--accent-rgb) / .14);
  }

  /* Fond photo. Tant que l'image n'est pas fournie, le dégradé tient le rôle :
     la carte reste lisible plutôt que blanche. */
  .mode-bg {
    position: absolute; inset: 0;
    background-size: cover; background-position: center;
  }
  /* Fond uni et illustration au trait (celle des fiches produit), centrée
     dans l'espace au-dessus du texte. `multiply` fond son blanc dans la
     carte. */
  .mode-bg { background: rgb(var(--c-panel)); }
  .mode[aria-checked="true"] .mode-bg { background: rgb(var(--accent-rgb) / .05); }
  /* Dans le flux, au-dessus du texte : elle prend la hauteur restante et
     ne chevauche jamais le titre, même quand la carte est basse. */
  .mode { flex-direction: column; align-items: stretch; }
  .mode-illu {
    position: relative;
    flex: 1 1 0; min-height: 0;
    width: 100%; height: 100%;
    object-fit: contain;
    padding: 1rem 1rem 0;
    mix-blend-mode: multiply;
    pointer-events: none;
  }
  @media (min-width: 768px) {
    /* Ordinateur : un quart plus petites, elles écrasaient la carte. */
    .mode-illu { padding: 3.5rem 17% .75rem; }
  }

  .mode-body {
    position: relative; display: flex; flex-direction: column; gap: .3rem;
    padding: 1rem 1.1rem 1.15rem; width: 100%;
  }
  .mode-name { font-size: 1.15rem; font-weight: 700; line-height: 1.1; }
  .mode-desc { font-size: .78rem; line-height: 1.45; color: rgb(var(--c-n400)); max-width: 34ch; }
  .mode-price { margin-top: .35rem; font-size: 1.05rem; font-weight: 700; }
  .mode-launch { font-size: .74rem; color: rgb(var(--c-n400)); display: flex; align-items: center; flex-wrap: wrap; gap: .35rem; }
  .mode-launch-tag {
    font-size: .64rem; font-weight: 700; text-transform: uppercase; letter-spacing: .06em;
    background: #fde2ee; color: #b0185a; padding: .18rem .42rem; border-radius: 4px;
  }
  @media (min-width: 768px) {
    .mode-body { padding: 1.4rem 1.5rem 1.5rem; gap: .38rem; }
    .mode-name { font-size: 1.4rem; }
    .mode-desc { font-size: .84rem; }
    .mode-price { font-size: 1.2rem; }
  }

  .mode-check {
    position: absolute; top: .7rem; right: .7rem;
    display: flex; align-items: center; justify-content: center;
    width: 26px; height: 26px; border-radius: 999px;
    background: rgb(var(--accent-rgb)); color: #fff;
    opacity: 0; transform: scale(.7);
    transition: opacity .2s, transform .2s cubic-bezier(.34,1.56,.64,1);
  }
  .mode-check svg { width: 15px; height: 15px; }
  .mode[aria-checked="true"] .mode-check { opacity: 1; transform: none; }

  .step-foot {
    flex: none; display: flex; align-items: center; justify-content: space-between;
    gap: 1rem; padding: .8rem 1rem calc(.8rem + env(safe-area-inset-bottom));
    border-top: 1px solid rgb(var(--c-cream) / .1);
  }
  .step-total { flex: none; display: flex; flex-direction: column; line-height: 1.15; }
  .step-total-l { font-size: .68rem; text-transform: uppercase; letter-spacing: .08em; color: rgb(var(--c-n500)); }
  .step-total-v { font-size: 1.35rem; font-weight: 700; white-space: nowrap; }
  .step-add { flex: 0 1 auto; padding-left: 1.6rem; padding-right: 1.6rem; }

  /* ── Voile de travail ────────────────────────────────────────────
     Posé DANS l'étape, donc au-dessus des deux cartes et de la barre d'action :
     pendant la préparation, plus rien n'est cliquable, et ça se voit. */
  .busy {
    position: absolute; inset: 0; z-index: 5;
    display: flex; align-items: center; justify-content: center;
    background: rgb(var(--c-dark) / .78);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
  }
  .busy[hidden] { display: none; }
  .busy-card {
    display: flex; flex-direction: column; align-items: center; gap: .55rem;
    padding: 1.5rem 1.8rem; max-width: 20rem; text-align: center;
    border-radius: 20px;
    background: rgb(var(--c-dark));
    border: 1px solid rgb(var(--c-cream) / .1);
    box-shadow: 0 18px 40px -22px rgb(var(--c-cream) / .4);
  }
  /* L'anneau : une piste discrète, un arc qui avance par étapes, et une
     rotation lente par-dessus pour que ça respire même entre deux étapes. */
  .busy-viz { position: relative; display: block; width: 62px; height: 62px; }
  .busy-ring {
    width: 100%; height: 100%;
    transform: rotate(-90deg);        /* départ à midi */
    animation: busy-breathe 3.2s linear infinite;
  }
  @keyframes busy-breathe { to { transform: rotate(270deg); } }
  .busy-track {
    fill: none; stroke: rgb(var(--c-cream) / .1); stroke-width: 4;
  }
  .busy-arc {
    fill: none; stroke: rgb(var(--accent-rgb)); stroke-width: 4; stroke-linecap: round;
    /* 2πr avec r = 20 */
    stroke-dasharray: 125.66;
    stroke-dashoffset: 125.66;
    transition: stroke-dashoffset .5s cubic-bezier(.22,.61,.36,1), stroke .3s;
  }
  .busy-tick {
    position: absolute; inset: 0; margin: auto;
    width: 30px; height: 30px; color: rgb(var(--accent-rgb));
    opacity: 0; transform: scale(.5);
    transition: opacity .25s, transform .4s cubic-bezier(.34,1.7,.5,1);
  }
  /* Fin de course : l'anneau se fige plein et la coche éclôt au centre. */
  .busy-card[data-done] .busy-ring { animation: none; }
  .busy-card[data-done] .busy-tick { opacity: 1; transform: none; }
  .busy-card[data-done] .busy-viz::after {
    content: ""; position: absolute; inset: -6px;
    border-radius: 50%; border: 2px solid rgb(var(--accent-rgb) / .45);
    animation: busy-pulse .7s cubic-bezier(.22,.61,.36,1) forwards;
  }
  @keyframes busy-pulse {
    from { opacity: .9; transform: scale(.82); }
    to   { opacity: 0;  transform: scale(1.28); }
  }
  @media (prefers-reduced-motion: reduce) {
    .busy-ring { animation: none; }
    .busy-card[data-done] .busy-viz::after { animation: none; opacity: 0; }
  }

  .busy-msg { font-size: 1rem; font-weight: 700; }
  .busy-sub { font-size: .78rem; color: rgb(var(--c-n500)); line-height: 1.45; }

  .busy-actions { display: flex; flex-direction: column; gap: .45rem; width: 100%; margin-top: .5rem; }
  .busy-actions[hidden] { display: none; }
  .busy-cart, .busy-more {
    padding: .6rem 1rem; border-radius: 12px; cursor: pointer;
    font-size: .84rem; font-weight: 600; transition: background .15s, border-color .15s;
  }
  .busy-cart { background: rgb(var(--accent-rgb)); color: #fff; }
  .busy-cart:hover { background: rgb(var(--accent-dark-rgb)); }
  .busy-more {
    border: 1px solid rgb(var(--c-cream) / .18); color: rgb(var(--c-cream) / .8);
  }
  .busy-more:hover { border-color: rgb(var(--c-cream) / .4); color: rgb(var(--c-cream)); }
  @media (min-width: 768px) {
    .step-foot { padding: 1rem 1.4rem; }
    .step-total-v { font-size: 1.5rem; }
  }

  /* ── Barre ───────────────────────────────────────────────────────
     Bandeau plein, à la différence du rail et du panneau : en îlot, ses marges
     et son ombre coûtaient une vingtaine de pixels de hauteur au plan de
     travail, qui est la partie utile de l'écran.
     PAS de backdrop-filter non plus : un filtre fait de l'élément le BLOC
     CONTENEUR de ses descendants en `position: fixed`. Le tiroir du sélecteur
     de modèle, qui vit dans cette barre, s'ancrait alors sur la barre au lieu
     du viewport, et la feuille mobile s'ouvrait à cheval sur le haut. */
  .bar {
    grid-area: bar;
    display: flex; align-items: center; justify-content: space-between; gap: .75rem;
    padding: .35rem .7rem;
    background: rgb(var(--c-dark));
    border-bottom: 1px solid rgb(var(--c-cream) / .1);
    z-index: 60;
  }
  @media (min-width: 1024px) {
    .bar { padding: .4rem .9rem; }
  }
  /* Le tiroir du sélecteur de modèle est un enfant de la barre. Or la barre
     porte un z-index : elle crée donc un CONTEXTE D'EMPILEMENT, dans lequel le z-index 10002 du tiroir ne vaut plus
     rien face au header, qui est à 10000 dans le contexte racine. Le tiroir
     s'ouvrait derrière lui.
     Tant qu'il est ouvert, on hisse la barre entière au-dessus du header ; le
     voile et le panneau retrouvent alors leur superposition normale à
     l'intérieur. Le reste du temps la barre repasse sous le header, pour que
     les menus déroulants de celui-ci la recouvrent comme avant. */
  .bar:has(.mp-panel:not([hidden])) { z-index: 10005; }

  /* Plus de `position: sticky` : la page ne défile plus, c'est la grille qui
     tient la barre en haut. Le `top: var(--header-h)` de l'ancienne règle la
     décalait de 72 px vers le bas, par-dessus le panneau. */
  .bar-l, .bar-r { display: flex; align-items: center; gap: .4rem; }
  .bar-l { min-width: 0; flex: 1 1 auto; }
  .bar-r { flex: none; }
  .sbtn {
    display: inline-flex; align-items: center; justify-content: center;
    width: 38px; height: 38px; border-radius: 9px; cursor: pointer; color: inherit;
    transition: background .15s, opacity .15s;
  }
  .sbtn svg { width: 18px; height: 18px; }
  .sbtn:hover:not(:disabled) { background: rgb(var(--c-cream) / .08); }
  .sbtn:disabled { opacity: .28; cursor: default; }
  .bar-sep { width: 1px; height: 20px; background: rgb(var(--c-cream) / .15); margin: 0 .2rem; }
  .bar-model {
    font-size: .74rem; opacity: .65; margin-left: .4rem;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 40vw;
  }
  @media (max-width: 520px) { .bar-model { display: none; } }
  /* Sous 420 px, la barre ne tient plus : annuler, rétablir, effacer, modèle,
     prix et bouton d'achat se disputent 375 px. Plutôt que de sacrifier un
     élément, on resserre les cibles secondaires, le prix et l'achat, eux,
     gardent leur taille. */
  @media (max-width: 420px) {
    .sbtn { width: 30px; height: 30px; }
    .bar-sep { margin: 0; }
    .bar-l { gap: .15rem; }
    .bar-add { padding-left: .7rem; padding-right: .7rem; }
  }
  /* Sur mobile, le prix cède sa place au nom du modèle.
     Arbitrage assumé : le prix est fixe et déjà connu du visiteur (il vient
     d'une page qui l'annonce, et le panier le redonne), alors que le modèle
     est le seul réglage obligatoire et celui qu'on vérifie du regard avant
     d'acheter. Tronqué à « iPhon… », il ne servait à rien. */
  @media (max-width: 560px) { .bar-price { display: none; } }
  .bar-price { font-size: 1.1rem; font-weight: 600; white-space: nowrap; }
  .bar-from { font-size: .72em; font-weight: 500; opacity: .7; }
  .bar-add { font-size: .74rem; padding-left: 1rem; padding-right: 1rem; white-space: nowrap; }
  /* Le libellé long ne tient pas à 375 px à côté du prix et des annulations :
     on bascule sur « Ajouter » (l'intitulé reste explicite en contexte).
     `font-size: 1em` annule la réduction que .btn-atc applique à ses <span>. */
  .bar-add .add-full, .bar-add .add-mini { font-size: 1em; font-weight: inherit; }
  .bar-add .add-mini { display: none; }
  @media (max-width: 700px) {
    .bar-add .add-full { display: none; }
    .bar-add .add-mini { display: inline; }
  }
  @media (min-width: 1024px) { .bar-price { font-size: 1.3rem; } .bar-add { font-size: .8rem; } }

  /* ── Rail d'outils ───────────────────────────────────────────────
     Îlot flottant, comme le header : détaché des bords, arrondi, fond
     translucide et flou d'arrière-plan. Les mêmes valeurs que l'îlot du
     header (82 % d'opacité, blur 16 saturate 1.4, filet à 10 %) pour que les
     deux surfaces se lisent comme une seule famille.

     Quatre outils seulement depuis que le modèle est remonté dans la barre :
     chaque cible respire, et l'outil actif se lit d'un coup d'œil. En mobile
     l'îlot est posé en bas, en desktop contre le bord gauche. */
  /* Le rail porte deux îlots : les outils de composition, puis l'aide à part.
     Le fond de chaque îlot est un pseudo-élément placé SOUS la pastille
     violette (z-index -1 dans le contexte isolé du rail) : la pastille peut
     ainsi glisser d'un îlot à l'autre en restant visible. */
  .rail {
    position: relative;          /* repère de la pastille glissante */
    isolation: isolate;
    grid-area: rail;
    display: flex; gap: .5rem;
    margin: 0 10px calc(10px + env(safe-area-inset-bottom));
    z-index: 60;
  }
  .rail-group { position: relative; display: flex; gap: .3rem; padding: .4rem .45rem; flex: 1; }
  .rail-group-help { flex: none; }
  .rail-group::before {
    content: ""; position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background: rgb(var(--c-dark) / .82);
    -webkit-backdrop-filter: blur(16px) saturate(1.4);
    backdrop-filter: blur(16px) saturate(1.4);
    border: 1px solid rgb(var(--c-cream) / .1);
    border-radius: 20px;
    box-shadow: 0 6px 18px -14px rgb(var(--c-cream) / .28),
                0 1px 0 rgb(255 255 255 / .5) inset;
  }
  @media (min-width: 1024px) {
    .rail {
      flex-direction: column; gap: .6rem;
      /* Collé en haut : une colonne étirée sur toute la hauteur éloignerait le
         dernier outil du plan de travail. `align-self` l'empêche de s'étirer
         sur la rangée de la grille. */
      align-self: start;
      margin: 12px 0 12px 12px;
    }
    .rail-group { flex-direction: column; gap: .35rem; padding: .8rem .5rem; flex: none; }
    .rail-group::before { border-radius: 24px; }
  }
  @media (max-width: 1023px) {
    .rail-group-help .rbtn { padding-left: .85rem; padding-right: .85rem; }
  }

  .rbtn {
    position: relative;
    flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: .3rem; padding: .5rem .2rem;
    border-radius: 14px; cursor: pointer;
    color: rgb(var(--c-cream) / .6);
    font-size: .63rem; font-weight: 500; letter-spacing: .02em;
    transition: background .18s, color .18s, transform .12s;
  }
  .rbtn svg { width: 22px; height: 22px; }
  .rbtn:hover { background: rgb(var(--c-cream) / .06); color: rgb(var(--c-cream) / .9); }
  .rbtn:active { transform: scale(.94); }

  /* Outil actif : pastille violette pleine. Un voile à 16 % se confondait avec
     le survol sur une surface déjà translucide, il fallait un aplat franc.
     Le dégradé reprend les trois nuances de l'accent du site (clair, accent,
     foncé) : c'est le même violet que les boutons et le prix, pas une seconde
     teinte inventée pour l'occasion. Le liseré clair en haut et l'ombre portée
     colorée donnent le relief. */
  /* Le fond violet vit sur .rail-ind, pas sur le bouton : c'est ce qui lui
     permet de glisser d'un outil à l'autre. Le bouton ne change que sa
     couleur d'encre, et il doit passer AU-DESSUS de la pastille. */
  .rbtn { z-index: 1; }
  .rbtn[aria-pressed="true"] { color: #fff; font-weight: 600; }
  .rbtn[aria-pressed="true"]:hover { background: none; }

  .rail-ind {
    position: absolute; left: 0; top: 0; z-index: 0;
    border-radius: 14px;
    background: linear-gradient(155deg,
      rgb(var(--accent-light-rgb)) 0%,
      rgb(var(--accent-rgb)) 52%,
      rgb(var(--accent-dark-rgb)) 100%);
    box-shadow: 0 6px 15px -7px rgb(var(--accent-rgb) / .75),
                0 1px 0 rgb(255 255 255 / .28) inset;
    opacity: 0;
    pointer-events: none;
    /* Le ressort léger sur la position donne le glissement ; la taille et
       l'opacité suivent sans rebond, sinon la pastille « respire » à chaque
       changement. */
    transition: transform .38s cubic-bezier(.34, 1.28, .48, 1),
                width .3s cubic-bezier(.22,.61,.36,1),
                height .3s cubic-bezier(.22,.61,.36,1),
                opacity .2s ease;
  }
  .rail-ind[data-on] { opacity: 1; }
  @media (min-width: 1024px) { .rail-ind { border-radius: 16px; } }
  @media (prefers-reduced-motion: reduce) { .rail-ind { transition: opacity .2s ease; } }

  /* L'anneau de focus global est du même violet que le remplissage : sur un
     bouton actif il se collait au fond et formait un gros bloc. On l'écarte et
     on l'assombrit pour qu'il se lise comme un contour. */
  .rbtn:focus-visible { outline: 2px solid rgb(var(--accent-rgb)); outline-offset: 3px; }
  .rbtn[aria-pressed="true"]:focus-visible {
    outline-color: rgb(var(--accent-dark-rgb));
    outline-offset: 3px;
  }

  @media (min-width: 1024px) {
    .rbtn { flex: none; padding: .7rem .3rem; font-size: .64rem; gap: .34rem; border-radius: 16px; }
    .rbtn svg { width: 23px; height: 23px; }
  }
  /* Compacté en mobile : chaque pixel gagné va au plan de travail, qui est la
     partie utile. */
  @media (max-width: 1023px) {
    .sbtn { width: 34px; height: 34px; }
    .rbtn { padding: .42rem .2rem; font-size: .61rem; gap: .2rem; }
    .rbtn svg { width: 20px; height: 20px; }
  }

  /* ── Panneau ─────────────────────────────────────────────────── */
  .panel { grid-area: panel; background: rgb(var(--c-dark)); }
  .panel[hidden] { display: none; }
  @media (min-width: 1024px) {
    /* Îlot, comme la barre et le rail : un panneau à bord franc collé contre
       le rail flottant cassait la famille de surfaces. */
    .panel {
      width: var(--panel); padding: 1rem;
      align-self: start;
      margin: 12px 0 12px 10px;
      background: rgb(var(--c-dark) / .82);
      -webkit-backdrop-filter: blur(16px) saturate(1.4);
      backdrop-filter: blur(16px) saturate(1.4);
      border: 1px solid rgb(var(--c-cream) / .1);
      border-radius: 22px;
      box-shadow: 0 6px 18px -14px rgb(var(--c-cream) / .28),
                  0 1px 0 rgb(255 255 255 / .5) inset;
      /* La rangée de la grille borne déjà la hauteur ; `align-self: start`
         empêche l'étirement, et 100% de la rangée moins les marges donne la
         limite de défilement. */
      overflow-y: auto; max-height: calc(100% - 24px);
    }
    /* L'entête collant doit masquer le contenu qui défile dessous : sur une
       surface translucide, un fond translucide ne masque rien. */
    .panel-head { background: rgb(var(--c-dark)); }
  }
  @media (max-width: 1023px) {
    /* Feuille du bas. Fermée = hauteur 0 ; ouverte = .panel--open. La bascule
       de max-height s'anime → ouverture ET fermeture lentes et fluides (le
       plan de travail se réajuste doucement en même temps). */
    .panel {
      max-height: 0; overflow-y: auto;
      overscroll-behavior: contain;          /* le défilement ne fuit pas vers la page */
      padding: 0 1rem;
      margin: 0 10px;
      border-radius: 20px;
      background: rgb(var(--c-dark) / .9);
      -webkit-backdrop-filter: blur(16px) saturate(1.4);
      backdrop-filter: blur(16px) saturate(1.4);
      box-shadow: 0 -14px 34px -20px rgba(0,0,0,.4);
      border: 1px solid rgb(var(--c-cream) / .12);
    }
    /* L'animation ne joue QUE pendant une ouverture ou une fermeture
       (.panel--anim, posée le temps du geste) : sans ça, tout changement de
       hauteur rejouait le « tiroir », par exemple à l'ouverture du clavier. */
    .panel.panel--anim {
      transition: max-height .45s cubic-bezier(.33, 1, .68, 1),
                  padding .45s cubic-bezier(.33, 1, .68, 1);
    }
    /* svh (petite hauteur d'écran, fixe) et non dvh : la hauteur dynamique
       change quand le clavier ou la barre du navigateur apparaît. */
    .panel.panel--open { max-height: 46svh; padding: 0 1rem .9rem; }
    /* « Aide » : un formulaire à remplir, pas une retouche de la coque. Le
       plan de travail s'efface et le panneau prend toute la hauteur, pour
       que les champs ne soient pas à l'étroit. */
    .builder--help > .canvas { display: none; }
    .builder--help > .panel.panel--open {
      flex: 1 1 auto; min-height: 0; max-height: 100svh;
      margin-top: 10px; margin-bottom: 10px;
    }
    /* Clavier ouvert sur un champ du panneau (html.kb-open, posé par le JS) :
       l'éditeur est calé sur la zone visible AU-DESSUS du clavier. Barre
       d'outils et rail ne servent pas pendant la saisie, ils laissent la
       place ; le panneau garde au plus la moitié de l'écran restant, sauf en
       « Aide » où il prend tout. */
    :global(html.kb-open) .builder > .bar,
    :global(html.kb-open) .builder > .rail { display: none; }
    :global(html.kb-open) .panel.panel--open { max-height: 55%; margin-top: 8px; margin-bottom: 8px; }
    :global(html.kb-open) .builder--help > .panel.panel--open { max-height: none; }

    /* Le header (titre + croix) reste collé en haut pendant le scroll, avec un
       fond, pour que la croix soit toujours visible. */
    .panel-head {
      position: sticky; top: 0; z-index: 6;
      background: rgb(var(--c-dark));
      margin: 0 -1rem .4rem; padding: .55rem 1rem .5rem;
    }
    .panel-x { background: rgb(var(--c-cream) / .08); }
  }

  .panel-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: .6rem; }
  .panel-head h2 { font-size: .95rem; }
  .panel-x {
    width: 32px; height: 32px; border-radius: 8px; cursor: pointer; color: inherit;
    display: flex; align-items: center; justify-content: center; flex: none;
    transition: background .15s;
  }
  .panel-x svg { width: 17px; height: 17px; }
  .panel-x:hover { background: rgb(var(--c-cream) / .14); }
  @media (min-width: 1024px) { .panel-x { display: none; } }
  .pane[hidden] { display: none; }
  .pane-label { display: block; font-size: .66rem; text-transform: uppercase; letter-spacing: .11em; opacity: .6; margin: .9rem 0 .5rem; }
  .pane-hint { font-size: .72rem; opacity: .6; margin-top: .7rem; line-height: 1.45; }
  .pane-empty { font-size: .75rem; opacity: .6; margin-top: .8rem; }
  .pane-cta {
    width: 100%; padding: .7rem; border-radius: 9px; cursor: pointer; font-weight: 600; font-size: .82rem;
    border: 1px dashed rgb(var(--c-cream) / .3); background: rgb(var(--c-cream) / .03); color: inherit;
  }
  .pane-cta:hover { border-color: rgb(var(--accent-rgb)); color: rgb(var(--accent-dark-rgb)); }

  .field {
    width: 100%; padding: .7rem .75rem; border-radius: 8px; font-size: 16px; color: inherit;
    border: 1px solid rgb(var(--c-cream) / .18); background: rgb(var(--c-cream) / .03);
  }
  .field:focus { outline: none; border-color: rgb(var(--accent-rgb)); }

  /* NB : polices et pastilles de couleur sont créées en JS, leurs règles
     vivent dans le bloc <style is:global>. */
  .swatch-row { display: flex; flex-wrap: wrap; gap: .5rem; }
  .font-row { display: flex; flex-wrap: wrap; gap: .4rem; }

  .tpl-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: .55rem; }
  @media (max-width: 1023px) { .tpl-grid { grid-template-columns: repeat(3, 1fr); } }

  .seg { display: flex; gap: .25rem; padding: .2rem; border-radius: 10px; background: rgb(var(--c-cream) / .05); }
  .seg button {
    flex: 1; padding: .45rem .3rem; border-radius: 8px; cursor: pointer; color: inherit;
    font-size: .74rem; font-weight: 500; transition: background .15s, color .15s;
  }
  .seg button[aria-pressed="true"] { background: rgb(var(--accent-rgb)); color: #fff; }

  .dropzone {
    width: 100%; display: flex; flex-direction: column; align-items: center; gap: .35rem;
    padding: 1.5rem 1rem; border-radius: 12px; cursor: pointer; color: inherit; text-align: center;
    border: 1.5px dashed rgb(var(--c-cream) / .28); background: rgb(var(--c-cream) / .03);
  }
  .dropzone:hover { border-color: rgb(var(--accent-rgb)); background: rgb(var(--accent-rgb) / .05); }
  .dropzone svg { width: 26px; height: 26px; opacity: .7; }
  .dropzone strong { font-size: .85rem; }
  .dropzone span { font-size: .7rem; opacity: .6; }

  /* ── Demande de design ───────────────────────────────────────── */
  .help-intro { padding: .85rem .9rem; border-radius: 12px; background: rgb(var(--accent-rgb) / .08); border: 1px solid rgb(var(--accent-rgb) / .22); }
  .help-intro strong { display: block; font-size: .92rem; margin-bottom: .3rem; }
  .help-intro p { font-size: .76rem; line-height: 1.5; opacity: .8; margin: 0; }
  .field-area { min-height: 110px; resize: vertical; line-height: 1.45; font-family: inherit; }
  .help-drop { padding: 1rem; }
  .help-thumbs { display: grid; grid-template-columns: repeat(5, 1fr); gap: .4rem; margin-bottom: .5rem; }
  .help-thumbs:empty { display: none; }
  .help-model { display: flex; align-items: center; justify-content: space-between; gap: .5rem; width: 100%; text-align: left; cursor: pointer; }
  .help-model-act { font-size: .72rem; font-weight: 600; color: rgb(var(--accent-rgb)); flex: none; }
  .help-hp { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
  .help-send { width: 100%; margin-top: 1.1rem; justify-content: center; }
  .help-send[disabled] { opacity: .6; cursor: wait; }
  .help-note { text-align: center; }
  .help-done { text-align: center; padding: 1.5rem .5rem; }
  .help-done svg { width: 40px; height: 40px; padding: 8px; border-radius: 999px; background: rgb(var(--accent-rgb)); color: #fff; }
  .help-done strong { display: block; font-size: 1rem; margin: .8rem 0 .4rem; }
  .help-done p { font-size: .8rem; line-height: 1.5; opacity: .8; margin: 0; }


  /* ── Plan de travail ─────────────────────────────────────────── */
  /* Le plan de travail porte un décor doux : c'est en le voyant AU TRAVERS
     de la coque qu'on comprend qu'elle est transparente. */
  .canvas {
    grid-area: canvas;
    position: relative; overflow: hidden;
    display: flex; align-items: center; justify-content: center;
    padding: 1.25rem 1rem; min-height: 0;
    background: rgb(var(--c-panel) / .5);
    /* Un glissement sur le plan de travail compose, il ne fait pas défiler
       la page derrière (indispensable au confort tactile). */
    touch-action: none;
    overscroll-behavior: contain;
  }
  /* Fond « craft » : une grille type papier millimétré / tapis de découpe.
     Deux échelles (fine + large) posées sur le panneau clair. La coque étant
     transparente, on voit la grille au travers, ce qui souligne la matière. */
  .canvas::before {
    content: ""; position: absolute; inset: 0; pointer-events: none;
    background-color: rgb(var(--c-panel));
    background-image:
      linear-gradient(rgb(var(--accent-rgb) / .09) 1px, transparent 1px),
      linear-gradient(90deg, rgb(var(--accent-rgb) / .09) 1px, transparent 1px),
      linear-gradient(rgb(var(--accent-rgb) / .045) 1px, transparent 1px),
      linear-gradient(90deg, rgb(var(--accent-rgb) / .045) 1px, transparent 1px);
    background-size: 104px 104px, 104px 104px, 26px 26px, 26px 26px;
    background-position: center;
    z-index: 0;   /* le décor reste sous la coque et la barre d'actions, qui
                     sont positionnées et peintes après lui */
  }

  /* ── La coque ────────────────────────────────────────────────── */
  .case {
    position: relative;
    width: 250px;                     /* recalculé par fitCase() */
    aspect-ratio: var(--ratio, .476);
    border-radius: var(--radius, 13%) / calc(var(--radius, 13%) / 2.1);
    container-type: inline-size;
    touch-action: none;
    /* Ombre portée en box-shadow (et non filter) : un ancêtre avec `filter`
       désactive le backdrop-filter du verre dépoli à l'intérieur. box-shadow
       suit tout autant le rayon arrondi. */
    box-shadow: 0 24px 40px -6px rgba(0,0,0,.34);
  }
  .case[data-over] { outline: 2px dashed rgb(var(--accent-rgb)); outline-offset: 8px; }

  /* Le téléphone : affiché seulement en aperçu « sur le téléphone ». Par
     défaut la coque est présentée seule, comme sur une photo produit. */
  .phone {
    position: absolute; inset: 0; border-radius: inherit; display: none;
    background: var(--device, linear-gradient(158deg, #3c3c42, #17171b 46%, #2b2b31));
  }
  .case[data-mount="phone"] .phone { display: block; }
  /* Finition opaque : la coque est teintée, elle masque alors le téléphone. */
  .case[data-finish="solid"] .phone { display: block; background: var(--caseColor, #f4eee2); }

  /* Verre dépoli de la coque transparente : floute le décor derrière + un
     voile blanc très léger. Sous le design, donc les éléments restent nets.
     Si backdrop-filter n'est pas supporté, le voile suffit à adoucir. */
  .frost {
    position: absolute; inset: 0; border-radius: inherit; z-index: 0;
    pointer-events: none;
    background: rgba(255,255,255,.2);
    -webkit-backdrop-filter: blur(9px);
    backdrop-filter: blur(9px);
  }
  /* Finition opaque ou montée sur téléphone : le dos n'est plus transparent,
     il n'y a rien à flouter. */
  .case[data-finish="solid"] .frost,
  .case[data-mount="phone"] .frost { display: none; }

  .design { position: absolute; inset: 0; border-radius: inherit; overflow: hidden; }
  .case-bg { position: absolute; inset: 0; background: center / cover no-repeat; pointer-events: none; }
  .brick-layer { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  .case-overlay { position: absolute; inset: 0; z-index: 5; background: center / 100% 100% no-repeat; pointer-events: none; }



  .guide { position: absolute; background: rgb(var(--accent-rgb)); display: none; z-index: 30; pointer-events: none; }
  .guide-v { left: 50%; top: 0; bottom: 0; width: 1px; transform: translateX(-.5px); }
  .guide-h { top: 50%; left: 0; right: 0; height: 1px; transform: translateY(-.5px); }

  /* Module caméra : dessiné par le JS selon la famille d'appareils */
  .cam { position: absolute; z-index: 6; pointer-events: none; }
  /* NB : le contenu du module caméra est injecté en JS, ses règles vivent
     dans le bloc <style is:global> (pas d'attribut de scope Astro). */

  /* La coque elle-même : épaisseur du TPU + reflet */
  /* La coque elle-même. En finition transparente elle ne pose AUCUN fond :
     on voit le plan de travail au travers, c'est ça qui fait lire « coque
     transparente » plutôt que « téléphone noir ». Seules les arêtes du TPU,
     sa paroi et les reflets sont dessinés. */
  .shell {
    position: absolute; inset: 0; border-radius: inherit; z-index: 8; pointer-events: none;
    background: linear-gradient(135deg, rgba(255,255,255,.14), rgba(255,255,255,.03) 42%, rgba(255,255,255,.09));
    border: 1px solid rgba(255,255,255,.8);
    box-shadow:
      inset 0 0 0 1.5px rgba(255,255,255,.55),   /* arête extérieure */
      inset 0 0 0 9px  rgba(255,255,255,.09),    /* paroi (épaisseur du TPU) */
      inset 0 0 0 10px rgba(255,255,255,.5),     /* arête intérieure */
      inset 0 3px 7px rgba(255,255,255,.4),      /* lumière du haut */
      inset 0 -3px 7px rgba(255,255,255,.22),
      0 1px 1px rgba(255,255,255,.5),
      0 22px 44px -20px rgba(0,0,0,.4);
  }
  /* Montée sur un téléphone : le dos opaque reprend le dessus, on adoucit
     donc les reflets pour ne pas voiler le visuel. */
  .case[data-mount="phone"] .shell,
  .case[data-finish="solid"] .shell {
    background: linear-gradient(135deg, rgba(255,255,255,.10), rgba(255,255,255,0) 45%, rgba(255,255,255,.06));
    border-color: rgba(255,255,255,.5);
    box-shadow:
      inset 0 0 0 1.5px rgba(255,255,255,.35),
      inset 0 0 0 9px rgba(255,255,255,.06),
      inset 0 0 0 10px rgba(255,255,255,.28),
      inset 0 3px 6px rgba(255,255,255,.28),
      0 22px 44px -20px rgba(0,0,0,.45);
  }
  .case[data-finish="solid"] .shell {
    border-color: rgba(255,255,255,.28);
    box-shadow: inset 0 0 0 1px rgba(255,255,255,.18), inset 0 2px 3px rgba(255,255,255,.22);
  }
  .sheen {
    position: absolute; inset: 0; border-radius: inherit;
    background: linear-gradient(112deg,
      rgba(255,255,255,.26) 0%, rgba(255,255,255,.05) 22%,
      rgba(255,255,255,0) 46%, rgba(255,255,255,0) 66%,
      rgba(255,255,255,.16) 82%, rgba(255,255,255,.02) 100%);
  }
  /* Boutons latéraux moulés dans la coque */
  .side { position: absolute; width: 2.4%; border-radius: 2px; background: rgba(255,255,255,.30); box-shadow: inset 0 0 0 1px rgba(255,255,255,.4); z-index: 9; }
  .side-l { left: -1.6%; top: 20%; height: 7%; }
  .side-r { right: -1.6%; top: 26%; height: 11%; }

  .empty {
    position: absolute; inset: 0; display: flex; flex-direction: column;
    align-items: center; justify-content: center; gap: .3rem; text-align: center;
    z-index: 4; pointer-events: none; padding: 0 10%;
  }
  .empty[hidden] { display: none; }
  .empty p { font-size: 4.2cqw; color: rgba(0,0,0,.48); }
  .empty span { font-size: 3.2cqw; color: rgba(0,0,0,.34); }
  .case[data-dark] .empty p { color: rgba(255,255,255,.75); }
  .case[data-dark] .empty span { color: rgba(255,255,255,.48); }

  /* ── Barre contextuelle ──────────────────────────────────────── */
  /* Flottante en bas du PLAN DE TRAVAIL : rattachée à la coque, elle
     débordait dès que celle-ci rétrécissait (panneau ouvert en mobile). */
  .ctx {
    position: absolute; left: 50%; bottom: 10px; transform: translateX(-50%);
    display: flex; gap: 2px; padding: 4px; border-radius: 10px;
    background: rgba(24,24,27,.88); backdrop-filter: blur(6px);
    box-shadow: 0 10px 26px -10px rgba(0,0,0,.6); z-index: 40;
  }
  .ctx[hidden] { display: none; }
  .ctx button {
    display: inline-flex; align-items: center; justify-content: center;
    min-width: 38px; height: 38px; padding: 0 9px; border-radius: 7px;
    color: #fff; background: transparent; font-size: .78rem; cursor: pointer;
  }
  .ctx button svg { width: 18px; height: 18px; }
  .ctx button:hover { background: rgba(255,255,255,.15); }
  .ctx button[data-on] { background: rgb(var(--accent-rgb)); }
  .ctx button[hidden] { display: none; }
  .studio .el[data-cropping] { cursor: move; outline: .5cqw dashed rgb(var(--accent-rgb)); }
  .ctx .ctx-del:hover { background: #e11d48; }
  /* Mobile et tablette : colonne verticale au bord droit du plan de travail.
     En bas, la barre recouvrait le bas de la coque, là où l'on travaille. */
  @media (max-width: 1023px) {
    .ctx {
      left: auto; right: 8px; bottom: auto; top: 50%;
      transform: translateY(-50%);
      flex-direction: column;
    }
    .ctx button { min-width: 40px; height: 40px; padding: 0; }
    /* Plan de travail trop bas (panneau ouvert) : la colonne ne tient plus,
       la barre passe en ligne en haut du plan de travail (cf. fitCtx). */
    .ctx[data-row] {
      top: 6px; right: auto; left: 50%; transform: translateX(-50%);
      flex-direction: row;
    }
  }

  .toast {
    position: fixed; left: 50%; bottom: calc(84px + env(safe-area-inset-bottom)); transform: translateX(-50%);
    z-index: 10060; padding: .7rem 1.15rem; border-radius: 999px;
    background: #16a34a; color: #fff; font-size: .85rem; font-weight: 500;
    box-shadow: 0 10px 30px -10px rgba(0,0,0,.5);
  }
  .toast[data-kind="warn"] { background: #b45309; }
  @media (min-width: 1024px) { .toast { bottom: 26px; } }

  @media (prefers-reduced-motion: reduce) { .panel { transition: none } }
</style>

<!-- Éléments créés en JS : pas d'attribut de scope Astro, règles globales. -->
<style is:global>
  /* ── L'éditeur est une APPLICATION plein écran ────────────────────
     Sans ça la page défile de plusieurs centaines de pixels (le pied de page
     vit sous l'éditeur) : on perd la barre d'outils en glissant, ce qui rend
     l'édition pénible. Le drapeau est posé par le script du studio, donc ces
     règles ne touchent que cette page.

     Verrou étendu au DESKTOP : la mise en îlots du rail et du panneau a
     introduit des marges qui débordaient de quelques pixels, et la page se
     mettait à défiler pour rien. Un éditeur ne défile pas, ce sont ses
     panneaux qui défilent, chacun chez lui. */
  html[data-studio-app], html[data-studio-app] body {
    overflow: hidden;
    height: 100%;
    /* iOS ignore overflow:hidden sur <html> quand le geste part d'une zone
       non défilable ; la position fixe, elle, tient. */
    overscroll-behavior: none;
  }
  html[data-studio-app] footer { display: none; }
  /* Le plan de travail se cale sur la hauteur RÉELLE restante, sans calcul.
     `calc(100dvh - var(--header-h))` se trompait de six pixels : en thème
     sunfreaks le header flotte, son îlot occupe un peu plus que --header-h, et
     le bas de la coque se retrouvait coupé. Ici `main` remplit la page, son
     padding haut est compris dans sa hauteur (border-box), et l'éditeur prend
     ce qui reste, quelle que soit la hauteur du header. */
  html[data-studio-app] .site-main {
    height: 100%;
    box-sizing: border-box;
    overflow: hidden;
  }
  /* La chaîne des hauteurs doit être continue : une seule hauteur `auto` sur
     le parcours et le pourcentage de l'éditeur redevient indéfini, donc égal à
     son contenu, soit 1440 px de haut et une grille écrasée. */
  html[data-studio-app] .studio { height: 100%; }
  /* Clavier ouvert (mobile) : iOS pose le clavier PAR-DESSUS la page sans la
     réduire. La page prend donc la hauteur réellement visible (--vvh, mesurée
     par visualViewport) et l'en-tête s'efface le temps de la saisie. */
  @media (max-width: 1023px) {
    /* L'éditeur est FIXÉ sur la zone visible : son haut (--vvt, décalage de
       la zone visible que iOS fait glisser) et sa hauteur (--vvh). La hauteur
       de la page, elle, ne change pas : l'allonger poussait iOS à décaler la
       zone visible encore plus loin. */
    html[data-studio-app].kb-open #site-header { display: none; }
    html[data-studio-app].kb-open .site-main,
    html[data-theme='sunfreaks'][data-studio-app].kb-open .site-main {
      position: fixed; left: 0; right: 0; z-index: 10001;
      top: var(--vvt, 0px); height: var(--vvh, 100%);
      padding-top: max(8px, env(safe-area-inset-top));
    }
  }
  /* En sunfreaks le header est un ÎLOT : il flotte 9 px sous le haut de page,
     donc son bas dépasse --header-h d'autant. `main` se décalait de
     --header-h seulement, et l'îlot recouvrait le haut de la barre d'outils ,
     visible surtout sur mobile, où le bouton d'achat passait dessous. */
  html[data-theme='sunfreaks'][data-studio-app] .site-main {
    padding-top: calc(var(--header-total) + 18px);
  }
</style>

<style is:global>
  /* ── <ModelPicker> posé dans la barre du studio ──────────────────
     Le composant est conçu pour une fiche produit : étiquette au-dessus,
     champ pleine largeur, marge basse. Dans une barre d'outils il doit se
     réduire à une pastille. On ne touche PAS au composant lui-même, sa
     feuille et sa logique servent aussi aux fiches produit, on ne fait que
     le remettre en forme ici. */
  .studio .bar-mp { min-width: 0; flex: 0 1 auto; margin-left: .3rem; }
  .studio .bar-mp .mp { margin-bottom: 0; }
  .studio .bar-mp .mp > label { display: none; }
  .studio .bar-mp .mp-trigger {
    width: auto; min-width: 0; max-width: 46vw;
    min-height: 34px;
    gap: .45rem; padding: .3rem .7rem;
    border-radius: 999px; font-size: .74rem;
    border-color: rgb(var(--c-cream) / .22);
    background: rgb(var(--c-cream) / .06);
    color: rgb(var(--c-cream));
    transition: border-color .15s, background .15s;
  }
  .studio .bar-mp .mp-trigger:hover { border-color: rgb(var(--c-cream) / .45); background: rgb(var(--c-cream) / .1); }
  .studio .bar-mp .mp-trigger-value {
    color: rgb(var(--c-cream) / .6);
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  /* Modèle choisi : la pastille s'allume. C'est le seul réglage obligatoire
     de la page, son état doit se lire sans chercher. */
  .studio .bar-mp .mp[data-mp-chosen] .mp-trigger {
    border-color: rgb(var(--accent-rgb) / .55);
    background: rgb(var(--accent-rgb) / .14);
  }
  .studio .bar-mp .mp[data-mp-chosen] .mp-trigger-value { color: rgb(var(--c-cream)); font-weight: 500; }
  .studio .bar-mp .mp-error { display: none; }
  /* Petits écrans : le libellé complet « Choisir mon modèle » mangeait la
     place du prix et du bouton d'achat. Tant qu'aucun modèle n'est retenu on
     n'affiche que « Modèle » ; dès qu'il l'est, c'est son nom qui compte et
     il reprend toute la largeur disponible. Texte en dur : le studio n'existe
     qu'en français (cf. data-design-edit-path dans BaseLayout). */
  @media (max-width: 560px) {
    .studio .bar-mp .mp:not([data-mp-chosen]) .mp-trigger-value { display: none; }
    .studio .bar-mp .mp:not([data-mp-chosen]) .mp-trigger::before { content: "Modèle"; }
    /* Le mot « CHANGER » du composant coûte 60 px pour une information que la
       pastille donne déjà : elle est cliquable, donc elle se change. */
    .studio .bar-mp .mp[data-mp-chosen] .mp-trigger-action { display: none; }
    .studio .bar-mp .mp-trigger { max-width: 46vw; padding: .3rem .6rem; }
  }
  @media (min-width: 1024px) {
    .studio .bar-mp .mp-trigger { max-width: 260px; min-height: 38px; font-size: .78rem; padding: .35rem .85rem; }
  }

  /* ── Vignettes de designs (créées en JS) ───────────────────────── */
  .studio .tpl {
    display: flex; flex-direction: column; gap: .35rem; padding: .4rem;
    border-radius: 10px; cursor: pointer; color: inherit;
    border: 1px solid rgb(var(--c-cream) / .12); background: rgb(var(--c-cream) / .02);
    transition: border-color .15s, background .15s, transform .1s;
  }
  .studio .tpl:hover { border-color: rgb(var(--accent-rgb)); background: rgb(var(--accent-rgb) / .05); }
  .studio .tpl:active { transform: scale(.97); }
  .studio .tpl-thumb {
    position: relative; display: block; width: 100%; aspect-ratio: .476;
    border-radius: 9px; overflow: hidden;
    container-type: inline-size;             /* les cqw des éléments suivent la vignette */
    background: linear-gradient(150deg, #f6f2ea, #e9e3d7);
    background-size: cover; background-position: center;
    box-shadow: inset 0 0 0 1px rgba(0,0,0,.07);
  }
  .studio .tel {
    position: absolute; left: 50%; top: 50%;
    white-space: nowrap; line-height: 1.05; pointer-events: none;
  }
  .studio .tpl-name { font-size: .68rem; text-align: center; opacity: .75; }

  /* ── Contrôles des panneaux (créés en JS) ──────────────────────── */


  .studio .swatch {
    width: 34px; height: 34px; border-radius: 50%; cursor: pointer;
    box-shadow: inset 0 0 0 1px rgb(var(--c-cream) / .3); transition: transform .1s;
  }
  .studio .swatch:hover { transform: scale(1.08); }
  .studio .swatch[aria-pressed="true"] { box-shadow: 0 0 0 2px rgb(var(--c-dark)), 0 0 0 4px rgb(var(--accent-rgb)); }
  .studio .swatch--clear {
    background:
      linear-gradient(135deg, rgba(255,255,255,.85), rgba(255,255,255,.2)),
      repeating-conic-gradient(#d8d8dc 0% 25%, #f4f4f6 0% 50%) 50% / 10px 10px;
  }

  .studio .font-chip {
    padding: .45rem .8rem; border-radius: 8px; cursor: pointer; font-size: 1rem; color: inherit;
    border: 1px solid rgb(var(--c-cream) / .18); background: transparent;
  }
  .studio .font-chip[aria-pressed="true"] { border-color: rgb(var(--accent-rgb)); background: rgb(var(--accent-rgb) / .1); }

  /* ── Module caméra (injecté en JS) ──────────────────────────────
     Il doit TRANCHER sur le dos du téléphone : sombre sur sombre, il
     disparaissait et l'aperçu ne se lisait plus comme un dos de coque. */
  /* Découpe caméra sur une coque seule : pas de fond, uniquement l'arête de
     plastique qui borde le trou, on doit voir le décor au travers. */
  /* Même creux ombré que les trous ronds des Galaxy (cf. .cam-hole). */
  .studio .cam-cut {
    position: absolute; inset: 0; border-radius: 26%;
    background: radial-gradient(circle at 50% 40%, rgba(0,0,0,.04), rgba(0,0,0,.13));
    box-shadow:
      0 0 0 1px rgba(0,0,0,.14),
      0 1px 0 1.5px rgba(255,255,255,.85),
      inset 0 3px 8px rgba(0,0,0,.28),
      inset 0 0 0 1px rgba(0,0,0,.08);
  }
  .studio .cam-cut.is-pill { border-radius: 999px; }
  /* Petits trous ronds (Galaxy) : un simple filet blanc se perdait sur une
     coque claire, la coque passait pour une feuille vierge. Un léger creux
     ombré et un liseré gris les font lire comme de vraies découpes. */
  .studio .cam-hole {
    position: absolute; aspect-ratio: 1; border-radius: 22%;
    background: radial-gradient(circle at 50% 40%, rgba(0,0,0,.04), rgba(0,0,0,.13));
    box-shadow:
      0 0 0 1px rgba(0,0,0,.14),
      0 1px 0 1.5px rgba(255,255,255,.85),
      inset 0 2px 5px rgba(0,0,0,.28),
      inset 0 0 0 1px rgba(0,0,0,.08);
  }
  .studio .cam-hole.is-round { border-radius: 50%; }

  .studio .cam-island {
    position: absolute; inset: 0; border-radius: 26%;
    background: linear-gradient(150deg, #43434d, #1d1d24 60%);
    box-shadow:
      inset 0 1px 0 rgba(255,255,255,.30),
      inset 0 0 0 1px rgba(255,255,255,.18),
      0 2px 6px rgba(0,0,0,.55);
  }
  .studio .cam-bar {
    position: absolute; inset: 0; border-radius: 999px;
    background: linear-gradient(160deg, #3e3e48, #16161c 60%);
    box-shadow: inset 0 1px 0 rgba(255,255,255,.28), inset 0 0 0 1px rgba(255,255,255,.18), 0 2px 6px rgba(0,0,0,.5);
  }
  /* aspect-ratio plutôt qu'une hauteur en % : la boîte du module n'est pas
     carrée (colonne étroite chez Galaxy, barre large chez Pixel), les
     objectifs sortaient donc ovales. */
  .studio .lens {
    position: absolute; border-radius: 50%; aspect-ratio: 1;
    background: radial-gradient(circle at 34% 28%, #8ea0bb 0%, #2d3442 42%, #07070b 78%);
    box-shadow:
      0 0 0 1.5px rgba(214,222,235,.65),   /* bague métallique */
      0 0 0 3px rgba(0,0,0,.55),
      inset 0 0 4px rgba(0,0,0,.9);
  }
  .studio .lens::after {
    content: ""; position: absolute; left: 22%; top: 18%; width: 30%; height: 30%;
    border-radius: 50%; background: rgba(255,255,255,.75); filter: blur(.4px);
  }
  .studio .flash {
    position: absolute; border-radius: 50%; aspect-ratio: 1;
    background: radial-gradient(circle at 40% 35%, #fff7de, #d9b169 70%);
    box-shadow: 0 0 0 1px rgba(0,0,0,.45), 0 0 6px rgba(255,236,180,.5);
  }

  .studio .el {
    position: absolute; left: 50%; top: 50%;
    transform: translate(-50%, -50%);
    touch-action: none; cursor: grab; user-select: none; -webkit-user-select: none;
  }
  .studio .el:active { cursor: grabbing; }
  /* Textes, stickers et photos ajoutés par le client passent AU-DESSUS de la
     planche ; seules les photos des cadres restent dessous. */
  .studio .el:not([data-slot]) { z-index: 6; }
  .studio .el-content { display: block; line-height: 1.05; white-space: nowrap; pointer-events: none; }
  .studio .el[data-type="image"] .el-content img { display: block; width: 100%; height: auto; pointer-events: none; }
  /* Photo du calque briques : invisible mais toujours manipulable (cadre de
     sélection, glisser, pincer) ; c'est le calque qui la montre en briques. */
  .studio .design[data-fx="bricks"] .el[data-photo] .el-content { opacity: 0; }
  /* Cadre Polaroid : bord blanc, marge basse plus large, photo carrée
     recadrée. Mêmes proportions que le fichier d'impression (POLA). */
  .studio .pola {
    display: block; background: #fff; padding: 6% 6% 24%;
    box-shadow: 0 .6cqw 1.6cqw rgba(0,0,0,.28), 0 0 0 .15cqw rgba(0,0,0,.06);
  }
  .studio .el[data-type="image"] .pola img { width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; }
  /* Case photo vide : invite à toucher pour ajouter sa photo. */
  .studio .slot-empty {
    display: grid; place-items: center; aspect-ratio: 1; width: 100%;
    background: repeating-linear-gradient(135deg, #eceae4 0 6px, #f4f2ed 6px 12px);
    color: #6b6359; font: 600 3.4cqw/1.2 Inter, system-ui, sans-serif; text-align: center;
    white-space: normal;
  }
  .studio .slot-empty span { display: block; font-size: 9cqw; line-height: 1; margin-bottom: .6cqw; }
  .studio .slot-plain { border: .5cqw dashed #9a9184; }
  /* Case de BD : bord blanc cerné de noir. */
  .studio .panel { display: block; background: #fff; padding: 2.5%; box-shadow: 0 0 0 .9cqw #111; }
  .studio .el[data-type="image"] .panel img,
  .studio .el[data-type="image"] .fill { display: block; width: 100%; height: auto; object-fit: cover; }
  .studio .tel-slot { position: absolute; background: linear-gradient(160deg, #cfd8e3, #a9b6c6); }
  .studio .tel-slot[data-fx="bricks"] { background: url('/images/studio-bg/tpl-briques.webp') center / cover; }
  .studio .tel-slot[data-fx="manga"] { background: #fff url('/images/studio-bg/tpl-manga.webp') center / cover; box-shadow: 0 0 0 2px #111; border: 2px solid #fff; }
  .studio .tel-pola {
    position: absolute; background: #fff; aspect-ratio: 1 / 1.18;
    box-shadow: 0 1px 3px rgba(0,0,0,.3);
  }
  .studio .tel-pola::after {
    content: ""; position: absolute; left: 6%; right: 6%; top: 5%; aspect-ratio: 1;
