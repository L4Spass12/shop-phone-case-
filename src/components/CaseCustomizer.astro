    }
    function applyFx(img, fx, ar) {
      var cv = null;
      try { cv = fx === 'bricks' ? fxBricks(img, ar) : fx === 'manga' ? fxManga(img, ar) : null; } catch (_) { cv = null; }
      if (!cv) return '';
      var out = cv.toDataURL('image/webp', .9);
      if (out.indexOf('data:image/webp') !== 0) out = cv.toDataURL('image/jpeg', .92);
      freeCanvas(cv);
