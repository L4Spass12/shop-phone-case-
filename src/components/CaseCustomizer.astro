        if (!field(document.activeElement)) full = vv.height;
        var kb = mq.matches && field(document.activeElement) && full - vv.height > 120;
        de.classList.toggle('kb-open', kb);
        if (kb) {
          de.style.setProperty('--vvh', Math.round(vv.height) + 'px');
          de.style.setProperty('--vvt', Math.round(Math.max(0, vv.offsetTop)) + 'px');
        } else { de.style.removeProperty('--vvh'); de.style.removeProperty('--vvt'); }
