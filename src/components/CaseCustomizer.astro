    // Seule la largeur est donnée : la hauteur suit via aspect-ratio: 1.
    function lens(l, t, w) { return '<span class="lens" style="left:' + l + '%;top:' + t + '%;width:' + w + '%"></span>'; }
    function flash(l, t, w) { return '<span class="flash" style="left:' + l + '%;top:' + t + '%;width:' + w + '%"></span>'; }
    function hole(l, t, w, round) {
      return '<span class="cam-hole' + (round ? ' is-round' : '') + '" style="left:' + l + '%;top:' + t + '%;width:' + w + '%"></span>';
    }

    function renderCase() {
      var fam = specOf(state.model);
      caseEl.style.setProperty('--ratio', fam.ratio.toFixed(4));
      caseEl.style.setProperty('--radius', fam.radius + '%');

      // Coque seule → la découpe est un TROU (on voit au travers).
      // Coque montée → on dessine le module photo du téléphone.
      var onPhone = state.mount === 'phone';
      var s = camEl.style, html = '';

      if (fam.cam === 'island3' || fam.cam === 'islandBig') {
        var big = fam.cam === 'islandBig';
        s.left = '6%'; s.top = '3.2%'; s.width = big ? '42%' : '39%'; s.height = big ? '20.5%' : '19%';
        html = onPhone
          ? '<span class="cam-island"></span>' + lens(9, 8, 36) + lens(53, 8, 36) + lens(9, 52, 36) + flash(60, 58, 18)
          : '<span class="cam-cut"></span>';
      } else if (fam.cam === 'island2') {
        s.left = '6%'; s.top = '3.2%'; s.width = '30%'; s.height = '14.5%';
        html = onPhone
          ? '<span class="cam-island"></span>' + lens(8, 10, 40) + lens(52, 48, 40)
          : '<span class="cam-cut"></span>';
      } else if (fam.cam === 'lenses3' || fam.cam === 'lenses4') {
        // Galaxy : pas d'îlot, des découpes rondes séparées (4 sur les Ultra)
        var four = fam.cam === 'lenses4';
        s.left = '7%'; s.top = '3.5%'; s.width = '16%'; s.height = four ? '38%' : '30%';
        var tops = four ? [1, 26, 51, 76] : [2, 36, 70];
        html = tops.map(function (t) {
          return onPhone ? lens(12, t, 78) : hole(12, t, 78, true);
        }).join('');
      } else if (fam.cam === 'bar2' || fam.cam === 'bar3') {
        // Pixel : barre horizontale traversante (3 objectifs sur les Pro)
        s.left = '4%'; s.top = '6.5%'; s.width = '92%'; s.height = '8.2%';
        html = onPhone
          ? '<span class="cam-bar"></span>' + lens(8, 12, 9) + lens(20, 12, 9)
            + (fam.cam === 'bar3' ? lens(32, 12, 9) : '') + flash(fam.cam === 'bar3' ? 45 : 33, 34, 4.5)
          : '<span class="cam-cut is-pill"></span>';
      } else if (fam.cam === 'single') {
        // iPhone SE / XR : un seul objectif, pas d'îlot
        s.left = '7%'; s.top = '3.5%'; s.width = '15%'; s.height = '9%';
