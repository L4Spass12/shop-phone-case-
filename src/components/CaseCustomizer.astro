        // de transparence, sans lui le hors-coque virerait au noir.
        if (opts.background) { g.fillStyle = opts.background; g.fillRect(0, 0, w, h); }

        g.save();
        casePath(g, w, h, specOf(state.model).radius, INSET_MM * (w / mm[0]));
        g.clip();

        if (state.finish !== 'clear') { g.fillStyle = state.finish; g.fillRect(0, 0, w, h); }
        else if (opts.background) {
          // Coque transparente : sur l'aperçu on pose un voile clair, sinon le
          // design flotterait sur le fond et se lirait mal.
          g.fillStyle = 'rgba(255,255,255,.72)';
          g.fillRect(0, 0, w, h);
        }
        // Fond de coque : couvre tout, comme en CSS (cover, centré).
        if (bgImg && bgImg.naturalWidth) {
          var k = Math.max(w / bgImg.naturalWidth, h / bgImg.naturalHeight);
          var bw = bgImg.naturalWidth * k, bh = bgImg.naturalHeight * k;
          g.drawImage(bgImg, (w - bw) / 2, (h - bh) / 2, bw, bh);
        }

        // Mode briques : toutes les photos passent dans la grille, posée sur
        // toute la coque ; les textes restent dessinés par-dessus.
        if (state.fx === 'bricks') {
          var blist = state.elements
            .filter(function (e) { return e.type === 'image' && images[e.id] && images[e.id].naturalWidth; })
            .map(function (e) { return { el: e, img: images[e.id] }; });
          var brows = brickRows(w, h);
          drawBricks(g, brickSample(blist, BRICK_COLS, brows), BRICK_COLS, brows, w, h);
        }
        function drawEl(el) {
          if (state.fx === 'bricks' && el.type === 'image') return;
          g.save();
          g.translate(el.x * w / 100, el.y * h / 100);
          g.rotate(el.rot * Math.PI / 180);
          if (el.type === 'image' && el.slot) {
            var pimg = images[el.id];
            if (pimg && pimg.naturalWidth) {
              // Case d'un modèle : cadre éventuel, puis photo recadrée aux
              // proportions de la case (comme object-fit: cover).
