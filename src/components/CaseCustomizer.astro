/**
 * ═══════════════════════════════════════════════════════════════════════
 *  STUDIO, builder de coque personnalisée (esprit Canva / Printify)
 * ═══════════════════════════════════════════════════════════════════════
 *  Organisation : rail d'icônes → panneau contextuel → plan de travail.
 *  Sur mobile le rail passe en bas, le panneau devient une feuille.
 *
 *  Choix structurants :
 *   1. UN SEUL ÉTAT SÉRIALISABLE (`state`) ; le DOM n'en est que le rendu.
 *      D'où, gratuitement : annuler/rétablir, sauvegarde auto, envoi au panier.
 *   2. LA COQUE SUIT LE MODÈLE. Chaque famille d'appareils a son gabarit
 *      (proportions, rayon des angles, découpe caméra) : changer de modèle
 *      change réellement la coque affichée, pas seulement une étiquette.
 *   3. RENDU RÉALISTE. La coque est transparente par défaut : on voit le
 *      téléphone au travers, le TPU a une épaisseur et un reflet. C'est ce qui
 *      permet au client de juger son visuel avant d'acheter.
 *   4. GESTES UNIFIÉS souris + tactile (Pointer Events).
 * ═══════════════════════════════════════════════════════════════════════
 */
import ModelPicker from './ModelPicker.astro';
import siteConfig from '../../site.config.mjs';
import { t, type Locale } from '../lib/i18n';

interface Props { lang?: Locale }
const { lang = 'fr' } = Astro.props;

/* Polices de personnalisation, importées ICI et non dans global.css :
   elles ne servent qu'au studio, elles ne doivent pas peser sur le reste
   du site. Un seul graisse/subset latin par famille. */
import '@fontsource/bodoni-moda/900.css';
import '@fontsource/playfair-display/400.css';
import '@fontsource/abril-fatface/400.css';
import '@fontsource/bebas-neue/400.css';
