    /* ── Finition + téléphone ───────────────────────────────────────
       Plus d'interface : la boutique n'imprime que sur coque transparente, et
       l'aperçu reste « coque seule ». L'état et le rendu gardent les champs
       (`finish`, `device`, `mount`), un design déjà enregistré avec une autre
       finition continue de se rouvrir correctement, et rouvrir le choix plus
       tard ne demandera que de remettre les boutons. */

    /* ── Photos ─────────────────────────────────────────────────── */
    root.querySelector('[data-pick]').addEventListener('click', function () { fileInput.click(); });
    /* Copie haute définition des photos, pour le SEUL fichier d'impression.
       L'éditeur et la sauvegarde travaillent sur une version 1 400 px (légère,
       elle tient dans le localStorage) ; imprimer cette version sur tout le
       dos d'une coque ne donnait qu'environ 220 dpi.

       La copie HD reste dans le NAVIGATEUR du client (IndexedDB, fait pour les
       gros fichiers), jamais sur le serveur : elle survit à un rechargement de
       page sans rien coûter à la base. Chaque photo porte une clé `hk` dans la
       composition ; la copie expire au bout de 7 jours (ménage au démarrage).
       Sans IndexedDB (rare), on retombe sur la version 1 400 px. */
    var hiRes = {};
    var HI_DB = 'moroji-studio', HI_OS = 'hires', HI_TTL = 7 * 24 * 3600 * 1000;
    function hiDb() {
      return new Promise(function (done) {
        try {
          var rq = indexedDB.open(HI_DB, 1);
          rq.onupgradeneeded = function () { rq.result.createObjectStore(HI_OS); };
          rq.onsuccess = function () { done(rq.result); };
          rq.onerror = function () { done(null); };
        } catch (_) { done(null); }
      });
    }
    function hiStore(k, blob) {
      hiDb().then(function (db) {
        if (db) db.transaction(HI_OS, 'readwrite').objectStore(HI_OS).put({ b: blob, t: Date.now() }, k);
      }).catch(function () {});
    }
    /* Recharge les copies HD des photos de la composition, et supprime les
       copies expirées. */
    function hiRestore() {
      var refs = {};
      state.elements.forEach(function (e) { if (e.hk) refs[e.hk] = 1; });
      hiDb().then(function (db) {
        if (!db) return;
        var now = Date.now();
        var rq = db.transaction(HI_OS, 'readwrite').objectStore(HI_OS).openCursor();
        rq.onsuccess = function () {
          var cur = rq.result; if (!cur) return;
          var v = cur.value;
          if (!v || !v.b || now - v.t > HI_TTL) cur.delete();
          else if (refs[cur.key] && !hiRes[cur.key]) hiRes[cur.key] = URL.createObjectURL(v.b);
          cur.continue();
        };
      }).catch(function () {});
    }
    /* Libère la mémoire d'un canvas tout de suite : Safari sur iPhone plafonne
       la mémoire de TOUS les canvas de la page, et au-delà il dessine du vide
       sans lever d'erreur (la photo « ne s'ajoutait pas »). */
    function freeCanvas(c) { try { c.width = 0; c.height = 0; } catch (_) {} }
    /* ── Calque briques ────────────────────────────────────────────
       La grille est FIXE sur la coque (BRICK_COLS colonnes de briques
       carrées) : la photo glisse, tourne ou rétrécit dessous, et chaque
       brique prend la couleur de la photo à son emplacement. Même calcul à
       l'écran et dans le fichier d'impression. */
    var BRICK_COLS = 32;
    // Couleur de base des briques sans photo dessous : la grille couvre
    // toujours toute la coque.
    var BRICK_BASE = [242, 239, 233];
    // Couleurs de toutes les photos (dans l'ordre d'empilement) à la
    // résolution de la grille (cols x rows).
    function brickSample(list, cols, rows) {
      var cv = document.createElement('canvas'); cv.width = cols; cv.height = rows;
      var g = cv.getContext('2d');
      g.imageSmoothingQuality = 'high';
      list.forEach(function (it) {
        var el = it.el, img = it.img;
        var iw = el.size / 100 * cols, ih = iw * ((img.naturalHeight || 1) / (img.naturalWidth || 1));
        g.save();
        g.translate(el.x / 100 * cols, el.y / 100 * rows);
        g.rotate(el.rot * Math.PI / 180);
        g.drawImage(img, -iw / 2, -ih / 2, iw, ih);
        g.restore();
      });
      var px = g.getImageData(0, 0, cols, rows).data;
      freeCanvas(cv);
      // Mélange avec la couleur de base là où la photo est absente ou
      // partiellement transparente (bords).
      for (var i = 0; i < px.length; i += 4) {
        var a = px[i + 3] / 255;
        px[i] = Math.round(px[i] * a + BRICK_BASE[0] * (1 - a));
        px[i + 1] = Math.round(px[i + 1] * a + BRICK_BASE[1] * (1 - a));
        px[i + 2] = Math.round(px[i + 2] * a + BRICK_BASE[2] * (1 - a));
        px[i + 3] = 255;
