      return '<span class="cam-hole' + (round ? ' is-round' : '') + '" style="left:' + l + '%;top:' + t + '%;width:' + w + '%"></span>';
    }

    function renderCase() {
      var fam = specOf(state.model);
      caseEl.style.setProperty('--ratio', fam.ratio.toFixed(4));
      caseEl.style.setProperty('--radius', fam.radius + '%');

      // Coque seule → la découpe est un TROU (on voit au travers).
      // Coque montée → on dessine le module photo du téléphone.
      var onPhone = state.mount === 'phone';
      var s = camEl.style, html = '';

      if (fam.cam === 'island3' || fam.cam === 'islandBig') {
        var big = fam.cam === 'islandBig';
        s.left = '6%'; s.top = '3.2%'; s.width = big ? '42%' : '39%'; s.height = big ? '20.5%' : '19%';
        html = onPhone
          ? '<span class="cam-island"></span>' + lens(9, 8, 36) + lens(53, 8, 36) + lens(9, 52, 36) + flash(60, 58, 18)
          : '<span class="cam-cut"></span>';
      } else if (fam.cam === 'island2') {
        s.left = '6%'; s.top = '3.2%'; s.width = '30%'; s.height = '14.5%';
        html = onPhone
          ? '<span class="cam-island"></span>' + lens(8, 10, 40) + lens(52, 48, 40)
          : '<span class="cam-cut"></span>';
      } else if (fam.cam === 'lenses3' || fam.cam === 'lenses4') {
        // Galaxy : pas d'îlot, des découpes rondes séparées (4 sur les Ultra)
        var four = fam.cam === 'lenses4';
        s.left = '7%'; s.top = '3.5%'; s.width = '16%'; s.height = four ? '38%' : '30%';
        var tops = four ? [1, 26, 51, 76] : [2, 36, 70];
        html = tops.map(function (t) {
          return onPhone ? lens(12, t, 78) : hole(12, t, 78, true);
        }).join('');
      } else if (fam.cam === 'bar2' || fam.cam === 'bar3') {
        // Pixel : barre horizontale traversante (3 objectifs sur les Pro)
        s.left = '4%'; s.top = '6.5%'; s.width = '92%'; s.height = '8.2%';
        html = onPhone
          ? '<span class="cam-bar"></span>' + lens(8, 12, 9) + lens(20, 12, 9)
            + (fam.cam === 'bar3' ? lens(32, 12, 9) : '') + flash(fam.cam === 'bar3' ? 45 : 33, 34, 4.5)
          : '<span class="cam-cut is-pill"></span>';
      } else if (fam.cam === 'single') {
        // iPhone SE / XR : un seul objectif, pas d'îlot
        s.left = '7%'; s.top = '3.5%'; s.width = '15%'; s.height = '9%';
        html = onPhone ? lens(0, 0, 100) : hole(0, 0, 100, true);
      } else if (fam.cam === 'dualv') {
        // iPhone XS : deux objectifs alignés verticalement dans un îlot
        s.left = '6%'; s.top = '3.4%'; s.width = '16%'; s.height = '17%';
        html = onPhone
          ? '<span class="cam-island"></span>' + lens(11, 4, 78) + lens(11, 52, 78)
          : '<span class="cam-cut"></span>';
      }
      camEl.innerHTML = html;
      fitCase();
    }

    // La coque doit tenir dans le plan de travail : on calcule sa largeur à
    // partir de la place disponible (une largeur explicite est indispensable
    // au conteneur `inline-size` qui pilote les unités cqw des éléments).
    function fitCase() {
      var spec = specOf(state.model);
      var r = canvasEl.getBoundingClientRect();
      if (!r.height) return;
      // Aucun plancher élevé ici : un minimum de 220 px de haut empêchait la
      // coque de rétrécir quand un panneau s'ouvre en mobile, et elle
      // débordait alors du plan de travail par le haut.
      var maxW = Math.max(70, r.width - 28);
      var maxH = Math.max(110, r.height - 20);
      caseEl.style.width = Math.round(Math.min(maxW, maxH * spec.ratio, 300)) + 'px';
      // La coque a changé de taille : recale le cadre de sélection.
      if (selectedId != null) { var s = findEl(selectedId); if (s) positionGizmo(s); }
    }
    // Le plan de travail change de taille à chaque ouverture/fermeture de
    // panneau (mobile), rotation ou apparition du clavier : on observe la
    // boîte plutôt que de rappeler fitCase() à chaque endroit concerné.
    if (window.ResizeObserver) new ResizeObserver(fitCase).observe(canvasEl);
    else window.addEventListener('resize', fitCase);

    function applyFinish() {
      if (state.finish === 'clear') {
        caseEl.dataset.finish = 'clear';
      } else {
        caseEl.dataset.finish = 'solid';
        caseEl.style.setProperty('--caseColor', state.finish);
      }
      caseEl.dataset.mount = state.mount;
      phoneEl.style.setProperty('--device', state.device);
      // Fond sombre derrière le visuel ? Sert à choisir la couleur des
      // libellés de l'état vide pour qu'ils restent lisibles.
      var dev = DEVICES.filter(function (d) { return d.id === state.device; })[0];
      var darkBack = state.finish !== 'clear'
        ? isDark(state.finish)
        : (state.mount === 'phone' && dev && dev.dark);
      caseEl.toggleAttribute('data-dark', !!darkBack);
    }

    /* ── Rendu des éléments ─────────────────────────────────────── */
    // Contour de texte : huit ombres décalées, rendu identique partout (le
    // fichier d'impression, lui, trace un vrai contour, cf. renderDesign).
    function outlineCss(c) {
      if (!c) return '';
      return [[1,0],[-1,0],[0,1],[0,-1],[.7,.7],[-.7,.7],[.7,-.7],[-.7,-.7]].map(function (p) {
        return (p[0] * .055).toFixed(3) + 'em ' + (p[1] * .055).toFixed(3) + 'em 0 ' + c;
      }).join(',');
    }
    function applyCrop(el) {
      var ref = nodes.get(el.id), im = ref && ref.node.querySelector('img');
      if (im) im.style.objectPosition = ((el.ox == null ? .5 : el.ox) * 100) + '% ' + ((el.oy == null ? .5 : el.oy) * 100) + '%';
    }
    function applyStyles(el) {
      var ref = nodes.get(el.id); if (!ref) return;
      ref.node.style.left = el.x + '%';
      ref.node.style.top = el.y + '%';
      ref.node.style.transform = 'translate(-50%,-50%) rotate(' + el.rot + 'deg)';
      if (el.type === 'image') ref.content.style.width = el.size + 'cqw';
      else {
        ref.content.style.fontSize = el.size + 'cqw';
        if (el.type === 'text') { ref.content.style.fontFamily = el.font; ref.content.style.color = el.color; ref.content.style.textShadow = outlineCss(el.outline); }
      }
      if (el.id === selectedId) positionGizmo(el);
      if (state.fx === 'bricks' && el.type === 'image') scheduleBricks();
    }

    // Cale le cadre de sélection (calque hors du clip) sur l'élément : même
    // centre (x/y %), même taille (mesurée sur le nœud) et même rotation, avec
    // 7px de marge tout autour comme l'ancien cadre.
    function positionGizmo(el) {
      var ref = nodes.get(el.id); if (!ref) { gizmoEl.hidden = true; return; }
      gizmoEl.style.left = el.x + '%';
      gizmoEl.style.top = el.y + '%';
      gizmoEl.style.width = (ref.node.offsetWidth + 14) + 'px';
      gizmoEl.style.height = (ref.node.offsetHeight + 14) + 'px';
      gizmoEl.style.transform = 'translate(-50%,-50%) rotate(' + el.rot + 'deg)';
    }

    function createNode(el) {
      var node = document.createElement('div');
      node.className = 'el'; node.dataset.type = el.type; node.dataset.id = String(el.id);
      if (el.type === 'image' && el.src) node.dataset.photo = '';
      if (el.slot) node.dataset.slot = '';
      var content = document.createElement('div');
      content.className = 'el-content';
      if (el.type === 'image') {
        // Case photo d'un modèle : cadre Polaroid éventuel, et tant qu'elle
        // est vide, une invite « Ajouter une photo » (toucher la case ouvre
        // le choix de photo, cf. onUp).
        var host = content;
        if (el.frame === 'polaroid' || el.frame === 'panel') {
          host = document.createElement('div'); host.className = el.frame === 'panel' ? 'panel' : 'pola';
          content.appendChild(host);
        }
        if (el.src) {
          var img = document.createElement('img');
          img.src = el.src; img.alt = 'Visuel importé'; img.draggable = false;
          // Case d'un modèle : photo recadrée aux proportions de la case.
          if (el.slot && el.frame !== 'polaroid' && el.fx !== 'bricks') { img.className = 'fill'; img.style.aspectRatio = String(1 / (el.ar || 1)); }
          if (el.slot) img.style.objectPosition = ((el.ox == null ? .5 : el.ox) * 100) + '% ' + ((el.oy == null ? .5 : el.oy) * 100) + '%';
          // Filet pour les navigateurs sans ResizeObserver : au décodage, la
          // hauteur passe de zéro à sa valeur réelle.
          img.addEventListener('load', function () {
            if (selectedId === el.id) positionGizmo(el);
            if (state.fx === 'bricks') scheduleBricks();
          });
          host.appendChild(img);
        } else {
          var ph = document.createElement('div');
          ph.className = 'slot-empty' + (el.frame ? '' : ' slot-plain');
          ph.style.aspectRatio = String(1 / (el.ar || 1));
          ph.innerHTML = '<div><span>+</span></div>';
          ph.firstChild.appendChild(document.createTextNode(I.slotAdd));
          host.appendChild(ph);
        }
      } else content.textContent = el.text;
      node.append(content);
      node.addEventListener('pointerdown', function (e) { onDown(e, el.id); });
      if (el.type === 'text') node.addEventListener('dblclick', function () { enterEdit(el.id); });
      design.appendChild(node);
      nodes.set(el.id, { node: node, content: content });
      applyStyles(el);
    }

    var caseBgEl = root.querySelector('[data-casebg]');
    var overlayEl = root.querySelector('[data-overlay]');
    function bgSrc() { return state.bg && BG[state.bg] ? BG[state.bg].src : ''; }
    function renderBg() { caseBgEl.style.backgroundImage = bgSrc() ? 'url("' + bgSrc() + '")' : ''; }
    function renderAll() {
      renderBg();
      design.querySelectorAll('.el').forEach(function (n) { n.remove(); });
      nodes.clear();
      state.elements.forEach(createNode);
      if (state.fx) design.dataset.fx = state.fx; else delete design.dataset.fx;
      overlayEl.hidden = !state.overlay;
      overlayEl.style.backgroundImage = state.overlay ? 'url("' + state.overlay + '")' : '';
      renderCase(); applyFinish(); refreshEmpty(); scheduleBricks();
      if (selectedId && !findEl(selectedId)) selectedId = null;
      applySelection();
    }
    function refreshEmpty() { emptyEl.hidden = state.elements.length > 0 || !!bgSrc() || !!state.overlay; }

    /* ── Historique + sauvegarde ────────────────────────────────── */
    function snapshot() { return JSON.stringify(state); }
    function pushHistory() {
      history = history.slice(0, hIndex + 1);
      history.push(snapshot());
      if (history.length > 60) history.shift();
      hIndex = history.length - 1;
      syncHistory(); save();
    }
    function syncHistory() { undoBtn.disabled = hIndex <= 0; redoBtn.disabled = hIndex >= history.length - 1; }
    function restore(json) { state = JSON.parse(json); seq = state.elements.reduce(function (m, e) { return Math.max(m, e.id); }, 0); renderAll(); save(); }
    function undo() { if (hIndex > 0) { hIndex--; restore(history[hIndex]); syncHistory(); } }
    function redo() { if (hIndex < history.length - 1) { hIndex++; restore(history[hIndex]); syncHistory(); } }
    function save() { try { localStorage.setItem(STORE, snapshot()); } catch (e) {} }

    undoBtn.addEventListener('click', undo);
    redoBtn.addEventListener('click', redo);
    root.querySelector('[data-reset]').addEventListener('click', function () {
      if (!state.elements.length && !state.bg) return;
      if (!window.confirm(I.confirmReset)) return;
      state.elements = []; state.bg = null; state.fx = null; state.overlay = null; selectedId = null; renderAll(); pushHistory(); toast(I.resetDone);
    });

    /* ── Ajout / suppression ────────────────────────────────────── */
    function addElement(data) {
      var n = state.elements.length;
      var el = Object.assign({ id: ++seq, x: clamp(50 + (n % 3 - 1) * 9, 12, 88), y: clamp(46 + (n % 4) * 7, 26, 88), rot: 0 }, data);
      state.elements.push(el); createNode(el); refreshEmpty(); select(el.id); pushHistory();
      return el;
    }
    function removeElement(id) {
      // Photo d'une case de modèle : on vide la case au lieu de la retirer,
      // pour que la photo suivante retrouve le même cadre et le même effet.
      var sl = findEl(id);
      if (sl && sl.type === 'image' && sl.slot && sl.src) {
        sl.src = ''; delete sl.hk;
        var r0 = nodes.get(id); if (r0) { r0.node.remove(); nodes.delete(id); }
        createNode(sl);
        state.elements.forEach(function (x) { var r = nodes.get(x.id); if (r) design.appendChild(r.node); });
        selectedId = null; applySelection(); scheduleBricks(); pushHistory();
        return;
      }
      var ref = nodes.get(id); if (ref) { ref.node.remove(); nodes.delete(id); }
      state.elements = state.elements.filter(function (e) { return e.id !== id; });
      if (selectedId === id) { selectedId = null; applySelection(); }
      scheduleBricks();
      refreshEmpty(); pushHistory();
    }
    function duplicate(id) {
      var el = findEl(id); if (!el) return;
      var c = Object.assign({}, el); delete c.id;
      c.x = clamp(el.x + 7, 6, 94); c.y = clamp(el.y + 7, 6, 94);
      // La copie garde la même clé `hk` : elle partage la photo HD.
      addElement(c);
    }
    function reorder(id, dir) {
      var i = state.elements.findIndex(function (e) { return e.id === id; });
      var j = i + dir; if (i < 0 || j < 0 || j >= state.elements.length) return;
      var t = state.elements[i]; state.elements[i] = state.elements[j]; state.elements[j] = t;
      state.elements.forEach(function (e) { design.appendChild(nodes.get(e.id).node); });
      pushHistory();
    }

    /* ── Sélection ──────────────────────────────────────────────── */
    function select(id) { selectedId = id; applySelection(); }
    function deselect() { if (editingId) exitEdit(); selectedId = null; applySelection(); }
    /* Le cadre se mesure sur le nœud. Or un nœud qui vient d'apparaître n'a
       pas encore sa taille définitive : une image importée ne connaît la
       sienne qu'une fois décodée, un texte qu'une fois sa police chargée. Le
       cadre se posait donc sur un nœud encore plat, une barre large et fine,
       qui ne se recalait qu'au premier redimensionnement.
       On suit désormais la taille réelle du nœud sélectionné : dès qu'elle
       change, le cadre suit. */
    var gizmoWatch = null;
    var sizeObserver = typeof ResizeObserver === 'function'
      ? new ResizeObserver(function () {
          var el = selectedId ? findEl(selectedId) : null;
          if (el) positionGizmo(el);
        })
      : null;

    function watchSelected(node) {
      if (!sizeObserver) return;
      if (gizmoWatch) sizeObserver.unobserve(gizmoWatch);
      gizmoWatch = node || null;
      if (gizmoWatch) sizeObserver.observe(gizmoWatch);
    }

    function applySelection() {
      nodes.forEach(function (ref, id) { ref.node.classList.toggle('sel', id === selectedId); });
      var el = selectedId ? findEl(selectedId) : null;
      var ref = el ? nodes.get(el.id) : null;
      watchSelected(ref ? ref.node : null);
      if (el) { gizmoEl.hidden = false; positionGizmo(el); } else { gizmoEl.hidden = true; }
      ctx.hidden = !el;
      if (el) ctx.querySelector('[data-act="edit"]').hidden = el.type !== 'text';
      fitCtxSoon();
      if (el) ctx.querySelector('[data-act="crop"]').hidden = !(el.type === 'image' && el.slot && el.src && el.fx !== 'bricks');
      if (!el || el.id !== cropId) setCrop(null);
      syncTextPane();
    }
    // La colonne d'actions (mobile) doit tenir dans le plan de travail.
    function fitCtx() {
      if (ctx.hidden) return;
      ctx.removeAttribute('data-row');
      if (window.innerWidth > 1023) return;
      var avail = canvasEl.getBoundingClientRect().height - 16;
      if (ctx.getBoundingClientRect().height > avail) ctx.setAttribute('data-row', '');
    }
    function fitCtxSoon() { requestAnimationFrame(fitCtx); }
    if (typeof ResizeObserver === 'function') new ResizeObserver(fitCtx).observe(canvasEl);
    window.addEventListener('resize', fitCtx);
    ctx.addEventListener('click', function (e) {
      var b = e.target.closest('[data-act]'); if (!b || !selectedId) return;
      var a = b.dataset.act;
      if (a === 'del') removeElement(selectedId);
      else if (a === 'dup') duplicate(selectedId);
      else if (a === 'front') reorder(selectedId, 1);
      else if (a === 'back') reorder(selectedId, -1);
      else if (a === 'edit') openPane('text');
      else if (a === 'crop') setCrop(cropId === selectedId ? null : selectedId);
    });
    /* Recadrage : en mode recadrage, glisser déplace la photo DANS son cadre
       (point de cadrage ox/oy, de 0 à 1) au lieu de déplacer le cadre. */
    var cropId = null;
    function setCrop(id) {
      if (cropId === id) return;
      if (cropId != null) { var r0 = nodes.get(cropId); if (r0) delete r0.node.dataset.cropping; }
      cropId = id;
      var btn = ctx.querySelector('[data-act="crop"]');
      if (id != null) { var r1 = nodes.get(id); if (r1) r1.node.dataset.cropping = ''; btn.dataset.on = ''; toast(U_CROP_ON); }
      else delete btn.dataset.on;
    }
    var U_CROP_ON = I.cropOn || '';
    // Cliquer n'importe où sur le plan de travail, coque OU fond autour ,
    // désélectionne. Seuls un élément (.el, poignées comprises) et la barre
    // d'actions (data-ctx) en sont exclus : sinon on annulerait la sélection
    // qu'on vient de faire, ou l'action qu'on s'apprête à déclencher.
    canvasEl.addEventListener('pointerdown', function (e) {
      if (e.target.closest('.el') || e.target.closest('[data-gizmo]') || e.target.closest('[data-ctx]')) return;
      deselect();
    });

    // Poignées du cadre (redimensionner / pivoter) : elles vivent sur le calque
    // hors du clip, donc leur pointerdown doit déclencher le geste sur
    // l'élément sélectionné.
    gizmoEl.addEventListener('pointerdown', function (e) {
      var handle = e.target && e.target.dataset ? e.target.dataset.handle : null;
      if (!handle || selectedId == null) return;
      onDown(e, selectedId);
    });

    /* ── Gestes ─────────────────────────────────────────────────── */
    var SNAP = 2.2;
    function onDown(e, id) {
      if (editingId === id) return;
      e.preventDefault(); select(id);
      var el = findEl(id); if (!el) return;
      var handle = e.target.dataset ? e.target.dataset.handle : null;
      var d = design.getBoundingClientRect(), b = nodes.get(id).node.getBoundingClientRect();
      var cx = b.left + b.width / 2, cy = b.top + b.height / 2;
      gesture = {
        el: el, mode: handle || (cropId === id ? 'pan' : 'drag'), px: e.clientX, py: e.clientY,
        sox: el.ox == null ? .5 : el.ox, soy: el.oy == null ? .5 : el.oy, bw: b.width, bh: b.height,
        sx: el.x, sy: el.y, srot: el.rot, ssize: el.size, cx: cx, cy: cy,
        a0: Math.atan2(e.clientY - cy, e.clientX - cx),
        d0: Math.hypot(e.clientX - cx, e.clientY - cy) || 1,
        cw: d.width, ch: d.height, moved: false,
      };
      try { e.target.setPointerCapture(e.pointerId); } catch (_) {}
      window.addEventListener('pointermove', onMove);
      window.addEventListener('pointerup', onUp);
      window.addEventListener('pointercancel', onUp);
    }
    function onMove(e) {
      if (!gesture) return;
      var g = gesture; g.moved = true;
      if (g.mode === 'pan') {
        // Glisser vers le bas montre le HAUT de la photo : le point de
        // cadrage recule.
        g.el.ox = clamp(g.sox - (e.clientX - g.px) / g.bw * 1.6, 0, 1);
        g.el.oy = clamp(g.soy - (e.clientY - g.py) / g.bh * 1.6, 0, 1);
        applyCrop(g.el);
        return;
      }
      if (g.mode === 'drag') {
        var nx = g.sx + (e.clientX - g.px) / g.cw * 100, ny = g.sy + (e.clientY - g.py) / g.ch * 100;
        var sv = Math.abs(nx - 50) < SNAP, sh = Math.abs(ny - 50) < SNAP;
        if (sv) nx = 50; if (sh) ny = 50;
        guideV.style.display = sv ? 'block' : 'none';
        guideH.style.display = sh ? 'block' : 'none';
        g.el.x = clamp(nx, 0, 100); g.el.y = clamp(ny, 0, 100);
      } else if (g.mode === 'rotate') {
        var a = Math.atan2(e.clientY - g.cy, e.clientX - g.cx);
        var deg = g.srot + (a - g.a0) * 180 / Math.PI;
        if (Math.abs(deg % 90) < 5) deg = Math.round(deg / 90) * 90;
        g.el.rot = deg;
      } else if (g.mode === 'resize') {
        var dd = Math.hypot(e.clientX - g.cx, e.clientY - g.cy);
        // Les images peuvent déborder très largement la coque : le design est
        // en overflow:hidden, donc le débord est rogné proprement au bord et
        // on ne voit aucune coupure. Plafond bien plus haut que pour le texte.
        var maxSize = g.el.type === 'image' ? 400 : 96;
        g.el.size = clamp(g.ssize * (dd / g.d0), 4, maxSize);
      }
      applyStyles(g.el);
    }
    var pendingSlot = null;
    function isEmptySlot(el) { return !!(el && el.type === 'image' && el.slot && !el.src); }
    function onUp(e) {
      var g0 = gesture;
      if (g0 && g0.mode === 'drag' && isEmptySlot(g0.el) && e &&
          Math.hypot(e.clientX - g0.px, e.clientY - g0.py) < 8) {
        pendingSlot = g0.el.id; fileInput.click();
      }
      if (gesture && gesture.moved) pushHistory();
      gesture = null;
      guideV.style.display = 'none'; guideH.style.display = 'none';
      window.removeEventListener('pointermove', onMove);
      window.removeEventListener('pointerup', onUp);
      window.removeEventListener('pointercancel', onUp);
    }

    /* ── Édition de texte en place ──────────────────────────────── */
    function enterEdit(id) {
      var ref = nodes.get(id); if (!ref) return;
      editingId = id; ref.node.dataset.editing = '';
      ref.content.contentEditable = 'true'; ref.content.focus();
      var s = document.getSelection(); if (s) s.selectAllChildren(ref.content);
    }
    function exitEdit() {
      if (!editingId) return;
      var el = findEl(editingId), ref = nodes.get(editingId);
      if (ref) { ref.content.contentEditable = 'false'; delete ref.node.dataset.editing; }
      if (el && ref) {
        var v = ref.content.textContent.trim();
        if (!v) { var id = editingId; editingId = null; removeElement(id); return; }
        if (v !== el.text) { el.text = v; pushHistory(); }
      }
      editingId = null;
    }

    /* ── Pastille glissante du rail ─────────────────────────────────
       Une seule pastille pour tous les outils : elle se déplace vers celui
       qu'on vient de choisir. Les positions sont mesurées sur les boutons
       eux-mêmes (offsetLeft/offsetTop, relatifs au rail qui est en
       `position: relative`), donc ça marche aussi bien pour la colonne du
       desktop que pour la barre horizontale du mobile, sans code séparé. */
    var railInd = root.querySelector('[data-railind]');
    var railIndPlaced = false;

    function moveRailInd(animate) {
      var b = root.querySelector('.rbtn[aria-pressed="true"]');
      if (!b) { railInd.removeAttribute('data-on'); railIndPlaced = false; return; }
      // Premier placement (ou changement de format) : on pose la pastille sans
      // transition, sinon elle traverse l'écran depuis le coin au chargement.
      if (!railIndPlaced) animate = false;
      railIndPlaced = true;
      if (!animate) railInd.style.transition = 'none';
      // Position mesurée par rapport au rail (et non offsetLeft) : les boutons
      // sont rangés dans deux îlots, chacun son propre repère.
      var rr = railInd.parentElement.getBoundingClientRect(), br = b.getBoundingClientRect();
      railInd.style.width = b.offsetWidth + 'px';
      railInd.style.height = b.offsetHeight + 'px';
      railInd.style.transform = 'translate3d(' + (br.left - rr.left) + 'px,' + (br.top - rr.top) + 'px,0)';
      railInd.setAttribute('data-on', '');
