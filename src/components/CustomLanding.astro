---
// Page « coque personnalisée » (/coque-personnalisee/) : la page qui répond à
// la recherche « coque personnalisée » et envoie vers le studio. Le studio
// lui-même (/personnaliser) est une application, peu lisible pour Google.
import BaseLayout from '../layouts/BaseLayout.astro';
import siteConfig from '../../site.config.mjs';
import { localePrefix, type Locale } from '../lib/i18n';
import { PHONE_MODELS } from '../lib/models';

interface Props { lang: Locale }
const { lang } = Astro.props;
const lp = localePrefix(lang);
const url = (p: string) => `${lp}${p}`;
const money = (c: number) => new Intl.NumberFormat(lang === 'en' ? 'en-IE' : lang === 'de' ? 'de-DE' : 'fr-FR', { style: 'currency', currency: siteConfig.shop.currency }).format(c / 100);
const flat = money(siteConfig.shop?.customCasePriceCents ?? 1990);
const relief = money(siteConfig.shop?.customCaseReliefPriceCents ?? 2490);
const iphones = PHONE_MODELS.filter((m) => m.brand === 'apple').map((m) => m.label);
const galaxies = PHONE_MODELS.filter((m) => m.brand === 'samsung').map((m) => m.label);

const TPL = [
  { src: '/images/studio-bg/tpl-toi-moi.webp', name: { fr: 'Toi & Moi', en: 'You & Me', de: 'Du & Ich' } },
  { src: '/images/studio-bg/tpl-manga-planche-v2.webp', name: { fr: 'Manga', en: 'Manga', de: 'Manga' } },
  { src: '/images/studio-bg/tpl-souvenirs.webp', name: { fr: 'Souvenirs', en: 'Memories', de: 'Erinnerungen' } },
  { src: '/images/studio-bg/tpl-amour-rose.webp', name: { fr: 'Amour rose', en: 'Pink love', de: 'Rosa Liebe' } },
];

const T = {
  fr: {
    title: 'Coque personnalisée avec photo pour iPhone et Samsung',
    description: `Créez votre coque de téléphone personnalisée avec vos photos et vos textes, pour iPhone et Samsung Galaxy. Imprimée à l'unité en France, dès ${flat}.`,
    h1: 'Coque personnalisée avec vos photos',
    intro: `Une photo de couple, votre animal, un souvenir de vacances ou votre prénom : créez une coque de téléphone qui n'existe qu'en un exemplaire. Vous la composez en ligne, nous l'imprimons à l'unité dans notre atelier en France.`,
    cta: 'Créer ma coque',
    price: `À partir de ${flat}, ${relief} en relief`,
    stepsTitle: 'Comment ça marche ?',
    steps: [
      ['Choisissez votre téléphone', `iPhone 11 à 18 Pro Max ou Samsung Galaxy : la coque est moulée pour votre modèle exact.`],
      ['Composez votre design', 'Ajoutez vos photos et vos textes, ou partez d’un modèle prêt à remplir : cadres Polaroid, planche manga, collage souvenirs…'],
      ['Recevez votre coque', 'Elle est imprimée à l’unité dans notre atelier en France, puis expédiée sous 1 à 2 jours ouvrés.'],
    ],
    tplTitle: 'Des modèles prêts à remplir',
    tplText: 'Pas d’idée de mise en page ? Choisissez un modèle dans le studio, glissez-y vos photos, c’est prêt.',
    finishTitle: 'À plat ou en relief',
    finishText: `À plat (${flat}), l’encre affleure la coque : surface lisse et couleurs franches, idéal pour les photos. En relief (${relief}), l’encre est déposée en plusieurs couches : votre design se sent sous le doigt.`,
    helpTitle: 'Pas inspiré ? On le crée pour vous',
    helpText: 'Dans le studio, l’onglet Aide vous permet de décrire votre idée et d’envoyer vos photos : notre atelier prépare votre design et vous l’envoie par e-mail sous 48 à 72 h, avec 2 propositions incluses. La création coûte 6,90 €, ajoutés au prix de la coque seulement si vous la commandez.',
    giftTitle: 'Une idée cadeau unique',
    giftText: 'Saint-Valentin, anniversaire, fête des mères ou des pères, Noël : une coque avec une photo qui compte fait un cadeau personnel, utilisé tous les jours.',
    modelsTitle: 'Modèles disponibles',
    faqTitle: 'Questions fréquentes',
    faq: [
      ['Quelle qualité de photo faut-il ?', 'Une photo prise avec un smartphone récent suffit largement. Évitez simplement les captures d’écran très compressées ou les petites images trouvées sur internet : elles seraient floues une fois imprimées.'],
      ['Combien de temps pour la recevoir ?', 'La coque est imprimée à la commande puis expédiée sous 1 à 2 jours ouvrés. Comptez 4 à 7 jours en point relais en France.'],
      ['Puis-je retourner une coque personnalisée ?', 'Une création personnalisée est fabriquée pour vous seul : comme le prévoit la loi, elle ne bénéficie pas du droit de rétractation. En cas de défaut d’impression, nous la refaisons.'],
      ['Puis-je utiliser plusieurs photos ?', 'Oui : ajoutez autant de photos et de textes que vous voulez, déplacez-les, redimensionnez-les, ou utilisez un modèle avec plusieurs cadres.'],
    ],
    home: 'Accueil',
  },
  en: {
    title: 'Custom photo phone case for iPhone and Samsung',
    description: `Create your custom phone case with your own photos and text, for iPhone and Samsung Galaxy. Printed one at a time in France, from ${flat}.`,
    h1: 'Custom phone case with your photos',
    intro: 'A couple photo, your pet, a holiday memory or your name: create a phone case that exists only once. You design it online, we print it one at a time in our workshop in France.',
    cta: 'Create my case',
    price: `From ${flat}, ${relief} with raised printing`,
    stepsTitle: 'How does it work?',
    steps: [
      ['Pick your phone', 'iPhone 11 to 18 Pro Max or Samsung Galaxy: the case is moulded for your exact model.'],
      ['Design it', 'Add your photos and text, or start from a ready-made template: Polaroid frames, manga page, memories collage…'],
      ['Get your case', 'It is printed one at a time in our workshop in France, then shipped within 1 to 2 working days.'],
    ],
    tplTitle: 'Ready-to-fill templates',
    tplText: 'No layout idea? Pick a template in the studio, drop your photos in, done.',
    finishTitle: 'Flat or raised',
    finishText: `Flat (${flat}): the ink sits flush with the case, smooth surface and bold colours, ideal for photos. Raised (${relief}): the ink is built up in several layers, so you can feel your design.`,
    helpTitle: 'No inspiration? We design it for you',
    helpText: 'In the studio, the Help tab lets you describe your idea and send your photos: our workshop prepares your design and emails it to you within 48 to 72 hours, with 2 proposals included. The design service costs €6.90, added to the price of the case only if you order it.',
    giftTitle: 'A one-of-a-kind gift',
    giftText: 'Valentine’s Day, birthdays, Mother’s or Father’s Day, Christmas: a case with a photo that matters is a personal gift used every day.',
    modelsTitle: 'Available models',
    faqTitle: 'Frequently asked questions',
    faq: [
      ['What photo quality do I need?', 'A photo taken with a recent smartphone is more than enough. Just avoid heavily compressed screenshots or small images found online: they would look blurry once printed.'],
      ['How long does delivery take?', 'The case is printed to order and shipped within 1 to 2 working days. Delivery time depends on your country.'],
      ['Can I return a custom case?', 'A custom design is made just for you, so by law it is not covered by the right of withdrawal. If there is a printing defect, we reprint it.'],
      ['Can I use several photos?', 'Yes: add as many photos and text as you like, move and resize them, or use a template with several frames.'],
    ],
    home: 'Home',
  },
  de: {
    title: 'Handyhülle mit eigenem Foto für iPhone und Samsung',
    description: `Gestalte deine eigene Handyhülle mit deinen Fotos und Texten, für iPhone und Samsung Galaxy. Einzeln in Frankreich bedruckt, ab ${flat}.`,
    h1: 'Handyhülle mit deinen Fotos',
    intro: 'Ein Pärchenfoto, dein Haustier, eine Urlaubserinnerung oder dein Name: Gestalte eine Handyhülle, die es nur einmal gibt. Du gestaltest sie online, wir bedrucken sie einzeln in unserem Atelier in Frankreich.',
    cta: 'Meine Hülle gestalten',
    price: `Ab ${flat}, ${relief} mit Relief`,
    stepsTitle: 'Wie funktioniert es?',
    steps: [
      ['Wähle dein Handy', 'iPhone 11 bis 18 Pro Max oder Samsung Galaxy: Die Hülle ist für dein genaues Modell geformt.'],
      ['Gestalte dein Design', 'Füge deine Fotos und Texte hinzu oder starte mit einer fertigen Vorlage: Polaroid-Rahmen, Manga-Seite, Erinnerungs-Collage…'],
      ['Erhalte deine Hülle', 'Sie wird einzeln in unserem Atelier in Frankreich bedruckt und innerhalb von 1 bis 2 Werktagen verschickt.'],
    ],
    tplTitle: 'Fertige Vorlagen zum Ausfüllen',
    tplText: 'Keine Idee für das Layout? Wähle im Studio eine Vorlage, zieh deine Fotos hinein, fertig.',
    finishTitle: 'Flach oder mit Relief',
    finishText: `Flach (${flat}): Die Farbe liegt bündig auf der Hülle, glatte Oberfläche und kräftige Farben, ideal für Fotos. Relief (${relief}): Die Farbe wird in mehreren Schichten aufgetragen, dein Design ist fühlbar.`,
    helpTitle: 'Keine Idee? Wir gestalten es für dich',
    helpText: 'Im Studio kannst du im Hilfe-Tab deine Idee beschreiben und deine Fotos schicken: Unser Atelier bereitet dein Design vor und schickt es dir innerhalb von 48 bis 72 Stunden per E-Mail, mit 2 inklusiven Vorschlägen. Die Gestaltung kostet 6,90 €, die nur bei einer Bestellung zum Preis der Hülle hinzukommen.',
    giftTitle: 'Ein einzigartiges Geschenk',
    giftText: 'Valentinstag, Geburtstag, Mutter- oder Vatertag, Weihnachten: Eine Hülle mit einem Foto, das zählt, ist ein persönliches Geschenk für jeden Tag.',
    modelsTitle: 'Verfügbare Modelle',
    faqTitle: 'Häufige Fragen',
    faq: [
      ['Welche Fotoqualität brauche ich?', 'Ein Foto von einem aktuellen Smartphone reicht völlig aus. Vermeide nur stark komprimierte Screenshots oder kleine Bilder aus dem Internet: Sie wären gedruckt unscharf.'],
      ['Wie lange dauert die Lieferung?', 'Die Hülle wird auf Bestellung bedruckt und innerhalb von 1 bis 2 Werktagen verschickt. Die Lieferzeit hängt von deinem Land ab.'],
      ['Kann ich eine personalisierte Hülle zurückgeben?', 'Ein personalisiertes Design wird nur für dich hergestellt und ist daher gesetzlich vom Widerrufsrecht ausgenommen. Bei einem Druckfehler drucken wir sie neu.'],
      ['Kann ich mehrere Fotos verwenden?', 'Ja: Füge so viele Fotos und Texte hinzu, wie du willst, verschiebe und skaliere sie oder nutze eine Vorlage mit mehreren Rahmen.'],
    ],
    home: 'Startseite',
  },
}[lang] ?? null;
if (!T) throw new Error(`CustomLanding : langue non prise en charge (${lang})`);

const pageUrl = `${siteConfig.url}${url('/coque-personnalisee/')}`;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: T.home, item: `${siteConfig.url}${url('/')}` },
      { '@type': 'ListItem', position: 2, name: T.h1, item: pageUrl },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: T.stepsTitle,
    step: T.steps.map(([name, text], i) => ({ '@type': 'HowToStep', position: i + 1, name, text })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: T.faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
  },
];
---

<BaseLayout title={`${T.title} | ${siteConfig.name}`} description={T.description} jsonLd={jsonLd} image="/images/menu-studio-wide.webp">
  <div class="crumbs-shell max-w-7xl mx-auto px-6 pt-6 md:pt-8 pb-16 md:pb-24">
    <nav class="site-breadcrumb flex items-center gap-2 text-xs text-n-500 mb-6 font-light" aria-label="breadcrumb">
      <a href={url('/')} class="hover:text-cream transition-colors">{T.home}</a>
      <span>/</span>
      <span class="text-n-400">{T.h1}</span>
    </nav>

    <section class="grid md:grid-cols-2 gap-8 md:gap-12 items-center mb-20">
      <div class="order-2 md:order-1">
        <h1 class="text-4xl md:text-5xl font-medium tracking-tight text-cream leading-[1.1] mb-5">{T.h1}</h1>
        <p class="text-base md:text-lg text-n-400 font-light leading-relaxed mb-7">{T.intro}</p>
        <a href={url('/personnaliser')} class="btn-primary inline-flex items-center gap-2">{T.cta} →</a>
        <p class="text-sm text-n-500 font-light mt-4">{T.price}</p>
      </div>
      <img class="order-1 md:order-2 w-full rounded-3xl object-cover aspect-[5/2] md:aspect-[4/3]" src="/images/menu-studio-wide.webp"
        alt={T.h1} width="1400" height="560" fetchpriority="high" decoding="async" />
    </section>

    <section class="mb-20">
      <h2 class="text-2xl md:text-3xl font-medium tracking-tight text-cream mb-8">{T.stepsTitle}</h2>
      <ol class="grid md:grid-cols-3 gap-6">
        {T.steps.map(([name, text], i) => (
          <li class="rounded-2xl border border-white/[0.08] bg-panel p-6">
            <span class="text-xs font-medium text-n-500 tracking-widest">0{i + 1}</span>
            <h3 class="text-lg font-medium text-cream mt-2 mb-2">{name}</h3>
            <p class="text-sm text-n-400 font-light leading-relaxed">{text}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="mb-20">
      <h2 class="text-2xl md:text-3xl font-medium tracking-tight text-cream mb-3">{T.tplTitle}</h2>
      <p class="text-base text-n-400 font-light mb-8 max-w-2xl">{T.tplText}</p>
      <ul class="grid grid-cols-2 md:grid-cols-4 gap-4">
        {TPL.map((t) => (
          <li>
            <a href={url('/personnaliser')} class="group block">
              <img src={t.src} alt={`${T.h1} : ${t.name[lang]}`} width="400" height="840" loading="lazy" decoding="async"
                class="w-full aspect-[1/2] object-cover rounded-[1.4rem] border border-white/[0.08] group-hover:scale-[1.02] transition-transform duration-300" />
              <span class="block mt-3 text-sm font-medium text-cream">{t.name[lang]}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="grid md:grid-cols-3 gap-6 mb-20">
      {[[T.finishTitle, T.finishText], [T.helpTitle, T.helpText], [T.giftTitle, T.giftText]].map(([h, p]) => (
        <div class="rounded-2xl border border-white/[0.08] bg-panel p-6">
          <h2 class="text-lg font-medium text-cream mb-2">{h}</h2>
          <p class="text-sm text-n-400 font-light leading-relaxed">{p}</p>
        </div>
      ))}
    </section>

    <section class="mb-20">
      <h2 class="text-2xl md:text-3xl font-medium tracking-tight text-cream mb-5">{T.modelsTitle}</h2>
      <p class="text-sm text-n-400 font-light leading-relaxed"><strong class="text-cream font-medium">iPhone :</strong> {iphones.join(', ')}</p>
      <p class="text-sm text-n-400 font-light leading-relaxed mt-2"><strong class="text-cream font-medium">Samsung :</strong> {galaxies.join(', ')}</p>
    </section>

    <section class="max-w-3xl mb-16">
      <h2 class="text-2xl md:text-3xl font-medium tracking-tight text-cream mb-6">{T.faqTitle}</h2>
      <div class="space-y-3">
        {T.faq.map(([q, a]) => (
          <details class="rounded-2xl border border-white/[0.08] bg-panel px-6 py-4">
            <summary class="cursor-pointer font-medium text-cream">{q}</summary>
            <p class="mt-3 text-sm text-n-400 font-light leading-relaxed">{a}</p>
          </details>
        ))}
      </div>
    </section>

    <div class="text-center">
      <a href={url('/personnaliser')} class="btn-primary inline-flex items-center gap-2">{T.cta} →</a>
    </div>
  </div>
</BaseLayout>
