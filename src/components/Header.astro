---
import siteConfig from '../../site.config.mjs';
import { t, localeFromPath, localePrefix, localizeUrl, ACTIVE_LOCALES, localeMeta } from '../lib/i18n';

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const lang = localeFromPath(Astro.url.pathname);
const lp = localePrefix(lang); // '' pour fr, '/en' pour en, '/de' pour de

// Helpers internes : URLs préfixées par locale
const url = (path: string) => `${lp}${path}`;

// Pour la détection d'onglet actif, on travaille sur le pathname dépouillé du
// préfixe de locale (le matcher reste identique en fr/en/de).
const stripped = lp ? pathname.replace(new RegExp(`^${lp}`), '') || '/' : pathname;

// Switcher de langue : pour chaque locale active, on calcule l'URL équivalente
// dans cette locale. Affiché uniquement si > 1 locale active.
//
// `langSwitcherFallbackHome` : sur une page qui n'a pas d'équivalent traduit
// (typiquement la 404), on renvoie vers l'accueil de la locale.
interface Props {
  langSwitcherFallbackHome?: boolean;
}
const { langSwitcherFallbackHome = false } = Astro.props;

const showLangSwitcher = ACTIVE_LOCALES.length > 1;
const langSwitcherItems = ACTIVE_LOCALES.map(l => ({
  code: l,
  label: localeMeta(l).label,
  short: localeMeta(l).short,
  href: langSwitcherFallbackHome ? `${localePrefix(l)}/` : localizeUrl(Astro.url.pathname, l),
  active: l === lang,
}));

// Détermine quel onglet est actif selon l'URL courante.
const isHome    = stripped === '/';
const isShop    = stripped === '/boutique' || stripped.startsWith('/product/') || stripped.startsWith('/product-category/');
const isContact = stripped === '/contact';

// Ordre des catégories produit dans le menu
const cats = (siteConfig.productCategories || []) as {slug:string; label:string}[];

const THEMES = [
  { id: 'default',   name: 'Défaut',    desc: 'Épuré, clair' },
  { id: 'heritage',  name: 'Heritage',  desc: 'Galerie d’art' },
  { id: 'sunfreaks', name: 'Sunfreaks', desc: 'Rétro solaire' },
];
---

<header
  id="site-header"
  class="fixed top-0 left-0 right-0 backdrop-blur-xl bg-dark/80 border-b border-white/[0.08]"
  style="z-index: 10000;"
>
  {/* .header-shell = LA surface. En thème sunfreaks c'est l'îlot flottant ;
      il contient la barre ET le menu, donc il « grandit » quand le menu
      s'ouvre — le menu se lit comme une extension du header, pas un bloc à
      part. */}
  <div class="header-shell max-w-7xl mx-auto px-4 md:px-6">

    {/* ─── Barre principale : burger (g.) · logo (centre) · panier (dr.) ─── */}
    <div class="header-bar relative flex items-center justify-between">
      <button
        id="menu-btn"
        class="hdr-btn -ml-2 text-cream/90 hover:text-cream transition-colors"
        aria-label={t('nav.menu', lang)}
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <span class="hdr-burger" aria-hidden="true"><span></span><span></span><span></span></span>
      </button>

      <a
        href={url('/')}
        data-logo
        class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 font-medium text-[15px] md:text-base uppercase tracking-[0.22em] text-cream hover:text-n-400 transition-colors whitespace-nowrap"
        aria-label={`${siteConfig.name} - ${t('nav.home', lang)}`}
      >
        {siteConfig.logoPrefix}{siteConfig.logoSuffix && <span class="text-n-400">{siteConfig.logoSuffix}</span>}
      </a>

      <div class="-mr-2 min-w-[44px] flex items-center justify-end">
        {siteConfig.shop?.enabled && siteConfig.shop?.provider === 'atelier' && (
          <div data-atelier-cart-icon class="flex items-center"></div>
        )}
      </div>
    </div>

    {/* ─── Menu : extension animée (hauteur pilotée par .menu-open) ─── */}
    <div id="mobile-nav" class="header-menu" aria-label={t('nav.menu', lang)}>
      <div class="header-menu-inner">
        <div class="header-menu-content">

          <a href={url('/')} class={`hdr-link ${isHome ? 'is-active' : ''}`} aria-current={isHome ? 'page' : undefined}>{t('nav.home', lang)}</a>

          {siteConfig.shop?.enabled && (
            <a
              href={url('/boutique')}
              class={`my-1 flex items-center justify-between gap-2 px-4 py-2.5 rounded-xl border transition-colors ${isShop ? 'bg-cream text-dark border-cream font-medium' : 'border-white/[0.12] bg-white/[0.03] text-cream hover:border-white/25 hover:bg-white/[0.07]'}`}
              aria-current={isShop ? 'page' : undefined}
            >
              <span class="text-sm">{t('nav.shop', lang)}</span>
              <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/>
                <path d="M3 6h18"/>
                <path d="M16 10a4 4 0 0 1-8 0"/>
              </svg>
            </a>
          )}

          {siteConfig.shop?.enabled && cats.length > 0 && (
            <details class="mobile-cat-details my-1">
              <summary class="flex items-center justify-between gap-2 px-4 py-2.5 rounded-xl border border-white/[0.12] bg-white/[0.03] text-cream cursor-pointer list-none select-none hover:border-white/25 hover:bg-white/[0.07] transition-colors">
                <span class="text-sm">{t('nav.categories', lang)}</span>
                <svg class="w-4 h-4 mobile-cat-chevron text-n-400 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <polyline points="6 9 12 15 18 9"/>
                </svg>
              </summary>
              <div class="mt-1 pl-3 py-1 space-y-0.5 border-l border-white/[0.08] ml-2">
                {cats.map(c => {
                  const active = stripped === `/product-category/${c.slug}`;
                  return (
                    <a
                      href={url(`/product-category/${c.slug}`)}
                      class={`block py-2 px-2 text-xs rounded-md transition-colors ${active ? 'text-cream font-medium' : 'text-n-500 hover:text-cream hover:bg-white/[0.04]'}`}
                      aria-current={active ? 'page' : undefined}
                    >
                      {c.label}
                    </a>
                  );
                })}
              </div>
            </details>
          )}

          <a href={url('/contact')} class={`hdr-link ${isContact ? 'is-active' : ''}`} aria-current={isContact ? 'page' : undefined}>{t('nav.contact', lang)}</a>

          {/* Thème (le wrapper .theme-switcher est requis par le JS) */}
          <div class="theme-switcher hdr-section">
            <span class="hdr-section-label">Thème</span>
            {THEMES.map(th => (
              <button type="button" data-theme-choice={th.id} class="hdr-choice">
                <span class="text-left">
                  <span class="block font-medium">{th.name}</span>
                  <span class="block text-[10px] opacity-60">{th.desc}</span>
                </span>
                <svg class="w-4 h-4 shrink-0 theme-check opacity-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <polyline points="20 6 9 17 4 12"/>
                </svg>
              </button>
            ))}
          </div>

          {showLangSwitcher && (
            <div class="hdr-section">
              <span class="hdr-section-label">Langue</span>
              {langSwitcherItems.map(item => (
                <a
                  href={item.href}
                  hreflang={item.code}
                  data-lang-link={item.code}
                  aria-current={item.active ? 'true' : undefined}
                  class={`hdr-choice ${item.active ? 'is-active' : ''}`}
                >
                  <span>{item.label}</span>
                  <span class="text-[10px] tracking-widest opacity-60">{item.short}</span>
                </a>
              ))}
            </div>
          )}

        </div>
      </div>
    </div>
  </div>
</header>

<style>
  /* ─── Barre ─────────────────────────────────────────────────────── */
  .header-bar { height: var(--header-h); }

  /* Boutons d'icône : cible tactile confortable et régulière (44px). */
  .hdr-btn {
    width: 44px; height: 44px; flex: none;
    display: flex; align-items: center; justify-content: center;
  }

  /* Burger animé : trois traits qui se transforment en croix. */
  .hdr-burger { position: relative; width: 22px; height: 16px; }
  .hdr-burger span {
    position: absolute; left: 0; width: 22px; height: 2px; border-radius: 2px;
    background: currentColor;
    transition: transform .32s cubic-bezier(.4,0,.2,1), opacity .2s ease;
  }
  .hdr-burger span:nth-child(1) { top: 0; }
  .hdr-burger span:nth-child(2) { top: 7px; }
  .hdr-burger span:nth-child(3) { top: 14px; }
  #site-header.menu-open .hdr-burger span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  #site-header.menu-open .hdr-burger span:nth-child(2) { opacity: 0; }
  #site-header.menu-open .hdr-burger span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  /* ─── Menu : hauteur animée (astuce grid 0fr → 1fr = auto animable) ─ */
  .header-menu {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows .36s cubic-bezier(.4,0,.2,1);
  }
  #site-header.menu-open .header-menu { grid-template-rows: 1fr; }
  .header-menu-inner { overflow: hidden; min-height: 0; }

  .header-menu-content {
    max-width: 26rem; margin: 0 auto;
    padding: .5rem 0 1.25rem;
    border-top: 1px solid rgb(var(--c-cream) / .08);
    /* léger fondu + glissé du contenu, en plus de l'ouverture en hauteur */
    opacity: 0; transform: translateY(-6px);
    transition: opacity .25s ease .04s, transform .34s cubic-bezier(.4,0,.2,1) .02s;
    pointer-events: none;
  }
  #site-header.menu-open .header-menu-content { opacity: 1; transform: none; pointer-events: auto; }

  /* Liens simples du menu */
  .hdr-link {
    display: block; padding: .6rem .25rem;
    color: rgb(var(--c-n400)); transition: color .15s;
  }
  .hdr-link:hover { color: rgb(var(--c-cream)); }
  .hdr-link.is-active { color: rgb(var(--c-cream)); font-weight: 500; }

  /* Sections thème / langue */
  .hdr-section { margin-top: 1rem; padding-top: 1rem; border-top: 1px solid rgb(var(--c-cream) / .08); }
  .hdr-section-label {
    display: block; font-size: 11px; font-weight: 500;
    text-transform: uppercase; letter-spacing: .11em;
    color: rgb(var(--c-n500)); margin-bottom: .5rem;
  }
  .hdr-choice {
    width: 100%; display: flex; align-items: center; justify-content: space-between;
    gap: .75rem; padding: .5rem .75rem; border-radius: .6rem;
    font-size: 12px; color: rgb(var(--c-n400));
    transition: background .15s, color .15s;
  }
  .hdr-choice:hover { background: rgb(var(--c-cream) / .05); color: rgb(var(--c-cream)); }
  .hdr-choice.is-active { background: rgb(var(--c-cream)); color: rgb(var(--c-dark)); font-weight: 500; }
  .theme-check { transition: opacity .15s ease; }

  /* Accordéon catégories */
  .mobile-cat-details summary { list-style: none; }
  .mobile-cat-details summary::-webkit-details-marker { display: none; }
  .mobile-cat-details[open] .mobile-cat-chevron { transform: rotate(180deg); }
  .mobile-cat-chevron { transition: transform .2s ease; }

  @media (prefers-reduced-motion: reduce) {
    .header-menu, .header-menu-content, .hdr-burger span { transition: none; }
  }
</style>

<script>
  const header = document.getElementById('site-header');
  const btn = document.getElementById('menu-btn');
  const nav = document.getElementById('mobile-nav');

  const isMenuOpen = () => !!header?.classList.contains('menu-open');
  const setMenu = (open: boolean) => {
    header?.classList.toggle('menu-open', open);
    btn?.setAttribute('aria-expanded', String(open));
  };

  btn?.addEventListener('click', (e) => {
    e.stopPropagation();
    setMenu(!isMenuOpen());
  });

  // Fermeture : Échap, clic hors du header, clic sur un lien du menu.
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setMenu(false); });
  document.addEventListener('click', (e) => {
    if (isMenuOpen() && header && !header.contains(e.target as Node)) setMenu(false);
  });
  nav?.querySelectorAll('a[href]').forEach((a) => a.addEventListener('click', () => setMenu(false)));

  // ─── Mémorisation du choix de langue (cookie 1 an) ──────────────────
  document.querySelectorAll('[data-lang-link]').forEach((el) => {
    el.addEventListener('click', () => {
      const code = (el as HTMLElement).dataset.langLink;
      if (code) document.cookie = `bp_lang=${code}; path=/; max-age=${60 * 60 * 24 * 365}; SameSite=Lax`;
    });
  });

  // ─── Sélecteur de thème ─────────────────────────────────────────────
  // L'état initial est posé sur <html> par le script inline du <head>
  // (anti-flash). Ici : choix + synchro des coches.
  const themeSwitcher = document.querySelector('.theme-switcher');
  const currentTheme = () => document.documentElement.getAttribute('data-theme') || 'default';
  const syncTheme = () => {
    const cur = currentTheme();
    themeSwitcher?.querySelectorAll('[data-theme-choice]').forEach((b) => {
      const on = b.getAttribute('data-theme-choice') === cur;
      b.setAttribute('aria-current', on ? 'true' : 'false');
      b.querySelector('.theme-check')?.classList.toggle('opacity-0', !on);
    });
  };
  syncTheme();
  themeSwitcher?.querySelectorAll('[data-theme-choice]').forEach((b) => {
    b.addEventListener('click', () => {
      const choice = b.getAttribute('data-theme-choice');
      if (choice === 'default') document.documentElement.removeAttribute('data-theme');
      else if (choice) document.documentElement.setAttribute('data-theme', choice);
      try { if (choice) localStorage.setItem('site-theme', choice); } catch (e) {}
      syncTheme();
    });
  });

  // ─── Comportements du header au scroll ──────────────────────────────
  //   .header-over-hero : sur le hero (accueil), le header se fond dans la bannière.
  //   .header-hidden    : au-delà du hero, il s'efface en descendant, revient en remontant.
  // Effets figés tant que le menu est ouvert.
  const hero = document.querySelector('.hero-section');
  if (header) {
    let lastY = window.scrollY;
    let ticking = false;
    const heroThreshold = () => hero ? Math.max(0, (hero as HTMLElement).offsetHeight - header.offsetHeight) : 0;
    const update = () => {
      const y = window.scrollY;
      const overHero = hero ? y < heroThreshold() : false;
      // Menu ouvert → header plein (surface lisible), jamais transparent.
      if (hero) header.classList.toggle('header-over-hero', overHero && !isMenuOpen());
      if (!isMenuOpen() && !overHero && y > lastY && y > 100) {
        document.documentElement.classList.add('header-hidden');
      } else {
        document.documentElement.classList.remove('header-hidden');
      }
      lastY = y;
      ticking = false;
    };
    update();
    window.addEventListener('scroll', () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    }, { passive: true });
  }
</script>
