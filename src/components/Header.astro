---
import siteConfig from '../../site.config.mjs';
import { t, localeFromPath, localePrefix, localizeUrl, ACTIVE_LOCALES, localeMeta } from '../lib/i18n';

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const lang = localeFromPath(Astro.url.pathname);
const lp = localePrefix(lang); // '' pour fr, '/en' pour en, '/de' pour de

// Helpers internes : URLs préfixées par locale
const url = (path: string) => `${lp}${path}`;

// Pour la détection d'onglet actif, on travaille sur le pathname dépouillé du
// préfixe de locale (le matcher reste identique en fr/en/de).
const stripped = lp ? pathname.replace(new RegExp(`^${lp}`), '') || '/' : pathname;

// Switcher de langue : pour chaque locale active, on calcule l'URL équivalente
// dans cette locale. Affiché uniquement si > 1 locale active.
//
// `langSwitcherFallbackHome` : sur une page qui n'a pas d'équivalent traduit
// (typiquement la 404), on renvoie vers l'accueil de la locale.
interface Props {
  langSwitcherFallbackHome?: boolean;
}
const { langSwitcherFallbackHome = false } = Astro.props;

const showLangSwitcher = ACTIVE_LOCALES.length > 1;
const langSwitcherItems = ACTIVE_LOCALES.map(l => ({
  code: l,
  label: localeMeta(l).label,
  short: localeMeta(l).short,
  href: langSwitcherFallbackHome ? `${localePrefix(l)}/` : localizeUrl(Astro.url.pathname, l),
  active: l === lang,
}));

// Détermine quel onglet est actif selon l'URL courante.
const isHome    = stripped === '/';
const isShop    = stripped === '/boutique' || stripped.startsWith('/product/') || stripped.startsWith('/product-category/');
const isContact = stripped === '/contact';
const isStudio  = stripped === '/personnaliser';

// Ordre des catégories produit dans le menu
const cats = (siteConfig.productCategories || []) as {slug:string; label:string}[];

---

<header
  id="site-header"
  class="fixed top-0 left-0 right-0 backdrop-blur-xl bg-dark/80 border-b border-white/[0.08]"
  style="z-index: 10000;"
>
  {/* .header-shell = LA surface. En thème sunfreaks c'est l'îlot flottant ;
      il contient la barre ET le menu, donc il « grandit » quand le menu
      s'ouvre — le menu se lit comme une extension du header, pas un bloc à
      part. */}
  <div class="header-shell max-w-7xl mx-auto px-4 md:px-6">

    {/* ─── Barre principale : burger (g.) · logo (centre) · panier (dr.) ─── */}
    <div class="header-bar relative flex items-center justify-between">
      <button
        id="menu-btn"
        class="hdr-btn -ml-2 text-cream/90 hover:text-cream transition-colors"
        aria-label={t('nav.menu', lang)}
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <span class="hdr-burger" aria-hidden="true"><span></span><span></span><span></span></span>
      </button>

      <a
        href={url('/')}
        data-logo
        class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 font-medium text-[15px] md:text-base uppercase tracking-[0.22em] text-cream hover:text-n-400 transition-colors whitespace-nowrap"
        aria-label={`${siteConfig.name} - ${t('nav.home', lang)}`}
      >
        {siteConfig.logoPrefix}{siteConfig.logoSuffix && <span class="text-n-400">{siteConfig.logoSuffix}</span>}
      </a>

      <div class="-mr-2 min-w-[44px] flex items-center justify-end">
        {siteConfig.shop?.enabled && siteConfig.shop?.provider === 'atelier' && (
          <div data-atelier-cart-icon class="flex items-center"></div>
        )}
      </div>
    </div>

    {/* ─── Menu : extension animée (hauteur pilotée par .menu-open) ─── */}
    <div id="mobile-nav" class="header-menu" aria-label={t('nav.menu', lang)}>
      <div class="header-menu-inner">
        <div class="header-menu-content">

          {/* Les deux entrées qui comptent, en cartes sur toute la largeur :
              la boutique, et le studio (mis en avant, jaune des boutons). */}
          {siteConfig.shop?.enabled && (
            <div class="hdr-feature">
              {/* Images posées en data-src : elles ne se chargent qu'à la
                  première ouverture du menu, pas sur chaque page. */}
              <a href={url('/boutique')} class={`hdr-tile ${isShop ? 'is-active' : ''}`} aria-current={isShop ? 'page' : undefined}>
                <picture>
                  <source media="(min-width: 640px)" data-srcset="/images/menu-boutique-wide.webp" width="1400" height="539" />
                  <img class="hdr-tile-img" data-src="/images/menu-boutique.webp" alt="" width="520" height="650" decoding="async" style="--pos-wide: 50% 42%" />
                </picture>
                <span class="hdr-tile-txt">
                  <strong>{t('nav.shop', lang)}</strong>
                  <small>{t('nav.shopSub', lang)}</small>
                </span>
                <span class="hdr-tile-go" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M9 7h8v8"/></svg>
                </span>
              </a>
              <a href={url('/personnaliser')} class={`hdr-tile ${isStudio ? 'is-active' : ''}`} aria-current={isStudio ? 'page' : undefined}>
                <picture>
                  <source media="(min-width: 640px)" data-srcset="/images/menu-studio-wide.webp" width="1400" height="560" />
                  <img class="hdr-tile-img" data-src="/images/menu-studio.webp" alt="" width="520" height="650" decoding="async" style="--pos-wide: 50% 40%" />
                </picture>
                <span class="hdr-tile-txt">
                  <strong>{t('nav.create', lang)}</strong>
                  <small>{t('nav.createSub', lang)}</small>
                </span>
                <span class="hdr-tile-go" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M9 7h8v8"/></svg>
                </span>
              </a>
            </div>
          )}

          {/* Colonne 1 : navigation */}
          <div class="hdr-col">
            <span class="hdr-section-label">Navigation</span>
            <a href={url('/')} class={`hdr-link ${isHome ? 'is-active' : ''}`} aria-current={isHome ? 'page' : undefined}>{t('nav.home', lang)}</a>
            <a href={url('/contact')} class={`hdr-link ${isContact ? 'is-active' : ''}`} aria-current={isContact ? 'page' : undefined}>{t('nav.contact', lang)}</a>
          </div>

          {/* Colonne 2 : catégories (listées directement, pas d'accordéon) */}
          {siteConfig.shop?.enabled && cats.length > 0 && (
            <div class="hdr-col">
              <span class="hdr-section-label">{t('nav.categories', lang)}</span>
              {cats.map(c => {
                const active = stripped === `/product-category/${c.slug}`;
                return (
                  <a href={url(`/product-category/${c.slug}`)} class={`hdr-link ${active ? 'is-active' : ''}`} aria-current={active ? 'page' : undefined}>{c.label}</a>
                );
              })}
            </div>
          )}

          {/* Colonne 3 : langue */}
          {showLangSwitcher && (
            <div class="hdr-col">
              <span class="hdr-section-label">Langue</span>
              {/* Les langues sur une seule ligne, en sélecteur segmenté. */}
              <div class="hdr-langs">
                {langSwitcherItems.map(item => (
                  <a
                    href={item.href}
                    hreflang={item.code}
                    data-lang-link={item.code}
                    aria-current={item.active ? 'true' : undefined}
                    aria-label={item.label}
                    class={`hdr-lang ${item.active ? 'is-active' : ''}`}
                  >{item.label}</a>
                ))}
              </div>
            </div>
          )}

        </div>
      </div>
    </div>
  </div>
</header>

<style>
  /* ─── Barre ─────────────────────────────────────────────────────── */
  .header-bar { height: var(--header-h); }

  /* Boutons d'icône : cible tactile confortable et régulière (44px). */
  .hdr-btn {
    width: 44px; height: 44px; flex: none;
    display: flex; align-items: center; justify-content: center;
  }

  /* Burger animé : trois traits qui se transforment en croix. */
  .hdr-burger { position: relative; width: 22px; height: 16px; }
  .hdr-burger span {
    position: absolute; left: 0; width: 22px; height: 2px; border-radius: 2px;
    background: currentColor;
    transition: transform .32s cubic-bezier(.4,0,.2,1), opacity .2s ease;
  }
  .hdr-burger span:nth-child(1) { top: 0; }
  .hdr-burger span:nth-child(2) { top: 7px; }
  .hdr-burger span:nth-child(3) { top: 14px; }
  #site-header.menu-open .hdr-burger span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  #site-header.menu-open .hdr-burger span:nth-child(2) { opacity: 0; }
  #site-header.menu-open .hdr-burger span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  /* ─── Menu : hauteur animée (astuce grid 0fr → 1fr = auto animable) ─ */
  .header-menu {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows .36s cubic-bezier(.4,0,.2,1);
  }
  #site-header.menu-open .header-menu { grid-template-rows: 1fr; }
  .header-menu-inner { overflow: hidden; min-height: 0; }

  /* Contenu du menu : grille pleine largeur (méga-menu). Chaque section
     (Navigation, Catégories, Thème, Langue) est une colonne. */
  .header-menu-content {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem 2.5rem;
    padding: 1.1rem 0 1.4rem;
    border-top: 1px solid rgb(var(--c-cream) / .08);
    /* léger fondu + glissé du contenu, en plus de l'ouverture en hauteur */
    opacity: 0; transform: translateY(-6px);
    transition: opacity .25s ease .04s, transform .34s cubic-bezier(.4,0,.2,1) .02s;
    pointer-events: none;
  }
  @media (min-width: 640px)  { .header-menu-content { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .header-menu-content { grid-template-columns: repeat(4, 1fr); } }
  #site-header.menu-open .header-menu-content { opacity: 1; transform: none; pointer-events: auto; }

  .hdr-col { display: flex; flex-direction: column; gap: .1rem; min-width: 0; }
  .hdr-section-label {
    display: block; font-size: 10.5px; font-weight: 600;
    text-transform: uppercase; letter-spacing: .12em;
    color: rgb(var(--c-n500)); margin-bottom: .55rem;
  }

  /* Liens de section */
  .hdr-link {
    display: block; padding: .4rem .25rem; font-size: .9rem;
    color: rgb(var(--c-n400)); transition: color .15s;
  }
  .hdr-link:hover { color: rgb(var(--c-cream)); }
  .hdr-link.is-active { color: rgb(var(--c-cream)); font-weight: 600; }

  /* Tuiles photo Boutique / Créer ma coque : pleine largeur, côte à côte,
     titre blanc posé sur un dégradé sombre en bas de l'image. */
  .hdr-feature {
    grid-column: 1 / -1;
    display: grid; grid-template-columns: 1fr 1fr; gap: .6rem;
  }
  .hdr-tile {
    position: relative; isolation: isolate; overflow: hidden;
    display: flex; align-items: flex-end;
    aspect-ratio: 4 / 5;
    border-radius: 18px;
    background: rgb(var(--c-cream) / .08);
    color: #fff;
  }
  .hdr-tile-img {
    position: absolute; inset: 0; z-index: -2;
    width: 100%; height: 100%; object-fit: cover;
    transform: scale(1.01);
    transition: transform .6s cubic-bezier(.2, .7, .2, 1);
  }
  .hdr-tile::after {
    content: ""; position: absolute; inset: 0; z-index: -1;
    background: linear-gradient(to top, rgb(20 10 12 / .8) 0%, rgb(20 10 12 / .38) 45%, transparent 72%);
  }
  .hdr-tile:hover .hdr-tile-img { transform: scale(1.06); }
  .hdr-tile.is-active { box-shadow: inset 0 0 0 2px #fff, 0 0 0 2px rgb(var(--accent-rgb)); }
  .hdr-tile-txt { display: flex; flex-direction: column; gap: .2rem; padding: .9rem .9rem 1rem; min-width: 0; }
  .hdr-tile-txt strong {
    font-family: var(--font-display); font-weight: 700;
    font-size: 1.12rem; line-height: 1.08; letter-spacing: -.01em;
  }
  .hdr-tile-txt small { font-size: .72rem; line-height: 1.3; opacity: .85; }
  .hdr-tile-go {
    position: absolute; top: .65rem; right: .65rem;
    display: grid; place-items: center;
    width: 30px; height: 30px; border-radius: 999px;
    background: rgb(255 255 255 / .92); color: #1c1012;
    transition: transform .25s ease;
  }
  .hdr-tile-go svg { width: 15px; height: 15px; }
  .hdr-tile:hover .hdr-tile-go { transform: rotate(45deg); }

  /* Plus large : tuiles en bandeau, moins hautes. */
  @media (min-width: 640px) {
    .hdr-tile { aspect-ratio: auto; height: 190px; }
    /* Cadrage propre au bandeau (image large), réglé par tuile. */
    .hdr-tile-img[style*="--pos-wide"] { object-position: var(--pos-wide); }
    .hdr-tile-txt strong { font-size: 1.3rem; }
    .hdr-tile-txt small { font-size: .8rem; }
  }

  /* Langues : une ligne, trois segments égaux. */
  .hdr-langs {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 3px;
    padding: 3px; border-radius: .75rem;
    background: rgb(var(--c-cream) / .06);
  }
  .hdr-lang {
    display: flex; align-items: center; justify-content: center;
    padding: .5rem .4rem; border-radius: .6rem;
    font-size: 12.5px; color: rgb(var(--c-n400)); white-space: nowrap;
    transition: background .15s, color .15s;
  }
  .hdr-lang:hover { color: rgb(var(--c-cream)); background: rgb(var(--c-cream) / .05); }
  .hdr-lang.is-active { background: rgb(var(--c-cream)); color: rgb(var(--c-dark)); font-weight: 600; }

  .theme-check { transition: opacity .15s ease; }

  @media (prefers-reduced-motion: reduce) {
    .header-menu, .header-menu-content, .hdr-burger span { transition: none; }
  }
</style>

<script>
  const header = document.getElementById('site-header');
  const btn = document.getElementById('menu-btn');
  const nav = document.getElementById('mobile-nav');

  const isMenuOpen = () => !!header?.classList.contains('menu-open');
  const setMenu = (open: boolean) => {
    header?.classList.toggle('menu-open', open);
    btn?.setAttribute('aria-expanded', String(open));
  };

  // Images des tuiles : chargées à la première ouverture seulement.
  const loadTiles = () => {
    nav?.querySelectorAll<HTMLSourceElement>('source[data-srcset]').forEach((src) => {
      src.srcset = src.dataset.srcset || ''; src.removeAttribute('data-srcset');
    });
    nav?.querySelectorAll<HTMLImageElement>('img[data-src]').forEach((img) => {
      img.src = img.dataset.src || ''; img.removeAttribute('data-src');
    });
  };
  btn?.addEventListener('pointerenter', loadTiles, { once: true });
  btn?.addEventListener('touchstart', loadTiles, { once: true, passive: true });

  btn?.addEventListener('click', (e) => {
    e.stopPropagation();
    loadTiles();
    setMenu(!isMenuOpen());
  });

  // Fermeture : Échap, clic hors du header, clic sur un lien du menu.
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setMenu(false); });
  document.addEventListener('click', (e) => {
    if (isMenuOpen() && header && !header.contains(e.target as Node)) setMenu(false);
  });
  nav?.querySelectorAll('a[href]').forEach((a) => a.addEventListener('click', () => setMenu(false)));

  // ─── Mémorisation du choix de langue (cookie 1 an) ──────────────────
  document.querySelectorAll('[data-lang-link]').forEach((el) => {
    el.addEventListener('click', () => {
      const code = (el as HTMLElement).dataset.langLink;
      if (code) document.cookie = `bp_lang=${code}; path=/; max-age=${60 * 60 * 24 * 365}; SameSite=Lax`;
    });
  });

  // ─── Comportements du header au scroll ──────────────────────────────
  //   .header-over-hero : sur le hero (accueil), le header se fond dans la bannière.
  //   .header-hidden    : au-delà du hero, il s'efface en descendant, revient en remontant.
  // Effets figés tant que le menu est ouvert.
  const hero = document.querySelector('.hero-section');
  if (header) {
    let lastY = window.scrollY;
    let ticking = false;
    // Le seuil du hero se MESURE, et lire une hauteur oblige le navigateur à
    // recalculer la mise en page sur-le-champ. Mesuré à chaque frame de
    // défilement, ce seul calcul prenait une part du budget de 16 ms, sur le
    // fil même qui doit faire glisser la page. Il est donc mis en cache : il
    // ne bouge qu'au redimensionnement ou quand le hero change de taille.
    let seuilHero = 0;
    const mesurerSeuil = () => {
      seuilHero = hero ? Math.max(0, (hero as HTMLElement).offsetHeight - header.offsetHeight) : 0;
    };
    mesurerSeuil();
    window.addEventListener('resize', mesurerSeuil, { passive: true });
    // La hauteur du hero change aussi sans redimensionnement : arrivée de la
    // police de titres, chargement de la photo. Un observateur suffit, il ne
    // se déclenche qu'à ces moments-là.
    if (hero && 'ResizeObserver' in window) new ResizeObserver(mesurerSeuil).observe(hero);

    // État courant des deux classes : on n'écrit dans le DOM que s'il CHANGE.
    // Réécrire la même classe à chaque frame salit le style pour rien et
    // relance un recalcul à la frame suivante.
    let surHero: boolean | null = null;
    let masque: boolean | null = null;
    // Marge morte avant de considérer qu'on a changé de sens. Un doigt ne
    // défile jamais parfaitement droit : sans cette marge, le moindre
    // tremblement inversait le sens, ce qui relançait la transition de 0,35 s
    // du header. C'est ce va-et-vient qui se ressentait comme des coupures.
    const MARGE = 12;
    const update = () => {
      const y = window.scrollY;
      const menuOuvert = isMenuOpen();
      const overHero = hero ? y < seuilHero : false;
      // Menu ouvert → header plein (surface lisible), jamais transparent.
      const fondu = overHero && !menuOuvert;
      if (hero && fondu !== surHero) {
        header.classList.toggle('header-over-hero', fondu);
        surHero = fondu;
      }
      let cacher = masque === true;
      if (y - lastY > MARGE) cacher = true;
      else if (lastY - y > MARGE) cacher = false;
      if (menuOuvert || overHero || y <= 100) cacher = false;
      if (cacher !== masque) {
        document.documentElement.classList.toggle('header-hidden', cacher);
        masque = cacher;
      }
      if (Math.abs(y - lastY) > MARGE) lastY = y;
      ticking = false;
    };
    update();
    window.addEventListener('scroll', () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    }, { passive: true });
  }
</script>
