---
// Filtres de la boutique : une rangée de vignettes (une par catégorie de
// style), sur le modèle des catégories du menu : petite image carrée + nom.
// Défilable au doigt sur mobile, sur une ligne à partir de la tablette.
// Ce sont de vrais liens vers les pages de catégorie : utiles au
// référencement et sans JavaScript.
import { existsSync } from 'node:fs';
import { getCollection } from 'astro:content';
import siteConfig from '../../site.config.mjs';
import { t, localePrefix, type Locale } from '../lib/i18n';

interface Props { lang?: Locale; active?: string }
const { lang = 'fr', active = '' } = Astro.props;
const lp = localePrefix(lang);
type Cat = { slug: string; label: string; labels?: Record<string, string>; theme?: boolean };
const cats = ((siteConfig.productCategories ?? []) as Cat[]).filter((c) => c.theme);
const name = (c: Cat) => (lang !== 'fr' && c.labels?.[lang]) || c.label;
const all = { fr: 'Toutes', en: 'All', de: 'Alle' }[lang] ?? 'Toutes';

// Même vignette que le menu : gros plan dédié, sinon la 1re coque de la catégorie.
const products = (await getCollection('products'))
  .filter((p) => !p.slug.includes('/'))
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0) || b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const thumb = (slug: string) => {
  if (existsSync(`public/images/menu-cats/${slug}.webp`)) return `/images/menu-cats/${slug}.webp`;
  const p = products.find((x) => (x.data.categories ?? []).includes(slug));
  return p ? p.data.image.replace(/\.webp$/, '-400w.webp') : null;
};
// « Toutes » : mosaïque des quatre premières vignettes.
const mosaic = cats.map((c) => thumb(c.slug)).filter(Boolean).slice(0, 4) as string[];
---
{cats.length > 0 && (
  <nav class="cat-tiles" aria-label={t('shop.chooseCategory', lang)}>
    <a href={`${lp}/boutique`} class:list={['cat-tile', !active && 'is-active']} aria-current={!active ? 'page' : undefined}>
      <span class="cat-img is-mosaic">
        {mosaic.map((src) => <img src={src} alt="" width="200" height="200" loading="lazy" decoding="async" />)}
      </span>
      <span class="cat-name">{all}</span>
    </a>
    {cats.map((c) => {
      const src = thumb(c.slug);
      return (
        <a href={`${lp}/product-category/${c.slug}`} class:list={['cat-tile', active === c.slug && 'is-active']} aria-current={active === c.slug ? 'page' : undefined}>
          <span class="cat-img">{src && <img src={src} alt="" width="200" height="200" loading="lazy" decoding="async" />}</span>
          <span class="cat-name">{name(c)}</span>
        </a>
      );
    })}
  </nav>
)}

<style>
  .cat-tiles {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 68px;
    gap: .75rem;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
    margin: 0 -1.5rem 2.25rem;
    padding: .25rem 1.5rem;
    -webkit-mask: linear-gradient(90deg, transparent 0, #000 1.5rem, #000 calc(100% - 2rem), transparent 100%);
            mask: linear-gradient(90deg, transparent 0, #000 1.5rem, #000 calc(100% - 2rem), transparent 100%);
  }
  .cat-tiles::-webkit-scrollbar { display: none; }
  @media (min-width: 768px) {
    .cat-tiles {
      grid-auto-columns: 76px;
      margin: 0 0 2.5rem;
      padding: .25rem 0;
      -webkit-mask: none;
              mask: none;
    }
  }
  .cat-tile {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: .4rem;
    min-width: 0;
    scroll-snap-align: start;
    color: rgb(var(--c-n400));
    text-decoration: none;
  }
  .cat-img {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 16px;
    background: rgb(var(--c-cream) / .06);
    box-shadow: inset 0 0 0 1px rgb(var(--c-cream) / .08);
  }
  .cat-img img { width: 100%; height: 100%; object-fit: cover; transition: transform .45s cubic-bezier(.2, .7, .2, 1); }
  .cat-img.is-mosaic { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; background: #fff; }
  .cat-tile:hover .cat-img img { transform: scale(1.07); }
  .cat-name { font-size: .72rem; line-height: 1.2; text-align: center; transition: color .15s; }
  .cat-tile:hover .cat-name, .cat-tile.is-active .cat-name { color: rgb(var(--c-cream)); }
  .cat-tile.is-active .cat-name { font-weight: 600; }
  .cat-tile.is-active .cat-img { box-shadow: 0 0 0 2px rgb(var(--accent-rgb)); }
</style>
