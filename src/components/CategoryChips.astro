---
// Filtres de la boutique : une rangée de pastilles (une par catégorie de
// style), défilable au doigt sur mobile. Ce sont de vrais liens vers les pages
// de catégorie : utiles au référencement et sans JavaScript.
import siteConfig from '../../site.config.mjs';
import { t, localePrefix, type Locale } from '../lib/i18n';

interface Props { lang?: Locale; active?: string }
const { lang = 'fr', active = '' } = Astro.props;
const lp = localePrefix(lang);
type Cat = { slug: string; label: string; labels?: Record<string, string>; theme?: boolean };
const cats = ((siteConfig.productCategories ?? []) as Cat[]).filter((c) => c.theme);
const name = (c: Cat) => (lang !== 'fr' && c.labels?.[lang]) || c.label;
const all = { fr: 'Toutes', en: 'All', de: 'Alle' }[lang] ?? 'Toutes';
---
{cats.length > 0 && (
  <nav class="cat-chips" aria-label={t('shop.chooseCategory', lang)}>
    <a href={`${lp}/boutique`} class:list={['cat-chip', !active && 'is-active']} aria-current={!active ? 'page' : undefined}>{all}</a>
    {cats.map((c) => (
      <a href={`${lp}/product-category/${c.slug}`} class:list={['cat-chip', active === c.slug && 'is-active']} aria-current={active === c.slug ? 'page' : undefined}>{name(c)}</a>
    ))}
  </nav>
)}

<style>
  .cat-chips {
    display: flex; gap: .5rem; overflow-x: auto; scrollbar-width: none;
    margin: 0 -1.5rem 2.25rem; padding: .25rem 1.5rem;
    -webkit-mask: linear-gradient(90deg, transparent 0, #000 1.5rem, #000 calc(100% - 1.5rem), transparent 100%);
            mask: linear-gradient(90deg, transparent 0, #000 1.5rem, #000 calc(100% - 1.5rem), transparent 100%);
  }
  .cat-chips::-webkit-scrollbar { display: none; }
  @media (min-width: 1024px) { .cat-chips { flex-wrap: wrap; overflow: visible; margin: 0 0 2.5rem; padding: 0; -webkit-mask: none; mask: none; } }
  .cat-chip {
    flex: none; padding: .55rem 1rem; border-radius: 999px; font-size: .85rem; font-weight: 500; white-space: nowrap;
    border: 1px solid rgb(var(--c-cream) / .14); color: rgb(var(--c-cream) / .8); background: rgb(var(--c-cream) / .03);
    transition: border-color .2s, background .2s, color .2s;
  }
  .cat-chip:hover { border-color: rgb(var(--c-cream) / .35); color: rgb(var(--c-cream)); }
  .cat-chip.is-active { background: rgb(var(--c-cream)); color: rgb(var(--c-dark)); border-color: rgb(var(--c-cream)); }
</style>
