---
/**
 * Sélecteur de police de titres, TEMPORAIRE.
 *
 * Un menu déroulant posé en bas de l'écran : on choisit, le site change
 * aussitôt, sans rechargement, et le choix suit la navigation jusqu'à la
 * fermeture de l'onglet. Il sert à trancher entre les candidates de
 * src/lib/typo-titres.ts en les voyant sur les vraies pages.
 *
 * ⚠️ Il est visible par TOUT LE MONDE, visiteurs compris. C'est le prix de
 * l'essai sur le site en ligne. Pour le retirer : `typoSelecteur: false` dans
 * site.config.mjs, et le site n'en porte plus une ligne.
 *
 * Il ne fait qu'appeler window.__typoAppliquer, défini dans BaseLayout : la
 * logique d'application vit à un seul endroit.
 */
import { CANDIDATES, STYLES, type Style } from '../lib/typo-titres';

const groupes = (Object.keys(STYLES) as Style[]).map((s) => ({
  titre: STYLES[s],
  items: CANDIDATES.filter((c) => c.style === s),
}));
---

{/* Replié en pastille par défaut : une barre posée en permanence recouvrait
    le titre des pages, c'est-à-dire justement ce qu'on vient regarder.
    <details> fait l'ouverture et la fermeture sans une ligne de script. */}
<details class="typo-sel" data-typo-selecteur>
  <summary class="typo-sel-pastille" title="Essayer une police de titres" aria-label="Essayer une police de titres">Aa</summary>
  <div class="typo-sel-corps">
    <label class="typo-sel-label" for="typo-sel-champ">Typo d’essai</label>
    <select id="typo-sel-champ" class="typo-sel-champ">
      <option value="">Actuelle (Georgia)</option>
      {groupes.map((g) => (
        <optgroup label={g.titre}>
          {g.items.map((c) => (
            <option value={c.id}>{c.famille}{c.italique ? '' : ' (sans italique)'}</option>
          ))}
        </optgroup>
      ))}
    </select>
    <a class="typo-sel-lien" href="/typo/">aperçus</a>
  </div>
</details>

<style>
  /* Bas gauche : replié, la pastille ne gêne rien ; déployé, le panneau peut
     passer devant la barre d'achat, mais seulement le temps du choix. */
  .typo-sel {
    position: fixed;
    left: 12px;
    bottom: 12px;
    z-index: 9000;
    font-family: 'Inter', system-ui, sans-serif;
  }

  .typo-sel-pastille {
    list-style: none;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 999px;
    cursor: pointer;
    background: rgb(255 255 255 / .94);
    border: 1px solid rgb(47 26 22 / .16);
    box-shadow: 0 8px 22px -12px rgb(47 26 22 / .55);
    color: rgb(124 58 237);
    font-size: .8rem;
    font-weight: 700;
    letter-spacing: .02em;
    user-select: none;
  }
  .typo-sel-pastille::-webkit-details-marker { display: none; }
  .typo-sel[open] .typo-sel-pastille { background: rgb(124 58 237); color: #fff; border-color: transparent; }

  .typo-sel-corps {
    position: absolute;
    left: 0;
    bottom: 42px;
    display: flex;
    align-items: center;
    gap: .6rem;
    padding: .5rem .7rem;
    border-radius: 999px;
    background: rgb(255 255 255 / .97);
    border: 1px solid rgb(47 26 22 / .16);
    box-shadow: 0 12px 30px -14px rgb(47 26 22 / .55);
    white-space: nowrap;
  }
  .typo-sel-label {
    color: rgb(124 58 237);
    font-weight: 600;
    letter-spacing: .08em;
    text-transform: uppercase;
    font-size: .6rem;
  }
  .typo-sel-champ {
    font-family: inherit;
    font-size: .78rem;
    color: rgb(47 26 22);
    background: rgb(47 26 22 / .05);
    border: 1px solid rgb(47 26 22 / .14);
    border-radius: 999px;
    padding: .3rem .6rem;
    max-width: 13rem;
  }
  .typo-sel-lien {
    color: rgb(47 26 22 / .55);
    text-decoration: underline;
    font-size: .68rem;
  }
  .typo-sel-lien:hover { color: rgb(47 26 22); }

  /* Sur un écran étroit, le panneau se cale sur toute la largeur plutôt que
     de sortir du cadre. */
  @media (max-width: 560px) {
    .typo-sel-corps {
      left: 0;
      width: calc(100vw - 24px);
      justify-content: center;
      white-space: normal;
    }
    .typo-sel-champ { flex: 1; max-width: none; }
    .typo-sel-lien { display: none; }
  }
  @media print { .typo-sel { display: none; } }
</style>

<script>
  (function () {
    var champ = document.getElementById('typo-sel-champ');
    if (!champ) return;
    try { champ.value = sessionStorage.getItem('typo-essai') || ''; } catch (e) {}
    champ.addEventListener('change', function () {
      if (window.__typoAppliquer) window.__typoAppliquer(champ.value);
    });
  })();
</script>
