---
/**
 * Grille « feed Instagram » — bandeau de photos lifestyle en bas de fiche
 * produit, pour ajouter du visuel et renforcer la marque.
 *
 * Photos dans /public/images/insta (insta-N.webp + variante -400w). Aucune
 * tuile n'est un lien : la section montre le compte sans faire quitter le site.
 */
import { smallerVariant } from '../lib/image-variants';
import { localeFromPath } from '../lib/i18n';

const lang = localeFromPath(Astro.url.pathname);
const L = {
  fr: { section: 'Photos Instagram', follow: 'Suivez-nous' },
  en: { section: 'Instagram photos', follow: 'Follow us' },
  de: { section: 'Instagram-Fotos', follow: 'Folge uns' },
}[lang] ?? { section: 'Photos Instagram', follow: 'Suivez-nous' };

interface Props {
  handle?: string;
}
const { handle = 'bymoroji' } = Astro.props;
// Pas de lien vers Instagram : la section est une vitrine, elle ne doit pas
// faire quitter la boutique. Le compte est simplement nommé.

// `?v=N` = cache-bust : Hostinger sert les images avec un cache immuable
// (max-age 1 an). Sans changer ce suffixe, remplacer un fichier au même nom
// continue de servir l'ancienne version. À incrémenter à chaque changement
// d'image.
const V = 5;
// Photos portées (7 à 9) intercalées avec les visuels de collection.
const photos = [7, 1, 2, 8, 3, 4, 9, 5, 6].map((n) => `/images/insta/insta-${n}.webp?v=${V}`);
---

<section class="insta below-fold-defer" aria-label={L.section}>
  <div class="insta-head">
    <p class="insta-handle">
      <span class="insta-badge" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
          <rect x="2.5" y="2.5" width="19" height="19" rx="5.5"/>
          <circle cx="12" cy="12" r="4.2"/>
          <circle cx="17.6" cy="6.4" r="1.1" fill="currentColor" stroke="none"/>
        </svg>
      </span>
      <span>{L.follow} @{handle}</span>
    </p>
  </div>

  <div class="insta-grid">
    {photos.map((src, i) => (
      <div class="insta-tile">
        {/* Les tuiles font 190 px au plus large : variante 400w servie. */}
        <img src={smallerVariant(src, 400)} alt="" loading="lazy" decoding="async" width="400" height="400" />
      </div>
    ))}
  </div>
</section>

<style>
  /* Bandeau pleine largeur, calé sur les codes des boutiques de coques : un
     en-tête centré, puis une bande de photos JOINTIVES qui touche les deux
     bords de l'écran. Pas de conteneur centré ni de gouttières : c'est ce
     débord qui donne l'impression d'un fil qui continue. */
  .insta {
    padding: 0 0 3rem;
    border-top: 1px solid rgb(var(--c-cream) / .08);
  }
  /* De l'air avant le pied de page : la bande de photos venait buter
     contre son arrondi. */
  @media (min-width: 768px) { .insta { padding-bottom: 4.5rem; } }
  .insta-head {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2.25rem 1.5rem;
  }
  .insta-handle {
    display: inline-flex; align-items: center; gap: 0.85rem;
    font-size: 1rem; font-weight: 600; color: rgb(var(--c-cream));
    transition: opacity .15s;
  }
  @media (min-width: 768px) { .insta-handle { font-size: 1.15rem; } }
  .insta-badge {
    display: grid; place-items: center;
    width: 40px; height: 40px; border-radius: 50%;
    background: rgb(var(--c-cream)); color: rgb(var(--c-dark));
    flex: none;
  }
  .insta-badge svg { width: 22px; height: 22px; }

  /* Défilement horizontal : les vignettes gardent une largeur fixe, donc la
     dernière est coupée par le bord. C'est volontaire — une rangée qui se
     termine pile au bord se lit comme une grille figée, pas comme un fil. */
  .insta-grid {
    display: flex;
    gap: 0;
    overflow-x: auto;
    scroll-snap-type: x proximity;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .insta-grid::-webkit-scrollbar { display: none; }

  .insta-tile {
    position: relative;
    display: block;
    flex: 0 0 42vw;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    scroll-snap-align: start;
    background: rgb(var(--c-panel));
  }
  @media (min-width: 768px) { .insta-tile { flex-basis: 18.5vw; } }
  .insta-tile img {
    width: 100%; height: 100%; object-fit: cover; display: block;
    transition: transform .35s ease;
  }
  /* Souris seulement : sur tactile, le zoom restait collé après un toucher. */
  @media (hover: hover) { .insta-tile:hover img { transform: scale(1.06); } }
</style>
