---
/**
 * Choix du rendu d'impression d'une coque : à plat ou en relief.
 *
 * Pourquoi un composant et pas du balisage recopié dans les deux gabarits de
 * fiche produit : le mode décide du PRIX, donc de la clé d'article envoyée au
 * panier. Deux copies finiraient par diverger, et une clé divergente se
 * traduit par « Article indisponible » en caisse, puisque le serveur de
 * paiement refuse toute clé absente du manifeste.
 *
 * La clé du relief est la clé de base suffixée « -relief ». Le manifeste
 * (/seamless-items.json) déclare les deux, chacune avec son prix : c'est ce
 * qui empêche de faire passer un relief au tarif du plat en réécrivant le
 * panier dans les outils de développement.
 */
import siteConfig from '../../site.config.mjs';
import { t, type Locale } from '../lib/i18n';

interface Props {
  /** Prix de base affiché, en euros (le mode à plat). */
  price: number;
  lang?: Locale;
  class?: string;
}
const { price, lang = 'fr', class: className = '' } = Astro.props;

// Le relief est le rendu mis en avant : c'est le plus valorisé, et la fiche
// l'affiche donc coché d'entrée. La carte cochée et les prix rendus par le
// serveur doivent s'accorder dès le premier affichage, sinon l'étiquette
// contredit le choix le temps que le script démarre.

const surcharge = siteConfig.shop.catalogueReliefSurchargeCents ?? 0;
const defaultMode: 'flat' | 'relief' = surcharge > 0 ? 'relief' : 'flat';
const currency = siteConfig.shop.currency;
const fmt = (cents: number) =>
  new Intl.NumberFormat('fr-FR', { style: 'currency', currency }).format(cents / 100);

const basePriceCents = Math.round(price * 100);
---

<div
  class={`print-mode ${className}`}
  data-print-mode-root
  data-surcharge={String(surcharge)}
  data-default-mode={defaultMode}
  data-currency={currency}
>
  <div class="pm-head">
    <span class="pm-label">{t('print.label', lang)}</span>
    <span class="pm-hint">{t('print.hint', lang)}</span>
  </div>

  <div class="pm-grid" role="radiogroup" aria-label={t('print.label', lang)}>
    <button
      type="button"
      class:list={['pm-opt', defaultMode === 'flat' && 'is-on']}
      data-mode="flat"
      role="radio"
      aria-checked={String(defaultMode === 'flat')}
    >
      {/* Le dos de la coque vu de face, avec un motif posé dessus. Le même
          motif sert aux deux options : seule sa façon d'occuper la surface
          change, donc la comparaison saute aux yeux. Ici il est dans le plan,
          sans ombre : l'encre affleure. */}
      <svg class="pm-fig" viewBox="0 0 48 40" fill="none" aria-hidden="true">
        <rect x="4" y="3" width="40" height="34" rx="9" fill="rgb(var(--c-panel))" stroke="currentColor" stroke-width="1.7"/>
        <rect x="13" y="18" width="22" height="4.5" rx="2.25" fill="currentColor"/>
      </svg>
      <span class="pm-name">{t('print.flat', lang)}</span>
      <span class="pm-price">{fmt(basePriceCents)}</span>
      <span class="pm-check" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>
      </span>
    </button>

    <button
      type="button"
      class:list={['pm-opt', defaultMode === 'relief' && 'is-on']}
      data-mode="relief"
      role="radio"
      aria-checked={String(defaultMode === 'relief')}
    >
      {/* Même coque, même motif, mais il décolle : une ombre portée dessous et
          une arête éclairée dessus. C'est la lecture immédiate du volume, là
          où une coupe technique demandait un effort d'interprétation. */}
      <svg class="pm-fig" viewBox="0 0 48 40" fill="none" aria-hidden="true">
        <rect x="4" y="3" width="40" height="34" rx="9" fill="rgb(var(--c-panel))" stroke="currentColor" stroke-width="1.7"/>
        {/* Trois passes empilées en pyramide, contre une seule pour le plat.
            C'est littéralement ce qui se passe à l'impression, et une pile se
            lit à 40 px de large là où un volume dessiné devient illisible. */}
        <rect x="13" y="22" width="22" height="4.5" rx="2.25" fill="currentColor"/>
        <rect x="16" y="17.5" width="16" height="4.5" rx="2.25" fill="currentColor" opacity=".78"/>
        <rect x="19" y="13" width="10" height="4.5" rx="2.25" fill="currentColor" opacity=".56"/>
      </svg>
      <span class="pm-name">{t('print.relief', lang)}</span>
      <span class="pm-price">{fmt(basePriceCents + surcharge)}</span>
      <span class="pm-check" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>
      </span>
    </button>
  </div>
</div>

<style>
  /* Vocabulaire « sunfreaks » : filet brun épais, ombre portée dure (pas de
     flou), jaune électrique sur l'option retenue, titres en Playfair italique.
     Les couleurs passent par les variables du thème, donc un autre thème
     suivrait sans retouche. */
  .print-mode { margin-top: 1.25rem; margin-bottom: .5rem; }

  .pm-head {
    display: flex;
    align-items: baseline;
    gap: .45rem;
    margin-bottom: .55rem;
    flex-wrap: wrap;
  }
  .pm-label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .09em;
    text-transform: uppercase;
    color: rgb(var(--c-cream));
  }
  .pm-hint { font-size: 11px; color: rgb(var(--c-n500)); }

  .pm-grid { display: grid; grid-template-columns: 1fr 1fr; gap: .55rem; }

  .pm-opt {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-rows: auto auto;
    align-items: center;
    gap: 0 .55rem;
    padding: .6rem .7rem;
    border-radius: 14px;
    border: 1.5px solid rgb(var(--c-cream) / .22);
    background: rgb(var(--c-dark));
    color: rgb(var(--c-n400));
    text-align: left;
    cursor: pointer;
    transition: border-color .18s ease, background-color .18s ease,
                color .18s ease, box-shadow .18s ease, transform .18s ease;
  }
  .pm-opt:hover { border-color: rgb(var(--c-cream) / .55); color: rgb(var(--c-cream)); }

  /* L'option retenue : jaune, filet plein et ombre dure décalée. C'est la
     signature du thème, celle du bouton d'achat — appliquée ici en plus petit
     pour qu'elle se lise comme « choisi » sans voler la vedette au bouton. */
  .pm-opt.is-on {
    border-color: rgb(var(--c-cream));
    background: var(--sun-yellow);
    color: rgb(var(--c-cream));
    box-shadow: 0 2px 0 rgb(var(--c-cream) / .55);
  }
  .pm-opt:active { transform: translateY(1px); }
  .pm-opt.is-on:active { box-shadow: 0 1px 0 rgb(var(--c-cream) / .55); }
  .pm-opt:focus-visible { outline: 2px solid rgb(var(--accent-rgb)); outline-offset: 2px; }

  .pm-fig { grid-row: 1 / span 2; width: 44px; height: auto; color: currentColor; }

  .pm-name {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 700;
    font-size: 14px;
    line-height: 1.2;
    letter-spacing: -.01em;
  }
  .pm-price {
    font-size: 11.5px;
    line-height: 1.35;
    color: rgb(var(--c-n500));
    font-variant-numeric: tabular-nums;
  }
  .pm-opt.is-on .pm-price { color: rgb(var(--c-cream) / .78); font-weight: 600; }

  /* Pastille de validation : ronde, brune, posée sur le jaune. Elle n'existe
     que sur l'option retenue, sinon deux cartes traitées pareil se
     ressemblent trop au premier coup d'œil. */
  .pm-check {
    position: absolute;
    top: -6px;
    right: -6px;
    width: 18px;
    height: 18px;
    display: grid;
    place-items: center;
    border-radius: 999px;
    background: rgb(var(--c-cream));
    color: var(--sun-yellow);
    opacity: 0;
    transform: scale(.5);
    transition: opacity .18s ease, transform .18s ease;
  }
  .pm-check svg { width: 10px; height: 10px; }
  .pm-opt.is-on .pm-check { opacity: 1; transform: scale(1); }

  @media (max-width: 380px) {
    .pm-fig { width: 34px; }
    .pm-opt { padding: .55rem .6rem; gap: 0 .45rem; }
    .pm-name { font-size: 13px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pm-opt, .pm-check { transition: none; }
  }
</style>

<script>
  // Le mode d'impression décide de la clé d'article ET du prix. Les boutons
  // d'achat portent leur configuration de BASE (data-base-item-id / -price),
  // posée par le serveur puis mise à jour par le sélecteur de variantes ; ce
  // script en dérive la configuration réellement envoyée au panier.
  //
  // Passer par des attributs « de base » plutôt que de modifier directement
  // data-item-id évite d'empiler les suffixes : deux clics sur « relief » ne
  // doivent pas produire « ...-relief-relief ».
  const root = document.querySelector<HTMLElement>('[data-print-mode-root]');
  if (root) {
    const surcharge = parseInt(root.dataset.surcharge || '0', 10) || 0;
    const currency = root.dataset.currency || 'EUR';
    const fmt = (cents: number) =>
      new Intl.NumberFormat('fr-FR', { style: 'currency', currency }).format(cents / 100);

    const opts = Array.from(root.querySelectorAll<HTMLButtonElement>('.pm-opt'));
    let mode: 'flat' | 'relief' = root.dataset.defaultMode === 'flat' ? 'flat' : 'relief';

    function sync() {
      const relief = mode === 'relief';
      const modeName = opts.find((o) => o.dataset.mode === mode)
        ?.querySelector('.pm-name')?.textContent?.trim();
      let shownPrice: number | null = null;

      document.querySelectorAll<HTMLElement>('[data-base-item-id]').forEach((btn) => {
        const baseId = btn.dataset.baseItemId || '';
        const basePrice = parseInt(btn.dataset.baseItemPrice || '0', 10) || 0;
        const baseName = btn.dataset.baseItemName || btn.dataset.itemName || '';
        if (!baseId) return;
        const price = relief ? basePrice + surcharge : basePrice;
        btn.dataset.itemId = relief ? baseId + '-relief' : baseId;
        btn.dataset.itemPrice = String(price);
        if (baseName) btn.dataset.itemName = modeName ? baseName + ' — ' + modeName : baseName;
        if (shownPrice === null) shownPrice = price;
      });

      // Tous les prix affichés suivent : celui du bouton, mais aussi celui de
      // la barre collante. Une étiquette qui contredit ce qui part au panier
      // est pire que pas d'étiquette du tout.
      if (shownPrice !== null) {
        const text = fmt(shownPrice);
        document.querySelectorAll<HTMLElement>('[data-buy-price]').forEach((el) => {
          el.textContent = text;
        });
      }
    }

    opts.forEach((opt) => {
      opt.addEventListener('click', () => {
        mode = opt.dataset.mode === 'relief' ? 'relief' : 'flat';
        opts.forEach((o) => {
          const on = o === opt;
          o.classList.toggle('is-on', on);
          o.setAttribute('aria-checked', String(on));
        });
        sync();
      });
    });

    // Le sélecteur de variantes réécrit les attributs de base : on recompose
    // derrière lui, sinon changer de variante annulerait le choix du relief.
    document.addEventListener('vareska:variant-change', sync);
    sync();
  }
</script>
