---
/**
 * Choix du rendu d'impression d'une coque : à plat ou en relief.
 *
 * Pourquoi un composant et pas du balisage recopié dans les deux gabarits de
 * fiche produit : le mode décide du PRIX, donc de la clé d'article envoyée au
 * panier. Deux copies finiraient par diverger, et une clé divergente se
 * traduit par « Article indisponible » en caisse, puisque le serveur de
 * paiement refuse toute clé absente du manifeste.
 *
 * La clé du relief est la clé de base suffixée « -relief ». Le manifeste
 * (/seamless-items.json) déclare les deux, chacune avec son prix : c'est ce
 * qui empêche de faire passer un relief au tarif du plat en réécrivant le
 * panier dans les outils de développement.
 */
import siteConfig from '../../site.config.mjs';
import { t, type Locale } from '../lib/i18n';

interface Props {
  /** Prix de base affiché, en euros (le mode à plat). */
  price: number;
  lang?: Locale;
  class?: string;
}
const { price, lang = 'fr', class: className = '' } = Astro.props;

// Le relief est le rendu mis en avant : c'est le plus valorisé, et la fiche
// l'affiche donc coché d'entrée. La carte cochée et les prix rendus par le
// serveur doivent s'accorder dès le premier affichage, sinon l'étiquette
// contredit le choix le temps que le script démarre.

const surcharge = siteConfig.shop.catalogueReliefSurchargeCents ?? 0;
const defaultMode: 'flat' | 'relief' = surcharge > 0 ? 'relief' : 'flat';
const currency = siteConfig.shop.currency;
const fmt = (cents: number) =>
  new Intl.NumberFormat('fr-FR', { style: 'currency', currency }).format(cents / 100);

const basePriceCents = Math.round(price * 100);
---

<div
  class={`print-mode ${className}`}
  data-print-mode-root
  data-surcharge={String(surcharge)}
  data-default-mode={defaultMode}
  data-currency={currency}
>
  <span class="pm-label">{t('print.label', lang)}</span>

  <div class="pm-rows" role="radiogroup" aria-label={t('print.label', lang)}>
    <button
      type="button"
      class:list={['pm-opt', defaultMode === 'flat' && 'is-on']}
      data-mode="flat"
      role="radio"
      aria-checked={String(defaultMode === 'flat')}
    >
      {/* Les deux illustrations montrent la MÊME coque : tranche en haut, dos
          en dessous. À plat la tranche est lisse et le motif d'un seul trait ;
          en relief la tranche ondule et le motif est doublé. C'est la
          comparaison entre les deux lignes qui explique, pas l'une isolément. */}
      <img
        class="pm-fig"
        src="/images/print-mode-flat.webp"
        alt=""
        width="560"
        height="493"
        loading="lazy"
        decoding="async"
      />

      <span class="pm-body">
        <span class="pm-name">{t('print.flat', lang)}</span>
        <span class="pm-desc">{t('print.flatDesc', lang)}</span>
      </span>
      <span class="pm-price">{fmt(basePriceCents)}</span>
      <span class="pm-radio" aria-hidden="true"></span>
    </button>

    <button
      type="button"
      class:list={['pm-opt', defaultMode === 'relief' && 'is-on']}
      data-mode="relief"
      role="radio"
      aria-checked={String(defaultMode === 'relief')}
    >
      <img
        class="pm-fig"
        src="/images/print-mode-relief.webp"
        alt=""
        width="560"
        height="493"
        loading="lazy"
        decoding="async"
      />

      <span class="pm-body">
        <span class="pm-name">{t('print.relief', lang)}</span>
        <span class="pm-desc">{t('print.reliefDesc', lang)}</span>
      </span>
      <span class="pm-price">{fmt(basePriceCents + surcharge)}</span>
      <span class="pm-radio" aria-hidden="true"></span>
    </button>
  </div>
</div>

<style>
  /* Deux lignes pleine largeur plutôt que deux cartes côte à côte : l'illustration
     a besoin de place pour montrer le motif, et un titre suivi de sa description
     se lit mieux sur une ligne que serré dans une colonne. */
  .print-mode { margin-top: 1.25rem; margin-bottom: .5rem; }

  .pm-label {
    display: block;
    margin-bottom: .5rem;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .09em;
    text-transform: uppercase;
    color: rgb(var(--c-cream));
  }

  .pm-rows { display: grid; gap: .5rem; }

  .pm-opt {
    --pm-fill: rgb(var(--c-panel));
    display: grid;
    grid-template-columns: auto 1fr auto auto;
    align-items: center;
    min-height: 0;
    gap: .75rem;
    width: 100%;
    padding: .55rem .85rem .55rem .55rem;
    border-radius: 14px;
    border: 1.5px solid rgb(var(--c-cream) / .16);
    background: rgb(var(--c-panel));
    color: rgb(var(--c-n400));
    text-align: left;
    cursor: pointer;
    transition: border-color .18s ease, background-color .18s ease, color .18s ease;
  }
  .pm-opt:hover { border-color: rgb(var(--c-cream) / .4); }

  /* Retenue : filet violet, l'accent du site. Le jaune reste au bouton d'achat,
     seule action de la page. */
  .pm-opt.is-on {
    --pm-fill: rgb(var(--c-dark));
    border-color: rgb(var(--accent-rgb));
    background: rgb(var(--c-dark));
    color: rgb(var(--accent-rgb));
  }
  .pm-opt:focus-visible { outline: 2px solid rgb(var(--accent-rgb) / .55); outline-offset: 2px; }

  /* L'illustration porte l'explication : on lui laisse de la place plutôt que
     de la réduire à une vignette où l'ondulation de la tranche disparaîtrait. */
  .pm-fig { width: 96px; height: auto; flex: none; }

  .pm-body { display: grid; gap: 1px; min-width: 0; }
  .pm-name {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 700;
    font-size: 14.5px;
    line-height: 1.2;
    letter-spacing: -.01em;
  }
  .pm-desc {
    font-size: 11.5px;
    white-space: nowrap;
    line-height: 1.25;
    color: rgb(var(--c-n500));
  }
  .pm-price {
    font-size: 12.5px;
    font-weight: 600;
    white-space: nowrap;
    color: rgb(var(--c-n400));
    font-variant-numeric: tabular-nums;
  }
  .pm-opt.is-on .pm-price { color: rgb(var(--accent-rgb)); }

  /* Bouton radio : le repère le plus universel pour « une seule des deux ». */
  .pm-radio {
    width: 17px;
    height: 17px;
    border-radius: 999px;
    border: 2px solid rgb(var(--c-cream) / .28);
    display: grid;
    place-items: center;
    transition: border-color .18s ease;
  }
  .pm-radio::after {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: rgb(var(--accent-rgb));
    transform: scale(0);
    transition: transform .18s ease;
  }
  .pm-opt.is-on .pm-radio { border-color: rgb(var(--accent-rgb)); }
  .pm-opt.is-on .pm-radio::after { transform: scale(1); }

  @media (max-width: 380px) {
    .pm-fig { width: 78px; }
    .pm-opt { gap: .55rem; padding: .5rem .7rem .5rem .45rem; }
    .pm-name { font-size: 13.5px; }
    .pm-desc { font-size: 11px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pm-opt, .pm-radio, .pm-radio::after { transition: none; }
  }
</style>

<script>
  // Le mode d'impression décide de la clé d'article ET du prix. Les boutons
  // d'achat portent leur configuration de BASE (data-base-item-id / -price),
  // posée par le serveur puis mise à jour par le sélecteur de variantes ; ce
  // script en dérive la configuration réellement envoyée au panier.
  //
  // Passer par des attributs « de base » plutôt que de modifier directement
  // data-item-id évite d'empiler les suffixes : deux clics sur « relief » ne
  // doivent pas produire « ...-relief-relief ».
  const root = document.querySelector<HTMLElement>('[data-print-mode-root]');
  if (root) {
    const surcharge = parseInt(root.dataset.surcharge || '0', 10) || 0;
    const currency = root.dataset.currency || 'EUR';
    const fmt = (cents: number) =>
      new Intl.NumberFormat('fr-FR', { style: 'currency', currency }).format(cents / 100);

    const opts = Array.from(root.querySelectorAll<HTMLButtonElement>('.pm-opt'));
    let mode: 'flat' | 'relief' = root.dataset.defaultMode === 'flat' ? 'flat' : 'relief';

    function sync() {
      const relief = mode === 'relief';
      const modeName = opts.find((o) => o.dataset.mode === mode)
        ?.querySelector('.pm-name')?.textContent?.trim();
      let shownPrice: number | null = null;

      document.querySelectorAll<HTMLElement>('[data-base-item-id]').forEach((btn) => {
        const baseId = btn.dataset.baseItemId || '';
        const basePrice = parseInt(btn.dataset.baseItemPrice || '0', 10) || 0;
        const baseName = btn.dataset.baseItemName || btn.dataset.itemName || '';
        if (!baseId) return;
        const price = relief ? basePrice + surcharge : basePrice;
        btn.dataset.itemId = relief ? baseId + '-relief' : baseId;
        btn.dataset.itemPrice = String(price);
        if (baseName) btn.dataset.itemName = modeName ? baseName + ' — ' + modeName : baseName;
        if (shownPrice === null) shownPrice = price;
      });

      // Tous les prix affichés suivent : celui du bouton, mais aussi celui de
      // la barre collante. Une étiquette qui contredit ce qui part au panier
      // est pire que pas d'étiquette du tout.
      if (shownPrice !== null) {
        const text = fmt(shownPrice);
        document.querySelectorAll<HTMLElement>('[data-buy-price]').forEach((el) => {
          el.textContent = text;
        });
      }
    }

    opts.forEach((opt) => {
      opt.addEventListener('click', () => {
        mode = opt.dataset.mode === 'relief' ? 'relief' : 'flat';
        opts.forEach((o) => {
          const on = o === opt;
          o.classList.toggle('is-on', on);
          o.setAttribute('aria-checked', String(on));
        });
        sync();
      });
    });

    // Le sélecteur de variantes réécrit les attributs de base : on recompose
    // derrière lui, sinon changer de variante annulerait le choix du relief.
    document.addEventListener('vareska:variant-change', sync);
    sync();
  }
</script>
