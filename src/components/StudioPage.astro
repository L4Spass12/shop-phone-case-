---
// Page du studio de personnalisation, commune à toutes les langues
// (routes /personnaliser et /<lang>/personnaliser).
import BaseLayout from '../layouts/BaseLayout.astro';
import CaseCustomizer from './CaseCustomizer.astro';
import siteConfig from '../../site.config.mjs';
import { localePrefix, type Locale } from '../lib/i18n';

interface Props { lang: Locale }
const { lang } = Astro.props;
const lp = localePrefix(lang);

const T = {
  fr: { home: 'Accueil', crumb: 'Personnaliser', title: 'Personnaliser ma coque',
        seoTitle: 'Coque personnalisée avec vos photos et textes', h1: 'Créer ma coque de téléphone personnalisée',
        description: 'Créez votre coque de téléphone unique : partez d’un de nos designs, ajoutez vos photos et vos textes, arrangez-les à votre goût. Studio de personnalisation en ligne.' },
  en: { home: 'Home', crumb: 'Customise', title: 'Customise my case',
        seoTitle: 'Custom phone case with your photos and text', h1: 'Create my custom phone case',
        description: 'Create your own unique phone case: start from one of our designs, add your photos and text, and arrange them as you like. Online customisation studio.' },
  de: { home: 'Startseite', crumb: 'Gestalten', title: 'Meine Hülle gestalten',
        seoTitle: 'Handyhülle mit eigenem Foto und Text gestalten', h1: 'Meine eigene Handyhülle gestalten',
        description: 'Gestalte deine eigene Handyhülle: Starte mit einem unserer Designs, füge deine Fotos und Texte hinzu und ordne sie nach deinem Geschmack an. Online-Gestaltungsstudio.' },
}[lang] ?? null;
if (!T) throw new Error(`StudioPage : langue non prise en charge (${lang})`);

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: T.home, item: `${siteConfig.url}${lp}/` },
    { '@type': 'ListItem', position: 2, name: T.crumb, item: `${siteConfig.url}${lp}/personnaliser` },
  ],
};
---

<BaseLayout
  title={`${T.seoTitle} | ${siteConfig.name}`}
  description={T.description}
  jsonLd={breadcrumbSchema}
>
  {/* Le studio n'affiche pas de titre : H1 pour Google et les lecteurs d'écran. */}
  <h1 class="sr-only">{T.h1}</h1>
  <CaseCustomizer lang={lang} realistic />
</BaseLayout>
